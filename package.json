{
  "name": "assubki-books",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "rm -rf .wrangler/state/v3/observability",
    "dev": "astro dev",
    "build": "node scripts/run-check.mjs astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:local": "wrangler d1 execute assubki-books --local",
    "db:remote": "wrangler d1 execute assubki-books --remote",
    "migrate:woo": "node scripts/migrate-from-woo.mjs",
    "images:fetch": "node scripts/fetch-images.mjs",
    "test:e2e": "node scripts/run-check.mjs node --experimental-strip-types --no-warnings scripts/e2e.mjs",
    "test:e2e:prod": "node scripts/run-check.mjs node --experimental-strip-types --no-warnings scripts/e2e.mjs --prod",
    "typecheck": "node scripts/run-check.mjs astro check --minimumSeverity error",
    "deploy:sweep": "wrangler deploy -c workers/expire-holds/wrangler.jsonc",
    "test:backup": "node scripts/run-check.mjs node scripts/test-backup.mjs",
    "test:reservations": "node scripts/run-check.mjs node scripts/test-reservations.mjs",
    "test:covers": "node scripts/run-check.mjs node --experimental-strip-types --no-warnings scripts/test-cover-clean.mjs && node scripts/run-check.mjs node scripts/test-cover-review.mjs && node scripts/run-check.mjs node scripts/test-model-route.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/qrcode": "^1.5.6",
    "onnxruntime-web": "^1.29.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.0",
    "esbuild": "0.28.2"
  }
}
