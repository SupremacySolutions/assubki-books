{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // A separate Worker purely so the hold sweep can run on a cron trigger: the
  // Astro Cloudflare adapter owns the main Worker's entrypoint and exposes no
  // way to add a `scheduled` handler to it.
  //
  // Deploy from the repo root:
  //   npx wrangler deploy -c workers/expire-holds/wrangler.jsonc
  "name": "assubki-books-expire-holds",
  "main": "./index.ts",
  "compatibility_date": "2026-08-01",

  // No public URL. This Worker is a cron job; it has no reason to answer the
  // internet, and leaving workers.dev on published an endpoint that expired
  // holds and deleted payment screenshots for anybody who found it.
  "workers_dev": false,
  "preview_urls": false,

  // Same database as the site.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assubki-books",
      "database_id": "efc0b55d-885f-44cb-9baf-a4431bb169ce"
    }
  ],

  // The screenshots the sweep removes. Same bucket the site writes them to;
  // this Worker only ever deletes, and only under the `proofs/` prefix.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "assubki-books-uploads"
    }
  ],

  // This Worker writes to customers now, not only to the database: it drains
  // the queue of "your reserved books have arrived" notices. That needs the
  // same addresses the site sends from.
  //
  // The two secrets behind it are NOT shared with the main Worker - a Worker's
  // secret store is its own - and have to be put here as well:
  //
  //   npx wrangler secret put RESEND_API_KEY    -c workers/expire-holds/wrangler.jsonc
  //   npx wrangler secret put TELEGRAM_BOT_TOKEN -c workers/expire-holds/wrangler.jsonc
  //
  // Without them every notice fails both routes, silently, four times, and the
  // customers who reserved are never told their books landed.
  "vars": {
    "ORDER_FROM": "As-Subki Orders <orders@assubkibooks.co.uk>",
    "OWNER_EMAIL": "subkibooks@gmail.com",
    "TELEGRAM_BOT_USERNAME": "AsSubkiBooksBot",
    "TELEGRAM_CHANNEL_ID": "-1003850128293"
  },

  // Every 15 minutes. A book whose hold has lapsed should return to the shelf
  // quickly - an hour of showing "out of stock" when it is free is a lost sale.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "observability": { "enabled": true }
}
