---
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import Rosette from '../components/Rosette.astro';
import { categoryTree, shelfBooks, catalogueStats } from '../lib/db';
import { classmark } from '../lib/classmarks';
import { SITE, imageUrl } from '../lib/format';

const [tree, shelf, stats] = await Promise.all([categoryTree(), shelfBooks(24), catalogueStats()]);
const top = tree.slice(0, 8);
/*
 * How many shelves there are in total, not how many are shown - and that means
 * counting the children too, since a subject one level down is still a shelf a
 * customer can browse.
 */
const shelfCount = tree.reduce((n, c) => n + 1 + (c.children?.length ?? 0), 0);

/*
 * The drifting shelf behind the hero uses the same covers as the grid below,
 * so the browser fetches each image once and the second use is a cache hit.
 *
 * Upright covers only, because the strip crops every one of them to a single
 * size. Cropping is what keeps it even and what removes the white margin the
 * scans carry - but a landscape photo cropped to 118x166 loses most of itself
 * and a spine loses nearly all of it, so those are simply not offered a slot.
 * The grid below is unaffected and shows them at their own shape.
 *
 * It costs almost nothing: of the in-stock covers, 198 are upright and 4 wide.
 */
const upright = (b: { width: number | null; height: number | null }) =>
  Boolean(b.width && b.height) && b.width! / b.height! >= 0.6 && b.width! / b.height! <= 0.85;

const drifting = shelf.filter((b) => b.image_key && upright(b)).slice(0, 14);
---

<Base wide headerSearch={false} description={`${stats.titles} Islamic titles - classical texts, Dars Nizami and Maktab syllabus sets, hadith, fiqh and tafsir. ${SITE.tagline}.`}>
  <!-- The hero is the catalogue, not a slogan. People arrive knowing the text
       they want, so the search field is the first thing they meet. -->
  <section class="bg-[var(--color-navy-deep)] text-white relative overflow-hidden">
    <div
      class="absolute -right-24 -top-28 text-white/[0.045] pointer-events-none select-none hidden sm:block"
      aria-hidden="true"
    >
      <Rosette size={420} />
    </div>

    <div class="mx-auto max-w-[var(--width-shop)] px-5 md:px-10 pt-14 md:pt-[76px] relative text-center">
      <p class="eyebrow !text-[10.5px] !tracking-[0.2em] !text-[var(--color-wash)]/65">
        {SITE.nameAr} · Leicester
      </p>
      <h1
        class="mt-3 mx-auto font-[family-name:var(--font-display)] font-semibold max-w-[16ch] text-[34px] leading-[1.08] sm:text-[46px] md:text-[62px] md:leading-[1.06] tracking-[-0.025em]"
      >
        The books on your syllabus, in stock and priced plainly.
      </h1>

      {/* The search pill. The white ground and the long soft shadow lift it off
          the navy, which is the one thing the hero is for: people arrive
          knowing the text they want. */}
      <form action="/catalogue" method="get" class="mt-8 mx-auto max-w-xl" role="search">
        <label for="hero-q" class="sr-only">Search the catalogue</label>
        <div
          class="flex items-center gap-2 bg-white rounded-[var(--radius-pill)] pl-[22px] pr-2.5 py-2.5 shadow-[var(--shadow-search)]"
        >
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-ink-faint)"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            class="shrink-0"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="hero-q"
            type="search"
            name="q"
            placeholder="Try “Nahw” or “النحو”"
            class="flex-1 min-w-0 bg-transparent border-0 outline-none text-[17px] text-[var(--color-ink)] placeholder:text-[var(--color-ink-faint)]"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary !py-2 !px-5 !text-[14.5px] shrink-0">
            Search
          </button>
        </div>
      </form>

      {/* The prototype promises results as you type and a live count beside the
          box. This search posts to /catalogue, so it says what it does. */}
      <p class="mt-4 text-[13.5px] text-[var(--color-wash)]/70">
        Search in English or Arabic{' · '}
        <a href="/catalogue" class="underline underline-offset-2 hover:text-white">
          {stats.inStock} of {stats.titles} titles in stock
        </a>
      </p>
    </div>

    {
      drifting.length > 0 && (
        // Real covers, and now real links: someone who spots a book here can go
        // straight to it instead of hunting for it again below. The strip
        // scrolls natively, so it can be swiped or flicked past rather than
        // waited on.
        <div class="mt-11">
          <div class="shelf-strip relative" data-shelf aria-label="A few of the books in stock">
          <div class="shelf-track">
            {drifting.map((book) => (
              <a class="shelf-book" href={`/book/${book.slug}`}>
                <img
                  src={imageUrl(book.image_key, 'hero')}
                  alt={book.title}
                  loading="lazy"
                  decoding="async"
                  width="118"
                  height="166"
                />
              </a>
            ))}
            {/* The same covers again, so the drift can wrap without a visible
                jump.

                These are links too. They used to be plain spans, to keep a
                second copy of every book out of a screen reader and off the
                keyboard's path - but both halves are on screen and drifting
                past, so that made roughly half the covers anyone could see
                unclickable. `aria-hidden` and `tabindex="-1"` get the same
                quiet without taking the click away. */}
            {drifting.map((book) => (
              <a
                class="shelf-book"
                href={`/book/${book.slug}`}
                aria-hidden="true"
                tabindex="-1"
              >
                <img
                  src={imageUrl(book.image_key, 'hero')}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="118"
                  height="166"
                />
              </a>
            ))}
            </div>
          </div>
          {/* The board, and a line saying the drift can be stopped - it moves
              on its own, and a moving thing you cannot catch is a nuisance. */}
          <div class="shelf-board" aria-hidden="true"></div>
          <p class="mt-4 pb-11 text-center text-[12.5px] text-[var(--color-wash)]/55">
            On the shelf this week · hover or swipe to stop it
          </p>
        </div>
      )
    }
  </section>

  <!-- Subjects as shelf classmarks: how a madrasah student actually navigates. -->
  <section class="mx-auto max-w-[var(--width-shop)] px-5 md:px-10 py-12 md:py-16 reveal">
    <div class="flex items-baseline justify-between gap-4 pb-3.5 border-b border-[var(--color-rule-soft)]">
      <h2 class="font-[family-name:var(--font-display)] text-[26px] font-semibold">Browse the shelves</h2>
      <a
        href="/catalogue"
        class="text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2 whitespace-nowrap"
      >All {shelfCount} subjects →</a>
    </div>

    {/* Rows on hairlines, not boxes. A boxed grid gives twenty-six shelves the
        same visual weight as twenty-six products; a ruled list reads as an
        index, which is what it is. The classmark sits in a fixed column so the
        codes line up down the page and can be scanned without reading. */}
    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-10">
      {
        top.map((cat) => (
          <li class="border-b border-[var(--color-rule-faint)]">
            <a href={`/catalogue/${cat.path}`} class="group flex items-center gap-3 py-[13px]">
              <span class="w-[38px] shrink-0 text-[10.5px] font-semibold tracking-[0.12em] uppercase text-[var(--color-navy)]">
                {classmark(cat.slug)}
              </span>
              <span class="min-w-0 flex-1 text-[15.5px] font-medium truncate group-hover:text-[var(--color-navy)]">
                {cat.name}
              </span>
              <span class="shrink-0 text-[13px] text-[var(--color-ink-faint)] tabular-nums">
                {cat.count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[var(--width-shop)] px-5 md:px-10 pb-16 reveal">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 class="font-[family-name:var(--font-display)] text-[26px] font-semibold">Recently added</h2>
      <a href="/catalogue?sort=newest" class="text-[14.5px] text-[var(--color-navy)] hover:underline underline-offset-2"
        >All new arrivals →</a
      >
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-7 gap-y-11">
      {shelf.slice(0, 10).map((book, i) => (
        <div class="reveal" data-delay={String(Math.min(i % 5, 5))}>
          <BookCard book={book} eager={i < 5} quickAdd />
        </div>
      ))}
    </div>
  </section>

  <!-- Ordering here is unusual enough that it needs saying plainly and early. -->
  <section class="border-t border-[var(--color-rule-soft)] bg-white">
    <div class="mx-auto max-w-[var(--width-shop)] px-5 md:px-10 py-14 md:py-16 reveal">
      {/* The heading sits beside the steps rather than above them, so the three
          columns line up on one rule and read as a single sequence. */}
      <div class="grid gap-9 md:grid-cols-[260px_1fr] md:gap-14">
        <div>
          <h2 class="font-[family-name:var(--font-display)] text-[26px] font-semibold">How ordering works</h2>
          <p class="mt-3 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
            No card details are taken on this website at any point.
          </p>
        </div>
      <ol class="grid gap-7 md:grid-cols-3 md:gap-9">
        <li class="border-t-2 border-[var(--color-navy-deep)] pt-4">
          <span class="eyebrow !text-[10.5px]">Step one</span>
          <h3 class="mt-2 text-[19px]">Add what you need</h3>
          <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
            Build a basket from the catalogue. Stock counts are live, so what you see is what is on
            the shelf.
          </p>
        </li>
        <li class="border-t-2 border-[var(--color-rule-soft)] pt-4">
          <span class="eyebrow !text-[10.5px]">Step two</span>
          <h3 class="mt-2 text-[19px]">Send your request</h3>
          <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
            You get an itemised confirmation by email with a reference. Your books are held for 48
            hours while we reply.
          </p>
        </li>
        <li class="border-t-2 border-[var(--color-rule-soft)] pt-4">
          <span class="eyebrow !text-[10.5px]">Step three</span>
          <h3 class="mt-2 text-[19px]">We send payment details</h3>
          <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
            Payment is arranged directly with us. No card details are taken on this website at any
            point.
          </p>
        </li>
      </ol>
      </div>
    </div>
  </section>
</Base>
