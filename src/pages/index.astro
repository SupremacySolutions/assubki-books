---
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import Rosette from '../components/Rosette.astro';
import { categoryTree, shelfBooks, catalogueStats } from '../lib/db';
import { classmark } from '../lib/classmarks';
import { SITE } from '../lib/format';

const [tree, shelf, stats] = await Promise.all([categoryTree(), shelfBooks(12), catalogueStats()]);
const top = tree.slice(0, 8);
---

<Base wide description={`${stats.titles} Islamic titles — classical texts, Dars Nizami and Maktab syllabus sets, hadith, fiqh and tafsir. ${SITE.tagline}.`}>
  <!-- The hero is the catalogue, not a slogan. People arrive knowing the text
       they want, so the search field is the first thing they meet. -->
  <section class="bg-[var(--color-navy-deep)] text-white relative overflow-hidden">
    <div
      class="absolute -right-24 -top-24 text-white/[0.05] pointer-events-none select-none hidden sm:block"
      aria-hidden="true"
    >
      <Rosette size={420} />
    </div>

    <div class="mx-auto max-w-6xl px-5 md:px-8 py-14 md:py-20 relative">
      <p class="eyebrow !text-[var(--color-wash)]/70">{SITE.nameAr} · Leicester</p>
      <h1
        class="mt-3 font-[family-name:var(--font-display)] text-[34px] leading-[1.1] sm:text-[46px] md:text-[54px] font-semibold max-w-3xl tracking-[-0.02em]"
      >
        The books on your syllabus, in stock and priced plainly.
      </h1>
      <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-wash)] max-w-xl">
        {stats.titles} titles across hadith, fiqh, tafsir and the Dars Nizami and Maktab courses.
        Request what you need and we will send payment details directly.
      </p>

      <form action="/catalogue" method="get" class="mt-8 max-w-xl" role="search">
        <label for="hero-q" class="sr-only">Search the catalogue</label>
        <div class="flex gap-2">
          <input
            id="hero-q"
            type="search"
            name="q"
            placeholder="Try “Nahw” or “النحو”"
            class="field !py-3 !text-[16px] flex-1"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary !bg-white !text-[var(--color-navy-deep)] !py-3 hover:!bg-[var(--color-wash)]">
            Search
          </button>
        </div>
      </form>

      <p class="mt-4 text-[14px] text-[var(--color-wash)]/70">
        {stats.inStock} of {stats.titles} titles available now{' · '}
        <a href="/catalogue" class="underline underline-offset-2 hover:text-white">browse everything</a>
      </p>
    </div>
  </section>

  <!-- Subjects as shelf classmarks: how a madrasah student actually navigates. -->
  <section class="mx-auto max-w-6xl px-5 md:px-8 py-12 md:py-16">
    <h2 class="eyebrow">Shelves</h2>
    <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5">
      {
        top.map((cat) => (
          <li>
            <a
              href={`/catalogue/${cat.path}`}
              class="flex items-center gap-3 p-3.5 bg-white border border-[var(--color-rule)] rounded-[var(--radius-card)] hover:border-[var(--color-navy)] transition-colors group"
            >
              <span class="classmark shrink-0">{classmark(cat.slug)}</span>
              <span class="min-w-0 flex-1">
                <span class="block text-[15px] font-medium text-[var(--color-ink)] truncate group-hover:text-[var(--color-navy)]">
                  {cat.name}
                </span>
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] tabular-nums">
                  {cat.count} {cat.count === 1 ? 'title' : 'titles'}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-5 md:px-8 pb-16">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 class="font-[family-name:var(--font-display)] text-[26px] font-semibold">Recently added</h2>
      <a href="/catalogue?sort=newest" class="text-[14.5px] text-[var(--color-navy)] hover:underline underline-offset-2"
        >All new arrivals →</a
      >
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-x-5 gap-y-8">
      {shelf.map((book, i) => <BookCard book={book} eager={i < 6} />)}
    </div>
  </section>

  <!-- Ordering here is unusual enough that it needs saying plainly and early. -->
  <section class="border-t border-[var(--color-rule)] bg-white">
    <div class="mx-auto max-w-6xl px-5 md:px-8 py-14">
      <h2 class="font-[family-name:var(--font-display)] text-[26px] font-semibold">How ordering works</h2>
      <ol class="mt-7 grid gap-7 md:grid-cols-3 md:gap-10">
        <li>
          <span class="eyebrow">Step one</span>
          <h3 class="mt-1.5 text-[18px]">Add what you need</h3>
          <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
            Build a basket from the catalogue. Stock counts are live, so what you see is what is on
            the shelf.
          </p>
        </li>
        <li>
          <span class="eyebrow">Step two</span>
          <h3 class="mt-1.5 text-[18px]">Send your request</h3>
          <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
            You get an itemised confirmation by email with a reference. Your books are held for 48
            hours while we reply.
          </p>
        </li>
        <li>
          <span class="eyebrow">Step three</span>
          <h3 class="mt-1.5 text-[18px]">We send payment details</h3>
          <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
            Payment is arranged directly with us. No card details are taken on this website at any
            point.
          </p>
        </li>
      </ol>
    </div>
  </section>
</Base>
