---
import Base from '../../layouts/Base.astro';
import { publicShipments } from '../../lib/shipments';
import { whenText } from '../../lib/incoming';

/*
 * A list of shipments, not a list of books.
 *
 * A shipment can carry hundreds of titles, and stacking two of those on one
 * page gave a customer a screen they had to scroll past rather than read -
 * with the one button that does anything stranded at the bottom of it. Each
 * shipment is a card that says what it is and how much of it is left, and the
 * books live on the shipment's own page where they can be paged through.
 */
const shipments = (await publicShipments()).filter((s) => s.items > 0);

/**
 * The date under the name.
 *
 * Before it lands that is a forecast, deliberately vague - "late November
 * 2026" - because a shop that names a day and misses it has broken a promise.
 * Once it has landed we know the answer exactly, so it stops being a forecast
 * and becomes the day it came.
 *
 * Either way the year is kept: see `whenText`.
 */
const when = (s: {
  status: string;
  arrived_at: number | null;
  incoming_vague: string | null;
  incoming_month: string | null;
}) =>
  s.status === 'arrived' && s.arrived_at
    ? new Date(s.arrived_at * 1000).toLocaleDateString('en-GB', {
        day: 'numeric', month: 'long', year: 'numeric',
      })
    : whenText(s.incoming_vague, s.incoming_month, { year: true });
---

<Base
  title="Upcoming shipments"
  description="Books arriving in our next shipment, and how to reserve a copy before they land."
>
  <div class="wrap py-10">
    <h1 class="text-[30px] sm:text-[34px] leading-tight">Upcoming shipments</h1>
    <p class="mt-3 max-w-[44rem] text-[15.5px] text-[var(--color-ink-soft)] leading-relaxed">
      These books are on their way to us. Reserving one puts a copy aside in your
      name — nothing is paid now, and nothing is charged on this website at any
      point. We write to you when the shipment lands.
    </p>

    {shipments.length === 0 && (
      <p class="mt-8 text-[15.5px] text-[var(--color-ink-soft)]">
        Nothing on its way just now. Everything we have is in
        {' '}<a href="/catalogue" class="underline">the catalogue</a>.
      </p>
    )}

    <ul class="mt-8 grid gap-4">
      {shipments.map((s) => {
        const free = Math.max(0, s.copies - s.claimed);
        return (
          <li>
            <a
              href={`/shipments/${s.id}`}
              class="block bg-white border border-[var(--color-rule)] rounded-[var(--radius-panel)] p-5 hover:border-[var(--color-navy)] transition-colors"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <div class="min-w-0">
                  <h2 class="text-[21px] leading-snug">{s.title}</h2>
                  {when(s) && (
                    <p class="mt-0.5 text-[14px] text-[var(--color-ink-soft)]">
                      {s.status === 'open' ? 'Expected ' : 'Arrived '}{when(s)}
                    </p>
                  )}
                </div>
                <span
                  class:list={[
                    'text-[13.5px] shrink-0',
                    s.status === 'open'
                      ? 'text-[var(--color-instock)]'
                      : 'text-[var(--color-ink-faint)]',
                  ]}
                >
                  {s.status === 'open' ? 'Open for reservations' : 'Arrived — reservations closed'}
                </span>
              </div>

              <p class="mt-3 text-[14px] text-[var(--color-ink-soft)] tabular-nums">
                {s.items} {s.items === 1 ? 'title' : 'titles'}
                {' · '}{s.copies} {s.copies === 1 ? 'copy' : 'copies'}
                {s.status === 'open' && (
                  <span class={free > 0 ? '' : 'text-[var(--color-outstock)]'}>
                    {' · '}{free > 0 ? `${free} free to reserve` : 'all reserved'}
                  </span>
                )}
              </p>

              <p class="mt-3 text-[14px] text-[var(--color-navy)]">
                {s.status === 'open' ? 'See the list and reserve →' : 'See what came in →'}
              </p>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
