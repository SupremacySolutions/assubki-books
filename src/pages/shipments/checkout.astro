---
import Base from '../../layouts/Base.astro';
import CheckoutFields from '../../components/CheckoutFields.astro';
import { getShipment, publicShipmentItemsByIds } from '../../lib/shipments';
import { whenText } from '../../lib/incoming';
import { price } from '../../lib/format';

const params = Astro.url.searchParams;
const shipmentId = Number.parseInt(params.get('s') ?? '', 10);
const shipment = Number.isInteger(shipmentId) ? await getShipment(shipmentId) : null;
if (!shipment || shipment.status !== 'open') return Astro.redirect('/shipments');

/*
 * What was chosen, read back out of the address.
 *
 * The quantities travel in the URL rather than in a session, so this page
 * needs no memory of the last one: a customer can go back, change their mind
 * and come again, and a rejected form can be handed back with everything they
 * typed still in it. Only the ids come from the URL - every price and limit is
 * read from the shipment.
 */
const wanted = new Map<number, number>();
for (const [key, value] of params) {
  if (!key.startsWith('q')) continue;
  const bookId = Number.parseInt(key.slice(1), 10);
  const qty = Math.round(Number(value) || 0);
  if (Number.isInteger(bookId) && qty > 0) wanted.set(bookId, qty);
}

const chosen = (await publicShipmentItemsByIds(shipmentId, [...wanted.keys()]))
  .map((item) => ({ item, qty: Math.min(item.free, wanted.get(item.id) ?? 0) }))
  .filter((row) => row.qty > 0);

if (!chosen.length) return Astro.redirect(`/shipments/${shipmentId}`);

const total = chosen.reduce((sum, r) => sum + r.item.price_pence * r.qty, 0);
const copies = chosen.reduce((n, r) => n + r.qty, 0);
const error = params.get('e');
const when = whenText(shipment.incoming_vague, shipment.incoming_month, { year: true });
---

<Base title="Reserve these books" noindex>
  <div class="py-10 md:py-14 max-w-3xl">
    <h1 class="font-[family-name:var(--font-display)] text-[32px] md:text-[38px] font-semibold">
      Reserve these books
    </h1>
    <p class="mt-3 text-[16px] text-[var(--color-ink-soft)] leading-relaxed max-w-xl">
      From {shipment.title}{when ? `, expected ${when}` : ''}.
      {' '}<strong class="text-[var(--color-ink)]">Nothing is paid now.</strong>
      {' '}We write to you when it lands.
    </p>

    {/*
      * A rejected reservation comes back here with everything still typed in,
      * so this says what went wrong before the customer has scrolled anywhere.
      */}
    {error && (
      <p
        role="alert"
        class="mt-5 p-3.5 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]"
      >
        {error}.
      </p>
    )}

    {/*
      * The same form as the ordinary checkout, because it is the same form:
      * three steps, the same fields, the same inline errors, the same country
      * box. Only what is being ordered differs, and that is the column on the
      * right. A plain POST rather than an API call, so a reservation can be
      * made with scripting off; `wireCheckoutForm` checks it first when there
      * is scripting, and `/api/reservations` checks it again regardless.
      */}
    <form
      id="form"
      method="post"
      action="/api/reservations"
      novalidate
      class="mt-8 grid gap-8 md:grid-cols-[1fr_280px] md:gap-10 items-start"
    >
      <input type="hidden" name="s" value={shipmentId} />
      {chosen.map(({ item, qty }) => (
        <input type="hidden" name={`q${item.id}`} value={qty} />
      ))}

      <div class="grid gap-6">
        <CheckoutFields
          submitLabel="Reserve these books"
          closing="Reserving does not commit you to buy. We write to you when the books land, with the total, and you decide then."
          fulfilmentLegend="How would you like them when they arrive?"
          notesPlaceholder="Anything we should know about this reservation."
        />
      </div>

      <aside id="aside" class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5 md:sticky md:top-[100px]">
        <h2 class="eyebrow mb-3">Your reservation</h2>
        <ul class="space-y-2.5 text-[14.5px]">
          {chosen.map(({ item, qty }) => (
            <li class="flex items-baseline justify-between gap-3">
              <span class="ar min-w-0">
                {item.title}
                {qty > 1 && <span class="text-[var(--color-ink-faint)]"> × {qty}</span>}
              </span>
              <span class="shrink-0 tabular-nums">{price(item.price_pence * qty)}</span>
            </li>
          ))}
        </ul>

        <div class="mt-4 pt-3 border-t border-[var(--color-rule)] flex items-baseline justify-between">
          <span class="text-[14.5px]">Total</span>
          <span class="price text-[18px]">{price(total)}</span>
        </div>

        <p
          class="mt-3 -mx-5 px-5 py-3 bg-[var(--color-paper-raised)] border-t border-[var(--color-rule-soft)] text-[12.5px] text-[var(--color-brass)] leading-relaxed"
        >
          {copies === 1 ? 'This copy is' : `These ${copies} copies are`} set aside in your
          name until the shipment arrives, however long that takes. Payment and postage
          are settled after it lands.
        </p>

        <a
          href={`/shipments/${shipmentId}`}
          class="mt-3 inline-block text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2"
        >
          Change what you reserved
        </a>
      </aside>
    </form>
  </div>

  <script>
    import { wireCheckoutForm } from '../../scripts/checkout-form.ts';

    /*
     * The same wiring the ordinary checkout uses. Its `onSubmit` is the only
     * difference, and here it is the plainest one there is: hand the form to
     * the browser, which is exactly what happens without scripting too.
     */
    const form = document.querySelector<HTMLFormElement>('#form');
    if (form) {
      wireCheckoutForm(form, {
        onSubmit: () => {
          const submit = document.querySelector<HTMLButtonElement>('#submit')!;
          submit.disabled = true;
          submit.textContent = 'Reserving…';
          form.submit();
        },
      });
    }
  </script>
</Base>
