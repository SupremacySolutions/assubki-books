---
import Base from '../../layouts/Base.astro';
import { getShipment, publicShipmentPage, SHIPMENT_PAGE } from '../../lib/shipments';
import { whenText } from '../../lib/incoming';
import { price } from '../../lib/format';

const id = Number.parseInt(Astro.params.id ?? '', 10);
const shipment = Number.isInteger(id) ? await getShipment(id) : null;
/* Draft and closed shipments are the owner's business, not a customer's. */
if (!shipment || !['open', 'arrived'].includes(shipment.status)) {
  return Astro.rewrite('/404');
}

const params = Astro.url.searchParams;
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
const { items, total, page: at, pages } = await publicShipmentPage(id, page);
if (total === 0) return Astro.rewrite('/404');

const open = shipment.status === 'open';

const when = shipment.status === 'arrived' && shipment.arrived_at
  ? new Date(shipment.arrived_at * 1000).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
    })
  : whenText(shipment.incoming_vague, shipment.incoming_month, { year: true });

const first = (at - 1) * SHIPMENT_PAGE + 1;
const last = Math.min(at * SHIPMENT_PAGE, total);
---

<Base
  title={`${shipment.title}${when ? ` — ${when}` : ''}`}
  description={`The ${total} titles on this shipment, and how to reserve a copy before they land.`}
>
  <div class="wrap py-10 pb-32">
    <a href="/shipments" class="text-[13.5px] text-[var(--color-navy)] underline underline-offset-2">
      ← All shipments
    </a>

    <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <div class="min-w-0">
        <h1 class="text-[28px] sm:text-[32px] leading-tight">{shipment.title}</h1>
        {when && (
          <p class="mt-1 text-[15px] text-[var(--color-ink-soft)]">
            {open ? 'Expected ' : 'Arrived '}{when}
          </p>
        )}
      </div>
      <span
        class:list={[
          'text-[13.5px] shrink-0',
          open ? 'text-[var(--color-instock)]' : 'text-[var(--color-ink-faint)]',
        ]}
      >
        {open ? 'Open for reservations' : 'Arrived — reservations closed'}
      </span>
    </div>

    {!open && (
      <p class="mt-3 max-w-[44rem] text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        This shipment has landed, so it can no longer be reserved from. It is left
        here so you can see what came in — whatever was not spoken for goes into
        {' '}<a href="/catalogue" class="underline">the catalogue</a> as we
        photograph it.
      </p>
    )}

    {shipment.note && (
      <p class="mt-3 max-w-[44rem] text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed whitespace-pre-line">
        {shipment.note}
      </p>
    )}

    <p class="mt-5 text-[13.5px] text-[var(--color-ink-faint)] tabular-nums">
      {total} {total === 1 ? 'title' : 'titles'}
      {pages > 1 && ` · showing ${first}–${last}`}
    </p>

    {/*
      * The list, with the same button the rest of the shop uses.
      *
      * These went into a form of their own with a number box on every row and
      * a single Reserve at the foot of the page - a second way of buying,
      * looking nothing like the first, and on a shipment of three hundred
      * titles the only button that did anything was three hundred rows down.
      *
      * A book still at sea is a book. It goes in the same basket, through the
      * same checkout, and the shop works out which lines are claims when the
      * order is made - `createOrder` has always marked a line the shelf cannot
      * cover as one, and gives any order holding a claim no 48-hour clock, so
      * the half that is here is not released out from under the half that is
      * still coming.
      */}
    <ul class="mt-4 grid gap-2">
      {items.map((item) => (
        <li class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-3.5 flex flex-wrap items-center gap-x-4 gap-y-2">
          <div class="min-w-0 flex-1">
            <p class="ar text-[16px] leading-snug">{item.title}</p>
            <p class="mt-0.5 text-[13px] text-[var(--color-ink-faint)] flex flex-wrap gap-x-3">
              {item.volumes && item.volumes > 1 && <span>{item.volumes} volumes</span>}
              <span class="price !text-[13px]">{price(item.price_pence)}</span>
              {open && (
                <span class={item.free > 0 ? '' : 'text-[var(--color-outstock)]'}>
                  {item.free > 0 ? `${item.free} free to reserve` : 'fully reserved'}
                </span>
              )}
            </p>
          </div>

          {/* Brass, not navy. Reserving is a different act from buying
              something on the shelf, and the button should not pretend
              otherwise - the same one the book page uses. */}
          {open && item.free > 0 && (
            <button
              type="button"
              data-reserve
              data-book-id={item.id}
              data-max={item.free}
              class="shrink-0 rounded-[var(--radius-pill)] bg-[var(--color-brass)] px-5 py-2.5 text-[14.5px] font-medium text-white hover:brightness-110 transition-[filter] disabled:opacity-60"
            >
              Reserve a copy
            </button>
          )}
        </li>
      ))}
    </ul>

    <p data-note role="status" hidden class="mt-3 text-[13.5px] text-[var(--color-outstock)]"></p>

    {open && (
      <p class="mt-5 text-[13.5px] text-[var(--color-ink-soft)] leading-relaxed max-w-[44rem]">
        Reserved copies go in your basket alongside anything else you are buying.
        Each shipment becomes a separate order, so in-stock books can be sent now.
        Nothing is paid for reserved books until all their copies arrive. Postage is quoted separately for each order.
      </p>
    )}

    {pages > 1 && (
      <nav
        class="mt-8 grid grid-cols-[1fr_auto_1fr] items-center gap-3 border-t border-[var(--color-rule)] pt-6"
        aria-label="Pagination"
      >
        {at > 1 ? (
          <a
            href={`/shipments/${id}${at - 1 > 1 ? `?page=${at - 1}` : ''}`}
            class="btn btn-ghost w-full max-w-[8.5rem] justify-center justify-self-start"
          >
            ← Previous
          </a>
        ) : (
          <span />
        )}
        <p
          class="text-[14px] text-[var(--color-ink-faint)] tabular-nums text-center"
          aria-label={`Page ${at} of ${pages}`}
        >
          {at} of {pages}
        </p>
        {at < pages ? (
          <a
            href={`/shipments/${id}?page=${at + 1}`}
            class="btn btn-ghost w-full max-w-[8.5rem] justify-center justify-self-end"
          >
            Next →
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </div>

  <script>
    /*
     * Reserving a copy is adding to the basket.
     *
     * The same call the book page makes for a delivery that has not landed,
     * against the same store, so the header count, the basket page and the
     * checkout need to know nothing about shipments. The ceiling is re-read
     * rather than trusted from the render: this page can sit open while other
     * people reserve, and the number on it goes stale.
     */
    const note = document.querySelector<HTMLElement>('[data-note]');
    const say = (message: string) => {
      if (!note) return;
      note.textContent = message;
      note.hidden = !message;
    };

    /** What is still free to claim, asked at the moment of the click. */
    const freeNow = async (id: string, fallback: number) => {
      try {
        const res = await fetch(`/api/basket?ids=${encodeURIComponent(id)}`);
        const data = await res.json() as {books?:{reservable:number}[]};
        const book = data?.books?.[0];
        return typeof book?.reservable === 'number' ? book.reservable : 0;
      } catch {
        return fallback;
      }
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-reserve]')) {
      button.addEventListener('click', async () => {
        const id = button.dataset.bookId;
        if (!id) return;

        button.disabled = true;
        const free = await freeNow(id, Number(button.dataset.max ?? '1'));

        if (free <= 0) {
          say('Every copy of that one is already reserved.');
          button.disabled = false;
          return;
        }

        const result = window.asbBasket.addChecked(id, 1, free);
        if (result.added === 0) {
          say(`All ${free} free ${free === 1 ? 'copy is' : 'copies are'} already in your basket.`);
        } else {
          say('');
          button.textContent = 'Reserved ✓';
        }

        setTimeout(() => {
          button.textContent = 'Reserve a copy';
          button.disabled = false;
        }, result.added > 0 ? 1800 : 0);
      });
    }
  </script>
</Base>
