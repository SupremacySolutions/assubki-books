---
import Base from '../layouts/Base.astro';
import { HOLD_HOURS } from '../lib/orders';
import { COUNTRIES } from '../lib/address';
---

<Base title="Send your request" noindex>
  <div class="py-10 md:py-14 max-w-3xl">
    <h1 class="font-[family-name:var(--font-display)] text-[32px] md:text-[38px] font-semibold">
      Send your request
    </h1>
    <p class="mt-3 text-[16px] text-[var(--color-ink-soft)] leading-relaxed max-w-xl">
      We will hold your books for {HOLD_HOURS} hours and reply with the total and how to pay. <strong class="text-[var(--color-ink)]">No card details are taken here.</strong>
    </p>

    <div id="empty" hidden class="py-16 text-center">
      <h2 class="font-[family-name:var(--font-display)] text-[22px]">Your basket is empty</h2>
      <a href="/catalogue" class="btn btn-primary mt-5">Browse the catalogue</a>
    </div>

    {/* novalidate, but the `required` attributes stay: screen readers still
        announce which fields are needed, while the browser's own bubbles get
        out of the way. Otherwise the customer meets two different kinds of
        error message - a native popup on the name, an inline note on the
        postcode - depending on which field they got wrong. */}
    <form id="form" novalidate hidden class="mt-8 grid gap-8 md:grid-cols-[1fr_280px] md:gap-10 items-start">
      <div class="grid gap-5">
        <div>
          <label for="name" class="block text-[14.5px] font-medium mb-1.5">Your name</label>
          <input id="name" name="name" required autocomplete="name" maxlength="120" class="field"
            aria-describedby="name-error" />
          <p id="name-error" data-error-for="name" hidden class="field-error"></p>
        </div>

        <div>
          <label for="email" class="block text-[14.5px] font-medium mb-1.5">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" maxlength="254"
            class="field" aria-describedby="email-error" />
          <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
            Your confirmation and payment details come here.
          </p>
          <p id="email-error" data-error-for="email" hidden class="field-error"></p>
        </div>

        <div>
          <label for="phone" class="block text-[14.5px] font-medium mb-1.5">Phone</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            inputmode="tel"
            required
            autocomplete="tel"
            maxlength="40"
            class="field"
            aria-describedby="phone-error"
          />
          <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
            In case we need to reach you about the books or a collection time.
          </p>
          <p id="phone-error" data-error-for="phone" hidden class="field-error"></p>
        </div>

        <fieldset>
          <legend class="block text-[14.5px] font-medium mb-2">How would you like the books?</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            <label class="flex items-center gap-2.5 p-3 bg-white border border-[var(--color-rule)] rounded-[3px] cursor-pointer has-checked:border-[var(--color-navy)]">
              <input type="radio" name="fulfilment" value="delivery" checked class="accent-[var(--color-navy)]" />
              <span class="text-[15px]">Post them to me</span>
            </label>
            <label class="flex items-center gap-2.5 p-3 bg-white border border-[var(--color-rule)] rounded-[3px] cursor-pointer has-checked:border-[var(--color-navy)]">
              <input type="radio" name="fulfilment" value="collection" class="accent-[var(--color-navy)]" />
              <span class="text-[15px]">I will collect</span>
            </label>
          </div>
        </fieldset>

        {/* The parts, not a paragraph: a courier's label needs fields, and a
            form can only say which bit is missing if it asked for it. Country
            first, because it decides what the rest are called and whether a
            postcode exists at all. */}
        {/* Optional on purpose: neither is preselected, so leaving it alone is
            a valid answer. It is a request the shop sees, not a decision - the
            owner sets what actually happens when they confirm. */}
        <fieldset>
          <legend class="block text-[14.5px] font-medium mb-1.5">
            How would you like to pay?
            <span class="text-[var(--color-ink-faint)] font-normal">(optional)</span>
          </legend>
          <p class="text-[13px] text-[var(--color-ink-faint)] mb-2 leading-relaxed">
            Tell us what suits you and we will confirm when we reply. Nothing is paid on this
            website either way.
          </p>
          <div class="grid gap-2 sm:grid-cols-2">
            <label class="flex items-center gap-2.5 p-3 bg-white border border-[var(--color-rule)] rounded-[3px] cursor-pointer has-checked:border-[var(--color-navy)]">
              <input type="radio" name="paymentPreference" value="transfer" class="accent-[var(--color-navy)]" />
              <span class="text-[15px]">Bank transfer</span>
            </label>
            <label class="flex items-center gap-2.5 p-3 bg-white border border-[var(--color-rule)] rounded-[3px] cursor-pointer has-checked:border-[var(--color-navy)]">
              <input type="radio" name="paymentPreference" value="cash" class="accent-[var(--color-navy)]" />
              <span class="text-[15px]">Cash in person</span>
            </label>
          </div>
          <p id="paymentPreference-error" data-error-for="paymentPreference" hidden class="field-error"></p>
        </fieldset>

        <div id="addressWrap" class="grid gap-4">
          <p class="text-[14.5px] font-medium">Delivery address</p>

          <div>
            <label for="country" class="block text-[14px] mb-1.5">Country</label>
            <select id="country" name="country" class="field" autocomplete="country"
              aria-describedby="country-error">
              {COUNTRIES.map((c) => (
                <option value={c.code} selected={c.code === 'GB'}>{c.name}</option>
              ))}
            </select>
            <p id="country-error" data-error-for="country" hidden class="field-error"></p>
          </div>

          <div>
            <label for="line1" class="block text-[14px] mb-1.5">Street address</label>
            <input id="line1" name="line1" maxlength="120" autocomplete="address-line1"
              class="field" aria-describedby="line1-error" />
            <p id="line1-error" data-error-for="line1" hidden class="field-error"></p>
          </div>

          <div>
            <label for="line2" class="block text-[14px] mb-1.5">
              Flat, building or company <span class="text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input id="line2" name="line2" maxlength="120" autocomplete="address-line2" class="field" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="city" class="block text-[14px] mb-1.5" data-label="city">Town or city</label>
              <input id="city" name="city" maxlength="80" autocomplete="address-level2"
                class="field" aria-describedby="city-error" />
              <p id="city-error" data-error-for="city" hidden class="field-error"></p>
            </div>
            <div>
              <label for="region" class="block text-[14px] mb-1.5" data-label="region">
                County <span class="text-[var(--color-ink-faint)]">(optional)</span>
              </label>
              <input id="region" name="region" maxlength="80" autocomplete="address-level1"
                class="field" aria-describedby="region-error" />
              <p id="region-error" data-error-for="region" hidden class="field-error"></p>
            </div>
          </div>

          <div id="postcodeWrap" class="max-w-[12rem]">
            <label for="postcode" class="block text-[14px] mb-1.5" data-label="postcode">Postcode</label>
            <input id="postcode" name="postcode" maxlength="24" autocomplete="postal-code"
              class="field" aria-describedby="postcode-error" />
            <p id="postcode-error" data-error-for="postcode" hidden class="field-error"></p>
          </div>
        </div>

        <div>
          <label for="notes" class="block text-[14.5px] font-medium mb-1.5">
            Anything else? <span class="text-[var(--color-ink-faint)] font-normal">(optional)</span>
          </label>
          <textarea id="notes" name="notes" rows="3" maxlength="2000" class="field"
            placeholder="A title we do not list, a preferred edition, or when you need these by."></textarea>
        </div>

        <div id="error" hidden role="alert"
          class="p-3.5 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        </div>

        <div>
          <button type="submit" id="submit" class="btn btn-primary !py-3 !px-7">Send request</button>
          <p class="mt-3 text-[13px] text-[var(--color-ink-faint)] max-w-md leading-relaxed">
            Sending this does not commit you to buy. We reply with the total, and you decide.
          </p>
        </div>
      </div>

      <aside class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5 md:sticky md:top-[100px]">
        <h2 class="eyebrow mb-3">Your request</h2>
        <ul id="summary" class="space-y-2.5 text-[14.5px]"></ul>
        <div class="mt-4 pt-3 border-t border-[var(--color-rule)] flex items-baseline justify-between">
          <span class="text-[14.5px]">Subtotal</span>
          <span id="subtotal" class="price text-[18px]"></span>
        </div>
        <p id="postageNote" class="mt-2 text-[12.5px] text-[var(--color-ink-faint)]">
          Postage confirmed when we reply.
        </p>
        <a href="/basket" class="mt-3 inline-block text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2">
          Edit basket
        </a>
      </aside>
    </form>
  </div>

  <script>
    import { read, clear, setQty } from '../scripts/basket.ts';
    import { readGroup, leaveGroup } from '../scripts/group.ts';
    // The same rules the server applies, so the two cannot drift apart.
    import { checkOrder, type Field } from '../lib/validate.ts';
    import { addressLabels, postcodeRequired } from '../lib/address.ts';

    const gbp = (p: number) => `£${(p / 100).toFixed(2)}`;
    const form = document.querySelector<HTMLFormElement>('#form')!;
    const errorBox = document.querySelector<HTMLElement>('#error')!;
    const submit = document.querySelector<HTMLButtonElement>('#submit')!;

    // ------------------------------------------------------------------
    // Field-level errors
    // ------------------------------------------------------------------

    const fieldEl = (name: string) =>
      document.querySelector<HTMLInputElement | HTMLSelectElement>(`#${name}`);
    const errorEl = (name: string) =>
      document.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

    function markField(name: string, message: string | null) {
      const input = fieldEl(name);
      const slot = errorEl(name);
      if (slot) {
        slot.textContent = message ?? '';
        slot.hidden = !message;
      }
      if (input) {
        if (message) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
    }

    const FIELDS = ['name', 'email', 'phone', 'line1', 'city', 'region', 'postcode', 'country'];
    const clearFields = () => FIELDS.forEach((f) => markField(f, null));

    /** Read the form as the API will receive it. */
    function currentValues() {
      const data = new FormData(form);
      const value = (k: string) => String(data.get(k) ?? '').trim();
      return {
        name: value('name'),
        email: value('email'),
        phone: value('phone'),
        fulfilment: value('fulfilment'),
        paymentPreference: value('paymentPreference'),
        notes: value('notes'),
        address: {
          line1: value('line1'),
          line2: value('line2'),
          city: value('city'),
          region: value('region'),
          postcode: value('postcode'),
          country: value('country'),
        },
      };
    }

    /**
     * Mark everything wrong at once and put the cursor in the first.
     *
     * Being told about one missing field at a time, submit after submit, is how
     * a checkout gets abandoned.
     */
    function showProblems(problems: { field: Field; message: string }[]): boolean {
      clearFields();
      for (const p of problems) markField(p.field, p.message);
      const first = problems[0] && fieldEl(problems[0].field);
      if (first) {
        first.focus();
        first.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
      return problems.length === 0;
    }

    /**
     * What the fields are called where they live, and whether a postcode
     * exists there at all - Hong Kong and the Emirates have none, and a
     * required box with no possible answer ends the order.
     */
    function paintCountry() {
      const country = String(new FormData(form).get('country') ?? 'GB');
      const labels = addressLabels(country);
      const optional = ' <span class="text-[var(--color-ink-faint)]">(optional)</span>';

      const set = (name: keyof typeof labels, extra = '') => {
        const label = document.querySelector<HTMLElement>(`[data-label="${name}"]`);
        if (label) label.innerHTML = labels[name] + extra;
      };
      set('city');
      set('region', optional);
      set('postcode');

      const wrap = document.querySelector<HTMLElement>('#postcodeWrap');
      const needed = postcodeRequired(country);
      if (wrap) wrap.hidden = !needed;
      if (!needed) markField('postcode', null);
    }

    function showError(message: string) {
      errorBox.textContent = message;
      errorBox.hidden = false;
      errorBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    /*
     * A group order checks out from the shared basket, not this browser's own.
     * Only the organiser reaches here - the basket page hides the button for
     * everyone else - and the contents are re-read on the server when the
     * request is sent, so this summary is a courtesy rather than the source.
     */
    async function loadGroupSummary(member: NonNullable<ReturnType<typeof readGroup>>) {
      const res = await fetch(
        `/api/group?g=${encodeURIComponent(member.code)}&k=${encodeURIComponent(member.token)}`,
      );
      const data = await res.json();
      if (!res.ok || !data.ok) return false;

      const group = data.group as {
        lines: { title: string; qty: number; pricePence: number; addedBy: string }[];
        subtotalPence: number;
        people: string[];
      };
      if (!group.lines.length) return false;

      const list = document.querySelector<HTMLUListElement>('#summary')!;
      list.innerHTML = '';
      for (const line of group.lines) {
        const li = document.createElement('li');
        li.className = 'flex justify-between gap-3';
        li.innerHTML =
          `<span class="min-w-0">${line.title}${line.qty > 1 ? ` <span class="text-[var(--color-ink-faint)]">× ${line.qty}</span>` : ''}` +
          ` <span class="text-[var(--color-ink-faint)]">· ${line.addedBy}</span></span>` +
          `<span class="shrink-0 tabular-nums">${gbp(line.pricePence * line.qty)}</span>`;
        list.appendChild(li);
      }

      document.querySelector<HTMLElement>('#subtotal')!.textContent = gbp(group.subtotalPence);
      form.hidden = false;
      return true;
    }

    async function loadSummary() {
      const member = readGroup();
      if (member?.organiser) {
        if (await loadGroupSummary(member)) return true;
        // Expired or emptied while they were filling the form in.
        document.querySelector<HTMLElement>('#empty')!.hidden = true;
      }

      const basket = read();
      const ids = Object.keys(basket);
      if (!ids.length) {
        document.querySelector<HTMLElement>('#empty')!.hidden = false;
        return false;
      }

      const res = await fetch(`/api/basket?ids=${ids.join(',')}`);
      const { books } = (await res.json()) as {
        books: { id: number; title: string; pricePence: number; available: number }[];
      };

      const list = document.querySelector<HTMLUListElement>('#summary')!;
      list.innerHTML = '';
      let subtotal = 0;

      for (const book of books) {
        const qty = Math.min(basket[String(book.id)] ?? 0, Math.max(book.available, 0));
        if (qty <= 0) {
          setQty(book.id, 0);
          continue;
        }
        subtotal += book.pricePence * qty;
        const li = document.createElement('li');
        li.className = 'flex justify-between gap-3';
        li.innerHTML =
          `<span class="min-w-0">${book.title}${qty > 1 ? ` <span class="text-[var(--color-ink-faint)]">× ${qty}</span>` : ''}</span>` +
          `<span class="shrink-0 tabular-nums">${gbp(book.pricePence * qty)}</span>`;
        list.appendChild(li);
      }

      if (!list.children.length) {
        document.querySelector<HTMLElement>('#empty')!.hidden = false;
        return false;
      }

      document.querySelector<HTMLElement>('#subtotal')!.textContent = gbp(subtotal);
      form.hidden = false;
      return true;
    }

    // The address only applies to delivery, so it is removed rather than greyed
    // out when collecting - and its errors go with it, or a hidden field would
    // be blocking a collection order for a postcode nobody can see.
    const addressWrap = document.querySelector<HTMLElement>('#addressWrap')!;
    for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="fulfilment"]')) {
      radio.addEventListener('change', () => {
        const delivery =
          form.querySelector<HTMLInputElement>('input[name="fulfilment"]:checked')?.value === 'delivery';
        addressWrap.hidden = !delivery;
        if (!delivery) ['line1', 'city', 'region', 'postcode', 'country'].forEach((f) => markField(f, null));
      });
    }

    document.querySelector('#country')?.addEventListener('change', paintCountry);
    paintCountry();

    // Checked as they leave a field, not as they type it: telling someone their
    // email is wrong while they are still typing it is nagging, not helping.
    for (const name of FIELDS) {
      fieldEl(name)?.addEventListener('blur', () => {
        const values = currentValues();
        const problems = checkOrder(values).filter((p) => p.field === name);
        markField(name, problems[0]?.message ?? null);
      });
    }

    // The postage note is only true if something is being posted.
    const postageNote = document.querySelector<HTMLElement>('#postageNote');
    function syncFulfilment() {
      const delivery =
        form.querySelector<HTMLInputElement>('input[name="fulfilment"]:checked')?.value === 'delivery';
      if (postageNote) {
        postageNote.textContent = delivery
          ? 'Postage confirmed when we reply.'
          : 'Collection, so no postage.';
      }
    }
    for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="fulfilment"]')) {
      radio.addEventListener('change', syncFulfilment);
    }
    syncFulfilment();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.hidden = true;

      // The page checks first so the customer is not made to wait on a round
      // trip to be told their postcode is missing. The server checks again,
      // and it is the one that decides.
      if (!showProblems(checkOrder(currentValues()))) return;

      submit.disabled = true;
      submit.textContent = 'Sending…';

      const basket = read();
      const items = Object.entries(basket).map(([bookId, qty]) => ({ bookId: Number(bookId), qty }));
      const group = readGroup();
      const data = new FormData(form);

      try {
        const res = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            phone: data.get('phone'),
            fulfilment: data.get('fulfilment'),
            paymentPreference: data.get('paymentPreference'),
            line1: data.get('line1'),
            line2: data.get('line2'),
            city: data.get('city'),
            region: data.get('region'),
            postcode: data.get('postcode'),
            country: data.get('country'),
            notes: data.get('notes'),
            items,
            // The shop reads the group's contents from its own copy; sending
            // them from here would be sending one member's stale view of them.
            groupCode: group?.organiser ? group.code : undefined,
            groupOwnerToken: group?.organiser ? group.token : undefined,
          }),
        });
        const result = (await res.json()) as {
          ok: boolean; ref?: string; token?: string; error?: string; field?: Field;
          problems?: { bookId: number; title?: string; wanted?: number; available: number }[];
        };

        if (!res.ok || !result.ok) {
          let message = result.error ?? 'Something went wrong. Please try again.';

          // A refusal that names a field belongs under that field, not in the
          // box at the bottom of the form.
          if (result.field && result.error) {
            showProblems([{ field: result.field, message: result.error }]);
            submit.disabled = false;
            submit.textContent = 'Send request';
            return;
          }

          if (res.status === 409 && result.problems) {
            /*
             * A negative availability means "unknown", not "none". Losing the
             * race for the last copy reports every item in the order that way,
             * so treating it as a quantity emptied the whole basket - including
             * the titles that were perfectly fine - and left the customer
             * reading "your basket has been updated" over an empty page.
             */
            const known = result.problems.filter((p) => p.available >= 0);
            for (const p of known) setQty(p.bookId, p.available);
            await loadSummary();

            const named = known.filter((p) => p.title).map((p) => p.title);
            if (named.length) {
              message = `${named.join(', ')} ${named.length === 1 ? 'is' : 'are'} no longer available in the quantity you asked for. Your basket has been updated.`;
            }
          }

          showError(message);
          submit.disabled = false;
          submit.textContent = 'Send request';
          return;
        }

        // The group is closed at the other end; forgetting it here stops the
        // organiser's next basket opening as a group already sent.
        if (group?.organiser) leaveGroup();
        else clear();
        window.location.href = `/order?ref=${result.ref}&t=${result.token}`;
      } catch {
        showError('We could not reach the shop. Check your connection and try again.');
        submit.disabled = false;
        submit.textContent = 'Send request';
      }
    });

    loadSummary();
  </script>
</Base>
