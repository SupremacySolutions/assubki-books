---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/format';
import { ownerAddress } from '../lib/email';

// Read from OWNER_EMAIL rather than hardcoded, so the address customers are
// given is the same one order notifications go to, and only ever set in one
// place.
const contactEmail = ownerAddress();
---

<Base title="Contact" description="Get in touch with As-Subkī Books about an order, a title we do not list, or availability.">
  <div class="py-10 md:py-14 max-w-2xl">
    <h1 class="font-[family-name:var(--font-display)] text-[34px] md:text-[40px] font-semibold">Contact</h1>
    <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-ink-soft)]">
      Telegram is the fastest way to reach us - it is where new stock is posted and where we answer
      questions about availability.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a
        href={SITE.telegram}
        rel="noopener"
        class="block p-5 bg-white border border-[var(--color-rule)] rounded-[var(--radius-card)] hover:border-[var(--color-navy)] transition-colors"
      >
        <h2 class="text-[18px]">Telegram</h2>
        <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)]">
          New arrivals, availability and the quickest replies.
        </p>
        <p class="mt-3 text-[15px] text-[var(--color-navy)]">@alsubkibooks →</p>
      </a>

      <a
        href={`mailto:${contactEmail}`}
        class="block p-5 bg-white border border-[var(--color-rule)] rounded-[var(--radius-card)] hover:border-[var(--color-navy)] transition-colors"
      >
        <h2 class="text-[18px]">Email</h2>
        <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)]">
          For anything about an existing order - quote your reference.
        </p>
        <p class="mt-3 text-[15px] text-[var(--color-navy)] break-all">{contactEmail} →</p>
      </a>
    </div>

    <div class="mt-10 pt-8 border-t border-[var(--color-rule)]">
      <h2 class="font-[family-name:var(--font-display)] text-[22px] font-semibold">
        Already sent a request?
      </h2>
      <p class="mt-2 text-[15.5px] text-[var(--color-ink-soft)] leading-relaxed">
        Your confirmation email has a link to your order and its reference. Quote that reference and
        we can find it straight away.
      </p>
    </div>
  </div>
</Base>
