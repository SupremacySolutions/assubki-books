---
import Base from '../layouts/Base.astro';
import Rosette from '../components/Rosette.astro';
---

<Base title="Page not found" noindex>
  <div class="py-24 text-center">
    <div class="grid place-items-center text-[var(--color-wash)] mb-6">
      <Rosette size={80} />
    </div>
    <h1 class="font-[family-name:var(--font-display)] text-[30px] font-semibold">
      That page is not on the shelf
    </h1>
    <p class="mt-3 text-[16px] text-[var(--color-ink-soft)] max-w-md mx-auto">
      The link may be old, or the title may have moved. Search the catalogue and you will most
      likely find it.
    </p>
    <form action="/catalogue" method="get" class="mt-7 flex gap-2 max-w-sm mx-auto" role="search">
      <label for="nf-q" class="sr-only">Search the catalogue</label>
      <input id="nf-q" type="search" name="q" placeholder="Search by title" class="field" />
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
    <a href="/catalogue" class="inline-block mt-5 text-[15px] text-[var(--color-navy)] hover:underline underline-offset-2">
      Or browse all titles →
    </a>
  </div>
</Base>
