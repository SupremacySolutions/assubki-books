---
/**
 * One address for an order.
 *
 * With `?ref=…&t=…` it shows the order; without, it asks for the reference and
 * email. The emailed link and the lookup form therefore end up in the same
 * place, rather than the page a customer is told about being a different page
 * from the one they land on.
 */
import Base from '../../layouts/Base.astro';
import Rosette from '../../components/Rosette.astro';
import OrderJourney from '../../components/OrderJourney.astro';
import { getOrder } from '../../lib/orders';
import { optInLink } from '../../lib/telegram';
import MessageUs from '../../components/MessageUs.astro';
import Dialog from '../../components/Dialog.astro';
import { price } from '../../lib/format';
import { statusLabel, isSettled, moneyReceived, trackingUrl, cashMoment } from '../../lib/order-status';
import { collectionAddress } from '../../lib/settings';
import QRCode from 'qrcode';

const params = Astro.url.searchParams;
const ref = params.get('ref')?.trim() ?? '';
const token = params.get('t') ?? '';
const failedLookup = params.get('e') === '1';

// A wrong token is not a 404: the customer is told which order they were after,
// and only has to add their email to reach it.
const order = ref && token ? await getOrder(ref, token) : null;

// A collection order that is ready needs to say where to come, so the address
// is only fetched when it is about to be used.
//
// Wanted from the confirmation onward rather than only at 'paid': a cash order
// is invited to arrange a time as soon as it is confirmed, and an invitation
// that cannot name the place is not much of one.
const cashPayment = Boolean(order?.cash_payment);
// Cash is no longer collection-only, so every string about it has to say where
// the money changes hands rather than assuming a doorstep.
const moment = order ? cashMoment(order.fulfilment) : 'when you collect';
const whereToCollect =
  order?.fulfilment === 'collection' &&
  ['awaiting_payment', 'paid', 'dispatched', 'completed'].includes(order.status)
    ? await collectionAddress()
    : '';

const status = order ? statusLabel(order.status, order.fulfilment, whereToCollect, cashPayment) : null;
const placed = order ? new Date(order.created_at * 1000) : null;
const expires = order?.expires_at ? new Date(order.expires_at * 1000) : null;
const stillHeld = order?.status === 'requested' && expires && expires.getTime() > Date.now();

// Once they have paid, the page states what the order came to rather than
// continuing to ask for it - "Total to pay £16.45" under a heading saying
// "Payment received" is the shop contradicting itself.
const settled = order ? isSettled(order.status) : false;
// Whether the shop actually has the money, which on a cash collection is not
// true until they have been and gone. See lib/order-status.
const paidFor = order ? moneyReceived(order.status, cashPayment) : false;
const dropped = order?.status === 'cancelled' || order?.status === 'expired';

// Shown at the top of the page rather than only inside the timeline. Never for
// a collection (there is nothing to track) and never once cancelled.
const showTracking = Boolean(
  order?.tracking_number && order.fulfilment !== 'collection' && !dropped,
);
const trackHref = order?.tracking_number
  ? trackingUrl(order.postage_provider, order.tracking_number)
  : null;

const telegramLink = order ? optInLink(order.ref, token) : null;
const awaitingReply = order?.status === 'requested' || order?.status === 'awaiting_payment';
const telegramLinked = Boolean(order?.telegram_chat_id);

// Whether the page asks them to connect Telegram at all: only while the order
// is still waiting on a reply, and only if the chat is not already linked.
const offerTelegram = Boolean(telegramLink) && awaitingReply && !telegramLinked;

// The QR code is the way in for someone reading this on a desktop, where
// tapping the link does nothing. Drawn only when the invitation is actually on
// the page - a settled order would otherwise pay for an image it never shows -
// and a failure here must not take the order page down with it.
let qrCodeDataUrl = '';
if (offerTelegram && telegramLink) {
  try {
    qrCodeDataUrl = await QRCode.toDataURL(telegramLink, {
      width: 200,
      margin: 1,
      color: { dark: '#0e2a55', light: '#f5f4f0' },
    });
  } catch (err) {
    console.error('order page: QR code generation failed', err);
  }
}
---

<Base
  title={order ? `Order ${order.ref}` : 'Look up your order'}
  description="Check the progress of an order from As-Subkī Books."
  noindex
>
  {
    order && status ? (
      <div class="mx-auto max-w-2xl py-10 md:py-14" data-order-status={order.status} data-order-ref={order.ref}>
        <div class="flex items-start justify-center gap-4 text-center">
          <div class="text-[var(--color-navy)] shrink-0 mt-1">
            <Rosette size={40} />
          </div>
          <div>
            <p class="eyebrow">Reference {order.ref}</p>
            <h1 class="mt-1 font-[family-name:var(--font-display)] text-[30px] md:text-[36px] font-semibold leading-tight">
              {status.label}
            </h1>
          </div>
        </div>

        <div
          class:list={[
            'mt-6 p-4 rounded-[3px] border text-[15px] leading-relaxed',
            status.tone === 'wait' && 'bg-white border-[var(--color-rule)] text-[var(--color-ink-soft)]',
            (status.tone === 'good' || status.tone === 'done') &&
              'bg-[var(--color-instock)]/10 border-[var(--color-instock)]/30 text-[var(--color-instock)]',
            status.tone === 'off' && 'bg-[var(--color-rule)]/50 border-[var(--color-rule)] text-[var(--color-ink-soft)]',
          ]}
        >
          {status.blurb}
        </div>

        {stillHeld && (
          <p class="mt-3 text-[14px] text-[var(--color-ink-faint)]">
            Held until {expires!.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}.
          </p>
        )}

        {/* Once the books are on their way, the tracking number is the only
            thing on this page the customer came back for. It used to sit below
            the timeline in the quietest card on the page. */}
        {showTracking && (
          <div class="mt-6 p-5 bg-white border border-[var(--color-navy)]/25 rounded-[3px] text-center">
            <p class="eyebrow">
              {order.postage_provider && order.postage_provider !== 'Other'
                ? `Tracking · ${order.postage_provider}`
                : 'Tracking number'}
            </p>
            <p class="mt-1.5 text-[22px] font-medium tabular-nums select-all break-all">
              {order.tracking_number}
            </p>
            {order.postage_service && (
              <p class="mt-1 text-[13.5px] text-[var(--color-ink-soft)]">{order.postage_service}</p>
            )}
            {trackHref ? (
              <a href={trackHref} rel="noopener" target="_blank" class="btn btn-primary mt-4 !py-2.5">
                Track this parcel
              </a>
            ) : (
              <p class="mt-3 text-[13.5px] text-[var(--color-ink-faint)]">
                Use this number with the carrier to track it.
              </p>
            )}
          </div>
        )}

        {offerTelegram && telegramLink && (
          <section class="mt-6 p-5 bg-white border border-[var(--color-rule)] rounded-[3px] text-center">
            <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
              {cashPayment ? 'Arrange the handover on Telegram' : 'Get your payment details on Telegram'}
            </h2>
            <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed max-w-lg">
              Tap once to connect this order to your Telegram, and we will send
              {cashPayment ? ' your total and a time to arrange' : ' the total and how to pay'} straight
              to your chat. Otherwise we will email you.
            </p>
            {/* Opens away from this page. Following it in place meant that a
                customer without Telegram on this device - most laptops - lost
                the order they were looking at and got a Telegram sign-in page
                instead. */}
            <a
              href={telegramLink}
              target="_blank"
              rel="noopener noreferrer"
              data-connect-telegram
              class="btn mt-4 !bg-[#229ED9] !text-white hover:!bg-[#1d8ec2]"
            >
              Connect Telegram
            </a>

          </section>
        )}

        {/* Nothing visible happens if Telegram is not installed, so this has to
            account for itself rather than leave them waiting on a button that
            appears broken. Over the page rather than pushing it down: the
            customer has just tapped away to another app, and what they come
            back to should be the thing that was waiting for them. */}
        {offerTelegram && telegramLink && (
          <Dialog id="connect-telegram" title="Connecting to Telegram…">
            <p class="text-[14px] text-[var(--color-ink-soft)] leading-relaxed">
              If Telegram opened on this device, great — press Start in the chat and your order will
              link.
            </p>
            <p class="mt-2 text-[14px] text-[var(--color-ink-soft)] leading-relaxed">
              If nothing opened, that is fine too. Scan this code with your phone's camera instead:
            </p>
            {qrCodeDataUrl && (
              <div class="mt-4 flex justify-center">
                <img src={qrCodeDataUrl} alt="QR code to connect via Telegram" class="w-44 h-44" />
              </div>
            )}
            <p class="mt-4 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
              This page will update by itself once you connect. You can close this.
            </p>
          </Dialog>
        )}

        {telegramLinked && awaitingReply && (
          <div
            data-connected
            class="mt-6 p-5 bg-white border border-[var(--color-instock)]/30 rounded-[3px] flex items-start gap-3.5"
          >
            {/* Drawn rather than stamped: connecting is the one thing on this
                page the customer actually did, and a line of green text is a
                thin acknowledgement of it. */}
            <svg
              class="tick shrink-0 mt-0.5"
              width="26"
              height="26"
              viewBox="0 0 26 26"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="13" cy="13" r="12" class="tick-ring" stroke-width="1.5" />
              <path d="M7.5 13.5 11 17l7.5-7.5" class="tick-mark" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div>
              <p class="text-[15px] font-medium">Connected to Telegram</p>
              <p class="mt-1 text-[14px] text-[var(--color-ink-soft)] leading-relaxed">
                {cashPayment
                  ? 'Your total and a time to arrange will arrive in that chat.'
                  : 'Your total and how to pay will arrive in that chat.'}
              </p>
            </div>
          </div>
        )}

        <section class="mt-8">
          <h2 class="eyebrow mb-4 text-center">Progress</h2>
          <OrderJourney order={order} />
        </section>

        <section class="mt-9">
          <h2 class="eyebrow mb-3 text-center">What you asked for</h2>
          <ul class="border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
            {order.items.map((item) => (
              <li class="py-3 flex justify-between gap-4 text-[15px]">
                <span class="min-w-0">
                  {item.slug ? (
                    <a href={`/book/${item.slug}`} class="hover:text-[var(--color-navy)]">
                      {item.title_snapshot}
                    </a>
                  ) : (
                    item.title_snapshot
                  )}
                  {item.qty > 1 && <span class="text-[var(--color-ink-faint)]"> × {item.qty}</span>}
                </span>
                <span class="shrink-0 tabular-nums">{price(item.price_pence_snapshot * item.qty)}</span>
              </li>
            ))}
          </ul>

          <div class="mt-3 flex justify-between items-baseline">
            <span class="text-[15px]">Subtotal</span>
            <span class="tabular-nums">{price(order.subtotal_pence)}</span>
          </div>
          {order.total_pence !== null && !dropped && (
            <>
              {order.fulfilment !== 'collection' && (
                <div class="mt-1 flex justify-between items-baseline text-[var(--color-ink-soft)]">
                  <span class="text-[15px]">Postage</span>
                  <span class="tabular-nums">{price(order.postage_pence ?? 0)}</span>
                </div>
              )}
              <div class="mt-2 pt-2 border-t border-[var(--color-rule)] flex justify-between items-baseline">
                <span class="text-[15px] font-medium">{paidFor ? 'Total paid' : 'Total to pay'}</span>
                <span class="price text-[20px]">{price(order.total_pence)}</span>
              </div>
            </>
          )}
          {/* The shop's own reason, when it gave one. Without it a cancellation
              is a bare fact with no explanation, which only invites a reply
              asking why. */}
          {dropped && order.cancel_note && (
            <p class="mt-3 p-3 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px] text-[14px] leading-relaxed whitespace-pre-line">
              {order.cancel_note}
            </p>
          )}
          <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
            {dropped
              ? 'Nothing was charged.'
              : paidFor
                ? 'Paid in full. Nothing further is owed.'
                : cashPayment
                  ? `Payable in cash ${moment}. Nothing is charged through this website.`
                  : order.total_pence !== null
                    ? 'Nothing is charged through this website.'
                    : order.fulfilment === 'collection'
                      ? 'Nothing has been charged.'
                      : 'Postage is added when we confirm. Nothing has been charged.'}
          </p>
        </section>

        <section class="mt-9 grid gap-4 sm:grid-cols-2 text-center text-[14.5px]">
          <div>
            <h2 class="eyebrow mb-1.5">Requested</h2>
            <p class="text-[var(--color-ink-soft)]">
              {placed!.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}
            </p>
          </div>
          <div>
            <h2 class="eyebrow mb-1.5">
              {order.fulfilment === 'collection' ? 'Collection' : 'Delivery to'}
            </h2>
            <p class="text-[var(--color-ink-soft)] whitespace-pre-line">
              {order.fulfilment === 'collection' ? 'You are collecting in person.' : order.address}
            </p>
          </div>
        </section>

        {order.notes && (
          <section class="mt-6 text-center">
            <h2 class="eyebrow mb-1.5">Your note</h2>
            <p class="text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line">{order.notes}</p>
          </section>
        )}

        <div class="mt-10 border-t border-[var(--color-rule)] pt-6 text-center">
          <p class="text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
            Keep this page - it updates as we work through your request. Quote{' '}
            <strong class="text-[var(--color-ink)]">{order.ref}</strong> if you get in touch.
          </p>
          <div class="mt-4 flex flex-wrap items-start gap-3">
            <MessageUs subject={`Order ${order.ref}`} />
            <a href="/catalogue" class="btn btn-ghost">Keep browsing</a>
          </div>
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-md py-12 text-center md:py-16">
        <div class="mb-5 flex justify-center text-[var(--color-wash)]">
          <Rosette size={40} />
        </div>

        <h1 class="font-[family-name:var(--font-display)] text-[30px] md:text-[36px] font-semibold">
          Look up your order
        </h1>
        <p class="mt-3 text-[16px] text-[var(--color-ink-soft)] leading-relaxed">
          Your confirmation has a link straight to it. If you no longer have that, your reference and
          the email you ordered with will find it.
        </p>

        <form method="post" action="/api/orders/lookup" class="mt-7 space-y-4 text-left">
          <div>
            <label for="ref" class="block text-[14.5px] font-medium mb-1">Order reference</label>
            {/* Above the box, not under it: it tells you where to find what the
                box is asking for, which is no use once you have already
                guessed. */}
            <p class="mb-1.5 text-[13px] text-[var(--color-ink-faint)]">
              On your confirmation, and in any message we have sent you.
            </p>
            <input
              id="ref"
              name="ref"
              required
              maxlength="12"
              value={ref}
              placeholder="ASB-4F7K"
              autocapitalize="characters"
              spellcheck="false"
              class="field tracking-wide"
            />
          </div>

          <div>
            <label for="email" class="block text-[14.5px] font-medium mb-1.5">
              Email you ordered with
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
              class="field"
            />
          </div>

          {/* A reference with no working token means the link was old or got
              truncated in an email client. Say that, rather than showing a bare
              form as though they had arrived cold. */}
          {ref && !failedLookup && (
            <p
              role="status"
              class="p-3 bg-white border border-[var(--color-rule)] rounded-[3px] text-[14.5px] text-[var(--color-ink-soft)]"
            >
              That link has expired or was incomplete. Add the email you ordered with and we will
              bring up {ref}.
            </p>
          )}

          {failedLookup && (
            <p
              role="alert"
              class="p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]"
            >
              We could not find an order with that reference and email. Check both, or message us on
              Telegram and we will look it up.
            </p>
          )}

          <button type="submit" class="btn btn-primary">Look up order</button>
        </form>

        <p class="mt-8 pt-6 border-t border-[var(--color-rule)] text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
          Cannot find it? <MessageUs variant="inline" label="Get in touch" /> and we will find it
          for you.
        </p>
      </div>
    )
  }

  {/* The owner advances the order from the portal - payment received, posted,
      collected - and this page, rendered once when it was opened, would go on
      showing the old status until someone reloaded. A customer standing at the
      door watching "Awaiting payment" has no way to know it has moved.

      Polling is therefore deliberately modest: only while the order is still
      live, only while the tab is actually being looked at, and only for an hour.
      A page left open overnight should not still be asking the server. */}
  <script is:inline>
    (() => {
      const container = document.querySelector('[data-order-status]');
      if (!container) return;

      const current = container.getAttribute('data-order-status');
      const live = ['requested', 'awaiting_payment', 'paid', 'dispatched'];
      if (!live.includes(current)) return;

      const EVERY = 20000;
      const UNTIL = Date.now() + 3600000;
      let timer = null;
      let checking = false;

      const check = async () => {
        if (checking || document.visibilityState !== 'visible') return;
        checking = true;
        try {
          const res = await fetch('/api/orders/status' + location.search);
          const data = await res.json();
          if (data.status && data.status !== current) location.reload();
        } catch {
          /* offline or blocked: leave the page exactly as it is */
        } finally {
          checking = false;
        }
      };

      const stop = () => {
        if (timer) clearInterval(timer);
        timer = null;
      };

      const start = () => {
        if (timer || Date.now() > UNTIL) return;
        timer = setInterval(() => (Date.now() > UNTIL ? stop() : check()), EVERY);
      };

      // Coming back to the tab is the likeliest moment for the status to have
      // moved, so ask straight away rather than waiting out the interval.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          check();
          start();
        } else stop();
      });

      start();
    })();
  </script>

  {/* Connecting happens inside the Telegram app, so this page never learns of
      it on its own: the customer taps Connect, presses Start, comes back, and
      is looking at the HTML from before they linked - still being asked to do
      the thing they just did. On return, ask once and refresh if it took.

      The reference and token are read from the address bar rather than passed
      in, so this stays a plain script with nothing interpolated into it. */}
  <script is:inline>
    (() => {
      const button = document.querySelector('[data-connect-telegram]');
      if (!button) return;
      const dialog = document.querySelector('#connect-telegram');

      let started = false;
      let timer = null;

      const check = async () => {
        try {
          const res = await fetch('/api/orders/link-status' + location.search);
          const data = await res.json();
          if (data.linked) {
            clearInterval(timer);
            // Close first, or the reloaded page renders the confirmation
            // underneath a dialog that is still open over it.
            if (dialog && dialog.open) dialog.close();
            location.reload();
          }
        } catch {
          /* offline or blocked: leave the page exactly as it is */
        }
      };

      button.addEventListener('click', () => {
        // The dialog opens every time - they may tap Connect again after losing
        // their place - but the polling only ever starts once.
        if (dialog && !dialog.open) dialog.showModal();
        if (started) return;
        started = true;

        // The link opens in its own tab, so this one may never lose focus and
        // visibilitychange alone would not fire. Poll instead, briefly: long
        // enough to cover finding the app and pressing Start, short enough that
        // an abandoned attempt is not still calling the server ten minutes on.
        timer = setInterval(check, 3000);
        setTimeout(() => clearInterval(timer), 180000);
      });

      // Still worth checking on return, for the phone case where the Telegram
      // app takes over the screen entirely.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && started) check();
      });
    })();
  </script>
</Base>
