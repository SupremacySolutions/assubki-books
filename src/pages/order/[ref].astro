---
import Base from '../../layouts/Base.astro';
import Rosette from '../../components/Rosette.astro';
import { getOrder } from '../../lib/orders';
import { optInLink } from '../../lib/telegram';
import OrderJourney from '../../components/OrderJourney.astro';
import { price, SITE } from '../../lib/format';

const { ref } = Astro.params;
const token = Astro.url.searchParams.get('t') ?? '';
const order = ref ? await getOrder(ref, token) : null;

// A wrong or missing token is indistinguishable from a wrong reference, so
// neither confirms that an order exists.
if (!order) return Astro.rewrite('/404');

const STATUS: Record<string, { label: string; blurb: string; tone: 'wait' | 'good' | 'done' | 'off' }> = {
  requested: {
    label: 'Request received',
    blurb: 'Your books are held. We will reply with the total and how to pay.',
    tone: 'wait',
  },
  awaiting_payment: {
    label: 'Awaiting payment',
    blurb: 'We have sent you payment details. Your books stay held until payment reaches us.',
    tone: 'wait',
  },
  paid: { label: 'Payment received', blurb: 'Thank you. Your order is being packed.', tone: 'good' },
  dispatched: { label: 'Dispatched', blurb: 'Your books are on their way.', tone: 'done' },
  cancelled: { label: 'Cancelled', blurb: 'This request was cancelled. Nothing was charged.', tone: 'off' },
  expired: {
    label: 'Hold lapsed',
    blurb: 'We did not hear back within 48 hours, so the books returned to the shelf. Nothing was charged - you are welcome to request again.',
    tone: 'off',
  },
};

const status = STATUS[order.status] ?? STATUS.requested;
const placed = new Date(order.created_at * 1000);
const expires = order.expires_at ? new Date(order.expires_at * 1000) : null;
const stillHeld = order.status === 'requested' && expires && expires.getTime() > Date.now();

// Most customers arrive from the Telegram channel, so this is where they
// actually read. The bot cannot message them until they tap this, so it is
// given real prominence rather than being a footnote.
const telegramLink = optInLink(order.ref, token);
const awaitingReply = order.status === 'requested' || order.status === 'awaiting_payment';
const telegramLinked = Boolean(order.telegram_chat_id);
---

<Base title={`Request ${order.ref}`} noindex>
  <div class="py-10 md:py-14 max-w-2xl">
    <div class="flex items-start gap-4">
      <div class="text-[var(--color-navy)] shrink-0 mt-1"><Rosette size={40} /></div>
      <div>
        <p class="eyebrow">Reference {order.ref}</p>
        <h1 class="mt-1 font-[family-name:var(--font-display)] text-[30px] md:text-[36px] font-semibold leading-tight">
          {status.label}
        </h1>
      </div>
    </div>

    <div
      class:list={[
        'mt-6 p-4 rounded-[3px] border text-[15px] leading-relaxed',
        status.tone === 'wait' && 'bg-white border-[var(--color-rule)] text-[var(--color-ink-soft)]',
        status.tone === 'good' && 'bg-[var(--color-instock)]/10 border-[var(--color-instock)]/30 text-[var(--color-instock)]',
        status.tone === 'done' && 'bg-[var(--color-instock)]/10 border-[var(--color-instock)]/30 text-[var(--color-instock)]',
        status.tone === 'off' && 'bg-[var(--color-rule)]/50 border-[var(--color-rule)] text-[var(--color-ink-soft)]',
      ]}
    >
      {status.blurb}
    </div>

    {
      stillHeld && (
        <p class="mt-3 text-[14px] text-[var(--color-ink-faint)]">
          Held until{' '}
          {expires!.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}.
        </p>
      )
    }

    {
      telegramLink && awaitingReply && !telegramLinked && (
        <section class="mt-6 p-5 bg-white border border-[var(--color-rule)] rounded-[3px]">
          <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
            Get your payment details on Telegram
          </h2>
          <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)] leading-relaxed max-w-lg">
            Tap once to connect this order to your Telegram, and we will send the total and how to
            pay straight to your chat. Otherwise we will email you.
          </p>
          <a
            href={telegramLink}
            rel="noopener"
            class="btn mt-4 !bg-[#229ED9] !text-white hover:!bg-[#1d8ec2]"
          >
            Connect Telegram
          </a>
        </section>
      )
    }

    {
      telegramLinked && awaitingReply && (
        <p class="mt-4 text-[14.5px] text-[var(--color-instock)]">
          Connected to Telegram. Your total and how to pay will arrive in that chat.
        </p>
      )
    }

    <section class="mt-8">
      <h2 class="eyebrow mb-4">Progress</h2>
      <OrderJourney order={order} />
    </section>

    <section class="mt-9">
      <h2 class="eyebrow mb-3">What you asked for</h2>
      <ul class="border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
        {
          order.items.map((item) => (
            <li class="py-3 flex justify-between gap-4 text-[15px]">
              <span class="min-w-0">
                {item.slug ? (
                  <a href={`/book/${item.slug}`} class="hover:text-[var(--color-navy)]">
                    {item.title_snapshot}
                  </a>
                ) : (
                  item.title_snapshot
                )}
                {item.qty > 1 && <span class="text-[var(--color-ink-faint)]"> × {item.qty}</span>}
              </span>
              <span class="shrink-0 tabular-nums">
                {price(item.price_pence_snapshot * item.qty)}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="mt-3 flex justify-between items-baseline">
        <span class="text-[15px]">Subtotal</span>
        <span class="tabular-nums">{price(order.subtotal_pence)}</span>
      </div>
      {
        order.total_pence !== null && (
          <>
            {order.fulfilment !== 'collection' && (
              <div class="mt-1 flex justify-between items-baseline text-[var(--color-ink-soft)]">
                <span class="text-[15px]">Postage</span>
                <span class="tabular-nums">{price(order.postage_pence ?? 0)}</span>
              </div>
            )}
            <div class="mt-2 pt-2 border-t border-[var(--color-rule)] flex justify-between items-baseline">
              <span class="text-[15px] font-medium">Total to pay</span>
              <span class="price text-[20px]">{price(order.total_pence)}</span>
            </div>
          </>
        )
      }
      <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
        {order.total_pence !== null
          ? 'Nothing is charged through this website.'
          : order.fulfilment === 'collection'
            ? 'Nothing has been charged.'
            : 'Postage is added when we confirm. Nothing has been charged.'}
      </p>
    </section>

    <section class="mt-9 grid gap-4 sm:grid-cols-2 text-[14.5px]">
      <div>
        <h2 class="eyebrow mb-1.5">Requested</h2>
        <p class="text-[var(--color-ink-soft)]">
          {placed.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}
        </p>
      </div>
      <div>
        <h2 class="eyebrow mb-1.5">{order.fulfilment === 'collection' ? 'Collection' : 'Delivery to'}</h2>
        <p class="text-[var(--color-ink-soft)] whitespace-pre-line">
          {order.fulfilment === 'collection' ? 'You are collecting in person.' : order.address}
        </p>
      </div>
    </section>

    {
      order.notes && (
        <section class="mt-6">
          <h2 class="eyebrow mb-1.5">Your note</h2>
          <p class="text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line">{order.notes}</p>
        </section>
      )
    }

    <div class="mt-10 pt-6 border-t border-[var(--color-rule)]">
      <p class="text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        Keep this page - it updates as we work through your request. Quote{' '}
        <strong class="text-[var(--color-ink)]">{order.ref}</strong> if you get in touch.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={SITE.telegram} rel="noopener" class="btn btn-ghost">Message us on Telegram</a>
        <a href="/catalogue" class="btn btn-ghost">Keep browsing</a>
      </div>
    </div>
  </div>
</Base>
