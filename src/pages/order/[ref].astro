---
/**
 * The old order URL.
 *
 * Every confirmation sent before the pages were merged points here, so it has
 * to keep working. It now forwards to the single address at /order, which is
 * both the lookup form and the order itself.
 */
const { ref } = Astro.params;
const token = Astro.url.searchParams.get('t') ?? '';
const query = new URLSearchParams({ ref: ref ?? '', ...(token ? { t: token } : {}) });
return Astro.redirect(`/order?${query}`, 301);
---
