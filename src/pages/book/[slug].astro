---
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import Rosette from '../../components/Rosette.astro';
import { bookBySlug, relatedBooks, setOptions } from '../../lib/db';
import { price, availability, imageUrl, stripTags, truncate, SITE } from '../../lib/format';
import { delivery } from '../../lib/incoming';
import { liveSale } from '../../lib/sales';
import { classmark } from '../../lib/classmarks';
import { IMAGE_PRESETS } from '../../lib/image-presets';
import { cropsCleanly } from '../../lib/cover-fit';
import MessageUs from '../../components/MessageUs.astro';
import { BACK_IN_STOCK } from '../../lib/order-status';

const { slug } = Astro.params;
const book = slug ? await bookBySlug(slug) : null;
if (!book) return Astro.rewrite('/404');

const related = await relatedBooks(book.id, 6);
const avail = availability(book.available);

/*
 * A delivery on its way, and whether this customer already has one of it.
 *
 * `mine` cannot be known on the server - there is no customer session - so the
 * page renders the unreserved state and the client swaps it, the same way the
 * basket count is hydrated. It stays correct without JavaScript; it just does
 * not know this particular customer yet.
 */
/* The three facts again, with room to breathe. */
/* What came back from "tell me when it is back", turned into the sentence the
   page shows. One set of words, in order-status.ts, like everything else. */
const told = ({
  added: BACK_IN_STOCK.added,
  already: BACK_IN_STOCK.already,
  toomany: BACK_IN_STOCK.tooMany,
  bad: BACK_IN_STOCK.bad,
} as Record<string, string>)[Astro.url.searchParams.get('tell') ?? ''] ?? null;

const off = book.sale_percent ?? 0;
const nowPence = off > 0 ? Math.round((book.price_pence * (100 - off)) / 100) : book.price_pence;
const savedPence = book.price_pence - nowPence;
const sale = off > 0 ? await liveSale() : null;

const coming = delivery(book);
const mine: string | null = null;

const pillLabel = mine
  ? 'Reserved for you'
  : coming && book.available <= 0
    ? coming.free > 0
      ? 'On its way'
      : 'Fully reserved'
    : avail.label;
const cover = imageUrl(book.images[0]?.image_key, 'detail');
// Same rule as the catalogue card, so a book looks the same in both places.
const coverFills = cropsCleanly(book.images[0]?.width, book.images[0]?.height);

// The other ways this set can be bought. Empty for an ordinary book, which is
// every listing that is not part of one.
const options = book.set_id ? await setOptions(book.set_id) : [];
const volumeLabel = (o: { set_from: number | null; set_to: number | null }) =>
  o.set_from === o.set_to ? `Volume ${o.set_from}` : `Volumes ${o.set_from}-${o.set_to}`;
const plain = stripTags(book.description_html);

// This is the description Telegram shows when the owner posts the link, so it
// has to stand alone: what the book is, then price and availability.
const shareDescription = truncate(
  plain || `${book.title}${book.title_ar ? ` - ${book.title_ar}` : ''}`,
  160,
);

/*
 * A Book *and* a Product.
 *
 * schema.org allows a thing to be both, and Google needs it to be: the
 * book-specific fields are what make it a book, but merchant listings and
 * product snippets are only read off `Product`. Typed as `Book` alone - which
 * this was - the price and availability below were never eligible to appear in
 * a search result at all.
 *
 * Deliberately absent: `hasMerchantReturnPolicy` and `shippingDetails`. Both
 * earn annotations in Google's results and both would have to state a returns
 * window and a postage rate. The returns page is still a set of blanks and
 * postage is quoted per order, so there is no true value to give. A guessed one
 * would be a promise the shop has not made.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Book', 'Product'],
  name: book.title,
  sku: book.slug,
  url: new URL(`/book/${book.slug}`, Astro.url.origin).toString(),
  itemCondition: 'https://schema.org/NewCondition',
  brand: book.publisher ? { '@type': 'Brand', name: book.publisher } : undefined,
  alternateName: book.title_ar ?? undefined,
  author: book.author ? { '@type': 'Person', name: book.author } : undefined,
  publisher: book.publisher ? { '@type': 'Organization', name: book.publisher } : undefined,
  description: plain || undefined,
  // Same reasoning as the OG tags in Base.astro: follow the served host.
  image: cover ? new URL(cover, Astro.url.origin).toString() : undefined,
  offers: {
    '@type': 'Offer',
    // The sale price, or search results advertise one the shop is not charging.
    price: (nowPence / 100).toFixed(2),
    priceCurrency: 'GBP',
    availability:
      book.available > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Organization', name: SITE.name },
  },
};
---

<Base title={book.title} description={shareDescription} image={cover}>
  <div class="py-8 md:py-10">
    <nav aria-label="Breadcrumb" class="text-[13.5px] text-[var(--color-ink-faint)] mb-6">
      <a href="/" class="hover:text-[var(--color-navy)]">Home</a>
      <span class="mx-1.5">/</span>
      <a href="/catalogue" class="hover:text-[var(--color-navy)]">Catalogue</a>
      {
        book.categories[0] && (
          <>
            <span class="mx-1.5">/</span>
            <a href={`/catalogue/${book.categories[0].path}`} class="hover:text-[var(--color-navy)]">
              {book.categories[0].name}
            </a>
          </>
        )
      }
    </nav>

    <div class="grid gap-8 md:grid-cols-[minmax(0,340px)_1fr] md:gap-12 lg:gap-16">
      <div>
        <div
          class="bg-white rounded-[var(--radius-card)] shadow-[var(--shadow-cover-detail),inset_5px_0_0_rgba(14,42,85,0.12)] aspect-[3/4] grid place-items-center overflow-hidden"
        >
          {
            cover ? (
              <img
                id="cover"
                src={cover}
                alt={book.images[0]?.alt ?? book.title}
                {/* The box, not the stored image: an owner-uploaded photo has
                    no stored size at all. */}
                width={IMAGE_PRESETS.detail.width}
                height={IMAGE_PRESETS.detail.height}
                class:list={['h-full w-full', coverFills ? 'object-cover' : 'object-contain p-4']}
                fetchpriority="high"
              />
            ) : (
              <div class="grid place-items-center text-[var(--color-wash)]">
                <Rosette size={96} />
              </div>
            )
          }
        </div>

        {
          book.images.length > 1 && (
            <ul class="mt-3 flex gap-2.5 flex-wrap">
              {book.images.map((img, i) => (
                <li>
                  <button
                    type="button"
                    class="thumb w-[52px] h-[66px] bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-card)] p-1 grid place-items-center hover:border-[var(--color-navy)] transition-colors aria-pressed:border-[var(--color-navy)] aria-pressed:ring-2 aria-pressed:ring-[var(--color-navy)]"
                    data-src={imageUrl(img.image_key, 'detail')}
                    {/* Each photo carries its own answer. The main image used
                        to keep whichever fit the *first* one needed, so
                        clicking a differently shaped photo - a back cover, a
                        spine - would have cropped it to the first one's
                        proportions. */}
                    data-fit={cropsCleanly(img.width, img.height) ? 'cover' : 'contain'}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    <img src={imageUrl(img.image_key, 'thumb')} alt="" class="max-h-full max-w-full object-contain" loading="lazy" />
                    <span class="sr-only">View image {i + 1}</span>
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div>
        {
          book.categories.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mb-3">
              {book.categories.map((c) => (
                <a href={`/catalogue/${c.path}`} class="classmark !rounded-[var(--radius-pill)] !px-2.5 !py-1 hover:bg-[var(--color-wash)]">
                  {classmark(c.slug)} · {c.name}
                </a>
              ))}
            </div>
          )
        }

        <h1 class="font-[family-name:var(--font-display)] text-[32px] md:text-[46px] font-semibold leading-[1.08] tracking-[-0.02em] text-[var(--color-navy-deep)]">
          {book.title}
        </h1>
        {book.title_ar && <p class="ar mt-2 text-[26px] text-[var(--color-ink-soft)]">{book.title_ar}</p>}

        {/* Author, how many volumes, publisher - the three things a buyer
            wants before the price. Each part is left out when it is not known,
            so the separators cannot end up stranded. */}
        {
          (book.author || book.publisher || (book.volumes ?? 0) > 1) && (
            <p class="mt-2.5 text-[15.5px] text-[var(--color-ink-soft)]">
              {[
                book.author,
                (book.volumes ?? 0) > 1 ? `${book.volumes} volume set` : null,
                book.publisher,
              ]
                .filter(Boolean)
                .map((part, i) => (
                  <>
                    {i > 0 && <span class="text-[var(--color-ink-faint)]"> · </span>}
                    <span class:list={[i === 0 ? '' : 'text-[var(--color-ink-faint)]']}>{part}</span>
                  </>
                ))}
            </p>
          )
        }

        {/* Above the price, because which option they are looking at decides
            what the price means. The one they are on is marked rather than
            linked - a link to the page you are already on reads as broken. */}
        {
          options.length > 1 && (
            <div class="mt-6">
              <p class="eyebrow mb-2">This set can be bought as</p>
              <ul class="flex flex-wrap gap-2">
                {options.map((o) => {
                  const here = o.id === book.id;
                  const gone = o.available <= 0;
                  return (
                    <li>
                      <a
                        href={here ? undefined : `/book/${o.slug}`}
                        aria-current={here ? 'true' : undefined}
                        class:list={[
                          'block px-3 py-2 rounded-[3px] border text-[13.5px] leading-tight',
                          here
                            ? 'border-[var(--color-navy)] bg-[var(--color-navy)] text-white'
                            : 'border-[var(--color-rule)] hover:border-[var(--color-navy)]',
                          gone && !here && 'opacity-55',
                        ]}
                      >
                        <span class="block font-medium">{volumeLabel(o)}</span>
                        <span
                          class:list={[
                            'block mt-0.5',
                            here ? 'text-white/80' : 'text-[var(--color-ink-faint)]',
                          ]}
                        >
                          {price(o.price_pence)}
                          {gone && ' · out of stock'}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }

        {/* One panel for the whole decision: what it costs, whether it is
            there, how many, and the button. They were four loose rows that the
            eye had to gather up itself. */}
        <div class="mt-7 max-w-[520px] bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-[22px]">
          <div class="flex items-center gap-3.5 flex-wrap">
            <span class="price text-[34px] leading-none">{price(nowPence)}</span>
            {off > 0 && (
              <>
                <span class="text-[18px] text-[var(--color-ink-faint)] line-through decoration-1">
                  {price(book.price_pence)}
                </span>
                <span class="text-[13px] font-medium px-3 py-1 rounded-[var(--radius-pill)] text-[var(--color-outstock)] bg-[var(--color-outstock)]/10">
                  Save {price(savedPence)}
                </span>
              </>
            )}
            <span
              class:list={[
                'text-[13.5px] font-medium px-3 py-1 rounded-[var(--radius-pill)]',
                avail.state === 'in' && 'text-[var(--color-instock)] bg-[var(--color-instock)]/10',
                avail.state === 'low' && 'text-[var(--color-outstock)] bg-[var(--color-outstock)]/10',
                avail.state === 'out' && 'text-[var(--color-ink-faint)] bg-[var(--color-rule)]/60',
              ]}>{pillLabel}</span
            >
          </div>

          {off > 0 && sale && (
            <p class="mt-2.5 text-[13.5px] text-[var(--color-outstock)]">
              {off}% off in the{' '}
              <a href="/catalogue?sale=1" class="underline underline-offset-2 font-medium">{sale.name}</a>
            </p>
          )}

          {/*
            * A delivery on its way.
            *
            * Its own panel rather than a line in the availability pill: a copy
            * you can have today and a copy that is three weeks away are not
            * two shades of the same fact, and a customer who reads them as one
            * will be waiting for a parcel nobody has sent.
            */}
          {coming && book.available <= 0 && (
            <div class="mt-4 bg-[var(--color-paper-raised)] border border-[var(--color-rule-soft)] rounded-[10px] p-4">
              <p class="eyebrow !text-[10.5px] mb-1.5">Delivery on its way</p>
              <p class="text-[15px]">
                {coming.coming} {coming.coming === 1 ? 'copy' : 'copies'} expected
                {coming.when ? ` ${coming.when}` : ' shortly'}.
              </p>
              <p class="mt-0.5 text-[14px] text-[var(--color-ink-faint)]">
                {mine
                  ? `1 copy reserved for you on order ${mine}`
                  : coming.free > 0
                    ? `${coming.free} still free to reserve`
                    : `All ${coming.coming} are already spoken for`}
              </p>
            </div>
          )}

          {
            book.available > 0 ? (
              <>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                {/* A stepper rather than a bare number field: on a phone the
                    native spinner does not exist at all, and most orders are
                    for one or two. The field stays typeable for the rest. */}
                <div class="flex items-center rounded-[var(--radius-pill)] border border-[var(--color-rule)] bg-white">
                  <button
                    type="button"
                    data-qty="-1"
                    aria-label="One fewer"
                    class="w-10 h-11 grid place-items-center text-[18px] leading-none text-[var(--color-navy)] rounded-l-[var(--radius-pill)] hover:bg-[var(--color-paper)] disabled:opacity-40"
                  >−</button>
                  <label for="qty" class="sr-only">Quantity</label>
                  <input
                    id="qty"
                    type="number"
                    min="1"
                    max={book.available}
                    value="1"
                    inputmode="numeric"
                    class="w-11 h-11 text-center bg-transparent border-0 outline-none tabular-nums text-[15.5px] [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    data-qty="1"
                    aria-label="One more"
                    class="w-10 h-11 grid place-items-center text-[18px] leading-none text-[var(--color-navy)] rounded-r-[var(--radius-pill)] hover:bg-[var(--color-paper)] disabled:opacity-40"
                  >+</button>
                </div>
                <button
                  type="button"
                  id="add"
                  class="btn btn-primary !text-[16px] !py-[13px] !px-6 flex-1 min-w-[10rem]"
                  data-book-id={book.id}
                  data-max={book.available}
                >
                  Add to basket
                </button>
              </div>
              <a href="/basket" id="tobasket" class="mt-3 inline-block text-[14.5px] text-[var(--color-navy)] hover:underline underline-offset-2 hidden">
                View basket →
              </a>

              {/* The basket page says when it could not take what was asked
                  for; adding from here used to cut the quantity down and
                  confirm as though nothing had happened. Customers who need ten
                  and are quietly given three abandon the order later, or worse,
                  do not notice until the parcel arrives. */}
              <p id="addnote" role="status" class="mt-2 text-[13.5px] text-[var(--color-outstock)]" hidden />
              </>
            ) : mine ? (
              <p class="mt-4 text-[15px] text-[var(--color-ink-soft)]">
                It will be sent with the rest of that order once the delivery arrives.
              </p>
            ) : coming && coming.free > 0 ? (
              <>
                {/* Brass, not navy. Reserving is a different act from buying
                    something that is on the shelf, and the button should not
                    pretend otherwise. */}
                <button
                  type="button"
                  id="reserve"
                  class="mt-5 w-full sm:w-auto rounded-[var(--radius-pill)] bg-[var(--color-brass)] px-6 py-[13px] text-[16px] font-medium text-white hover:brightness-110 transition-[filter]"
                  data-book-id={book.id}
                  data-max={coming.free}
                  data-slug={book.slug}
                >
                  Reserve a copy
                </button>
                <p id="addnote" role="status" class="mt-2 text-[13.5px] text-[var(--color-outstock)]" hidden />
              </>
            ) : coming ? (
              <p class="mt-4 text-[15px] text-[var(--color-ink-soft)]">
                Every copy of this delivery is spoken for.{' '}
                <MessageUs variant="inline" label="Ask us" subject={`Next delivery: ${book.title}`} />{' '}
                and we will add you to the one after.
              </p>
            ) : (
              <div class="mt-4" id="tell">
                <p class="text-[15px] text-[var(--color-ink-soft)]">
                  This title is out of stock. Leave your email and we will tell you the moment it
                  is back, or{' '}
                  <MessageUs variant="inline" label="ask us" subject={`Back in stock: ${book.title}`} />.
                </p>

                {/* Its own form, never nested inside another - a nested form is
                    discarded by the browser and its button submits the outer
                    one, which has broken this codebase twice. */}
                <form method="post" action="/api/books/alert" class="mt-3 flex flex-wrap gap-2">
                  <input type="hidden" name="bookId" value={book.id} />
                  <input type="hidden" name="slug" value={book.slug} />
                  <label class="sr-only" for="tell-email">{BACK_IN_STOCK.placeholder}</label>
                  <input
                    id="tell-email"
                    type="email"
                    name="email"
                    required
                    maxlength="160"
                    autocomplete="email"
                    placeholder={BACK_IN_STOCK.placeholder}
                    class="field !py-2 !text-[14.5px] flex-1 min-w-[12rem]"
                  />
                  <button type="submit" class="btn btn-primary !py-2 !text-[14px] shrink-0">
                    {BACK_IN_STOCK.ask}
                  </button>
                </form>

                {told && (
                  <p
                    role="status"
                    class:list={[
                      'mt-2 text-[13.5px] leading-relaxed',
                      told === BACK_IN_STOCK.added
                        ? 'text-[var(--color-instock)]'
                        : 'text-[var(--color-ink-faint)]',
                    ]}
                  >{told}</p>
                )}
                {!told && (
                  <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                    {BACK_IN_STOCK.help}
                  </p>
                )}
              </div>
            )
          }
          <p class="mt-4 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
            {coming && book.available <= 0 && !mine
              ? 'A reservation is not a hold that runs out - it stands until the delivery lands. Nothing is paid now.'
              : 'Adding to the basket reserves nothing yet. You send a request, we confirm, then we send payment details - no card details are taken on this site.'}
          </p>
        </div>

        {
          book.description_html && (
            <div class="mt-9 pt-8 border-t border-[var(--color-rule)]">
              <h2 class="eyebrow mb-3">About this edition</h2>
              <div class="prose-book max-w-prose" set:html={book.description_html} />
            </div>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16 pt-10 border-t border-[var(--color-rule)]">
          <h2 class="font-[family-name:var(--font-display)] text-[24px] font-semibold mb-6">
            On the same shelf
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-5 gap-y-8">
            {related.map((b) => (
              <BookCard book={b} quickAdd />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <script is:inline nonce={Astro.locals.cspNonce} set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

  <script>
    import { readGroup } from '../../scripts/group.ts';

    const qtyField = document.querySelector<HTMLInputElement>('#qty');

    // The stepper, clamped to what is actually on the shelf so the field can
    // never ask for more than the button will accept.
    for (const step of document.querySelectorAll<HTMLButtonElement>('[data-qty]')) {
      step.addEventListener('click', () => {
        if (!qtyField) return;
        const max = Number(qtyField.max || '1');
        const next = (Number(qtyField.value) || 1) + Number(step.dataset.qty);
        qtyField.value = String(Math.min(max, Math.max(1, next)));
        qtyField.dispatchEvent(new Event('input', { bubbles: true }));
        for (const b of document.querySelectorAll<HTMLButtonElement>('[data-qty]')) {
          const v = Number(qtyField.value);
          b.disabled = b.dataset.qty === '-1' ? v <= 1 : v >= max;
        }
      });
    }

    const addBtn = document.querySelector<HTMLButtonElement>('#add');
    const qtyInput = document.querySelector<HTMLInputElement>('#qty');
    const toBasket = document.querySelector<HTMLAnchorElement>('#tobasket');

    const note = document.querySelector<HTMLParagraphElement>('#addnote');

    const say = (words: string) => {
      if (!note) return;
      note.textContent = words;
      note.hidden = !words;
    };

    /**
     * What the shop has right now, not what it had when this page rendered.
     *
     * `data-max` is baked in at render time, so a tab left open all afternoon
     * clamps against a ceiling that has since moved. If the check cannot be
     * made, fall back to that stale number rather than refusing the add.
     */
    const availableNow = async (id: string, fallback: number) => {
      try {
        const res = await fetch(`/api/basket?ids=${encodeURIComponent(id)}`);
        const data = await res.json();
        const book = data?.books?.[0];
        return typeof book?.available === 'number' ? book.available : fallback;
      } catch {
        return fallback;
      }
    };

    /**
     * Adding while part of a group puts the books in the group's basket, not
     * this browser's own - otherwise someone who joined a class order would add
     * to a private list nobody else can see, and find out at the end that none
     * of it was in the request.
     */
    const addToGroup = async (
      member: NonNullable<ReturnType<typeof readGroup>>,
      bookId: number,
      wanted: number,
      available: number,
    ) => {
      const res = await fetch(`/api/group?g=${encodeURIComponent(member.code)}&k=${encodeURIComponent(member.token)}`);
      const data = await res.json();
      if (!res.ok || !data.ok) return null;

      const lines = data.group.lines as { bookId: number; qty: number; addedBy: string }[];
      const held = lines.find((l) => l.bookId === bookId && l.addedBy === member.name)?.qty ?? 0;

      // The shelf is shared with everyone else in the group, not just with the
      // rest of the shop: two people each taking the last three copies is five
      // copies, and the order would be refused at the end for a reason neither
      // of them could see.
      const others = lines
        .filter((l) => l.bookId === bookId && l.addedBy !== member.name)
        .reduce((n, l) => n + l.qty, 0);
      const ceiling = Math.max(0, available - others);
      const total = Math.min(held + wanted, ceiling);

      if (total > held) {
        const put = await fetch('/api/group/line', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: member.code, token: member.token, name: member.name, bookId, qty: total }),
        });
        if (!put.ok) return null;
      }

      // Their own contribution, so the header badge means something while they
      // are filling someone else's basket.
      const mine = lines
        .filter((l) => l.addedBy === member.name && l.bookId !== bookId)
        .reduce((n, l) => n + l.qty, 0);
      window.asbBasket.setBadge(mine + total);

      return {
        added: total - held,
        requested: wanted,
        total,
        capped: total - held < wanted,
        ceiling,
      };
    };

    addBtn?.addEventListener('click', async () => {
      const id = addBtn.dataset.bookId;
      if (!id) return;
      const wanted = Math.max(1, Number(qtyInput?.value ?? '1') || 1);
      const member = readGroup();

      addBtn.disabled = true;
      const available = await availableNow(id, Number(addBtn.dataset.max ?? '1'));
      const result = member
        ? await addToGroup(member, Number(id), wanted, available)
        : window.asbBasket.addChecked(id, wanted, available);

      if (!result) {
        say('That group basket is no longer taking books. Open your basket to check.');
        addBtn.disabled = false;
        return;
      }

      // The same words the basket page uses, so one event is not described two
      // different ways depending on where the customer happened to be.
      // How many this reader could still take: in a group that is what is left
      // after everyone else's lines, which is why the group wording talks about
      // the group rather than about them.
      const left = 'ceiling' in result ? (result.ceiling as number) : available;

      if (available <= 0) say('Out of stock - nothing added');
      else if (result.added === 0) {
        say(
          member
            ? `The group has already asked for all ${available} we have`
            : `All ${available} we have are already in your basket`,
        );
      } else if (result.capped) {
        say(
          member
            ? `Only ${left} left after the rest of the group - quantity reduced`
            : `Only ${available} available - quantity reduced`,
        );
      } else say('');

      // Confirm in place. A redirect to the basket costs the customer their
      // position in a 226-title catalogue.
      if (result.added > 0) {
        addBtn.textContent = member ? 'Added to the group' : 'Added';
        toBasket?.classList.remove('hidden');
      }
      setTimeout(() => {
        addBtn.textContent = 'Add to basket';
        addBtn.disabled = false;
      }, result.added > 0 ? 1800 : 0);
    });

    /*
     * Reserving a copy from a delivery that has not landed.
     *
     * This button had no handler at all. It rendered, it looked exactly like
     * the one beside it, and clicking it did nothing - for the whole life of
     * the reservations feature. The suite never saw it because it reserves by
     * posting to the API, which has always worked; only the button was missing.
     *
     * The ceiling is `reservable` - what is left of the delivery after other
     * people's claims - and never shelf stock, which is nil by definition here.
     * Group baskets go through the same path as an ordinary add: a group line
     * is a book and a quantity, and whether it comes off the shelf or off a
     * delivery is decided when the order is actually created.
     */
    const reserveBtn = document.querySelector<HTMLButtonElement>('#reserve');

    /** What is still free to claim, re-read rather than trusted from render. */
    const reservableNow = async (id: string, fallback: number) => {
      try {
        const res = await fetch(`/api/basket?ids=${encodeURIComponent(id)}`);
        const data = await res.json();
        const book = data?.books?.[0];
        return typeof book?.reservable === 'number' ? book.reservable : fallback;
      } catch {
        return fallback;
      }
    };

    reserveBtn?.addEventListener('click', async () => {
      const id = reserveBtn.dataset.bookId;
      if (!id) return;
      const member = readGroup();

      reserveBtn.disabled = true;
      const free = await reservableNow(id, Number(reserveBtn.dataset.max ?? '1'));

      if (free <= 0) {
        say('Every copy of this delivery is already reserved.');
        reserveBtn.disabled = false;
        return;
      }

      const result = member
        ? await addToGroup(member, Number(id), 1, free)
        : window.asbBasket.addChecked(id, 1, free);

      if (!result) {
        say('That group basket is no longer taking books. Open your basket to check.');
        reserveBtn.disabled = false;
        return;
      }

      if (result.added === 0) {
        say(
          member
            ? `The group has already reserved all ${free} that are free`
            : `All ${free} free copies are already in your basket`,
        );
      } else say('');

      if (result.added > 0) {
        reserveBtn.textContent = member ? 'Reserved for the group' : 'Reserved';
        toBasket?.classList.remove('hidden');
      }
      setTimeout(() => {
        reserveBtn.textContent = 'Reserve a copy';
        reserveBtn.disabled = false;
      }, result.added > 0 ? 1800 : 0);
    });

    const cover = document.querySelector<HTMLImageElement>('#cover');
    for (const thumb of document.querySelectorAll<HTMLButtonElement>('.thumb')) {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.src;
        if (!src || !cover) return;
        cover.src = src;

        // Follow the photo, not the one that happened to be first.
        const fits = thumb.dataset.fit === 'cover';
        cover.classList.toggle('object-cover', fits);
        cover.classList.toggle('object-contain', !fits);
        cover.classList.toggle('p-4', !fits);
        for (const t of document.querySelectorAll('.thumb')) t.setAttribute('aria-pressed', 'false');
        thumb.setAttribute('aria-pressed', 'true');
      });
    }
  </script>
</Base>
