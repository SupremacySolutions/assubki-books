---
import Admin from '../../layouts/Admin.astro';
import { shelfTree } from '../../lib/shelves';
import ShelfRow from '../../components/admin/ShelfRow.astro';

const tree = await shelfTree();
const params = Astro.url.searchParams;
const saved = params.get('saved');
const problem = params.get('e');

const PROBLEMS: Record<string, string> = {
  cycle: 'A shelf cannot sit inside itself.',
  'not-found': 'That shelf no longer exists.',
};

const totalShelves = tree.reduce((n, t) => n + 1 + t.children.length, 0);

// Built from the tree rather than sorted by path, so the picker reads in the
// same order as the page: each top-level shelf followed by its own children.
const parentOptions: { id: number; label: string }[] = [];
for (const top of tree) {
  parentOptions.push({ id: top.id, label: top.name });
  for (const child of top.children) parentOptions.push({ id: child.id, label: `   ${child.name}` });
}
---

<Admin title="Shelves" sub={`${tree.length} top level, ${totalShelves} in total`}>
  {
    saved && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Shelves updated.
      </p>
    )
  }
  {
    problem && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        {PROBLEMS[problem] ?? 'That change could not be made.'}
      </p>
    )
  }

  <p class="mb-6 text-[14.5px] text-[var(--color-ink-soft)] max-w-2xl leading-relaxed">
    Shelves are how customers browse, and how a listing is filed. Renaming one changes its web
    address too, so links to it stop working. The order here is the order customers see.
  </p>

  <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5 mb-8">
    <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold mb-3">Add a shelf</h2>
    <form method="post" action="/api/admin/shelves/create" class="flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[200px]">
        <label for="newName" class="block text-[13px] font-medium mb-1.5 text-[var(--color-ink-soft)]">
          Name
        </label>
        <input id="newName" name="name" required maxlength="80" class="field" placeholder="e.g. Tajweed" />
      </div>
      <div>
        <label for="newParent" class="block text-[13px] font-medium mb-1.5 text-[var(--color-ink-soft)]">
          Sits under
        </label>
        <select id="newParent" name="parent" class="field !w-auto">
          <option value="">Nothing, a top-level shelf</option>
          {parentOptions.map((o) => <option value={o.id} set:html={o.label} />)}
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Add shelf</button>
    </form>
  </section>

  <div class="space-y-4">
    {
      tree.map((top, topIndex) => (
        <section class="bg-white border border-[var(--color-rule)] rounded-[3px] overflow-hidden">
          {/* Top-level shelf: tinted header band, so a parent never reads as
              just another row in a flat list. */}
          <div class="bg-[var(--color-paper)] border-b border-[var(--color-rule)] p-4">
            <ShelfRow
              shelf={top}
              isTop={true}
              index={topIndex}
              lastIndex={tree.length - 1}
              parentOptions={parentOptions}
            />
          </div>

          {top.children.length > 0 && (
            <ul class="divide-y divide-[var(--color-rule)]">
              {top.children.map((child, childIndex) => (
                <li class="p-4 ps-8 relative">
                  {/* A rule down the left ties children to their parent. */}
                  <span
                    class="absolute left-4 top-0 bottom-0 w-px bg-[var(--color-rule)]"
                    aria-hidden="true"
                  />
                  <ShelfRow
                    shelf={child}
                    isTop={false}
                    index={childIndex}
                    lastIndex={top.children.length - 1}
                    parentOptions={parentOptions}
                  />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>

  <script>
    for (const form of document.querySelectorAll<HTMLFormElement>('[data-delete-shelf]')) {
      form.addEventListener('submit', (event) => {
        const name = form.dataset.deleteShelf ?? 'this shelf';
        const cost = form.dataset.consequences;
        const detail = cost
          ? `\n\n${cost[0].toUpperCase()}${cost.slice(1)}. No books are deleted.`
          : '\n\nNothing else is affected.';
        if (!confirm(`Delete the “${name}” shelf?${detail}`)) event.preventDefault();
      });
    }
  </script>
</Admin>
