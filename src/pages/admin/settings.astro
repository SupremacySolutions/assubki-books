---
import Admin from '../../layouts/Admin.astro';
import {
  getSettings,
  PAYMENT_ACCOUNTS,
  COLLECTION_PLACES,
  CASH_SLOT,
  partBodyKey,
  partLabelKey,
} from '../../lib/settings';
import { botConfigured, botUsername, ownerOptInLink } from '../../lib/telegram';
import { emailConfigured, ownerAddress, lastEmailError, fromAddress } from '../../lib/email';

const [settings, emailError] = await Promise.all([getSettings(), lastEmailError()]);
const ownerTelegramLink = await ownerOptInLink();
const saved = Astro.url.searchParams.get('saved');
const unbound = Astro.url.searchParams.get('unbound');

/*
 * Whether the bound chat can be shown to be the handle customers are given.
 *
 * A Telegram account need not have a username, and then the label is a display
 * name that proves nothing. That is worth saying out loud rather than implying
 * a check that did not happen.
 */
const boundLabel = (settings.owner_telegram_label ?? '').trim();
const handle = (v: string) => v.trim().replace(/^@/, '').toLowerCase();
const alertsUnverified =
  Boolean(settings.owner_telegram_chat_id) &&
  (!boundLabel.startsWith('@') || handle(boundLabel) !== handle(settings.contact_telegram ?? ''));

const draftGroups = [
  {
    heading: 'How they pay',
    note: 'Your bank accounts, and the wording for cash. On an order you pick one of these - the cash one whenever the order is paid in cash, whether it is posted or collected. Leave a box empty and it will not be offered.',
    slots: [
      ...PAYMENT_ACCOUNTS.map((a) => ({ ...a, cash: false })),
      { slot: CASH_SLOT, label: 'Cash', cash: true },
    ],
  },
  {
    heading: 'Where they collect',
    note: 'Your collection addresses. One of these is added to the message on a collection order, above however they are paying.',
    slots: COLLECTION_PLACES.map((p) => ({ ...p, cash: false })),
  },
];
---

<Admin title="Settings">
  {
    saved && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Settings saved.
      </p>
    )
  }

  {
    /* Said plainly, because it stops alerts arriving and nothing else on the
       page would explain why. */
    unbound && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)] leading-relaxed">
        The Telegram handle changed, so owner alerts were disconnected - they were still going to
        the previous chat, which is not something the handle can redirect. Connect the new one
        below to start receiving them again.
      </p>
    )
  }

  <form method="post" action="/api/admin/settings" class="space-y-5 max-w-2xl">
    {/* Several per journey, each named by the owner. The list lives in
        lib/settings, so this renders whatever is defined there rather than
        hard-coding six boxes. */}
    <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
        Payment drafts
      </h2>
      <p class="mt-1.5 mb-1 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        The wording you send when you confirm an order. Give each one a short name so you can tell
        them apart, then pick the one you want on the order itself - you can still edit it there
        before it goes. The reference is added automatically.
      </p>

      {draftGroups.map((group) => (
        <div class="mt-5 pt-4 border-t border-[var(--color-rule)]" data-draft-group>
          <h3 class="text-[15px] font-semibold">{group.heading}</h3>
          <p class="mt-1 mb-3 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
            {group.note}
          </p>

          {/* One at a time, switched by these. Stacked, the six boxes were a
              wall of text with no sense of which was which. */}
          <div class="flex flex-wrap gap-2" role="tablist">
            {group.slots.map((slot, i) => (
              <button
                type="button"
                role="tab"
                data-draft-tab={slot.slot}
                aria-selected={i === 0 ? 'true' : 'false'}
                class="px-3 py-1.5 text-[13.5px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-navy)] aria-selected:border-[var(--color-navy)] aria-selected:bg-[var(--color-navy)] aria-selected:text-white"
              >
                {settings[partLabelKey(slot.slot)]?.trim() || slot.label}
              </button>
            ))}
          </div>

          {group.slots.map((slot, i) => (
            <div class="mt-3" data-draft-panel={slot.slot} hidden={i !== 0}>
              <label for={partLabelKey(slot.slot)} class="block text-[13px] text-[var(--color-ink-faint)] mb-1">
                Name for this one
              </label>
              <input
                id={partLabelKey(slot.slot)}
                name={partLabelKey(slot.slot)}
                maxlength="40"
                placeholder={slot.label}
                value={settings[partLabelKey(slot.slot)] ?? ''}
                data-draft-name={slot.slot}
                class="field !py-1.5 !text-[14px] !w-64"
              />
              <label for={partBodyKey(slot.slot)} class="block mt-3 text-[13px] text-[var(--color-ink-faint)] mb-1">
                What it says
              </label>
              <textarea
                id={partBodyKey(slot.slot)}
                name={partBodyKey(slot.slot)}
                rows="8"
                maxlength="4000"
                placeholder={slot.cash
                  ? 'What to tell somebody paying in cash. Where the money changes hands is added for you.'
                  : 'Leave empty if you do not use this one - it will not be offered on an order.'}
                class="field font-[family-name:var(--font-body)]">{settings[partBodyKey(slot.slot)] ?? ''}</textarea
              >
            </div>
          ))}
        </div>
      ))}

    </section>

    <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
        Where people reach you
      </h2>
      <p class="mt-1.5 mb-3 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        Every "Message us on Telegram" link on the site points here, and the bot sends anyone
        asking about anything other than an order here too. Leave it blank and the site falls back
        to the channel.
      </p>
      <label for="contact_telegram" class="block text-[14.5px] font-medium mb-1.5">
        Telegram handle
      </label>
      <input
        id="contact_telegram"
        name="contact_telegram"
        maxlength="80"
        placeholder="@alsubkibooks"
        value={settings.contact_telegram ?? ''}
        class="field !w-64"
      />
    </section>

    <button type="submit" class="btn btn-primary">Save settings</button>
  </form>

  <!-- Read-only: these are secrets, set from the command line, not the browser. -->
  <section class="mt-8 max-w-2xl bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
    <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">Connections</h2>
    <dl class="mt-4 space-y-3 text-[14.5px]">
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Customer email</dt>
        <dd
          class:list={[
            'text-right max-w-[60%]',
            emailConfigured() && !emailError
              ? 'text-[var(--color-instock)]'
              : 'text-[var(--color-outstock)]',
          ]}
        >
          {!emailConfigured()
            ? 'Not configured'
            : emailError
              ? `Failing as ${fromAddress()} - ${emailError}`
              : `Sending · orders go to ${ownerAddress()}`}
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Owner Telegram alerts</dt>
        <dd class="text-right max-w-[60%]">
          {settings.owner_telegram_chat_id ? (
            <>
              <span class="text-[var(--color-instock)]">
                Connected{boundLabel ? ` · ${boundLabel}` : ''}
              </span>
              {/* Without this, recovering from a wrong chat being bound needed
                  direct database access. */}
              <form method="post" action="/api/admin/settings/unbind-telegram" class="inline">
                <button
                  type="submit"
                  class="ml-3 text-[13.5px] text-[var(--color-outstock)] underline underline-offset-2"
                >
                  Disconnect
                </button>
              </form>
              {alertsUnverified && ownerTelegramLink && (
                <span class="block mt-1 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
                  We cannot confirm this is {settings.contact_telegram || 'the contact handle'} -
                  alerts go to whichever chat pressed Start, not to a handle.{' '}
                  <a href={ownerTelegramLink} class="text-[var(--color-navy)] underline">
                    Reconnect
                  </a>{' '}
                  from the right account if this is wrong.
                </span>
              )}
            </>
          ) : ownerTelegramLink ? (
            <a href={ownerTelegramLink} class="text-[var(--color-navy)] underline">Connect this chat</a>
          ) : (
            'Set ADMIN_SESSION_SECRET first'
          )}
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Telegram bot</dt>
        <dd class:list={[botConfigured() ? 'text-[var(--color-instock)]' : 'text-[var(--color-outstock)]']}>
          {botConfigured() ? `Connected${botUsername() ? ` · @${botUsername()}` : ''}` : 'Not configured'}
        </dd>
      </div>
    </dl>
  </section>
</Admin>
<script>
  /*
   * The drafts are switched rather than stacked, so only one is in front of the
   * owner at a time. Every box stays in the form while hidden - a hidden field
   * still submits - so switching never costs an edit, and Save writes them all.
   */
  for (const group of document.querySelectorAll<HTMLElement>('[data-draft-group]')) {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[data-draft-tab]')];
    const panels = [...group.querySelectorAll<HTMLElement>('[data-draft-panel]')];

    const show = (slot: string) => {
      for (const tab of tabs) tab.setAttribute('aria-selected', String(tab.dataset.draftTab === slot));
      for (const panel of panels) panel.hidden = panel.dataset.draftPanel !== slot;
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => show(tab.dataset.draftTab ?? ''));
    }

    // Renaming one should rename its tab as you type, or the tabs and the names
    // disagree until the page is saved and reloaded.
    for (const input of group.querySelectorAll<HTMLInputElement>('[data-draft-name]')) {
      input.addEventListener('input', () => {
        const tab = tabs.find((b) => b.dataset.draftTab === input.dataset.draftName);
        if (tab) tab.textContent = input.value.trim() || (input.placeholder ?? '');
      });
    }
  }
</script>

