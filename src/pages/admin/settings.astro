---
import { env } from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import {
  getSettings,
  PAYMENT_ACCOUNTS,
  COLLECTION_PLACES,
  CASH_SLOT,
  partBodyKey,
  partLabelKey,
} from '../../lib/settings';
import { botConfigured, botUsername, ownerOptInLink } from '../../lib/telegram';
import { emailConfigured, ownerAddress, lastEmailError, fromAddress } from '../../lib/email';
import { recentFailures } from '../../lib/login-throttle';

const [settings, emailError, failedSignIns] = await Promise.all([
  getSettings(),
  lastEmailError(),
  recentFailures(),
]);
const ownerTelegramLink = await ownerOptInLink();
const googleBooksConfigured = Boolean(
  (env as unknown as { GOOGLE_BOOKS_API_KEY?: string }).GOOGLE_BOOKS_API_KEY?.trim(),
);

/* The order discount, as the form needs it: pounds in the box, not pence. */
const discountOn = settings.order_discount_active === '1';
const discountThreshold = settings.order_discount_threshold ?? '';
const discountPercent = settings.order_discount_percent ?? '';
const saved = Astro.url.searchParams.get('saved');
const unbound = Astro.url.searchParams.get('unbound');

/*
 * Whether the bound chat can be shown to be the handle customers are given.
 *
 * A Telegram account need not have a username, and then the label is a display
 * name that proves nothing. That is worth saying out loud rather than implying
 * a check that did not happen.
 */
const boundLabel = (settings.owner_telegram_label ?? '').trim();
const handle = (v: string) => v.trim().replace(/^@/, '').toLowerCase();
const alertsUnverified =
  Boolean(settings.owner_telegram_chat_id) &&
  (!boundLabel.startsWith('@') || handle(boundLabel) !== handle(settings.contact_telegram ?? ''));

const draftGroups = [
  {
    heading: 'How they pay',
    note: 'Your bank accounts, and the wording for cash. On an order you pick one of these - the cash one whenever the order is paid in cash, whether it is posted or collected. Leave a box empty and it will not be offered.',
    slots: [
      ...PAYMENT_ACCOUNTS.map((a) => ({ ...a, cash: false })),
      { slot: CASH_SLOT, label: 'Cash', cash: true },
    ],
  },
  {
    heading: 'Where they collect',
    note: 'Your collection addresses. One of these is added to the message on a collection order, above however they are paying.',
    slots: COLLECTION_PLACES.map((p) => ({ ...p, cash: false })),
  },
];
const SECTIONS = [
  { id: 'messages', group: 'Orders', label: 'Payment wording' },
  { id: 'discount', group: 'Orders', label: 'Order discount' },
  { id: 'contact', group: 'Shop', label: 'Where people reach you' },
  { id: 'alerts', group: 'Shop', label: 'Owner alerts' },
  { id: 'maintenance', group: 'Shop', label: 'Closing the shop' },
  { id: 'security', group: 'Account', label: 'Getting in' },
] as const;

type SectionId = (typeof SECTIONS)[number]['id'];
const asked = Astro.url.searchParams.get('s');
const section = (SECTIONS.find((x) => x.id === asked)?.id ?? 'messages') as SectionId;
const groups = [...new Set(SECTIONS.map((s) => s.group))];
---

<Admin title="Settings">
  {
    saved && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Settings saved.
      </p>
    )
  }
  {
    unbound && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)] leading-relaxed">
        The Telegram handle changed, so owner alerts were disconnected - they were still going to
        the previous chat, which is not something the handle can redirect. Connect the new one
        below to start receiving them again.
      </p>
    )
  }

  {/*
    One section at a time, chosen by ?s= rather than by script.

    It was a single column of eight boxes, so the short ones - a handle, a
    connection status, a button - each took a whole row and the page was mostly
    scrolling past things nobody was changing. A list down the side also says
    what the portal can do, which a long scroll never did.
  */}
  <div class="grid gap-6 lg:grid-cols-[13rem_1fr] items-start">
    <nav aria-label="Settings sections" class="lg:sticky lg:top-[92px]">
      <ul class="space-y-0.5">
        {groups.map((group) => (
          <>
            <li class="eyebrow px-2 pt-3 pb-1">{group}</li>
            {SECTIONS.filter((s) => s.group === group).map((s) => (
              <li>
                <a
                  href={`/admin/settings?s=${s.id}`}
                  aria-current={s.id === section ? 'page' : undefined}
                  class:list={[
                    'block px-3 py-2 rounded-[var(--radius-field)] text-[14px]',
                    s.id === section
                      ? 'bg-[var(--color-wash-soft)] text-[var(--color-navy)] font-medium'
                      : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-paper)]',
                  ]}
                >
                  {s.label}
                </a>
              </li>
            ))}
          </>
        ))}
      </ul>
    </nav>

    <div class="min-w-0 max-w-2xl space-y-5">
      {
        section === 'messages' && (
          <form method="post" action="/api/admin/settings" class="space-y-5">
    <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
        Payment drafts
      </h2>
      <p class="mt-1.5 mb-1 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        The wording you send when you confirm an order. Give each one a short name so you can tell
        them apart, then pick the one you want on the order itself - you can still edit it there
        before it goes. The reference is added automatically.
      </p>

      {draftGroups.map((group) => (
        <div class="mt-5 pt-4 border-t border-[var(--color-rule)]" data-draft-group>
          <h3 class="text-[15px] font-semibold">{group.heading}</h3>
          <p class="mt-1 mb-3 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
            {group.note}
          </p>

          {/* One at a time, switched by these. Stacked, the six boxes were a
              wall of text with no sense of which was which. */}
          <div class="flex flex-wrap gap-2" role="tablist">
            {group.slots.map((slot, i) => (
              <button
                type="button"
                role="tab"
                data-draft-tab={slot.slot}
                aria-selected={i === 0 ? 'true' : 'false'}
                class="px-3.5 py-1.5 text-[13.5px] rounded-[var(--radius-pill)] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-navy)] aria-selected:border-[var(--color-navy)] aria-selected:bg-[var(--color-navy)] aria-selected:text-white"
              >
                {settings[partLabelKey(slot.slot)]?.trim() || slot.label}
              </button>
            ))}
          </div>

          {group.slots.map((slot, i) => (
            <div class="mt-3" data-draft-panel={slot.slot} hidden={i !== 0}>
              <label for={partLabelKey(slot.slot)} class="block text-[13px] text-[var(--color-ink-faint)] mb-1">
                Name for this one
              </label>
              <input
                id={partLabelKey(slot.slot)}
                name={partLabelKey(slot.slot)}
                maxlength="40"
                placeholder={slot.label}
                value={settings[partLabelKey(slot.slot)] ?? ''}
                data-draft-name={slot.slot}
                class="field !py-1.5 !text-[14px] !w-64"
              />
              <label for={partBodyKey(slot.slot)} class="block mt-3 text-[13px] text-[var(--color-ink-faint)] mb-1">
                What it says
              </label>
              <textarea
                id={partBodyKey(slot.slot)}
                name={partBodyKey(slot.slot)}
                rows="8"
                maxlength="4000"
                placeholder={slot.cash
                  ? 'What to tell somebody paying in cash. Where the money changes hands is added for you.'
                  : 'Leave empty if you do not use this one - it will not be offered on an order.'}
                class="field font-[family-name:var(--font-body)]">{settings[partBodyKey(slot.slot)] ?? ''}</textarea
              >
            </div>
          ))}
        </div>
      ))}

    </section>
            <button type="submit" class="btn btn-primary">Save wording</button>
          </form>
        )
      }

      {
        section === 'contact' && (
          <form method="post" action="/api/admin/settings" class="space-y-5">
    <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
        Where people reach you
      </h2>
      <p class="mt-1.5 mb-3 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        Every "Message us on Telegram" link on the site points here, and the bot sends anyone
        asking about anything other than an order here too. Leave it blank and the site falls back
        to the channel.
      </p>
      <label for="contact_telegram" class="block text-[14.5px] font-medium mb-1.5">
        Telegram handle
      </label>
      <input
        id="contact_telegram"
        name="contact_telegram"
        maxlength="80"
        placeholder="@alsubkibooks"
        value={settings.contact_telegram ?? ''}
        class="field !w-64"
      />
    </section>
            <button type="submit" class="btn btn-primary">Save</button>
          </form>
        )
      }

      {/* Outside any form. It used to sit inside the settings form, which is
          invalid HTML - a browser drops the inner form, so "Sign out
          everywhere" was posting the settings instead of signing out. */}
      {
        section === 'discount' && (
          <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
            <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">Order discount</h2>
            <p class="mt-1.5 text-[14px] text-[var(--color-ink-soft)] leading-relaxed max-w-xl">
              A standing reduction on the size of an order. It is not a sale - it runs all the time,
              on top of whatever a sale has already taken off, which is why it lives here rather
              than with the sales.
            </p>

            <label class="mt-5 flex items-start gap-2.5 cursor-pointer select-none">
              <input
                type="checkbox"
                name="order_discount_active"
                value="1"
                checked={discountOn}
                class="w-4 h-4 mt-0.5 accent-[var(--color-navy)]"
              />
              <span>
                <span class="block text-[14.5px] font-medium">Offer it</span>
                <span class="block mt-0.5 text-[13px] text-[var(--color-ink-faint)]">
                  Customers are told how much more to spend before it applies.
                </span>
              </span>
            </label>

            <div class="mt-4 flex flex-wrap items-end gap-3">
              <label class="block">
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                  Once the order reaches
                </span>
                <span class="inline-flex items-center rounded-[var(--radius-field)] border border-[var(--color-rule)] bg-white">
                  <span class="pl-2.5 text-[14px] text-[var(--color-ink-faint)]">£</span>
                  <input
                    type="text"
                    inputmode="decimal"
                    name="order_discount_threshold"
                    value={discountThreshold}
                    placeholder="85.00"
                    class="w-24 bg-transparent border-0 outline-none py-2 pl-1 pr-2.5 text-[14px] tabular-nums"
                  />
                </span>
              </label>

              <label class="block">
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">Take off</span>
                <span class="inline-flex items-center rounded-[var(--radius-field)] border border-[var(--color-rule)] bg-white">
                  <input
                    type="number"
                    min="1"
                    max="90"
                    name="order_discount_percent"
                    value={discountPercent}
                    placeholder="10"
                    class="w-16 bg-transparent border-0 outline-none py-2 px-2.5 text-[14px] tabular-nums text-right"
                  />
                  <span class="pr-2.5 text-[14px] text-[var(--color-ink-faint)]">%</span>
                </span>
              </label>
            </div>

            {/* Exactly the sentence a customer will read, so the owner can see
                what they are turning on rather than infer it. */}
            <div class="mt-5 pt-4 border-t border-[var(--color-rule-faint)]">
              <p class="eyebrow mb-1.5">What a customer sees</p>
              <p class="text-[14px] text-[var(--color-ink-soft)] leading-relaxed">
                {discountOn && Number(discountPercent) > 0 ? (
                  <>
                    Below it: <em>"Spend £12 more and {discountPercent}% comes off the whole order."</em>
                    <br />
                    Once they reach it: <em>"{discountPercent}% off orders over £{discountThreshold}"</em>{' '}
                    as its own line in the basket.
                  </>
                ) : (
                  <span class="text-[var(--color-ink-faint)]">Nothing - it is switched off.</span>
                )}
              </p>
            </div>
          </section>
        )
      }

      {section === 'security' && (
    <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">Getting in</h2>
      <p class="mt-1.5 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        Five wrong passwords from one place and it stops taking guesses from there for fifteen
        minutes.
      </p>

      <dl class="mt-3 space-y-2 text-[14.5px]">
        <div class="flex justify-between gap-4">
          <dt class="text-[var(--color-ink-soft)]">Failed sign-ins, last 24 hours</dt>
          <dd
            class:list={[
              'text-right tabular-nums',
              failedSignIns.count > 20 ? 'text-[var(--color-outstock)] font-medium' : '',
            ]}
          >
            {failedSignIns.count}
            {failedSignIns.lastAt && (
              <span class="block text-[13px] text-[var(--color-ink-faint)]">
                last {new Date(failedSignIns.lastAt * 1000).toLocaleString('en-GB')}
              </span>
            )}
          </dd>
        </div>
      </dl>

      <form method="post" action="/api/admin/sign-out-everywhere" class="mt-4 pt-3 border-t border-[var(--color-rule)]">
        <button type="submit" class="btn btn-ghost !py-1.5 !text-[13.5px]">
          Sign out everywhere
        </button>
        <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
          Ends every signed-in session, including this one. Use it if the password has been shared,
          or a device was left signed in somewhere.
        </p>
      </form>
    </section>
      )}

      {
        section === 'maintenance' && (
          <form method="post" action="/api/admin/settings" class="space-y-5">
            <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
              <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
                Closing the shop
              </h2>
              <p class="mt-1.5 mb-3 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
                Write something here and the shop closes to customers with that message. Leave it
                empty and it opens again. <strong>This portal stays open either way</strong>, and so
                does every customer's own order page - somebody waiting on books they have paid for
                should not hit a wall because the shop is being worked on.
              </p>
              <label for="maintenance" class="block text-[14.5px] font-medium mb-1.5">
                What customers see
              </label>
              <textarea
                id="maintenance"
                name="maintenance"
                rows="3"
                maxlength="400"
                placeholder="e.g. We are updating the catalogue this morning and will be back by midday, in shā Allāh."
                class="field font-[family-name:var(--font-body)]">{settings.maintenance ?? ''}</textarea
              >
            </section>
            <button type="submit" class="btn btn-primary">Save</button>
          </form>
        )
      }

      {section === 'alerts' && (
  <section class="mt-8 max-w-2xl bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
    <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">Connections</h2>
    <dl class="mt-4 space-y-3 text-[14.5px]">
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Customer email</dt>
        <dd
          class:list={[
            'text-right max-w-[60%]',
            emailConfigured() && !emailError
              ? 'text-[var(--color-instock)]'
              : 'text-[var(--color-outstock)]',
          ]}
        >
          {!emailConfigured()
            ? 'Not configured'
            : emailError
              ? `Failing as ${fromAddress()} - ${emailError}`
              : `Sending · orders go to ${ownerAddress()}`}
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Owner Telegram alerts</dt>
        <dd class="text-right max-w-[60%]">
          {settings.owner_telegram_chat_id ? (
            <>
              <span class="text-[var(--color-instock)]">
                Connected{boundLabel ? ` · ${boundLabel}` : ''}
              </span>
              {/* Without this, recovering from a wrong chat being bound needed
                  direct database access. */}
              <form method="post" action="/api/admin/settings/unbind-telegram" class="inline">
                <button
                  type="submit"
                  class="ml-3 text-[13.5px] text-[var(--color-outstock)] underline underline-offset-2"
                >
                  Disconnect
                </button>
              </form>
              {alertsUnverified && ownerTelegramLink && (
                <span class="block mt-1 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
                  We cannot confirm this is {settings.contact_telegram || 'the contact handle'} -
                  alerts go to whichever chat pressed Start, not to a handle.{' '}
                  <a href={ownerTelegramLink} class="text-[var(--color-navy)] underline">
                    Reconnect
                  </a>{' '}
                  from the right account if this is wrong.
                </span>
              )}
            </>
          ) : ownerTelegramLink ? (
            <a href={ownerTelegramLink} class="text-[var(--color-navy)] underline">Connect this chat</a>
          ) : (
            'Set ADMIN_SESSION_SECRET first'
          )}
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Telegram bot</dt>
        <dd class:list={[botConfigured() ? 'text-[var(--color-instock)]' : 'text-[var(--color-outstock)]']}>
          {botConfigured() ? `Connected${botUsername() ? ` · @${botUsername()}` : ''}` : 'Not configured'}
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Google Books covers</dt>
        <dd class:list={[googleBooksConfigured ? 'text-[var(--color-instock)]' : 'text-[var(--color-outstock)]']}>
          {googleBooksConfigured ? 'Connected · second cover source' : 'Not configured · Open Library only'}
        </dd>
      </div>
    </dl>
  </section>
      )}
    </div>
  </div>
</Admin>

{/* The tabs above are inert markup without this. It was lost once already,
    when a `<script>` block at the foot of this page went during the CSP work
    and left the buttons rendering and doing nothing. */}
<script>
  import '../../scripts/draft-tabs.ts';
</script>
