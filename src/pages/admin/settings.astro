---
import Admin from '../../layouts/Admin.astro';
import { getSettings } from '../../lib/settings';
import { botConfigured, botUsername, ownerOptInLink } from '../../lib/telegram';
import { emailConfigured, ownerAddress, lastEmailError, fromAddress } from '../../lib/email';

const [settings, emailError] = await Promise.all([getSettings(), lastEmailError()]);
const ownerTelegramLink = await ownerOptInLink();
const saved = Astro.url.searchParams.get('saved');
---

<Admin title="Settings">
  {
    saved && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Settings saved.
      </p>
    )
  }

  <form method="post" action="/api/admin/settings" class="space-y-5 max-w-2xl">
    <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
        How customers pay
      </h2>
      <p class="mt-1.5 mb-3 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        The starting text when you confirm an order. You can change it for each order before it
        goes - useful when a different account suits a different order. The reference is added
        automatically.
      </p>
      <label for="payment_instructions" class="sr-only">Payment instructions</label>
      <textarea
        id="payment_instructions"
        name="payment_instructions"
        rows="10"
        maxlength="4000"
        class="field font-[family-name:var(--font-body)]">{settings.payment_instructions ?? ''}</textarea
      >
    </section>

    <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">Postage</h2>
      <p class="mt-1.5 mb-3 text-[14.5px] text-[var(--color-ink-soft)]">
        Filled in for you when confirming an order. You can change it per order.
      </p>
      <label for="default_postage" class="block text-[14.5px] font-medium mb-1.5">
        Usual postage (£)
      </label>
      <input
        id="default_postage"
        name="default_postage"
        type="number"
        step="0.01"
        min="0"
        value={((Number(settings.default_postage_pence ?? '0') || 0) / 100).toFixed(2)}
        class="field !w-32 tabular-nums"
      />
    </section>

    <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">Collection</h2>
      <p class="mt-1.5 mb-3 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        Where collection customers should come. Sent to them once you mark their payment received,
        and shown on their order page.
      </p>
      <label for="collection_address" class="sr-only">Collection address</label>
      <textarea
        id="collection_address"
        name="collection_address"
        rows="3"
        maxlength="300"
        placeholder="e.g. 12 Evington Road, Leicester LE2 1HN - Saturdays 10am to 4pm"
        class="field font-[family-name:var(--font-body)]">{settings.collection_address ?? ''}</textarea
      >
    </section>

    <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
      <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
        Who the bot points people to
      </h2>
      <p class="mt-1.5 mb-3 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
        The bot does not answer general questions. Anyone who messages it is sent here instead.
        Leave blank and it will just say the shop will be in touch.
      </p>
      <label for="contact_telegram" class="block text-[14.5px] font-medium mb-1.5">
        Telegram handle
      </label>
      <input
        id="contact_telegram"
        name="contact_telegram"
        maxlength="80"
        placeholder="@alsubkibooks"
        value={settings.contact_telegram ?? ''}
        class="field !w-64"
      />
    </section>

    <button type="submit" class="btn btn-primary">Save settings</button>
  </form>

  <!-- Read-only: these are secrets, set from the command line, not the browser. -->
  <section class="mt-8 max-w-2xl bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
    <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">Connections</h2>
    <dl class="mt-4 space-y-3 text-[14.5px]">
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Customer email</dt>
        <dd
          class:list={[
            'text-right max-w-[60%]',
            emailConfigured() && !emailError
              ? 'text-[var(--color-instock)]'
              : 'text-[var(--color-outstock)]',
          ]}
        >
          {!emailConfigured()
            ? 'Not configured'
            : emailError
              ? `Failing as ${fromAddress()} - ${emailError}`
              : `Sending · orders go to ${ownerAddress()}`}
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Owner Telegram alerts</dt>
        <dd class="text-right max-w-[60%]">
          {settings.owner_telegram_chat_id ? (
            <>
              <span class="text-[var(--color-instock)]">Connected</span>
              {/* Without this, recovering from a wrong chat being bound needed
                  direct database access. */}
              <form method="post" action="/api/admin/settings/unbind-telegram" class="inline">
                <button
                  type="submit"
                  class="ml-3 text-[13.5px] text-[var(--color-outstock)] underline underline-offset-2"
                >
                  Disconnect
                </button>
              </form>
            </>
          ) : ownerTelegramLink ? (
            <a href={ownerTelegramLink} class="text-[var(--color-navy)] underline">Connect this chat</a>
          ) : (
            'Set ADMIN_SESSION_SECRET first'
          )}
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--color-ink-soft)]">Telegram bot</dt>
        <dd class:list={[botConfigured() ? 'text-[var(--color-instock)]' : 'text-[var(--color-outstock)]']}>
          {botConfigured() ? `Connected${botUsername() ? ` · @${botUsername()}` : ''}` : 'Not configured'}
        </dd>
      </div>
    </dl>
  </section>
</Admin>
