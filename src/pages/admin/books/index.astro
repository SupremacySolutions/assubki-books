---
import Admin from '../../../layouts/Admin.astro';
import Dialog from '../../../components/Dialog.astro';
import {
  listBooksAdmin,
  bookFilterCounts,
  type BookFilter,
  type BookSort,
} from '../../../lib/admin-db';
import { price, imageUrl, buildQuery } from '../../../lib/format';

const params = Astro.url.searchParams;
const q = params.get('q')?.trim() || null;
const filter = (params.get('filter') ?? 'all') as BookFilter;
const sort = (params.get('sort') ?? 'recent') as BookSort;
const perPage = Number.parseInt(params.get('per') ?? '40', 10) || 40;
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);

const [result, counts] = await Promise.all([
  listBooksAdmin({ q, filter, sort, page, perPage }),
  bookFilterCounts(),
]);

const saved = params.get('saved');
const deleted = params.get('deleted');
const deletedOrphan = params.get('deleted-orphan');

// The filters double as a worklist: each one is a job the import left behind,
// and the count is how much of it is left.
const FILTERS: { key: BookFilter; label: string }[] = [
  { key: 'all', label: 'All' },
  { key: 'no-photo', label: 'No photo' },
  { key: 'thin-photo', label: 'Photo too small' },
  // Not jobs like the rest of this list, but the same question asked of the
  // catalogue: which of these am I looking at.
  { key: 'english', label: 'English' },
  { key: 'arabic', label: 'Arabic' },
  { key: 'urdu', label: 'Urdu' },
  { key: 'no-description', label: 'No description' },
  { key: 'no-subject', label: 'No subject' },
  { key: 'not-announced', label: 'Not announced' },
  { key: 'out-of-stock', label: 'Out of stock' },
  { key: 'low-stock', label: 'Low stock' },
  { key: 'draft', label: 'Drafts' },
  { key: 'archived', label: 'Archived' },
];

const SORTS: { key: BookSort; label: string }[] = [
  { key: 'recent', label: 'Recently edited' },
  { key: 'title', label: 'Title A-Z' },
  { key: 'stock-asc', label: 'Lowest stock first' },
  { key: 'cover-worst', label: 'Poorest cover first' },
  { key: 'price-asc', label: 'Price low to high' },
  { key: 'price-desc', label: 'Price high to low' },
];

const base = { q, filter: filter === 'all' ? null : filter, sort: sort === 'recent' ? null : sort, per: perPage === 40 ? null : perPage };
const pageUrl = (n: number) => `/admin/books${buildQuery(base, { page: n > 1 ? n : null })}`;
const filterUrl = (f: BookFilter) =>
  `/admin/books${buildQuery({ q, sort: sort === 'recent' ? null : sort, per: perPage === 40 ? null : perPage }, { filter: f === 'all' ? null : f })}`;

const from = result.total === 0 ? 0 : (result.page - 1) * result.perPage + 1;
const to = Math.min(result.page * result.perPage, result.total);

// A compact window around the current page - 226 listings at 40 a page is only
// six, but this keeps the row sane if the catalogue grows.
const windowed = () => {
  const span = 2;
  const pages: (number | '…')[] = [];
  let last = 0;
  for (let n = 1; n <= result.pages; n++) {
    const near = Math.abs(n - result.page) <= span;
    if (n === 1 || n === result.pages || near) {
      if (last && n - last > 1) pages.push('…');
      pages.push(n);
      last = n;
    }
  }
  return pages;
};
---

<Admin
  title="Listings"
  sub={result.total === 0 ? 'nothing matches' : `${from}-${to} of ${result.total}`}
>
  {
    saved && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Listing saved.
      </p>
    )
  }
  {
    deleted && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Deleted “{deleted}”.
      </p>
    )
  }
  {
    deletedOrphan && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        Deleted “{deletedOrphan}”, but its Telegram post could not be removed - a bot can only
        delete its own posts, and only within 48 hours. Remove that one in the channel by hand.
      </p>
    )
  }

  <div class="flex flex-wrap gap-3 items-center mb-4">
    <form method="get" class="flex gap-2 flex-1 min-w-[240px]">
      {filter !== 'all' && <input type="hidden" name="filter" value={filter} />}
      {sort !== 'recent' && <input type="hidden" name="sort" value={sort} />}
      <label for="q" class="sr-only">Search listings</label>
      <input
        id="q"
        name="q"
        type="search"
        value={q ?? ''}
        placeholder="Search title, Arabic title or slug"
        class="field"
      />
      <button type="submit" class="btn btn-ghost">Search</button>
    </form>
    <a href="/admin/books/new" class="btn btn-primary">Add a listing</a>
  </div>

  <nav class="flex flex-wrap gap-1.5 mb-4" aria-label="Filter listings">
    {
      FILTERS.map((f) => {
        const n = counts[f.key] ?? 0;
        // Hide a filter that would only ever show an empty list.
        if (f.key !== 'all' && n === 0 && filter !== f.key) return null;
        return (
          <a
            href={filterUrl(f.key)}
            class:list={[
              'px-3.5 py-1.5 rounded-[var(--radius-pill)] text-[13.5px] border transition-colors',
              filter === f.key
                ? 'bg-[var(--color-navy)] text-white border-[var(--color-navy)]'
                : 'bg-white border-[var(--color-rule-soft)] text-[var(--color-ink-soft)] hover:border-[var(--color-navy)]',
            ]}
          >
            {f.label}
            {f.key !== 'all' && <span class="tabular-nums"> ({n})</span>}
          </a>
        );
      })
    }
  </nav>

  <form method="get" class="flex flex-wrap items-center gap-3 mb-5 pb-4 border-b border-[var(--color-rule)]">
    {q && <input type="hidden" name="q" value={q} />}
    {filter !== 'all' && <input type="hidden" name="filter" value={filter} />}
    <label class="flex items-center gap-2 text-[14px] text-[var(--color-ink-soft)]">
      Sort
      <select name="sort" data-autosubmit class="field !py-1.5 !w-auto !text-[14px]">
        {SORTS.map((s) => <option value={s.key} selected={sort === s.key}>{s.label}</option>)}
      </select>
    </label>
    <label class="flex items-center gap-2 text-[14px] text-[var(--color-ink-soft)]">
      Show
      <select name="per" data-autosubmit class="field !py-1.5 !w-auto !text-[14px]">
        {[20, 40, 80, 200].map((n) => <option value={n} selected={perPage === n}>{n}</option>)}
      </select>
    </label>
    {
      (q || filter !== 'all' || sort !== 'recent') && (
        <a href="/admin/books" class="text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2 ml-auto">
          Clear
        </a>
      )
    }
  </form>

  {
    result.books.length === 0 ? (
      <p class="p-5 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] text-[15px] text-[var(--color-ink-soft)]">
        Nothing matches that. <a href="/admin/books" class="text-[var(--color-navy)] underline underline-offset-2">Show everything</a>.
      </p>
    ) : (
      <ul class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] divide-y divide-[var(--color-rule-faint)]">
        {result.books.map((b) => (
          <li class="flex items-center gap-3 p-3">
            <a
              href={`/admin/books/${b.id}`}
              class="shrink-0 w-11 h-14 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[2px] grid place-items-center overflow-hidden"
            >
              {b.image_key ? (
                <img src={imageUrl(b.image_key, 'thumb')} alt="" class="max-h-full max-w-full object-contain" loading="lazy" />
              ) : (
                <span class="text-[10px] text-[var(--color-ink-faint)] text-center leading-tight px-0.5">
                  no photo
                </span>
              )}
            </a>

            <div class="min-w-0 flex-1">
              <a href={`/admin/books/${b.id}`} class="text-[15px] font-medium hover:text-[var(--color-navy)] block truncate">
                {b.title}
              </a>
              <p class="text-[13px] text-[var(--color-ink-faint)] flex flex-wrap gap-x-2">
                <span class="price !text-[13px]">{price(b.price_pence)}</span>
                {b.reserved > 0 && <span>{b.reserved} reserved</span>}
                {/*
                  * How much real detail the cover has across, against the 600
                  * the card asks for. Shown only when it falls short, and in
                  * red only when the card is enlarging it more than twice -
                  * the point past which no processing puts back what the
                  * photograph never had.
                  */}
                {b.usable_width !== null && b.usable_width < 600 && (
                  <span class:list={[b.usable_width < 300 ? 'text-[var(--color-outstock)]' : '']}>
                    cover {b.usable_width}px of 600
                  </span>
                )}
                {!b.has_description && <span class="text-[var(--color-outstock)]">no description</span>}
                {b.cat_count === 0 && <span class="text-[var(--color-outstock)]">no subject</span>}
                {b.status !== 'live' && <span class="text-[var(--color-outstock)]">{b.status}</span>}
                {!b.telegram_message_id && <span>not announced</span>}
              </p>
            </div>

            <form method="post" action="/api/admin/books/stock" class="flex items-center gap-1.5 shrink-0">
              <input type="hidden" name="id" value={b.id} />
              <label for={`s${b.id}`} class="sr-only">Stock for {b.title}</label>
              <input
                id={`s${b.id}`}
                name="stock"
                type="number"
                min={b.reserved}
                value={b.stock}
                class="field !w-16 !py-1.5 !px-2 tabular-nums text-center"
              />
              <button type="submit" class="btn btn-ghost !py-1.5 !px-2.5 !text-[13px]">Save</button>
            </form>

            {/*
              * Deleting used to mean opening the listing, scrolling to the
              * bottom of the editor and coming back - three pages to clear one
              * mistaken import. The row itself is where the owner decides.
              *
              * Copies promised to an open order cannot go: the endpoint
              * refuses them, so the button says so here rather than sending
              * the owner off to a redirect that looks like a failure.
              */}
            <button
              type="button"
              data-delete-book={b.id}
              data-title={b.title}
              disabled={b.reserved > 0}
              aria-label={`Delete ${b.title}`}
              title={
                b.reserved > 0
                  ? `${b.reserved} reserved by an open order, so this cannot be deleted yet`
                  : `Delete ${b.title}`
              }
              class="shrink-0 p-2 rounded-[3px] text-[var(--color-ink-faint)] hover:text-[var(--color-outstock)] hover:bg-[var(--color-outstock)]/10 disabled:opacity-30 disabled:hover:text-[var(--color-ink-faint)] disabled:hover:bg-transparent disabled:cursor-not-allowed cursor-pointer transition-colors"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" />
                <path d="M10 11v5M14 11v5" />
              </svg>
            </button>
          </li>
        ))}
      </ul>
    )
  }

  {
    result.pages > 1 && (
      <nav class="mt-6 flex flex-wrap items-center justify-center gap-1.5" aria-label="Pages">
        <a
          href={pageUrl(result.page - 1)}
          class:list={[
            'px-3 py-1.5 rounded-sm text-[14px] border',
            result.page > 1
              ? 'bg-white border-[var(--color-rule)] hover:border-[var(--color-navy)]'
              : 'border-transparent text-[var(--color-ink-faint)] pointer-events-none',
          ]}
          aria-disabled={result.page === 1}
        >
          ← Prev
        </a>

        {windowed().map((n) =>
          n === '…' ? (
            <span class="px-1.5 text-[var(--color-ink-faint)]">…</span>
          ) : (
            <a
              href={pageUrl(n)}
              aria-current={n === result.page ? 'page' : undefined}
              class:list={[
                'min-w-[34px] text-center px-2.5 py-1.5 rounded-sm text-[14px] border tabular-nums',
                n === result.page
                  ? 'bg-[var(--color-navy)] text-white border-[var(--color-navy)] font-medium'
                  : 'bg-white border-[var(--color-rule)] hover:border-[var(--color-navy)]',
              ]}
            >
              {n}
            </a>
          ),
        )}

        <a
          href={pageUrl(result.page + 1)}
          class:list={[
            'px-3 py-1.5 rounded-sm text-[14px] border',
            result.page < result.pages
              ? 'bg-white border-[var(--color-rule)] hover:border-[var(--color-navy)]'
              : 'border-transparent text-[var(--color-ink-faint)] pointer-events-none',
          ]}
          aria-disabled={result.page === result.pages}
        >
          Next →
        </a>
      </nav>
    )
  }

  {/*
    * One dialog for the whole list, not one per row: at 200 a page that would
    * be 200 copies of the same markup. The bin that was clicked fills in the
    * title and points the form at its own listing.
    */}
  <Dialog id="deleteBook" title="Delete this listing?">
    <p class="text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
      <strong id="deleteBookTitle" class="text-[var(--color-ink)]"></strong> goes for good, with
      any photos you uploaded and its post in the channel. Past orders keep their record of it.
    </p>
    <p class="mt-2 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
      To hide it without losing it, open the listing and set Visibility to Archived instead.
    </p>
    <form id="deleteBookForm" method="post" class="mt-4 flex gap-2 justify-end">
      <button type="button" data-dialog-close class="btn btn-ghost !py-2">Keep it</button>
      <button
        type="submit"
        class="btn btn-ghost !py-2 !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40"
      >
        Delete listing
      </button>
    </form>
  </Dialog>

  <script>
    /*
     * The confirmation is the site's own dialog rather than `confirm()`, which
     * cannot show the title in the shop's type, cannot be dismissed by the
     * backdrop, and reads as a browser warning rather than a decision the
     * owner is making about their own catalogue.
     */
    const dialog = document.querySelector<HTMLDialogElement>('#deleteBook');
    const form = document.querySelector<HTMLFormElement>('#deleteBookForm');
    const name = document.querySelector<HTMLElement>('#deleteBookTitle');

    for (const bin of document.querySelectorAll<HTMLButtonElement>('[data-delete-book]')) {
      bin.addEventListener('click', () => {
        if (!dialog || !form) return;
        form.action = `/api/admin/books/${bin.dataset.deleteBook}/delete`;
        // textContent, not innerHTML: a title is the supplier's text and may
        // carry anything.
        if (name) name.textContent = `\u201C${bin.dataset.title ?? 'This listing'}\u201D`;
        dialog.showModal();
      });
    }

    // A slow delete is still a delete. Without this a second click posts the
    // same listing twice, and the second one 302s to an empty page.
    form?.addEventListener('submit', () => {
      for (const button of form.querySelectorAll('button')) button.disabled = true;
    });
  </script>
</Admin>
