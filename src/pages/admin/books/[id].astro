            </p>
          </section>
        )
      }

      {
        book && (
          <>
      {/* The delivery has landed. Green rule: this is the finishing of
          something, not a warning. */}
      {book && book.incoming > 0 && (
        <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] border-l-[3px] border-l-[var(--color-instock)] p-5">
          <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
            Has this delivery arrived?
          </h2>
          <p class="mt-1.5 text-[14px] text-[var(--color-ink-soft)] leading-relaxed">
            {book.incoming} expected
            {whenText(book.incoming_vague, book.incoming_month)
              ? `, ${whenText(book.incoming_vague, book.incoming_month)}`
              : ''}
            {book.reserved_incoming > 0
              ? ` · ${book.reserved_incoming} already reserved by customers`
              : ' · none reserved yet'}
          </p>

          <div class="mt-4 flex items-end gap-2">
            <label class="block">
              <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">How many arrived</span>
              <input
                name="arrived"
                type="number"
                min="1"
                max="999"
                value={book.incoming}
                form="arrivedForm"
                class="field !w-40 tabular-nums"
              />
            </label>
            <button type="submit" form="arrivedForm" class="btn btn-primary !py-2 !text-[14px]">
              Release the reservations
            </button>
          </div>

          <p class="mt-2.5 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
            Those copies go on the shelf and the reservations against them become ordinary orders,
            oldest first. If fewer arrive than were claimed, the rest stay reserved and wait for the
            next delivery - they are never cancelled.
          </p>
        </section>
      )}

          <section id="s-parts" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24">
            <h2 class="eyebrow mb-3">Sold in parts</h2>
            {siblings.length > 0 ? (
              <>
                <div class="flex items-center gap-2.5 mb-3">
                  <span class="rounded-[var(--radius-pill)] bg-[var(--color-navy)]/10 px-3 py-1 text-[12.5px] font-medium text-[var(--color-navy)]">
                    {siblings.length} {siblings.length === 1 ? 'part' : 'parts'} live
                  </span>
                  <span class="text-[13px] text-[var(--color-ink-faint)]">
                    {book.volumes} volumes altogether
                  </span>
                </div>

                <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed mb-3">
                  Each of these is its own listing with its own price and cover. The shelf count is
                  shared between them.
                </p>

                <ul class="space-y-1.5 mb-4">
                  {siblings.map((o) => (
                    <li class="flex items-baseline justify-between gap-3 text-[13.5px]">
                      <a
                        href={`/admin/books/${o.id}`}
                        class:list={[
                          'truncate',
                          o.id === book.id ? 'font-medium' : 'text-[var(--color-navy)] underline underline-offset-2',
                        ]}
                      >
                        {o.set_from === o.set_to ? `Volume ${o.set_from}` : `Volumes ${o.set_from}-${o.set_to}`}
                        {o.id === book.id ? ' (this one)' : ''}
                      </a>
                      <span class="text-[var(--color-ink-faint)] shrink-0 tabular-nums">
                        {o.available} left
                      </span>
                    </li>
                  ))}
                </ul>

                <div class="bg-[var(--color-paper-raised)] border border-[var(--color-rule-soft)] rounded-[10px] p-4">
                  <p class="text-[13px] font-medium mb-2">A delivery has come in</p>
                  <div class="flex items-end gap-2">
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Complete sets on the shelf
                      </span>
                      <input
                        type="number"
                        name="sets"
                        min="0"
                        max="999"
