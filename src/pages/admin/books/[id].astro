      )}

      {/*
        * One Save for the whole page, wizard or not.
        *
        * `Continue` is a plain button that changes which panel is on screen -
        * it never submits, and it never navigates, so the unsaved-changes
        * warning is untouched. The submit is the same single button it always
        * was; on the first pass it simply waits until the last step, and with
        * scripting off it is the only control here.
        */}
      <div
        class="sticky bottom-0 -mx-1 px-1 pb-1 pt-3 bg-gradient-to-t from-[var(--color-paper-raised)] via-[var(--color-paper-raised)] to-transparent"
        style={isNew ? 'order:9' : undefined}
      >
        <div class="flex flex-wrap items-center gap-3 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] shadow-[var(--shadow-panel)] px-4 py-3">
          {isNew && (
            <button
              type="button"
              id="stepBack"
              hidden
              class="btn btn-ghost !py-2.5 !text-[14px]"
            >Back</button>
          )}
          <p id="saveHint" class="text-[13px] text-[var(--color-ink-faint)]">
            {isNew ? 'Nothing saved yet.' : 'No unsaved changes.'}
          </p>
          {isNew && (
            <button
              type="button"
              id="stepNext"
              hidden
              class="ml-auto btn btn-primary !py-2.5"
            >Continue</button>
          )}
          <button
            type="submit"
            id="saveBtn"
            class:list={['btn btn-primary !py-2.5', isNew ? 'ml-auto' : 'ml-auto']}
          >
            {isNew ? 'Create listing' : 'Save changes'}
          </button>
        </div>
      </div>
    </div>
  </form>

  {/* Outside the main form: forms cannot nest, so the sidebar buttons reach
      these through their `form` attribute instead. */}
  {
    book && (
      <>
        <form id="telegramForm" method="post" action={`/api/admin/books/${book.id}/telegram`} />
        {/* It said nothing about what it wanted, so the endpoint answered "That
            form did not say what it wanted to do" and the count never moved. */}
        <form id="restockForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="restock" />
        </form>
        <form id="partsForm" method="post" action={`/api/admin/books/${book.id}/set`} />
        <form id="adoptForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="adopt" />
        </form>
        <form id="partsForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="parts" />
        </form>
        <form id="unsplitForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="unsplit" />
        </form>
        <form id="deleteForm" method="post" action={`/api/admin/books/${book.id}/delete`} />
      </>
    )
  }

  {
    book && (
      <script is:inline nonce={Astro.locals.cspNonce} define:vars={{ bookId: book.id, bookTitle: book.title, bookAuthor: book.author ?? '' }}>
        // ------------------------------------------------------------------
        // Save and post are ordered, not parallel. Posting sends whatever is
        // in the database, so offering it while the form has unsaved edits
        // would announce the old version of a listing the owner has just
        // changed. Save is offered only when there is something to save;
        // posting only once there is nothing outstanding.
        // ------------------------------------------------------------------
        /*
         * Sold in parts: the builder.
         *
         * A half-filled part is refused, never guessed at. Filling in a missing
         * price or inferring a range would put a listing on the shop front at a
         * number nobody chose. The server refuses it too - this only saves the
         * round trip, and says what is wrong on the part that has it, which a
         * redirect with ?e=parts cannot.
         *
         * The rest is help the form works without: the name filled in from the
         * volumes, parts added one at a time instead of eight rows at once, two
         * shortcuts, and a preview of what the shop will list worked out from
         * the owner's own numbers rather than a made-up example.
         */
        (() => {
          const builder = document.querySelector('[data-parts-builder]');
          const partsForm = document.querySelector('#partsForm');
          const partsError = document.querySelector('#partsError');
          const buildBtn = document.querySelector('#buildParts');
          if (!builder || !partsForm || !partsError || !buildBtn) return;

          const KEYS = ['from', 'to', 'name', 'price'];
          const DRAWN = 24;
          const ERR = '!border-[var(--color-outstock)]';
          const BIG = 'w-[26px] h-[38px] rounded-[3px] bg-[var(--color-navy)] text-white text-[12px] font-semibold tabular-nums flex items-end justify-center pb-1';
          const MINI = 'w-3.5 h-[22px] rounded-[2px] border';
          const ON = 'bg-[var(--color-navy)] border-[var(--color-navy)]';
          const OFF = 'bg-white border-[var(--color-rule)]';
          const INFO = '<svg class="shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 7.2v4M8 4.8v.01"/></svg>';

          const volumesEl = builder.querySelector('[name="volumes"][form="partsForm"]');
          const setsEl = builder.querySelector('[name="sets"][form="partsForm"]');
          const cards = [...builder.querySelectorAll('[data-part]')];
          const addBtn = builder.querySelector('[data-part-add]');
          const setPrice = Number(builder.dataset.setPrice) || 0;
          /* Set once the owner presses the button: from then on a part that is
             only unfinished says so too, not just one that is wrong. */
          let tried = false;

          const input = (card, k) => card.querySelector('[name$="_' + k + '"]');
          const money = (pence) => '£' + (pence / 100).toFixed(2);
          const span = (from, to) => (from === to ? 'Volume ' + from : 'Volumes ' + from + '-' + to);
          const runs = (list) => {
            const out = [];
            for (const n of list) {
              const last = out.at(-1);
              if (last && last[1] === n - 1) last[1] = n;
              else out.push([n, n]);
            }
            return out.map(([a, b]) => (a === b ? String(a) : a + '-' + b)).join(', ');
          };
          const el = (tag, cls, text) => {
            const node = document.createElement(tag);
            if (cls) node.className = cls;
            if (text !== undefined) node.textContent = text;
            return node;
          };

          function total() {
            const n = Number.parseInt(volumesEl.value, 10);
            return n >= 2 && n <= 200 ? n : 0;
          }
          function sets() {
            return Math.max(0, Math.min(999, Number.parseInt(setsEl.value, 10) || 0));
          }
          function range(card) {
            const from = Number.parseInt(input(card, 'from').value, 10);
            const to = Number.parseInt(input(card, 'to').value, 10);
            return from >= 1 && to >= from ? { from, to } : null;
          }

          /* What one part says, or what is wrong with it. `quiet` is only
             "not filled in yet": shown once the owner moves on from that part
             or presses the button, never while they are halfway through it. */
          function read(card, vols) {
            const v = {};
            for (const k of KEYS) v[k] = input(card, k).value.trim();
            if (!KEYS.some((k) => v[k])) return { blank: true, bad: [] };
            const from = Number.parseInt(v.from, 10);
            const to = Number.parseInt(v.to, 10);
            if (v.from && v.to) {
              if (!(from >= 1)) return { error: 'A part starts at volume 1 or later.', bad: ['from'] };
              if (!(to >= from)) {
                return { error: '“To volume” is lower than “From volume”. Put the lower number first.', bad: ['from', 'to'] };
              }
              if (vols && to > vols) {
                return { error: 'This set has ' + vols + ' volumes, so a part cannot go up to volume ' + to + '.', bad: ['to'] };
              }
            }
            const missing = KEYS.filter((k) => !v[k]);
            if (missing.length) {
              const words = { from: 'the first volume', to: 'the last volume', name: 'a name', price: 'a price' };
              const said = missing.map((k) => words[k]);
              const list = said.length > 1 ? said.slice(0, -1).join(', ') + ' and ' + said.at(-1) : said[0];
              return { error: 'Add ' + list + ', or remove this part. Nothing is guessed.', bad: missing, quiet: true };
            }
            const pence = Math.round(Number(v.price.replace(/[^0-9.]/g, '')) * 100);
            if (!Number.isFinite(pence) || pence < 0) {
              return { error: 'Write the price as a number, like 17.00.', bad: ['price'] };
            }
            return { ok: true, from, to, pence, name: v.name, bad: [] };
          }

          function spines(holder, count, paintOne) {
            while (holder.childElementCount > count) holder.lastElementChild.remove();
            while (holder.childElementCount < count) holder.append(document.createElement('span'));
            [...holder.children].forEach((node, i) => paintOne(node, i + 1));
          }

          function listing(name, tag, vols, cost, have) {
            const row = el('div', 'grid grid-cols-[minmax(0,1fr)_4.5rem_4.5rem] sm:grid-cols-[minmax(0,1fr)_4.5rem_5rem_4.5rem] gap-3 items-center px-4 py-3 border-t border-[var(--color-rule-faint)] text-[14px]');
            const who = el('span', 'flex items-center gap-2 min-w-0 flex-wrap');
            who.append(
              el('span', 'font-medium truncate', name),
              el('span', tag === 'New'
                ? 'rounded-[var(--radius-pill)] px-2 py-0.5 text-[11.5px] bg-[var(--color-instock)]/10 text-[var(--color-instock)]'
                : 'rounded-[var(--radius-pill)] px-2 py-0.5 text-[11.5px] bg-[var(--color-wash-soft)] text-[var(--color-navy)]', tag),
            );
            row.append(
              who,
              el('span', 'hidden sm:block tabular-nums text-[var(--color-ink-soft)]', vols),
              el('span', 'text-right tabular-nums font-semibold', cost),
              el('span', 'text-right tabular-nums text-[var(--color-ink-soft)]', String(have)),
            );
            return row;
          }

          function note(text) {
            const p = el('p', 'flex items-start gap-2 text-[13px] leading-relaxed text-[var(--color-ink-soft)]');
            p.innerHTML = INFO;
            p.append(el('span', '', text));
            return p;
          }

          /* Everything on screen, from the fields. Returns whether the parts
             can be built as they stand. */
          function paint() {
            const vols = total();
            const have = sets();
            const shown = cards.filter((c) => !c.hidden);

            // 1. The set, drawn as numbered spines.
            builder.querySelector('[data-set-picture]').hidden = !vols;
            builder.querySelector('[data-set-caption]').textContent = vols
              ? 'One complete set: ' + vols + ' volumes' + (vols > DRAWN ? ' (the first ' + DRAWN + ' drawn)' : '')
              : '';
            spines(builder.querySelector('[data-set-spines]'), Math.min(vols, DRAWN), (node, n) => {
              node.className = BIG;
              node.textContent = String(n);
            });
            const volsBad = !vols && (tried || volumesEl.value.trim() !== '');
            volumesEl.parentElement.classList.toggle(ERR, volsBad);
            volumesEl.setAttribute('aria-invalid', String(volsBad));

            // 2. Each part: what it covers, and what is wrong with it.
            let firstShown = null;
            let blocked = !vols;
            const valid = [];
            for (const card of cards) {
              const r = read(card, vols);
              const span_ = range(card);
              const fits = span_ && (!vols || span_.to <= vols);
              const summary = card.querySelector('[data-part-summary]');
              summary.textContent = fits ? span(span_.from, span_.to) + (vols ? ' of ' + vols : '') : 'Choose the volumes';
              summary.classList.toggle('text-[var(--color-ink)]', Boolean(fits));
              summary.classList.toggle('text-[var(--color-ink-faint)]', !fits);
              const strip = card.querySelector('[data-part-spines]');
              strip.hidden = !vols || vols > DRAWN;
              spines(strip, vols && vols <= DRAWN ? vols : 0, (node, n) => {
                node.className = MINI + ' ' + (fits && n >= span_.from && n <= span_.to ? ON : OFF);
              });

              const show = Boolean(r.error) && (!r.quiet || tried || card.dataset.touched === '1');
              for (const k of KEYS) {
                const field = input(card, k);
                const bad = show && r.bad.includes(k);
                (k === 'price' ? field.parentElement : field).classList.toggle(ERR, bad);
                field.setAttribute('aria-invalid', String(bad));
              }
              card.classList.toggle(ERR, show);
              card.querySelector('[data-part-error]').hidden = !show;
              card.querySelector('[data-part-message]').textContent = show ? r.error : '';
              if (r.error) blocked = true;
              if (show && !firstShown) firstShown = 'Part ' + (shown.indexOf(card) + 1) + ': ' + r.error;
              if (r.ok) valid.push(r);
            }
            if (!valid.length) blocked = true;

            shown.forEach((card, k) => {
              card.querySelector('[data-part-label]').textContent = 'Part ' + (k + 1);
              card.querySelector('[data-part-remove]').setAttribute('aria-label', 'Remove part ' + (k + 1));
            });
            addBtn.hidden = shown.length >= cards.length;
            builder.querySelector('[data-part-full]').hidden = shown.length < cards.length;
            builder.querySelector('[data-part-count]').textContent = shown.length + ' of ' + cards.length;
            builder.querySelector('[data-parts-quick]').hidden = !vols;
            builder.querySelector('[data-preset="each"]').hidden = vols > cards.length;

            // 3. What goes on the shop, and what one sale does to the shelf.
            builder.querySelector('[data-check-rows]').replaceChildren(
              listing('Complete set', 'This listing', vols ? '1-' + vols : '-', money(setPrice), have),
              ...valid.map((r) => listing(r.name, 'New', r.from === r.to ? String(r.from) : r.from + '-' + r.to, money(r.pence), have)),
            );
            builder.querySelector('[data-check-empty]').hidden = valid.length > 0;

            const notes = [];
            if (vols && valid.length) {
              const count = new Array(vols + 1).fill(0);
              for (const r of valid) for (let n = r.from; n <= Math.min(r.to, vols); n++) count[n]++;
              const gaps = [];
              const twice = [];
              for (let n = 1; n <= vols; n++) {
                if (count[n] === 0) gaps.push(n);
                else if (count[n] > 1) twice.push(n);
              }
              if (gaps.length === 1) {
                notes.push('Volume ' + runs(gaps) + ' is not in any part, so it only sells with the complete set. That is fine if you meant it.');
              } else if (gaps.length) {
                notes.push('Volumes ' + runs(gaps) + ' are not in any part, so they only sell with the complete set. That is fine if you meant it.');
              }
              if (twice.length === 1) {
                notes.push('Volume ' + runs(twice) + ' is in more than one part. That is allowed: whichever part sells first uses it up.');
              } else if (twice.length) {
                notes.push('Volumes ' + runs(twice) + ' are in more than one part. That is allowed: whichever part sells first uses them up.');
              }
            }
            builder.querySelector('[data-check-notes]').replaceChildren(...notes.map(note));

            const lead = builder.querySelector('[data-shelf-lead]');
            const shelf = builder.querySelector('[data-shelf-rows]');
            const after = builder.querySelector('[data-shelf-after]');
            const sold = valid[0];
            shelf.hidden = after.hidden = !sold || have === 0;
            if (!sold) {
              lead.textContent = 'Add a part above and this shows what one sale does to the count.';
            } else if (have === 0) {
              lead.textContent = 'With no complete sets on the shelf, every listing here shows as sold out until you add some.';
            } else {
              lead.textContent = 'You have ' + have + ' complete ' + (have === 1 ? 'set' : 'sets') +
                '. Say a customer buys “' + sold.name + '” on its own. Afterwards:';
              const change = (label, drops) => {
                const row = el('div', 'flex justify-between gap-3 text-[13.5px]');
                row.append(
                  el('span', 'min-w-0 truncate text-[var(--color-ink-soft)]', label),
                  drops
                    ? el('span', 'shrink-0 tabular-nums font-semibold', have + ' → ' + (have - 1))
                    : el('span', 'shrink-0 tabular-nums text-[var(--color-ink-faint)]', have + ' → ' + have + ', no change'),
                );
                return row;
              };
              shelf.replaceChildren(
                change('Complete set', true),
                ...valid.map((r) => change(r.name, r.from <= sold.to && r.to >= sold.from)),
              );
            }

            // The button, and the one thing standing in its way.
            let message = firstShown;
            if (!vols && (tried || volumesEl.value.trim() !== '')) {
              message = 'Put how many volumes are in one set: between 2 and 200.';
            } else if (!message && tried && !valid.length) {
              message = 'Add at least one part, with its volumes and a price.';
            }
            partsError.hidden = !message;
            partsError.querySelector('[data-parts-message]').textContent = message || '';
            buildBtn.textContent = valid.length > 1
              ? 'Create ' + valid.length + ' part listings'
              : valid.length === 1 ? 'Create 1 part listing' : 'Create the parts';
            buildBtn.classList.toggle('opacity-50', blocked);
            buildBtn.setAttribute('aria-disabled', String(blocked));
            return !blocked;
          }

          for (const card of cards) {
            const name = input(card, 'name');
            name.dataset.auto = name.value.trim() ? '0' : '1';
            card.addEventListener('input', (event) => {
              if (event.target === name) {
                name.dataset.auto = name.value.trim() ? '0' : '1';
              } else if (event.target !== input(card, 'price') && name.dataset.auto === '1') {
                const r = range(card);
                name.value = r ? span(r.from, r.to) : '';
              }
              paint();
            });
            card.addEventListener('focusout', (event) => {
              if (card.contains(event.relatedTarget)) return;
              card.dataset.touched = '1';
              paint();
            });
            card.querySelector('[data-part-remove]').addEventListener('click', () => {
              for (const k of KEYS) input(card, k).value = '';
              name.dataset.auto = '1';
              delete card.dataset.touched;
              const others = cards.filter((c) => c !== card && !c.hidden);
              if (others.length) card.hidden = true;
              paint();
              (others.length ? addBtn : input(card, 'from')).focus();
            });
          }

          addBtn.addEventListener('click', () => {
            const next = cards.find((c) => c.hidden);
            if (!next) return;
            next.hidden = false;
            paint();
            input(next, 'from').focus();
          });

          for (const btn of builder.querySelectorAll('[data-preset]')) {
            btn.addEventListener('click', () => {
              const vols = total();
              if (!vols) return;
              const busy = cards.some((c) => KEYS.some((k) => input(c, k).value.trim()));
              if (busy && !window.confirm('Replace the parts you have filled in?')) return;
              const ranges = [];
              if (btn.dataset.preset === 'halves') {
                const half = Math.ceil(vols / 2);
                ranges.push([1, half], [half + 1, vols]);
              } else {
                for (let n = 1; n <= Math.min(vols, cards.length); n++) ranges.push([n, n]);
              }
              cards.forEach((card, i) => {
                const r = ranges[i];
                input(card, 'from').value = r ? String(r[0]) : '';
                input(card, 'to').value = r ? String(r[1]) : '';
                input(card, 'name').value = r ? span(r[0], r[1]) : '';
                input(card, 'name').dataset.auto = '1';
                input(card, 'price').value = '';
                delete card.dataset.touched;
                card.hidden = !r && i > 0;
              });
              paint();
              input(cards[0], 'price').focus();
            });
          }

          for (const btn of builder.querySelectorAll('[data-bump]')) {
            btn.hidden = false;
            btn.addEventListener('click', () => {
              const field = btn.parentElement.querySelector('input');
              const min = Number(field.min);
              const max = Number(field.max);
              const now = Number.parseInt(field.value, 10);
              const from = Number.isFinite(now) ? now : min - (field === volumesEl ? 1 : 0);
              field.value = String(Math.max(min, Math.min(max, from + Number(btn.dataset.bump))));
              if (field === volumesEl) volumesEl.dataset.own = '1';
              field.dispatchEvent(new Event('input', { bubbles: true }));
            });
          }

          volumesEl.addEventListener('input', paint);
          setsEl.addEventListener('input', paint);
          partsForm.addEventListener('submit', (event) => {
            tried = true;
            if (paint()) return;
            event.preventDefault();
            const first = builder.querySelector('[aria-invalid="true"]') ||
              input(cards.find((c) => !c.hidden) || cards[0], 'from');
            first.focus();
          });

          // Scripting is on, so the extras appear and the eight rows become one
          // to start with - more are a button away.
          for (const node of builder.querySelectorAll('[data-part-remove], [data-parts-check]')) node.hidden = false;
          for (const node of builder.querySelectorAll('[data-parts-static]')) node.hidden = true;
          cards.forEach((card, i) => {
            if (i > 0 && !KEYS.some((k) => input(card, k).value.trim())) card.hidden = true;
          });
          paint();
        })();

        const bookForm = document.querySelector('#bookForm');
        const saveBtn = document.querySelector('#saveBtn');
        const saveHint = document.querySelector('#saveHint');
        const postBtn = document.querySelector('#postBtn');
        const postHint = document.querySelector('#postHint');
        const postEditBtn = document.querySelector('#postEditBtn');

        const snapshot = () => new URLSearchParams(new FormData(bookForm)).toString();
        let saved = snapshot();

        function sync() {
          const dirty = snapshot() !== saved;

          if (saveBtn) {
            saveBtn.disabled = !dirty;
            saveHint.textContent = dirty ? 'You have unsaved changes.' : 'No unsaved changes.';
          }

          if (postBtn) {
            const blocked = postBtn.dataset.blocked === '1';
            postBtn.disabled = dirty || blocked;
            if (postEditBtn) postEditBtn.disabled = dirty;
            postHint.textContent = dirty
              ? 'Save your changes first, then post them.'
              : postBtn.dataset.reason || '';
          }
        }

        bookForm?.addEventListener('input', sync);
        bookForm?.addEventListener('change', sync);
        sync();

        // A form submission is about to reload the page; leaving the button
        // enabled invites a second click that posts twice.
        bookForm?.addEventListener('submit', () => {
          if (saveBtn) { saveBtn.disabled = true; saveHint.textContent = 'Saving…'; }
        });

        /*
         * Back to the written-for-you post.
         *
         * The generated text travels on the textarea itself, so this needs no
         * round trip and works before anything has been saved. With scripting
         * off the button is not there and emptying the box does the same job:
         * a blank caption is the shop's to write again.
         */
        const captionBox = document.querySelector('#telegram_caption');
        document.querySelector('#resetCaption')?.addEventListener('click', () => {
          if (!captionBox) return;
          captionBox.value = captionBox.dataset.generated ?? '';
          captionBox.focus();
        });

        document.querySelector('#telegramForm')?.addEventListener('submit', () => {
          if (postBtn) { postBtn.disabled = true; postHint.textContent = 'Posting…'; }
          if (postEditBtn) postEditBtn.disabled = true;
        });

        // Confirm in JS rather than an inline onsubmit: a title containing an
        // apostrophe would break the attribute.
        document.querySelector('#deleteForm')?.addEventListener('submit', (event) => {
          const ok = confirm(
            `Delete “${bookTitle}” for good?\n\nIts photos and channel post go too. Past orders keep their record of it.`,
          );
          if (!ok) event.preventDefault();
        });

        const input = document.querySelector('#photo');
        const status = document.querySelector('#uploadStatus');

        /**
         * Shrinks the photo before it leaves the phone, and measures it.
         *
         * A phone camera produces something like 4000px and several megabytes,
         * so this has to come down before it is sent. Resizing here also
         * sidesteps HEIC, which iPhones produce and the server does not
         * accept, because the canvas decodes it and hands back WebP.
         *
         * The ceiling has to clear the largest thing the shop builds, and for
         * a long time it did not. It was 800, written when the biggest variant
         * was 600x800; the detail variant is 840x1176 now, so every upload was
         * arriving smaller than the size it would be enlarged to. That is what
         * made covers added through the portal look soft, and it survived the
         * fix to the cropper - which had its own separate ceiling - because
         * this runs afterwards and simply put the photo back down again.
         *
         * Measured while we are holding the bitmap: the server cannot read
         * dimensions from a stream it passes straight through, and without them
         * the page has nothing to reserve space with, so the grid jumps as the
         * photo loads.
         *
         * The photo itself is not altered - no frame, no background, no mark.
         * There was a frame here briefly, to match a standardising pass over
         * the catalogue; the owner did not want it, and the covers read better
         * as they are.
         *
         * A failure here used to return the original silently, which on a phone
         * that cannot decode HEIC meant several megabytes going to R2 unshrunk.
         * It still sends - refusing the photo would be worse - but it says so.
         */
        const MAX_EDGE = 1400;

        async function shrink(file) {
          try {
            const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });

            // Fitted inside, never cropped and never enlarged, so a wide book
            // or a spine keeps all of itself at whatever size it arrived.
            const scale = Math.min(MAX_EDGE / bitmap.width, MAX_EDGE / bitmap.height, 1);
            const w = Math.max(1, Math.round(bitmap.width * scale));
            const h = Math.max(1, Math.round(bitmap.height * scale));

            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);

            /*
             * Encoded generously, because this is not the picture anyone sees.
             * It is the master the variants are cut from, and each of those is
             * encoded again at 82 - so anything given away here is given away
             * twice. The extra weight is paid once, on the way to R2.
             */
            const blob = await new Promise((r) => canvas.toBlob(r, 'image/webp', 0.92));
            return blob
              ? { file: new File([blob], 'photo.webp', { type: 'image/webp' }), width: w, height: h }
              : { file, width: bitmap.width, height: bitmap.height };
          } catch {
            return { file, width: null, height: null, failed: true };
          }
        }

        input?.addEventListener('change', async () => {
          const chosen = input.files?.[0];
          if (!chosen) return;
          await handOff(chosen);
        });

        /*
         * One path from "here is an image" to "it is on the listing", whether
         * it came off the owner's phone or out of the search. The search must
         * not get its own quieter route to R2 - the straightening, the look at
         * it, and the shrink are the same requirements either way.
         */
        async function handOff(chosen) {
          status.hidden = false;
          status.textContent = 'Preparing…';

          /*
           * Straighten and crop first, and let the owner look at it.
           *
           * Nothing reaches R2 until he has answered: a crooked photo of a book
           * on a kitchen table used to be live the moment it was chosen. If the
           * panel is not on the page - an older browser, a failed module - this
           * is undefined and the upload carries on exactly as it did.
           */
          /*
           * Two different nothings, and they must not be confused.
           *
           * `?? chosen` used to cover both, which meant Cancel resolved null,
           * fell through to the original, and uploaded the crooked photo the
           * owner had just refused. The panel being absent is the only case
           * that may fall back.
           */
          const original = window.coverClean ? await window.coverClean.review(chosen) : chosen;
          if (!original) {
            // Cancelled. Clear the input so choosing the same file again still
            // fires a change event.
            input.value = '';
            status.hidden = true;
            return;
          }

          status.textContent = 'Preparing…';

          /*
           * Framed and cut to size here, on the machine that already has the
           * photo decoded.
           *
           * The alternative was what this used to do: send the photo and
           * nothing else, leaving the listing with no variants until somebody
           * remembered to run scripts/resize-covers.mjs. Until that happened
           * `?p=card` fell back to the full-size original and the browser
           * cropped it however object-fit saw fit, which is not the framing
           * this shop follows. Sharp cannot run at Cloudflare's edge, so the
           * only machine that can do this before the upload lands is this one.
           */
          const dressed = window.coverClean?.dress
            ? await window.coverClean.dress(original)
            : null;

          // Falls back to the old path whenever the framing could not run, so
          // an older browser still uploads a usable cover.
          const { file, width, height, failed } = dressed?.variants?.size
            ? { file: dressed.master, width: dressed.width, height: dressed.height, failed: false }
            : await shrink(original);

          const saved = original.size - file.size;
          status.textContent = failed
            ? 'This phone could not shrink that photo - sending it as it is…'
            : saved > 0
              ? `Uploading… (${Math.round(original.size / 1024)}KB down to ${Math.round(file.size / 1024)}KB)`
              : 'Uploading…';

          const body = new FormData();
          body.append('bookId', String(bookId));
          body.append('photo', file);
          if (width && height) {
            body.append('width', String(width));
            body.append('height', String(height));
          }
          for (const [name, variant] of dressed?.variants ?? []) {
            body.append(`variant:${name}`, variant);
          }

          try {
            const res = await fetch('/api/admin/upload', { method: 'POST', body });
            input.value = '';
            if (!res.ok) throw new Error(await res.text());
            status.textContent = 'Uploaded.';
            window.location.reload();
          } catch (err) {
            status.textContent = `Could not upload that photo. ${err}`;
          }
        }

        for (const btn of document.querySelectorAll('[data-remove-image]')) {
          btn.addEventListener('click', async () => {
            if (!confirm('Remove this photo?')) return;
            const body = new FormData();
            body.append('imageId', btn.dataset.removeImage);
            const res = await fetch('/api/admin/upload', { method: 'DELETE', body });
            if (res.ok) window.location.reload();
          });
        }

        /*
         * Find a cover in two independent catalogues. Open Library work
         * results are expanded into editions on our server; Google stays in
         * its own provider block and in its native relevance order.
         *
         * Candidate images still come through our id-only proxy. It satisfies
         * the site's CSP and cannot be turned into an arbitrary URL fetcher.
         */
        const findBtn = document.querySelector('#findCover');
        if (findBtn) {
          const results = document.querySelector('#coverResults');
          const countLine = document.querySelector('#coverCount');
          const termsLine = document.querySelector('#coverTerms');
          const grid = document.querySelector('#coverGrid');
          const retry = document.querySelector('#coverRetry');
          const words = document.querySelector('#coverWords');
          const note = document.querySelector('#coverNote');

          // Dimensions are known only after the proxied image has loaded.
          function faults(w, h) {
            const out = [];
            if (w < 300) out.push('a thumbnail - too small to use');
            if (w >= h) out.push('not cover-shaped - check it is the right image');
            return out;
          }

          async function search(terms, author = '') {
            results.hidden = false;
            grid.innerHTML = '';
            retry.hidden = true;
            countLine.textContent = 'Looking…';
            note.hidden = false;
            termsLine.textContent = '';
            findBtn.disabled = true;

            let covers = [];
            let providers = {
              openlibrary: { state: 'unavailable', count: 0 },
              google: { state: 'unavailable', count: 0 },
            };
            try {
              const params = new URLSearchParams(author
                ? { title: terms, author }
                : { q: terms });
              // Read from the field rather than the saved row, so an ISBN just
              // typed in is used without having to save the listing first.
              const isbnNow = document.querySelector('#isbn')?.value?.trim();
              if (isbnNow) params.set('isbn', isbnNow);
              const res = await fetch(`/api/admin/covers/search?${params}`);
              if (res.ok) {
                const payload = await res.json();
                covers = payload.covers ?? [];
                providers = payload.providers ?? providers;
              }
            } catch {
              /* The provider-aware empty state below explains an outage. */
            }
            findBtn.disabled = false;

            function nothing() {
              const unavailable = Object.entries(providers)
                .filter(([, report]) => report.state === 'unavailable')
                .map(([provider]) => provider === 'google' ? 'Google Books' : 'Open Library');
              const googleMissing = providers.google?.state === 'not-configured';
              countLine.textContent = unavailable.length
                ? 'Cover search unavailable'
                : 'Nothing found';
              note.hidden = true;
              termsLine.textContent = unavailable.length
                ? `${unavailable.join(' and ')} could not be reached. Try again, or upload a photo.`
                : googleMissing
                  ? 'No match in Open Library. Google Books is not connected yet, so upload a photo or try different words.'
                  : 'Neither source has a matching cover. A photograph of the book is still the most reliable option.';
              retry.hidden = false;
              words.value = terms;
            }

            if (covers.length === 0) {
              nothing();
              return;
            }

            const unavailable = Object.entries(providers)
              .filter(([, report]) => report.state === 'unavailable')
              .map(([provider]) => provider === 'google' ? 'Google Books' : 'Open Library');
            termsLine.textContent = providers.google?.state === 'not-configured'
              ? `Searched for “${terms}”. Google Books is not connected yet.`
              : unavailable.length
                ? `Searched for “${terms}”. ${unavailable.join(' and ')} could not be reached, so these are partial results.`
                : `Searched for “${terms}”. Nothing is attached until you accept it.`;
            retry.hidden = false;
            words.value = terms;

            let shown = 0;
            let pending = covers.length;
            for (const provider of ['openlibrary', 'google']) {
              const providerCovers = covers.filter((cover) => cover.provider === provider);
              if (providerCovers.length === 0) continue;

              const section = document.createElement('section');
              section.dataset.coverProvider = provider;
              const heading = document.createElement('div');
              heading.className = 'mb-2 flex min-h-8 items-center justify-between gap-3';
              const headingText = document.createElement('h3');
              headingText.className = 'text-[13px] font-medium text-[var(--color-ink-soft)]';
              headingText.textContent = provider === 'google' ? 'Google Books' : 'Open Library editions';
              heading.append(headingText);
              if (provider === 'google') {
                const brand = document.createElement('img');
                brand.src = 'https://books.google.com/googlebooks/images/poweredby.png';
                brand.alt = 'Powered by Google';
                brand.width = 62;
                brand.height = 30;
                heading.append(brand);
              }
              const providerGrid = document.createElement('div');
              providerGrid.className = 'grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4';
              section.append(heading, providerGrid);
              grid.append(section);

              for (const cover of providerCovers) {
                const cell = document.createElement('div');

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className =
                  'block w-full text-left rounded-[8px] overflow-hidden border border-[var(--color-rule-soft)] hover:border-[var(--color-navy)] transition-colors';

                const img = document.createElement('img');
                img.alt = cover.title;
                img.className = 'block w-full aspect-[5/7] object-cover bg-[var(--color-paper)]';

                const title = document.createElement('p');
                title.className =
                  'mt-2 text-[12.5px] font-medium text-[var(--color-navy)] leading-tight line-clamp-2';
                title.textContent = cover.title;

                const note = document.createElement('p');
                note.className = 'mt-1 text-[11px] text-[var(--color-ink-faint)] leading-tight line-clamp-2';
                note.textContent = cover.source;

              // A provider id can still point at an image which has since
              // disappeared, so a tile earns its place by loading.
              cell.hidden = true;
              img.addEventListener('load', () => {
                cell.hidden = false;
                shown += 1;
                pending -= 1;
                countLine.textContent = shown === 1 ? '1 cover found' : `${shown} covers found`;
                const bad = faults(img.naturalWidth, img.naturalHeight);
                note.textContent = `${img.naturalWidth}×${img.naturalHeight} · ${cover.source}`;
                if (bad.length) {
                  const warn = document.createElement('span');
                  warn.className = 'block text-[var(--color-outstock)]';
                  warn.textContent = bad.join(' · ');
                  note.append(warn);
                }
              });
              img.addEventListener('error', () => {
                pending -= 1;
                cell.remove();
                if (providerGrid.children.length === 0) section.remove();
                if (pending === 0 && shown === 0) {
                  grid.innerHTML = '';
                  nothing();
                }
              });

              btn.addEventListener('click', async () => {
                status.hidden = false;
                status.textContent = 'Fetching that cover…';
                try {
                  const coverParams = new URLSearchParams({
                    provider: cover.provider,
                    id: String(cover.id),
                  });
                  const res = await fetch(`/api/admin/covers/image?${coverParams}`);
                  if (!res.ok) throw new Error('gone');
                  const blob = await res.blob();
                  // Straight into the same review the owner's own photo gets.
                  await handOff(new File([blob], 'cover.jpg', { type: blob.type || 'image/jpeg' }));
                } catch {
                  status.textContent = 'Could not fetch that cover. Try another, or upload one.';
                }
              });

              btn.append(img);
              cell.append(btn, title, note);
              if (provider === 'google') {
                const sourceLink = document.createElement('a');
                sourceLink.href = `https://books.google.com/books?id=${encodeURIComponent(cover.id)}`;
                sourceLink.target = '_blank';
                sourceLink.rel = 'noopener';
                sourceLink.className =
                  'mt-1.5 inline-block text-[11.5px] font-medium text-[var(--color-navy)] underline underline-offset-2';
                sourceLink.textContent = 'View on Google Books';
                cell.append(sourceLink);
              }
              providerGrid.append(cell);

              const imageParams = new URLSearchParams({
                provider: cover.provider,
                id: String(cover.id),
              });
              img.src = `/api/admin/covers/image?${imageParams}`;
              }
            }
          }

          // `start` deliberately stays visible. Hiding it once a search runs
          // would leave uploading as a link under a grid of results, which is
          // the one shape this section is not allowed to take.
          findBtn.addEventListener('click', () => search(bookTitle, bookAuthor));
          document.querySelector('#coverGo')?.addEventListener('click', () => search(words.value));
          words?.addEventListener('keydown', (e) => {
            // Enter inside the listing form would otherwise save the page.
            if (e.key === 'Enter') {
              e.preventDefault();
              search(words.value);
            }
          });
        }
      </script>
    )
  }
  {/*
    The review panel.

    A bundled module rather than another `is:inline` block: this is far too
    much logic for a script Astro ships verbatim, and it needs to import the
    geometry from src/scripts/cover-clean.ts, which an inline script cannot do.

    It hands itself to the inline uploader through `window.coverClean`, which
    is the whole seam between them - the uploader asks for a file to send and
    gets one back, or null if the owner cancelled.
  */}
  {/*
    * Sold in parts, without a save in the middle.
    *
    * The section waits on a volume count above one, and that count is typed in
    * Identity at the top of the same page. Reading it from the saved book
    * meant typing it, saving, scrolling back down, and only then finding the
    * builder - one round trip to learn something already on screen.
    *
    * `partsForm` posts its own volume count, so the saved value was never what
    * the builder needed; it was only what decided whether to draw it. So this
    * watches the field instead, and carries the number down so it is not typed
    * twice. With scripting off the panel keeps its original wording and the
    * save still gets there.
    */}
  <script is:inline nonce={Astro.locals.cspNonce}>
    (() => {
      const panel = document.querySelector('[data-parts-panel]');
      const wait = document.querySelector('[data-parts-wait]');
      const builder = document.querySelector('[data-parts-builder]');
      const volumes = document.querySelector('#volumes');
      if (!panel || !wait || !builder || !volumes) return;

      wait.textContent =
        'Waiting on a volume count. Put the number of volumes in \u201CVolumes in the set\u201D above and the builder opens here.';

      /* The builder's own volume field, which the owner should not have to
         fill in twice with the same number. Named by its form: the "link
         these" block above it has a volume field of its own, and used to be
         the one this found. */
      const echo = builder.querySelector('input[name="volumes"][form="partsForm"]');
      echo?.addEventListener('input', (event) => {
        if (event.isTrusted) echo.dataset.own = '1';
      });

      function paint() {
        const n = Number(volumes.value);
        const splittable = Number.isFinite(n) && n > 1;
        wait.hidden = splittable;
        builder.hidden = !splittable;

        panel.classList.toggle('bg-[#faf9f6]', !splittable);
        panel.classList.toggle('border-dashed', !splittable);
        panel.classList.toggle('border-[var(--color-rule)]', !splittable);
        panel.classList.toggle('bg-white', splittable);
        panel.classList.toggle('border-[var(--color-rule-soft)]', splittable);

        /* Only while the owner has not typed there - overwriting a number
           they put into the builder itself would be worse than asking for it
           twice. The event lets the builder redraw for the new count. */
        const count = String(Math.round(n));
        if (splittable && echo && echo.dataset.own !== '1' && echo.value !== count) {
          echo.value = count;
          echo.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }

      volumes.addEventListener('input', paint);
      paint();
    })();
  </script>

  {/*
    * Catch a mistyped ISBN before the save does.
    *
    * `save.ts` refuses one and redirects, which loses everything else typed on
    * the page - survivable on a listing being edited, and on a new one it
    * throws away the whole form. The same check runs here first, using the
    * shop's own validator rather than a second copy of the arithmetic, so the
    * round trip never happens. The server still refuses: this only saves the
    * owner from it.
    */}
  <script>
    import { validIsbn } from '../../../lib/isbn-search';

    const form = document.querySelector<HTMLFormElement>('#bookForm');
    const field = document.querySelector<HTMLInputElement>('#isbn');
    const note = document.querySelector<HTMLElement>('#isbnNote');

    if (form && field && note) {
      const said = note.textContent ?? '';
      form.addEventListener('submit', (event) => {
        const typed = field.value.trim();
        if (!typed || validIsbn(typed)) return;
        event.preventDefault();
        note.textContent =
          'That is not a real ISBN - the check digit does not add up. Correct it, or clear the field.';
        note.style.color = 'var(--color-outstock)';
        field.focus();
        /* The page is not going anywhere after all, so anything watching for
           a save - the wizard's leave-the-page guard - has to be told. */
        form.dispatchEvent(new CustomEvent('save:blocked'));
      });
      field.addEventListener('input', () => {
        note.textContent = said;
        note.style.color = '';
      });
    }
  </script>

  {/*
    * "Did you mean...?" for a publisher.
    *
    * The suggestions list catches a name the owner starts typing the same way;
    * this catches the one typed differently - "Zamzam" for "Zam Zam", or with
    * "Publications" on the end. It only offers: two real publishers can look
    * alike, and the owner is the one holding the book. Capitals and spacing
    * alone are folded on save without asking.
    */}
  <script>
    import { publisherKey, tidyPublisher } from '../../../lib/publishers';

    const field = document.querySelector<HTMLInputElement>('#publisher');
    const hint = document.querySelector<HTMLElement>('#publisherHint');
    const use = document.querySelector<HTMLButtonElement>('#publisherUse');
    const used = document.querySelector<HTMLElement>('#publisherUsed');
    const known = [...document.querySelectorAll<HTMLOptionElement>('#publisherNames option')].map((o) => ({
      name: o.value,
      count: Number(o.dataset.count) || 0,
      key: publisherKey(o.value),
    }));

    if (field && hint && use && used) {
      const check = () => {
        const typed = tidyPublisher(field.value);
        const key = publisherKey(typed);
        // Most used first, so the spelling offered is the one to settle on.
        const match = key ? known.find((k) => k.key === key && k.name !== typed) : undefined;
        hint.hidden = !match;
        if (!match) return;
        use.textContent = match.name;
        used.textContent = `Used on ${match.count === 1 ? '1 listing' : `${match.count} listings`}.`;
      };
      use.addEventListener('click', () => {
        field.value = use.textContent ?? field.value;
        field.dispatchEvent(new Event('input', { bubbles: true }));
        field.focus();
      });
      field.addEventListener('input', check);
      check();
    }
  </script>

  {/*
    * Finding a shelf among twenty-six, and saying how many are picked.
    *
    * Both are enhancements over a list that already works: the filter box is
    * hidden until this runs, and the counts it keeps up to date are rendered
    * correctly by the server to begin with.
    */}
  <script is:inline nonce={Astro.locals.cspNonce}>
    (() => {
      const labels = [...document.querySelectorAll('[data-subject]')];
      if (!labels.length) return;

      const head = document.getElementById('subjectsHead');
      const badge = document.getElementById('subjectsBadge');
      const empty = document.querySelector('[data-subject-empty]');
      const wrap = document.querySelector('[data-subject-filter]');
      const box = document.getElementById('subjectFilter');
      if (wrap) wrap.hidden = false;

      function count() {
        const n = labels.filter((l) => l.querySelector('input')?.checked).length;
        if (head) {
          head.textContent =
            n > 0
              ? `${n} chosen`
              : 'None chosen \u2014 a listing with no subject cannot be browsed to';
          head.style.color = n > 0 ? 'var(--color-ink-soft)' : 'var(--color-outstock)';
        }
        if (badge) {
          badge.textContent = n > 0 ? String(n) : 'none yet';
          badge.style.color = n > 0 ? 'var(--color-ink-faint)' : 'var(--color-outstock)';
        }
      }

      function filter() {
        const want = (box?.value ?? '').trim().toLowerCase();
        let shown = 0;
        for (const label of labels) {
          /* A shelf already ticked stays visible whatever is typed, or
             filtering would look like it had unpicked something. */
          const keep =
            !want ||
            (label.dataset.name ?? '').includes(want) ||
            Boolean(label.querySelector('input')?.checked);
          label.hidden = !keep;
          if (keep) shown += 1;
        }
        if (empty) empty.hidden = shown > 0;
      }

      box?.addEventListener('input', filter);
      for (const label of labels) {
        label.querySelector('input')?.addEventListener('change', count);
      }
      count();
    })();
  </script>

  {/*
    * The ISBN lookup, on both shapes of the page.
    *
    * Its own script because it is the one piece of the editor that a listing
    * being created for the first time needs as much as a saved one - and the
    * script that carries the rest only runs when there is a book to carry.
    */}
  <script is:inline nonce={Astro.locals.cspNonce}>
        /*
         * Look up the ISBN.
         *
         * Candidates only. Open Library returns many editions for one title -
         * eight numbers came back for "Riyad as-Salihin" - and the shop stocks
         * one of them, so the publisher and year are shown beside each and a
         * person picks. Nothing is written until they do.
         */
        const isbnBtn = document.querySelector('#findIsbn');
        if (isbnBtn) {
          /*
           * What to search for, read when the button is pressed.
           *
           * It used to be a value rendered into the page from the saved book,
           * which is why the lookup could only be offered on a listing that
           * already existed - on a new one there was nothing to render. Read
           * from the fields instead and the same button works on the first
           * pass, where it is most useful.
           */
          const terms = () =>
            [document.querySelector('#title')?.value, document.querySelector('#author')?.value]
              .map((v) => (v ?? '').trim())
              .filter(Boolean)
              .join(' ');
          const isbnField = document.querySelector('#isbn');
          const isbnList = document.querySelector('#isbnList');
          const isbnNote = document.querySelector('#isbnNote');

          isbnBtn.addEventListener('click', async () => {
            isbnBtn.disabled = true;
            isbnNote.textContent = 'Looking…';
            isbnList.hidden = true;
            isbnList.innerHTML = '';

            let found = [];
            try {
              const res = await fetch(`/api/admin/isbn/search?q=${encodeURIComponent(terms())}`);
              if (res.ok) found = (await res.json()).candidates ?? [];
            } catch {
              /* Same as finding nothing: the field is typed by hand instead. */
            }
            isbnBtn.disabled = false;

            if (found.length === 0) {
              isbnNote.textContent =
                'Nothing found. That is normal for these publishers - type it off the back of the book.';
              return;
            }

            isbnNote.textContent = 'Pick the edition that matches the copy on your shelf.';
            isbnList.hidden = false;

            for (const c of found) {
              const row = document.createElement('button');
              row.type = 'button';
              row.className =
                'text-left w-full px-3 py-2 bg-white border border-[var(--color-rule-soft)] rounded-[8px] hover:border-[var(--color-navy)] transition-colors';
              row.innerHTML =
                `<span class="block text-[13.5px] font-medium text-[var(--color-navy)]"></span>` +
                `<span class="block text-[12.5px] text-[var(--color-ink-faint)]"></span>`;
              row.children[0].textContent = c.isbn;
              row.children[1].textContent = `${c.title} · ${c.detail}`;
              row.addEventListener('click', () => {
                isbnField.value = c.isbn;
                isbnField.dispatchEvent(new Event('input', { bubbles: true }));
                isbnList.hidden = true;
                isbnNote.textContent = 'Set. Nothing is saved until you save the page.';
              });
              isbnList.append(row);
            }
          });
        }
  </script>

  {/*
    * The four steps, as staging over a form that already worked.
    *
    * Everything here is show and hide inside one document: no navigation, no
    * history entry, no second save. With scripting off none of it runs, all
    * four panels render open one after another, and the single Save at the
    * foot does what it always did.
    */}
  {
    isNew && (
      <script is:inline nonce={Astro.locals.cspNonce}>
        (() => {
          const form = document.getElementById('bookForm');
          if (!form) return;
          const panels = [...document.querySelectorAll('[data-step]')];
          if (!panels.length) return;

          const back = document.getElementById('stepBack');
          const next = document.getElementById('stepNext');
          const save = document.getElementById('saveBtn');
          const hint = document.getElementById('saveHint');
          const countLine = document.getElementById('stepCount');
          const NAMES = ['the book', 'subjects', 'price and stock', 'description'];
          const LAST = NAMES.length;
          let at = 1;

          const field = (name) => form.elements.namedItem(name);
          const valueOf = (name) => {
            const el = field(name);
            return el && 'value' in el ? String(el.value).trim() : '';
          };

          /* Every value read from the live field at the moment the review is
             drawn, so the card and the form cannot disagree. */
          function review() {
            const set = (key, text, muted) => {
              const cell = document.querySelector(`[data-review="${key}"]`);
              if (!cell) return;
              cell.textContent = text;
              cell.style.color = muted ? 'var(--color-outstock)' : '';
            };

            const vols = Number(valueOf('volumes'));
            const identity = [valueOf('title'), valueOf('title_ar')].filter(Boolean).join(' · ');
            const under = [
              valueOf('author'),
              valueOf('publisher'),
              valueOf('isbn') ? `ISBN ${valueOf('isbn')}` : 'no ISBN',
              vols > 1 ? `${vols} volumes` : 'single volume',
            ].filter(Boolean).join(' · ');
            set('book', identity ? `${identity} - ${under}` : 'no title yet', !identity);

            const picked = [...form.querySelectorAll('input[name="categories"]:checked')]
              .map((box) => box.closest('label')?.textContent?.trim())
              .filter(Boolean);
            set(
              'subjects',
              picked.length ? picked.join(', ') : 'none - it will not appear on any shelf',
              picked.length === 0,
            );

            const statusField = field('status');
            const statusText = statusField && statusField.selectedIndex >= 0
              ? statusField.options[statusField.selectedIndex].textContent.trim().toLowerCase()
              : '';
            const price = valueOf('price');
            const stock = valueOf('stock');
            set(
              'commerce',
              [price ? `£${price}` : 'no price', `${stock || 0} in stock`, statusText]
                .filter(Boolean)
                .join(' · '),
              !price,
            );
          }

          function show(step) {
            at = Math.min(Math.max(1, step), LAST);
            for (const panel of panels) panel.hidden = Number(panel.dataset.step) !== at;

            for (const button of document.querySelectorAll('[data-badge]')) {
              const n = Number(button.dataset.badge);
              const done = n < at;
              button.textContent = done ? '\u2713' : String(n);
              button.style.borderColor =
                n === at ? 'var(--color-navy)' : done ? 'var(--color-instock)' : 'var(--color-rule)';
              button.style.color =
                n === at ? 'var(--color-navy)' : done ? 'var(--color-instock)' : 'var(--color-ink-faint)';
              button.style.background = n === at ? 'var(--color-wash-soft)' : 'transparent';
            }
            for (const label of document.querySelectorAll('[data-name]')) {
              label.style.color =
                Number(label.dataset.name) === at ? 'var(--color-navy)' : 'var(--color-ink-soft)';
            }
            for (const dot of document.querySelectorAll('[data-dot]')) {
              dot.style.background =
                Number(dot.dataset.dot) <= at ? 'var(--color-navy)' : 'var(--color-rule)';
            }

            if (countLine) countLine.textContent = `Step ${at} of ${LAST}`;
            if (back) {
              back.hidden = false;
              back.disabled = at === 1;
              back.style.opacity = at === 1 ? '0.45' : '1';
            }
            if (next) next.hidden = at === LAST;
            if (save) save.hidden = at !== LAST;
            if (hint)
              hint.textContent =
                at === LAST
                  ? 'One Save covers all four steps · leaving the page warns you first'
                  : `Next: ${NAMES[at]} · leaving the page warns you first`;

            if (at === LAST) review();
            form.scrollIntoView({ block: 'start', behavior: 'smooth' });
          }

          /*
           * The one thing that stops the owner moving on.
           *
           * Everything else on the first step can be left empty and filled in
           * later; without a title there is no listing and no address for one.
           */
          function titleOk() {
            const title = field('title');
            if (!title || title.value.trim()) return true;
            title.reportValidity?.();
            title.focus();
            return false;
          }

          next?.addEventListener('click', () => {
            if (at === 1 && !titleOk()) return;
            show(at + 1);
          });
          back?.addEventListener('click', () => show(at - 1));
          for (const jump of document.querySelectorAll('[data-goto]')) {
            jump.addEventListener('click', () => {
              const to = Number(jump.dataset.goto);
              if (to > 1 && !titleOk()) return;
              show(to);
            });
          }

          /*
           * Leaving with work in it.
           *
           * Claimed in the footer, so it has to be true. The submit clears the
           * flag first - saving is not leaving.
           */
          let saving = false;
          form.addEventListener('submit', () => { saving = true; });
          form.addEventListener('save:blocked', () => { saving = false; });
          window.addEventListener('beforeunload', (event) => {
            if (saving) return;
            if (!new URLSearchParams(new FormData(form)).toString().replace(/(^|&)[^=]+=(?=&|$)/g, '').trim()) return;
            event.preventDefault();
            event.returnValue = '';
          });

          /* The one field a save can refuse over is on the first step, which
             is also where this opens, so a refusal lands where it happened. */
          show(1);
        })();
      </script>
    )
  }

  {
    !isNew && (
      <script>
        import { mountCoverReview } from '../../../scripts/cover-review.ts';

        mountCoverReview();
      </script>
    )
  }
  <script>
    /*
     * Multi-buy rows: add, remove, and say in plain words what each offer
     * works out at, against the price typed above - so "20 for £45" reads back
     * as "£2.25 each, saves £15.00 on 20" before anyone saves it.
     */
    const rows = document.querySelector<HTMLElement>('#mbRows');
    const addBtn = document.querySelector<HTMLButtonElement>('#mbAdd');
    const priceField = document.querySelector<HTMLInputElement>('#price');
    const gbp = (p: number) => `£${(p / 100).toFixed(2)}`;

    function hint(row: HTMLElement) {
      const kind = row.querySelector('select')!.value;
      const qty = Number(row.querySelector<HTMLInputElement>('[name="mb_qty"]')!.value);
      const pence = Math.round(Number(row.querySelector<HTMLInputElement>('[name="mb_price"]')!.value.replace(/^£/, '')) * 100);
      const base = Math.round(Number(priceField?.value || 0) * 100);
      row.querySelector('[data-mb-joiner]')!.textContent = kind === 'from' ? 'at' : 'for';
      row.querySelector('[data-mb-unit]')!.textContent = kind === 'from' ? 'each' : 'in total';
      const out = row.querySelector<HTMLElement>('[data-mb-hint]')!;
      out.classList.remove('!text-[var(--color-outstock)]');
      if (!qty || !pence) {
        out.textContent = '';
        return;
      }
      if (qty < 2) {
        out.textContent = 'An offer needs at least 2 copies.';
        out.classList.add('!text-[var(--color-outstock)]');
        return;
      }
      const full = base * qty;
      const total = kind === 'from' ? pence * qty : pence;
      if (total >= full) {
        out.textContent = `Not cheaper than ${qty} at the normal price (${gbp(full)}) - this will be refused.`;
        out.classList.add('!text-[var(--color-outstock)]');
        return;
      }
      out.textContent = kind === 'from'
        ? `Saves ${gbp(base - pence)} a copy - ${gbp(full - total)} on ${qty}, more on larger orders.`
        : `Works out at ${gbp(Math.round(pence / qty))} each - saves ${gbp(full - total)} on ${qty}.`;
    }

    function wire(row: HTMLElement) {
      for (const el of row.querySelectorAll('input, select')) {
        el.addEventListener('input', () => hint(row));
        el.addEventListener('change', () => hint(row));
      }
      row.querySelector('[data-mb-remove]')!.addEventListener('click', () => {
        // The last row is emptied rather than removed, so there is always
        // somewhere to type the next offer.
        if (rows!.querySelectorAll('[data-mb-row]').length > 1) row.remove();
        else {
          for (const el of row.querySelectorAll<HTMLInputElement>('input')) el.value = '';
          hint(row);
        }
        rows!.dispatchEvent(new Event('input', { bubbles: true }));
      });
      hint(row);
    }

    if (rows && addBtn) {
      const all = () => [...rows.querySelectorAll<HTMLElement>('[data-mb-row]')];
      all().forEach(wire);
      priceField?.addEventListener('input', () => all().forEach(hint));

      addBtn.addEventListener('click', () => {
        const last = all().at(-1)!;
        const row = last.cloneNode(true) as HTMLElement;
        for (const el of row.querySelectorAll<HTMLInputElement>('input')) el.value = '';
        row.querySelector('select')!.value = 'bundle';
        rows.appendChild(row);
        wire(row);
        row.querySelector<HTMLInputElement>('[name="mb_qty"]')!.focus();
      });
    }
  </script>
</Admin>

