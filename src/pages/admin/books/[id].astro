                </div>

                <div class="bg-[var(--color-paper-raised)] border border-[var(--color-rule-soft)] rounded-[10px] p-3 mb-4">
                  <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[var(--color-ink-faint)] mb-2">
