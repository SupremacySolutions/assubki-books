                  </p>
                  <div class="grid grid-cols-[1fr_.8fr_.8fr_1fr] gap-1.5 text-[13px]">
                    <span class="text-[var(--color-ink)]">Volumes 1-2</span>
                    <span class="tabular-nums text-[var(--color-ink)]">1</span>
                    <span class="tabular-nums text-[var(--color-ink)]">2</span>
                    <span class="tabular-nums text-[var(--color-ink)]">17.00</span>
                    <span class="text-[var(--color-ink)]">Volumes 3-4</span>
                    <span class="tabular-nums text-[var(--color-ink)]">3</span>
                    <span class="tabular-nums text-[var(--color-ink)]">4</span>
                    <span class="tabular-nums text-[var(--color-ink)]">17.00</span>
                  </div>
                  <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                    A four volume set, sold whole or as either half. Parts may overlap or leave gaps
                    - it is your shelf.
                  </p>
                </div>

                <div class="space-y-3">
                  <input type="hidden" name="action" value="create" form="partsForm" />

                  <div class="grid grid-cols-2 gap-3">
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Volumes altogether
                      </span>
                      <input type="number" name="volumes" min="2" max="200" required
                        placeholder="4" form="partsForm" class="field !py-2 !text-[14px]" />
                    </label>
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Complete sets on the shelf
                      </span>
                      <input type="number" name="sets" min="0" max="999" required
                        placeholder="3" form="partsForm" class="field !py-2 !text-[14px]" />
                    </label>
                  </div>

                  {/* Headers that stay. The only labelling used to be placeholder
                      text, which disappears the moment anyone types into it. */}
                  <div>
                    <div class="grid grid-cols-[1fr_.8fr_.8fr_1fr] gap-1.5 pb-1.5 mb-1.5 border-b border-[var(--color-rule-soft)]">
                      {['Name of the part', 'First volume', 'Last volume', 'Price'].map((h) => (
                        <span class="text-[10.5px] font-semibold tracking-[0.14em] uppercase text-[var(--color-ink-faint)]">
                          {h}
                        </span>
                      ))}
                    </div>

                    <div class="space-y-1.5">
                      {[0, 1, 2, 3].map((i) => (
                        <div class="grid grid-cols-[1fr_.8fr_.8fr_1fr] gap-1.5 items-center">
                          <input
                            type="text"
                            name={`part_${i}_name`}
                            maxlength="200"
                            placeholder="Volumes 1-2"
                            form="partsForm"
                            class="field !py-1.5 !text-[13.5px]"
                          />
                          <input type="number" name={`part_${i}_from`} min="1" max="200"
                            placeholder="1" form="partsForm"
                            class="field !py-1.5 !text-[13.5px] !px-2 tabular-nums" />
                          <input type="number" name={`part_${i}_to`} min="1" max="200"
                            placeholder="2" form="partsForm"
                            class="field !py-1.5 !text-[13.5px] !px-2 tabular-nums" />
                          {/* The £ lives inside the field shell, so the border,
                              background and radius stay one object. */}
                          <div class="flex items-center rounded-[var(--radius-field)] border border-[var(--color-rule)] bg-white focus-within:border-[var(--color-navy)]">
                            <span class="pl-2.5 text-[13.5px] text-[var(--color-ink-faint)]">£</span>
                            <input
                              type="text"
                              name={`part_${i}_price`}
                              inputmode="decimal"
                              placeholder="0.00"
                              form="partsForm"
                              class="w-full bg-transparent border-0 outline-none py-1.5 pl-1 pr-2 text-[13.5px] tabular-nums"
                            />
                          </div>
                        </div>
                      ))}
                    </div>

                    <p id="partsError" hidden role="alert"
                      class="mt-2 flex items-start gap-1.5 text-[12.5px] text-[var(--color-outstock)]">
                      <span aria-hidden="true">!</span><span data-parts-message></span>
                    </p>

                    <p class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      Leave rows blank if you need fewer. One volume on its own is fine - put the
                      same number in both.
                    </p>
                  </div>

                  <button type="submit" form="partsForm" id="buildParts"
                    class="btn btn-primary !py-2 !text-[13.5px]">
                    Build the parts
                  </button>
                </div>
              </>
            )}
          </section>
          </>
        )
      }

      {
        book && (
          <section id="s-delete" class="border border-[var(--color-outstock)]/30 rounded-[var(--radius-panel)] p-5 scroll-mt-24">
            <h2 class="eyebrow !text-[var(--color-outstock)] mb-2">Delete</h2>
            <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed">
              Removes this listing for good, with any photos you uploaded
              {book.telegram_message_id ? ' and its post in the channel' : ''}. Past orders keep
              their record of it. To hide it without losing it, set Visibility to Archived.
            </p>
            {book.reserved > 0 && (
              <p class="mt-2 text-[13px] text-[var(--color-outstock)]">
                {book.reserved} {book.reserved === 1 ? 'copy is' : 'copies are'} reserved by an open
                order, so this cannot be deleted yet.
              </p>
            )}
            <button
              type="submit"
              form="deleteForm"
              class="btn btn-ghost w-full !py-2 mt-3 !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40"
              disabled={book.reserved > 0}
            >
              Delete listing
            </button>
          </section>
        )
      }

      {
        book && (
          <a
            href={`/book/${book.slug}`}
            class="block text-center text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2"
          >
            View in the shop →
          </a>
        )
      }
      {/*
        * One Save for the whole page.
        *
        * The sections are same-page anchors, so no navigation happens and the
        * unsaved-changes warning keeps working exactly as it did.
        */}
      <div class="sticky bottom-0 -mx-1 px-1 pb-1 pt-3 bg-gradient-to-t from-[var(--color-paper-raised)] via-[var(--color-paper-raised)] to-transparent">
        <div class="flex flex-wrap items-center justify-between gap-3 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] shadow-[var(--shadow-panel)] px-4 py-3">
          <p id="saveHint" class="text-[13px] text-[var(--color-ink-faint)]">
            {isNew ? 'Nothing saved yet.' : 'No unsaved changes.'}
          </p>
          <button type="submit" id="saveBtn" class="btn btn-primary !py-2.5">
            {isNew ? 'Create listing' : 'Save changes'}
          </button>
        </div>
      </div>
    </div>
  </form>

  {/* Outside the main form: forms cannot nest, so the sidebar buttons reach
      these through their `form` attribute instead. */}
  {
    book && (
      <>
        <form id="telegramForm" method="post" action={`/api/admin/books/${book.id}/telegram`} />
        <form id="restockForm" method="post" action={`/api/admin/books/${book.id}/set`} />
        <form id="arrivedForm" method="post" action={`/api/admin/books/${book.id}/arrived`} />
        <form id="partsForm" method="post" action={`/api/admin/books/${book.id}/set`} />
        <form id="adoptForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="adopt" />
        </form>
        <form id="unsplitForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="unsplit" />
        </form>
        <form id="deleteForm" method="post" action={`/api/admin/books/${book.id}/delete`} />
      </>
    )
  }

  {
    book && (
      <script is:inline nonce={Astro.locals.cspNonce} define:vars={{ bookId: book.id, bookTitle: book.title, bookAuthor: book.author ?? '', coverTerms: [book.title, book.author].filter(Boolean).join(' ') }}>
        // ------------------------------------------------------------------
        // Save and post are ordered, not parallel. Posting sends whatever is
        // in the database, so offering it while the form has unsaved edits
        // would announce the old version of a listing the owner has just
        // changed. Save is offered only when there is something to save;
        // posting only once there is nothing outstanding.
        // ------------------------------------------------------------------
        /*
         * A half-filled part row is refused, never guessed at. Filling in a
         * missing price or inferring a range would put a listing on the shop
         * front at a number nobody chose.
         *
         * The server refuses it too - this only saves a round trip and names
         * the row, which a redirect with ?e=parts cannot.
         */
        const partsForm = document.querySelector('#partsForm');
        const partsError = document.querySelector('#partsError');
        const buildBtn = document.querySelector('#buildParts');

        function checkParts() {
          if (!partsError || !buildBtn) return true;
          let problem = null;
          for (let i = 0; i < 4 && !problem; i++) {
            const cells = ['name', 'from', 'to', 'price'].map((k) =>
              document.querySelector('[name="part_' + i + '_' + k + '"]'),
            );
            const filled = cells.map((el) => (el && el.value.trim() ? 1 : 0));
            const count = filled.reduce((a, b) => a + b, 0);
            if (count === 0 || count === 4) {
              for (const el of cells) el && el.classList.remove('!border-[var(--color-outstock)]');
              continue;
            }
            const missing = ['a name', 'a first volume', 'a last volume', 'a price'];
            const first = filled.indexOf(0);
            problem = 'Row ' + (i + 1) + ' needs ' + missing[first] +
              '. We will not guess one - fill it in or clear the row.';
            for (const [n, el] of cells.entries()) {
              if (!el) continue;
              el.classList.toggle('!border-[var(--color-outstock)]', filled[n] === 0);
            }
          }
          partsError.hidden = !problem;
          if (problem) partsError.querySelector('[data-parts-message]').textContent = problem;
          buildBtn.classList.toggle('opacity-50', Boolean(problem));
          return !problem;
        }

        if (partsForm) {
          for (let i = 0; i < 4; i++) {
            for (const k of ['name', 'from', 'to', 'price']) {
              const el = document.querySelector('[name="part_' + i + '_' + k + '"]');
              el && el.addEventListener('input', checkParts);
            }
          }
          partsForm.addEventListener('submit', (event) => {
            if (!checkParts()) event.preventDefault();
          });
        }

        const bookForm = document.querySelector('#bookForm');
        const saveBtn = document.querySelector('#saveBtn');
        const saveHint = document.querySelector('#saveHint');
        const postBtn = document.querySelector('#postBtn');
        const postHint = document.querySelector('#postHint');

        const snapshot = () => new URLSearchParams(new FormData(bookForm)).toString();
        let saved = snapshot();

        function sync() {
          const dirty = snapshot() !== saved;

          if (saveBtn) {
            saveBtn.disabled = !dirty;
            saveHint.textContent = dirty ? 'You have unsaved changes.' : 'No unsaved changes.';
          }

          if (postBtn) {
            const blocked = postBtn.dataset.blocked === '1';
            postBtn.disabled = dirty || blocked;
            postHint.textContent = dirty
              ? 'Save your changes first, then post them.'
              : postBtn.dataset.reason || '';
          }
        }

        bookForm?.addEventListener('input', sync);
        bookForm?.addEventListener('change', sync);
        sync();

        // A form submission is about to reload the page; leaving the button
        // enabled invites a second click that posts twice.
        bookForm?.addEventListener('submit', () => {
          if (saveBtn) { saveBtn.disabled = true; saveHint.textContent = 'Saving…'; }
        });

        document.querySelector('#telegramForm')?.addEventListener('submit', () => {
          if (postBtn) { postBtn.disabled = true; postHint.textContent = 'Posting…'; }
        });

        // Confirm in JS rather than an inline onsubmit: a title containing an
        // apostrophe would break the attribute.
        document.querySelector('#deleteForm')?.addEventListener('submit', (event) => {
          const ok = confirm(
            `Delete “${bookTitle}” for good?\n\nIts photos and channel post go too. Past orders keep their record of it.`,
          );
          if (!ok) event.preventDefault();
        });

        const input = document.querySelector('#photo');
        const status = document.querySelector('#uploadStatus');

        /**
         * Shrinks the photo before it leaves the phone, and measures it.
         *
         * A phone camera produces something like 4000px and several megabytes,
         * so this has to come down before it is sent. Resizing here also
         * sidesteps HEIC, which iPhones produce and the server does not
         * accept, because the canvas decodes it and hands back WebP.
         *
         * The ceiling has to clear the largest thing the shop builds, and for
         * a long time it did not. It was 800, written when the biggest variant
         * was 600x800; the detail variant is 840x1176 now, so every upload was
         * arriving smaller than the size it would be enlarged to. That is what
         * made covers added through the portal look soft, and it survived the
         * fix to the cropper - which had its own separate ceiling - because
         * this runs afterwards and simply put the photo back down again.
         *
         * Measured while we are holding the bitmap: the server cannot read
         * dimensions from a stream it passes straight through, and without them
         * the page has nothing to reserve space with, so the grid jumps as the
         * photo loads.
         *
         * The photo itself is not altered - no frame, no background, no mark.
         * There was a frame here briefly, to match a standardising pass over
         * the catalogue; the owner did not want it, and the covers read better
         * as they are.
         *
         * A failure here used to return the original silently, which on a phone
         * that cannot decode HEIC meant several megabytes going to R2 unshrunk.
         * It still sends - refusing the photo would be worse - but it says so.
         */
        const MAX_EDGE = 1400;

        async function shrink(file) {
          try {
            const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });

            // Fitted inside, never cropped and never enlarged, so a wide book
            // or a spine keeps all of itself at whatever size it arrived.
            const scale = Math.min(MAX_EDGE / bitmap.width, MAX_EDGE / bitmap.height, 1);
            const w = Math.max(1, Math.round(bitmap.width * scale));
            const h = Math.max(1, Math.round(bitmap.height * scale));

            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);

            /*
             * Encoded generously, because this is not the picture anyone sees.
             * It is the master the variants are cut from, and each of those is
             * encoded again at 82 - so anything given away here is given away
             * twice. The extra weight is paid once, on the way to R2.
             */
            const blob = await new Promise((r) => canvas.toBlob(r, 'image/webp', 0.92));
            return blob
              ? { file: new File([blob], 'photo.webp', { type: 'image/webp' }), width: w, height: h }
              : { file, width: bitmap.width, height: bitmap.height };
          } catch {
            return { file, width: null, height: null, failed: true };
          }
        }

        input?.addEventListener('change', async () => {
          const chosen = input.files?.[0];
          if (!chosen) return;
          await handOff(chosen);
        });

        /*
         * One path from "here is an image" to "it is on the listing", whether
         * it came off the owner's phone or out of the search. The search must
         * not get its own quieter route to R2 - the straightening, the look at
         * it, and the shrink are the same requirements either way.
         */
        async function handOff(chosen) {
          status.hidden = false;
          status.textContent = 'Preparing…';

          /*
           * Straighten and crop first, and let the owner look at it.
           *
           * Nothing reaches R2 until he has answered: a crooked photo of a book
           * on a kitchen table used to be live the moment it was chosen. If the
           * panel is not on the page - an older browser, a failed module - this
           * is undefined and the upload carries on exactly as it did.
           */
          /*
           * Two different nothings, and they must not be confused.
           *
           * `?? chosen` used to cover both, which meant Cancel resolved null,
           * fell through to the original, and uploaded the crooked photo the
           * owner had just refused. The panel being absent is the only case
           * that may fall back.
           */
          const original = window.coverClean ? await window.coverClean.review(chosen) : chosen;
          if (!original) {
            // Cancelled. Clear the input so choosing the same file again still
            // fires a change event.
            input.value = '';
            status.hidden = true;
            return;
          }

          status.textContent = 'Preparing…';
          const { file, width, height, failed } = await shrink(original);
          const saved = original.size - file.size;
          status.textContent = failed
            ? 'This phone could not shrink that photo - sending it as it is…'
            : saved > 0
              ? `Uploading… (${Math.round(original.size / 1024)}KB down to ${Math.round(file.size / 1024)}KB)`
              : 'Uploading…';

          const body = new FormData();
          body.append('bookId', String(bookId));
          body.append('photo', file);
          if (width && height) {
            body.append('width', String(width));
            body.append('height', String(height));
          }

          try {
            const res = await fetch('/api/admin/upload', { method: 'POST', body });
            input.value = '';
            if (!res.ok) throw new Error(await res.text());
            status.textContent = 'Uploaded.';
            window.location.reload();
          } catch (err) {
            status.textContent = `Could not upload that photo. ${err}`;
          }
        }

        for (const btn of document.querySelectorAll('[data-remove-image]')) {
          btn.addEventListener('click', async () => {
            if (!confirm('Remove this photo?')) return;
            const body = new FormData();
            body.append('imageId', btn.dataset.removeImage);
            const res = await fetch('/api/admin/upload', { method: 'DELETE', body });
            if (res.ok) window.location.reload();
          });
        }

        /*
         * Look up the ISBN.
         *
         * Candidates only. Open Library returns many editions for one title -
         * eight numbers came back for "Riyad as-Salihin" - and the shop stocks
         * one of them, so the publisher and year are shown beside each and a
         * person picks. Nothing is written until they do.
         */
        const isbnBtn = document.querySelector('#findIsbn');
        if (isbnBtn) {
          const isbnField = document.querySelector('#isbn');
          const isbnList = document.querySelector('#isbnList');
          const isbnNote = document.querySelector('#isbnNote');

          isbnBtn.addEventListener('click', async () => {
            isbnBtn.disabled = true;
            isbnNote.textContent = 'Looking…';
            isbnList.hidden = true;
            isbnList.innerHTML = '';

            let found = [];
            try {
              const res = await fetch(`/api/admin/isbn/search?q=${encodeURIComponent(coverTerms)}`);
              if (res.ok) found = (await res.json()).candidates ?? [];
            } catch {
              /* Same as finding nothing: the field is typed by hand instead. */
            }
            isbnBtn.disabled = false;

            if (found.length === 0) {
              isbnNote.textContent =
                'Nothing found. That is normal for these publishers - type it off the back of the book.';
              return;
            }

            isbnNote.textContent = 'Pick the edition that matches the copy on your shelf.';
            isbnList.hidden = false;

            for (const c of found) {
              const row = document.createElement('button');
              row.type = 'button';
              row.className =
                'text-left w-full px-3 py-2 bg-white border border-[var(--color-rule-soft)] rounded-[8px] hover:border-[var(--color-navy)] transition-colors';
              row.innerHTML =
                `<span class="block text-[13.5px] font-medium text-[var(--color-navy)]"></span>` +
                `<span class="block text-[12.5px] text-[var(--color-ink-faint)]"></span>`;
              row.children[0].textContent = c.isbn;
              row.children[1].textContent = `${c.title} · ${c.detail}`;
              row.addEventListener('click', () => {
                isbnField.value = c.isbn;
                isbnField.dispatchEvent(new Event('input', { bubbles: true }));
                isbnList.hidden = true;
                isbnNote.textContent = 'Set. Nothing is saved until you save the page.';
              });
              isbnList.append(row);
            }
          });
        }

        /*
         * Find a cover in two independent catalogues. Open Library work
         * results are expanded into editions on our server; Google stays in
         * its own provider block and in its native relevance order.
         *
         * Candidate images still come through our id-only proxy. It satisfies
         * the site's CSP and cannot be turned into an arbitrary URL fetcher.
         */
        const findBtn = document.querySelector('#findCover');
        if (findBtn) {
          const results = document.querySelector('#coverResults');
          const countLine = document.querySelector('#coverCount');
          const termsLine = document.querySelector('#coverTerms');
          const grid = document.querySelector('#coverGrid');
          const retry = document.querySelector('#coverRetry');
          const words = document.querySelector('#coverWords');
          const note = document.querySelector('#coverNote');

          // Dimensions are known only after the proxied image has loaded.
          function faults(w, h) {
            const out = [];
            if (w < 300) out.push('a thumbnail - too small to use');
            if (w >= h) out.push('not cover-shaped - check it is the right image');
            return out;
          }

          async function search(terms, author = '') {
            results.hidden = false;
            grid.innerHTML = '';
            retry.hidden = true;
            countLine.textContent = 'Looking…';
            note.hidden = false;
            termsLine.textContent = '';
            findBtn.disabled = true;

            let covers = [];
            let providers = {
              openlibrary: { state: 'unavailable', count: 0 },
              google: { state: 'unavailable', count: 0 },
            };
            try {
              const params = new URLSearchParams(author
                ? { title: terms, author }
                : { q: terms });
              // Read from the field rather than the saved row, so an ISBN just
              // typed in is used without having to save the listing first.
              const isbnNow = document.querySelector('#isbn')?.value?.trim();
              if (isbnNow) params.set('isbn', isbnNow);
              const res = await fetch(`/api/admin/covers/search?${params}`);
              if (res.ok) {
                const payload = await res.json();
                covers = payload.covers ?? [];
                providers = payload.providers ?? providers;
              }
            } catch {
              /* The provider-aware empty state below explains an outage. */
            }
            findBtn.disabled = false;

            function nothing() {
              const unavailable = Object.entries(providers)
                .filter(([, report]) => report.state === 'unavailable')
                .map(([provider]) => provider === 'google' ? 'Google Books' : 'Open Library');
              const googleMissing = providers.google?.state === 'not-configured';
              countLine.textContent = unavailable.length
                ? 'Cover search unavailable'
                : 'Nothing found';
              note.hidden = true;
              termsLine.textContent = unavailable.length
                ? `${unavailable.join(' and ')} could not be reached. Try again, or upload a photo.`
                : googleMissing
                  ? 'No match in Open Library. Google Books is not connected yet, so upload a photo or try different words.'
                  : 'Neither source has a matching cover. A photograph of the book is still the most reliable option.';
              retry.hidden = false;
              words.value = terms;
            }

            if (covers.length === 0) {
              nothing();
              return;
            }

            const unavailable = Object.entries(providers)
              .filter(([, report]) => report.state === 'unavailable')
              .map(([provider]) => provider === 'google' ? 'Google Books' : 'Open Library');
            termsLine.textContent = providers.google?.state === 'not-configured'
              ? `Searched for “${terms}”. Google Books is not connected yet.`
              : unavailable.length
                ? `Searched for “${terms}”. ${unavailable.join(' and ')} could not be reached, so these are partial results.`
                : `Searched for “${terms}”. Nothing is attached until you accept it.`;
            retry.hidden = false;
            words.value = terms;

            let shown = 0;
            let pending = covers.length;
            for (const provider of ['openlibrary', 'google']) {
              const providerCovers = covers.filter((cover) => cover.provider === provider);
              if (providerCovers.length === 0) continue;

              const section = document.createElement('section');
              section.dataset.coverProvider = provider;
              const heading = document.createElement('div');
              heading.className = 'mb-2 flex min-h-8 items-center justify-between gap-3';
              const headingText = document.createElement('h3');
              headingText.className = 'text-[13px] font-medium text-[var(--color-ink-soft)]';
              headingText.textContent = provider === 'google' ? 'Google Books' : 'Open Library editions';
              heading.append(headingText);
              if (provider === 'google') {
                const brand = document.createElement('img');
                brand.src = 'https://books.google.com/googlebooks/images/poweredby.png';
                brand.alt = 'Powered by Google';
                brand.width = 62;
                brand.height = 30;
                heading.append(brand);
              }
              const providerGrid = document.createElement('div');
              providerGrid.className = 'grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4';
              section.append(heading, providerGrid);
              grid.append(section);

              for (const cover of providerCovers) {
                const cell = document.createElement('div');

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className =
                  'block w-full text-left rounded-[8px] overflow-hidden border border-[var(--color-rule-soft)] hover:border-[var(--color-navy)] transition-colors';

                const img = document.createElement('img');
                img.alt = cover.title;
                img.className = 'block w-full aspect-[5/7] object-cover bg-[var(--color-paper)]';

                const title = document.createElement('p');
                title.className =
                  'mt-2 text-[12.5px] font-medium text-[var(--color-navy)] leading-tight line-clamp-2';
                title.textContent = cover.title;

                const note = document.createElement('p');
                note.className = 'mt-1 text-[11px] text-[var(--color-ink-faint)] leading-tight line-clamp-2';
                note.textContent = cover.source;

              // A provider id can still point at an image which has since
              // disappeared, so a tile earns its place by loading.
              cell.hidden = true;
              img.addEventListener('load', () => {
                cell.hidden = false;
                shown += 1;
                pending -= 1;
                countLine.textContent = shown === 1 ? '1 cover found' : `${shown} covers found`;
                const bad = faults(img.naturalWidth, img.naturalHeight);
                note.textContent = `${img.naturalWidth}×${img.naturalHeight} · ${cover.source}`;
                if (bad.length) {
                  const warn = document.createElement('span');
                  warn.className = 'block text-[var(--color-outstock)]';
                  warn.textContent = bad.join(' · ');
                  note.append(warn);
                }
              });
              img.addEventListener('error', () => {
                pending -= 1;
                cell.remove();
                if (providerGrid.children.length === 0) section.remove();
                if (pending === 0 && shown === 0) {
                  grid.innerHTML = '';
                  nothing();
                }
              });

              btn.addEventListener('click', async () => {
                status.hidden = false;
                status.textContent = 'Fetching that cover…';
                try {
                  const coverParams = new URLSearchParams({
                    provider: cover.provider,
                    id: String(cover.id),
                  });
                  const res = await fetch(`/api/admin/covers/image?${coverParams}`);
                  if (!res.ok) throw new Error('gone');
                  const blob = await res.blob();
                  // Straight into the same review the owner's own photo gets.
                  await handOff(new File([blob], 'cover.jpg', { type: blob.type || 'image/jpeg' }));
                } catch {
                  status.textContent = 'Could not fetch that cover. Try another, or upload one.';
                }
              });

              btn.append(img);
              cell.append(btn, title, note);
              if (provider === 'google') {
                const sourceLink = document.createElement('a');
                sourceLink.href = `https://books.google.com/books?id=${encodeURIComponent(cover.id)}`;
                sourceLink.target = '_blank';
                sourceLink.rel = 'noopener';
                sourceLink.className =
                  'mt-1.5 inline-block text-[11.5px] font-medium text-[var(--color-navy)] underline underline-offset-2';
                sourceLink.textContent = 'View on Google Books';
                cell.append(sourceLink);
              }
              providerGrid.append(cell);

              const imageParams = new URLSearchParams({
                provider: cover.provider,
                id: String(cover.id),
              });
              img.src = `/api/admin/covers/image?${imageParams}`;
              }
            }
          }

          // `start` deliberately stays visible. Hiding it once a search runs
          // would leave uploading as a link under a grid of results, which is
          // the one shape this section is not allowed to take.
          findBtn.addEventListener('click', () => search(bookTitle, bookAuthor));
          document.querySelector('#coverGo')?.addEventListener('click', () => search(words.value));
          words?.addEventListener('keydown', (e) => {
            // Enter inside the listing form would otherwise save the page.
            if (e.key === 'Enter') {
              e.preventDefault();
              search(words.value);
            }
          });
        }
      </script>
    )
  }
  {/*
    The review panel.

    A bundled module rather than another `is:inline` block: this is far too
    much logic for a script Astro ships verbatim, and it needs to import the
    geometry from src/scripts/cover-clean.ts, which an inline script cannot do.

    It hands itself to the inline uploader through `window.coverClean`, which
    is the whole seam between them - the uploader asks for a file to send and
    gets one back, or null if the owner cancelled.
  */}
  {
    !isNew && (
      <script>
        import { mountCoverReview } from '../../../scripts/cover-review.ts';

        mountCoverReview();
      </script>
    )
  }
</Admin>

<style>
  /*
   * The delivery fields are dimmed and unreachable until the tick is on.
   *
   * Written here rather than as a Tailwind variant for two reasons: the
   * selector has to be `input:checked` and not `:checked`, because a selected
   * <option> in the month dropdown matches the latter and held the gate
   * permanently open; and utility ordering made the opacity half of it lose to
   * the resting class while the pointer-events half won, which is the sort of
   * disagreement a plain rule does not have.
   */
  .delivery-fields {
    opacity: 0.45;
    pointer-events: none;
  }
  .group:has(input[name='has_incoming']:checked) .delivery-fields {
    opacity: 1;
    pointer-events: auto;
  }
</style>
