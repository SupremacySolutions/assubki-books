---
import Admin from '../../../layouts/Admin.astro';
import CoverReview from '../../../components/CoverReview.astro';
import { getBookAdmin } from '../../../lib/admin-db';
import { allCategories, setOptions } from '../../../lib/db';
import { imageUrl, stripTags, truncate, htmlToPlainText } from '../../../lib/format';
import { botConfigured, listingCaption } from '../../../lib/telegram';

const { id } = Astro.params;
const isNew = id === 'new';
const bookId = isNew ? null : Number.parseInt(id ?? '', 10);

if (!isNew && (!bookId || Number.isNaN(bookId))) return Astro.rewrite('/404');

const book = bookId ? await getBookAdmin(bookId) : null;

// The other options, when this listing is already part of a set.
const siblings = book?.set_id ? await setOptions(book.set_id) : [];
if (!isNew && !book) return Astro.rewrite('/404');

const categories = await allCategories();
const selected = new Set(book?.categoryIds ?? []);
const posted = Astro.url.searchParams.get('posted');
const error = Astro.url.searchParams.get('e');

// What the channel post will look like, rendered from the same function that
// builds the real caption - so the preview cannot drift from what is sent.
// The channel post is stale when the listing has been saved since it was
// announced. That is what decides whether "Update channel post" does anything,
// so the button can be switched off when there is nothing to send.
// A missing posted_at counts as stale: we cannot show that the channel is up
// to date, and wrongly disabling the button would leave the owner unable to
// push a correction.
const channelStale = Boolean(
  book?.telegram_message_id &&
    (book.telegram_posted_at === null || book.updated_at > book.telegram_posted_at),
);

const previewCaption = book
  ? listingCaption({
      title: book.title,
      titleAr: book.title_ar,
      pricePence: book.price_pence,
      blurb: truncate(stripTags(book.description_html), 180) || null,
      available: book.available,
      url: `${Astro.url.origin}/book/${book.slug}`,
    })
      // Undo the MarkdownV2 escaping for display only.
      .replace(/\\([_*[\]()~`>#+\-=|{}.!\\])/g, '$1')
      .replace(/\*(.+?)\*/g, '$1')
  : '';
---

<Admin
  title={isNew ? 'Add a listing' : book!.title}
  sub={isNew ? undefined : `£${(book!.price_pence / 100).toFixed(2)} · ${book!.available} available`}
  back={{ href: '/admin/books', label: 'All listings' }}
>
  {
    error === 'upload' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        That photo could not be saved. Check it is a JPEG, PNG or WebP under 8 MB.
      </p>
    )
  }
  {
    posted === '1' && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Posted to the Telegram channel.
      </p>
    )
  }
  {
    posted === '0' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        Telegram rejected the post. Check the bot is an admin of the channel.
      </p>
    )
  }
  {
    error === 'held' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        This listing cannot be deleted while copies are held by an open order. Cancel or complete
        that order first.
      </p>
    )
  }
  {
    posted === 'draft' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        Not announced - only live listings can be posted to the channel.
      </p>
    )
  }

  <form id="bookForm" method="post" action="/api/admin/books/save" class="grid gap-6 lg:grid-cols-[1fr_300px] items-start">
    <input type="hidden" name="id" value={book?.id ?? ''} />

    <div class="space-y-5">
      <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5 space-y-4">
        <div>
          <label for="title" class="block text-[14.5px] font-medium mb-1.5">Title</label>
          <input id="title" name="title" required maxlength="200" value={book?.title ?? ''} class="field" />
        </div>

        <div>
          <label for="title_ar" class="block text-[14.5px] font-medium mb-1.5">
            Arabic title <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
          </label>
          <input
            id="title_ar"
            name="title_ar"
            dir="rtl"
            maxlength="200"
            value={book?.title_ar ?? ''}
            class="field ar"
          />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="author" class="block text-[14.5px] font-medium mb-1.5">
              Author <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input id="author" name="author" maxlength="160" value={book?.author ?? ''} class="field" />
          </div>
          <div>
            <label for="publisher" class="block text-[14.5px] font-medium mb-1.5">
              Publisher <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input id="publisher" name="publisher" maxlength="160" value={book?.publisher ?? ''} class="field" />
          </div>
          <div>
            <label for="volumes" class="block text-[13px] text-[var(--color-ink-faint)] mb-1">
              Volumes in the set
            </label>
            {/* Blank for an ordinary book. Only a number greater than one is
                shown to anyone - "1 volume" is not worth printing. */}
            <input
              id="volumes"
              name="volumes"
              type="number"
              min="1"
              max="200"
              placeholder="Leave blank unless it is a set"
              value={book?.volumes ?? ''}
              class="field"
            />
          </div>
        </div>

        <div>
          <label for="description" class="block text-[14.5px] font-medium mb-1.5">Description</label>
          <textarea id="description" name="description" rows="7" maxlength="6000" class="field"
            >{htmlToPlainText(book?.description_html)}</textarea
          >
          <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
            Plain text. Blank lines start a new paragraph. The first couple of lines are what
            appears on Telegram.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <label for="price" class="block text-[14.5px] font-medium mb-1.5">Price (£)</label>
            <input
              id="price"
              name="price"
              type="number"
              step="0.01"
              min="0"
              required
              value={((book?.price_pence ?? 0) / 100).toFixed(2)}
              class="field tabular-nums"
            />
          </div>
          <div>
            <label for="stock" class="block text-[14.5px] font-medium mb-1.5">In stock</label>
            <input
              id="stock"
              name="stock"
              type="number"
              min={book?.reserved ?? 0}
              required
              value={book?.stock ?? 1}
              class="field tabular-nums"
            />
            {
              book && book.reserved > 0 && (
                <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
                  {book.reserved} held by open orders
                </p>
              )
            }
          </div>
          <div>
            <label for="status" class="block text-[14.5px] font-medium mb-1.5">Visibility</label>
            <select id="status" name="status" class="field">
              <option value="live" selected={(book?.status ?? 'live') === 'live'}>Live in shop</option>
              <option value="draft" selected={book?.status === 'draft'}>Draft (hidden)</option>
              <option value="archived" selected={book?.status === 'archived'}>Archived</option>
            </select>
          </div>
        </div>
      </section>

      <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
        <h2 class="eyebrow mb-3">Subjects</h2>
        <div class="grid gap-1.5 sm:grid-cols-2 max-h-64 overflow-y-auto">
          {
            categories.map((c) => (
              <label class="flex items-center gap-2 text-[14.5px] cursor-pointer">
                <input
                  type="checkbox"
                  name="categories"
                  value={c.id}
                  checked={selected.has(c.id)}
                  class="w-4 h-4 accent-[var(--color-navy)]"
                />
                <span class:list={[c.parent_id ? 'text-[var(--color-ink-soft)] pl-2' : '']}>
                  {c.name}
                </span>
              </label>
            ))
          }
        </div>
      </section>

      <div>
        <button type="submit" id="saveBtn" class="btn btn-primary">
          {isNew ? 'Create listing' : 'Save changes'}
        </button>
        <p id="saveHint" class="mt-2 text-[13px] text-[var(--color-ink-faint)]">
          {isNew ? '' : 'No unsaved changes.'}
        </p>
      </div>
    </div>

    <aside class="space-y-4">
      <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
        <h2 class="eyebrow mb-3">Photos</h2>

        {
          book && book.images.length > 0 && (
            <ul class="grid grid-cols-3 gap-2 mb-3">
              {book.images.map((img) => (
                <li class="relative">
                  <div class="aspect-[3/4] bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[2px] grid place-items-center overflow-hidden">
                    <img src={imageUrl(img.image_key, 'thumb')} alt="" class="max-h-full max-w-full object-contain" />
                  </div>
                  <button
                    type="button"
                    data-remove-image={img.id}
                    class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-[var(--color-outstock)] text-white text-[12px] leading-none grid place-items-center"
                    title="Remove this photo"
                  >
                    ×
                  </button>
                </li>
              ))}
            </ul>
          )
        }

        {
          isNew ? (
            <p class="text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed">
              Save the listing first, then photos can be added here.
            </p>
          ) : (
            <div>
              <label
                for="photo"
                class="block p-4 text-center border-2 border-dashed border-[var(--color-rule)] rounded-[3px] cursor-pointer hover:border-[var(--color-navy)] transition-colors"
              >
                <span class="text-[14px] text-[var(--color-navy)]">Choose a photo</span>
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mt-0.5">
                  Take one now or pick from your photos
                </span>
              </label>
              <input id="photo" type="file" accept="image/*" class="sr-only" />
              <p id="uploadStatus" class="mt-2 text-[13.5px] text-[var(--color-ink-soft)]" hidden />

              <CoverReview />
            </div>
          )
        }
      </section>

      {/* On a new listing there is nothing to announce or delete yet. Saying so
          beats leaving a gap where the panels will later appear. */}
      {
        isNew && (
          <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
            <h2 class="eyebrow mb-2">Telegram channel</h2>
            <p class="text-[13.5px] text-[var(--color-ink-soft)] leading-relaxed">
              Create the listing first. Posting to the channel appears here once it exists, along
              with a preview of exactly what the channel will see.
            </p>
          </section>
        )
      }

      {
        book && (
          <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
            <h2 class="eyebrow mb-2">Telegram channel</h2>
            {book.telegram_message_id ? (
              <p class="text-[13.5px] text-[var(--color-instock)] mb-3">
                ✓ Announced. Posting again updates that message rather than adding a new one.
              </p>
            ) : (
              <p class="text-[13.5px] text-[var(--color-ink-soft)] mb-3">Not announced yet.</p>
            )}

            <details class="mb-3">
              <summary class="text-[14px] text-[var(--color-navy)] cursor-pointer">
                Preview the post
              </summary>
              <div class="mt-2 p-3 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px]">
                {book.images[0] && (
                  <img
                    src={imageUrl(book.images[0].image_key, 'social')}
                    alt=""
                    class="w-full max-h-40 object-contain mb-2"
                  />
                )}
                <pre class="text-[13px] whitespace-pre-wrap font-[family-name:var(--font-body)] text-[var(--color-ink-soft)] leading-relaxed">{previewCaption}</pre>
              </div>
            </details>

            {botConfigured() ? (
              <>
                <button
                  type="submit"
                  form="telegramForm"
                  id="postBtn"
                  class="btn btn-primary w-full !py-2"
                  disabled={book.status !== 'live' || (!!book.telegram_message_id && !channelStale)}
                  data-blocked={book.status !== 'live' || (!!book.telegram_message_id && !channelStale) ? '1' : '0'}
                  data-reason={
                    book.status !== 'live'
                      ? 'Only live listings can be announced.'
                      : book.telegram_message_id && !channelStale
                        ? 'The channel already matches this listing.'
                        : ''
                  }
                >
                  {book.telegram_message_id ? 'Update channel post' : 'Post to channel'}
                </button>
                <p id="postHint" class="mt-2 text-[12.5px] text-[var(--color-ink-faint)]">
                  {book.status !== 'live'
                    ? 'Only live listings can be announced.'
                    : book.telegram_message_id && !channelStale
                      ? 'The channel already matches this listing.'
                      : ''}
                </p>
              </>
            ) : (
              <p class="text-[13px] text-[var(--color-ink-faint)]">
                Add TELEGRAM_BOT_TOKEN to enable posting.
              </p>
            )}
          </section>
        )
      }

      {/* Only reached when it is wanted. A single book, and a set sold only as
          a whole, stay one ordinary listing with one price and never meet any
          of this. */}
      {
        book && (
          <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
            <h2 class="eyebrow mb-3">Sold in parts</h2>

            {siblings.length > 0 ? (
              <>
                <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed mb-3">
                  This is one way of buying the set. Each way is
                  its own listing with its own price and cover; the shelf count is shared.
                </p>
                <ul class="space-y-1.5 mb-3">
                  {siblings.map((o) => (
                    <li class="flex items-baseline justify-between gap-3 text-[13.5px]">
                      <a
                        href={`/admin/books/${o.id}`}
                        class:list={[
                          'truncate',
                          o.id === book.id ? 'font-medium' : 'text-[var(--color-navy)] underline underline-offset-2',
                        ]}
                      >
                        {o.set_from === o.set_to ? `Volume ${o.set_from}` : `Volumes ${o.set_from}-${o.set_to}`}
                        {o.id === book.id ? ' (this one)' : ''}
                      </a>
                      <span class="text-[var(--color-ink-faint)] shrink-0 tabular-nums">
                        {o.available} left
                      </span>
                    </li>
                  ))}
                </ul>
                <form method="post" action={`/api/admin/books/${book.id}/set`} class="flex items-end gap-2">
                  <input type="hidden" name="action" value="restock" />
                  <label class="block">
                    <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                      Complete sets on the shelf
                    </span>
                    <input
                      type="number"
                      name="sets"
                      min="0"
                      max="999"
                      required
                      class="field !py-2 !text-[14px] !w-40"
                    />
                  </label>
                  <button type="submit" class="btn btn-ghost !py-2 !text-[13.5px]">Set count</button>
                </form>
                <p class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                  Sets every volume to that number. Use it when a delivery arrives - a half sold on
                  its own already came off the volumes it contained.
                </p>
              </>
            ) : (
              <>
                <div class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed mb-3 space-y-2">
                  <p>
                    For a set that can also be bought in parts. <strong>This listing becomes the
                    complete set</strong>, keeping its cover and description; each part you add
                    below becomes a listing of its own.
                  </p>
                  <p class="p-2.5 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px]">
                    <span class="block font-medium text-[var(--color-ink)]">For example</span>
                    A four volume set you hold 3 of. Add two parts: “Volumes 1 to 2” at £17 and
                    “Volumes 3 to 4” at £17. A customer can then buy the whole set or either half.
                    Sell one half and the shop still shows 3 of the other, but only 2 complete sets.
                  </p>
                </div>

                <form method="post" action={`/api/admin/books/${book.id}/set`} class="space-y-3">
                  <input type="hidden" name="action" value="create" />
                  <div class="grid grid-cols-2 gap-3">
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        How many volumes altogether
                      </span>
                      <input type="number" name="volumes" min="2" max="200" required
                        placeholder="4" class="field !py-2 !text-[14px]" />
                    </label>
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Complete sets on the shelf
                      </span>
                      <input type="number" name="sets" min="0" max="999" required
                        placeholder="3" class="field !py-2 !text-[14px]" />
                    </label>
                  </div>

                  {/* Proper fields rather than a line of comma-separated text.
                      Asking someone to type "Volumes 1-2, 1-2, 17.00" into a
                      box invites getting the punctuation wrong, and the name
                      and the range read as the same thing twice. */}
                  <div>
                    <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1.5">
                      The parts it can be split into
                    </span>
                    <div class="space-y-2">
                      {[0, 1, 2, 3].map((i) => (
                        <div class="grid grid-cols-[1fr_3.6rem_3.6rem_4.6rem] gap-1.5 items-center">
                          <input
                            type="text"
                            name={`part_${i}_name`}
                            maxlength="200"
                            placeholder={i === 0 ? 'First half' : i === 1 ? 'Second half' : 'Name'}
                            class="field !py-1.5 !text-[13.5px]"
                          />
                          <input type="number" name={`part_${i}_from`} min="1" max="200"
                            placeholder={i === 0 ? '1' : i === 1 ? '3' : 'from'}
                            class="field !py-1.5 !text-[13.5px] !px-2" />
                          <input type="number" name={`part_${i}_to`} min="1" max="200"
                            placeholder={i === 0 ? '2' : i === 1 ? '4' : 'to'}
                            class="field !py-1.5 !text-[13.5px] !px-2" />
                          <input type="text" name={`part_${i}_price`} inputmode="decimal"
                            placeholder={i < 2 ? '17.00' : '£'}
                            class="field !py-1.5 !text-[13.5px] !px-2" />
                        </div>
                      ))}
                    </div>
                    <p class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      Name, first volume, last volume, price. Leave rows blank if you need fewer.
                      One volume on its own is fine - put the same number in both.
                    </p>
                  </div>

                  <button type="submit" class="btn btn-primary !py-2 !text-[13.5px]">
                    Build the parts
                  </button>
                </form>
              </>
            )}
          </section>
        )
      }

      {
        book && (
          <section class="border border-[var(--color-outstock)]/30 rounded-[3px] p-5">
            <h2 class="eyebrow !text-[var(--color-outstock)] mb-2">Delete</h2>
            <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed">
              Removes this listing for good, with any photos you uploaded
              {book.telegram_message_id ? ' and its post in the channel' : ''}. Past orders keep
              their record of it. To hide it without losing it, set Visibility to Archived.
            </p>
            {book.reserved > 0 && (
              <p class="mt-2 text-[13px] text-[var(--color-outstock)]">
                {book.reserved} {book.reserved === 1 ? 'copy is' : 'copies are'} held by an open
                order, so this cannot be deleted yet.
              </p>
            )}
            <button
              type="submit"
              form="deleteForm"
              class="btn btn-ghost w-full !py-2 mt-3 !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40"
              disabled={book.reserved > 0}
            >
              Delete listing
            </button>
          </section>
        )
      }

      {
        book && (
          <a
            href={`/book/${book.slug}`}
            class="block text-center text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2"
          >
            View in the shop →
          </a>
        )
      }
    </aside>
  </form>

  {/* Outside the main form: forms cannot nest, so the sidebar buttons reach
      these through their `form` attribute instead. */}
  {
    book && (
      <>
        <form id="telegramForm" method="post" action={`/api/admin/books/${book.id}/telegram`} />
        <form id="deleteForm" method="post" action={`/api/admin/books/${book.id}/delete`} />
      </>
    )
  }

  {
    book && (
      <script is:inline nonce={Astro.locals.cspNonce} define:vars={{ bookId: book.id, bookTitle: book.title }}>
        // ------------------------------------------------------------------
        // Save and post are ordered, not parallel. Posting sends whatever is
        // in the database, so offering it while the form has unsaved edits
        // would announce the old version of a listing the owner has just
        // changed. Save is offered only when there is something to save;
        // posting only once there is nothing outstanding.
        // ------------------------------------------------------------------
        const bookForm = document.querySelector('#bookForm');
        const saveBtn = document.querySelector('#saveBtn');
        const saveHint = document.querySelector('#saveHint');
        const postBtn = document.querySelector('#postBtn');
        const postHint = document.querySelector('#postHint');

        const snapshot = () => new URLSearchParams(new FormData(bookForm)).toString();
        let saved = snapshot();

        function sync() {
          const dirty = snapshot() !== saved;

          if (saveBtn) {
            saveBtn.disabled = !dirty;
            saveHint.textContent = dirty ? 'You have unsaved changes.' : 'No unsaved changes.';
          }

          if (postBtn) {
            const blocked = postBtn.dataset.blocked === '1';
            postBtn.disabled = dirty || blocked;
            postHint.textContent = dirty
              ? 'Save your changes first, then post them.'
              : postBtn.dataset.reason || '';
          }
        }

        bookForm?.addEventListener('input', sync);
        bookForm?.addEventListener('change', sync);
        sync();

        // A form submission is about to reload the page; leaving the button
        // enabled invites a second click that posts twice.
        bookForm?.addEventListener('submit', () => {
          if (saveBtn) { saveBtn.disabled = true; saveHint.textContent = 'Saving…'; }
        });

        document.querySelector('#telegramForm')?.addEventListener('submit', () => {
          if (postBtn) { postBtn.disabled = true; postHint.textContent = 'Posting…'; }
        });

        // Confirm in JS rather than an inline onsubmit: a title containing an
        // apostrophe would break the attribute.
        document.querySelector('#deleteForm')?.addEventListener('submit', (event) => {
          const ok = confirm(
            `Delete “${bookTitle}” for good?\n\nIts photos and channel post go too. Past orders keep their record of it.`,
          );
          if (!ok) event.preventDefault();
        });

        const input = document.querySelector('#photo');
        const status = document.querySelector('#uploadStatus');

        /**
         * Shrinks the photo before it leaves the phone, and measures it.
         *
         * A phone camera produces something like 4000px and several megabytes,
         * and the shop never displays a cover larger than about 800. Resizing
         * here also sidesteps HEIC, which iPhones produce and the server does
         * not accept, because the canvas decodes it and hands back WebP.
         *
         * Measured while we are holding the bitmap: the server cannot read
         * dimensions from a stream it passes straight through, and without them
         * the page has nothing to reserve space with, so the grid jumps as the
         * photo loads.
         *
         * The photo itself is not altered - no frame, no background, no mark.
         * There was a frame here briefly, to match a standardising pass over
         * the catalogue; the owner did not want it, and the covers read better
         * as they are.
         *
         * A failure here used to return the original silently, which on a phone
         * that cannot decode HEIC meant several megabytes going to R2 unshrunk.
         * It still sends - refusing the photo would be worse - but it says so.
         */
        const MAX_EDGE = 800;

        async function shrink(file) {
          try {
            const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });

            // Fitted inside, never cropped and never enlarged, so a wide book
            // or a spine keeps all of itself at whatever size it arrived.
            const scale = Math.min(MAX_EDGE / bitmap.width, MAX_EDGE / bitmap.height, 1);
            const w = Math.max(1, Math.round(bitmap.width * scale));
            const h = Math.max(1, Math.round(bitmap.height * scale));

            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);

            const blob = await new Promise((r) => canvas.toBlob(r, 'image/webp', 0.82));
            return blob
              ? { file: new File([blob], 'photo.webp', { type: 'image/webp' }), width: w, height: h }
              : { file, width: bitmap.width, height: bitmap.height };
          } catch {
            return { file, width: null, height: null, failed: true };
          }
        }

        input?.addEventListener('change', async () => {
          const chosen = input.files?.[0];
          if (!chosen) return;
          status.hidden = false;
          status.textContent = 'Preparing…';

          /*
           * Straighten and crop first, and let the owner look at it.
           *
           * Nothing reaches R2 until he has answered: a crooked photo of a book
           * on a kitchen table used to be live the moment it was chosen. If the
           * panel is not on the page - an older browser, a failed module - this
           * is undefined and the upload carries on exactly as it did.
           */
          const original = (await window.coverClean?.review(chosen)) ?? chosen;
          if (!original) {
            // Cancelled. Clear the input so choosing the same file again still
            // fires a change event.
            input.value = '';
            status.hidden = true;
            return;
          }

          status.textContent = 'Preparing…';
          const { file, width, height, failed } = await shrink(original);
          const saved = original.size - file.size;
          status.textContent = failed
            ? 'This phone could not shrink that photo - sending it as it is…'
            : saved > 0
              ? `Uploading… (${Math.round(original.size / 1024)}KB down to ${Math.round(file.size / 1024)}KB)`
              : 'Uploading…';

          const body = new FormData();
          body.append('bookId', String(bookId));
          body.append('photo', file);
          if (width && height) {
            body.append('width', String(width));
            body.append('height', String(height));
          }

          try {
            const res = await fetch('/api/admin/upload', { method: 'POST', body });
            input.value = '';
            if (!res.ok) throw new Error(await res.text());
            status.textContent = 'Uploaded.';
            window.location.reload();
          } catch (err) {
            status.textContent = `Could not upload that photo. ${err}`;
          }
        });

        for (const btn of document.querySelectorAll('[data-remove-image]')) {
          btn.addEventListener('click', async () => {
            if (!confirm('Remove this photo?')) return;
            const body = new FormData();
            body.append('imageId', btn.dataset.removeImage);
            const res = await fetch('/api/admin/upload', { method: 'DELETE', body });
            if (res.ok) window.location.reload();
          });
        }
      </script>
    )
  }
  {/*
    The review panel.

    A bundled module rather than another `is:inline` block: this is far too
    much logic for a script Astro ships verbatim, and it needs to import the
    geometry from src/scripts/cover-clean.ts, which an inline script cannot do.

    It hands itself to the inline uploader through `window.coverClean`, which
    is the whole seam between them - the uploader asks for a file to send and
    gets one back, or null if the owner cancelled.
  */}
  {
    !isNew && (
      <script>
        import { mountCoverReview } from '../../../scripts/cover-review.ts';

        mountCoverReview();
      </script>
    )
  }
</Admin>
