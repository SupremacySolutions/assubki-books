---
import { VAGUE, monthOptions, whenText } from '../../../lib/incoming';
import Admin from '../../../layouts/Admin.astro';
import PoundInput from '../../../components/PoundInput.astro';
import CoverReview from '../../../components/CoverReview.astro';
import { getBookAdmin, partCandidates } from '../../../lib/admin-db';
import { allCategories, categoryCounts, publisherSpellings, setOptionsForOwner } from '../../../lib/db';
import { imageUrl, price, stripTags, truncate, htmlToPlainText } from '../../../lib/format';
import { botConfigured, plainCaption } from '../../../lib/telegram';
import { backInStock } from '../../../lib/publish';
import { parseOffers, type Offer } from '../../../lib/multibuy';

const { id } = Astro.params;
const isNew = id === 'new';
const months = monthOptions();
const bookId = isNew ? null : Number.parseInt(id ?? '', 10);

if (!isNew && (!bookId || Number.isNaN(bookId))) return Astro.rewrite('/404');

const book = bookId ? await getBookAdmin(bookId) : null;

// The other options, when this listing is already part of a set.
const siblings = book?.set_id ? await setOptionsForOwner(book.set_id) : [];
/* The set as a whole: how many volumes it has, which listing is the complete
   set, and how many of the others are parts. A part's own `volumes` is the
   size of that part, so the total is read off the widest range instead. */
const setTotal = siblings.reduce((n, o) => Math.max(n, o.set_to ?? 0), 0);
const wholeId = siblings.find((o) => o.set_from === 1 && o.set_to === setTotal)?.id ?? null;
const partCount = siblings.filter((o) => o.id !== wholeId).length;
/*
 * The parts, which are every listing in the set except the set itself.
 *
 * Keyed off `wholeId` rather than `set_part`, because this page is reached by
 * the whole and the column answers "should the shop browse this row", not
 * "which of these is the parent". They agree, and the suite checks that they do.
 */
const parts = siblings.filter((o) => o.id !== wholeId);
const wholeAvailable = siblings.find((o) => o.id === wholeId)?.available ?? 0;
/*
 * This page is either the listing or one of its parts, and they need different
 * screens. The listing owns the panel where the parts are managed; a part has
 * only its own identity, photo, description and shelves to edit, and showing it
 * the panel invited editing the set from a row that is inside it - with itself
 * missing from the list, since the panel lists the *other* parts.
 */
const isPart = Boolean(book?.set_part);
const parentListing = isPart ? siblings.find((o) => o.id === wholeId) ?? null : null;
/* The builder starts from the volume count already saved, when there is one
   worth splitting. Worked out here because a `>` inside a tag's attribute is
   where the source check for stray builder fields stops reading. */
const builderVolumes = (book?.volumes ?? 0) > 1 ? book!.volumes : '';

/* Listings that already exist and look like parts of this one. Only worth
   asking about for a listing that says it has volumes and is not yet a set. */
const candidates =
  book && !book?.set_id && (book.volumes ?? 0) > 1 ? await partCandidates(book) : [];


if (!isNew && !book) return Astro.rewrite('/404');

const categories = await allCategories();
/* The names already in use, offered as the owner types a publisher so the
   catalogue's publisher list does not split one imprint into three. */
const publishers = await publisherSpellings();
/* How many listings each shelf already holds - the quickest way to recognise
   the shelf you meant among twenty-six similar names. Cached for a minute and
   read as 441 links rather than the rollup that once ate the read budget; see
   `categoryCounts`. */
/* `fresh`: the owner must see the shelf they just moved a book onto, not a
   number the customer-facing cache is still serving for another few minutes. */
const shelfCounts = (await categoryCounts(true)).any;
const selected = new Set(book?.categoryIds ?? []);

/*
 * The nav, and what each entry has to say for itself.
 *
 * Photos, Telegram and the set builder all need a listing that exists, so on a
 * new one they are locked rather than hidden - a section that vanishes reads
 * as missing, one that says why reads as waiting.
 */
const chosenCount = book ? selected.size : 0;
/* Nothing to split, and nothing split yet. */
const partsEmpty = Boolean(book) && !book!.set_id && (book!.volumes ?? 0) <= 1;
/*
 * Arriving straight from a save.
 *
 * The four fields the owner has just typed are the last thing they want to
 * look at; the cover is the first. So on this one arrival they collapse into a
 * line, and on every other visit the page is as it was - the jump nav points
 * into those sections, and an anchor into a closed panel is a dead link.
 */
/** What each refusal from `set.ts` means, in the owner's words. */
const SET_REFUSALS: Record<string, string> = {
  heldsets:
    'That is fewer sets than customers are already holding. Cancel or complete those orders first, or set a number at least as high as what is reserved.',
  notaset: 'This listing is not sold in parts, so there is no shelf count to change.',
  alreadyset: 'This listing is already sold in parts.',
  /*
   * One sentence used to cover all of these.
   *
   * Every refusal from a part row said "one of those rows is half filled in",
   * so an owner who typed volumes 1 to 6 of a four volume set was told a row
   * was half filled in - which it was not - and an owner who filled in nothing
   * at all was told the same. Three mistakes wearing one sentence is how this
   * came to be reported as an error that makes no sense.
   */
  half:
    'One of those rows is half filled in. A part needs all four: a name, a first volume, a last volume and a price - or leave the row completely empty.',
  range:
    'One of those rows covers volumes the set does not have. The first and last volume must be within the number of volumes altogether, and the last cannot come before the first.',
  price: 'One of those rows has a price that is not a number. Write it as 17.00.',
  noparts:
    'No parts were filled in, so there is nothing to build. Fill in at least one row - a name, which volumes it covers, and a price.',
  stranger:
    'One of the listings ticked is not one this page offered, so it was not linked. Reload the page and try again.',
  nonepicked: 'No listings were ticked, so there was nothing to link.',
  heldpart:
    'A customer is holding copies of that part, so it cannot be taken down yet. Complete or cancel their order first, and it comes down after that.',
  heldrange:
    'A customer is holding copies of that part, so the volumes it covers cannot be changed - their order is a claim on the volumes as they were. Its name and price can still be edited.',
  lastpart:
    'That would leave the set with no parts, which is not an edit but a decision to stop selling in parts - use that button instead, so the shelf count goes back onto this listing.',
  nochange: 'Nothing was changed, so nothing was saved.',
  notthelisting:
    'The parts are managed on the listing they belong to, not on a part. Open that listing and edit them there, beside each other.',
  volumes: 'A set needs between 2 and 200 volumes.',
  badaction: 'That form did not say what it wanted to do. Reload the page and try again.',
};

const justSaved = Astro.url.searchParams.get('saved') === '1';

/*
 * Multi-buy offers, as saved, and one empty row to type a new one into - so
 * the form works with scripting off. The "Add another offer" button clones the
 * template for as many more as the owner wants.
 */
const offers: (Offer | null)[] = [...parseOffers(book?.multibuy ?? null), null];

/* A section that cannot be used yet is shown dashed and says why, rather than
   being hidden - a section that vanishes reads as missing, one that explains
   itself reads as waiting. */
const OPEN_PANEL =
  'bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24';
const LOCKED_PANEL =
  'bg-[#faf9f6] border border-dashed border-[var(--color-rule)] rounded-[var(--radius-panel)] p-5 scroll-mt-24';
const SECTIONS = [
  { id: 's-identity', label: 'Identity', badge: null, locked: false, warn: false },
  { id: 's-description', label: 'Description', badge: null, locked: false, warn: false },
  { id: 's-commerce', label: 'Price and stock', badge: null, locked: false, warn: false },
  {
    id: 's-subjects',
    label: 'Subjects',
    badge: chosenCount > 0 ? String(chosenCount) : 'none yet',
    locked: false,
    warn: chosenCount === 0,
  },
  { id: 's-photos', label: 'Photos', badge: isNew ? 'after saving' : String(book?.images.length ?? 0), locked: isNew, warn: false },
  { id: 's-telegram', label: 'Telegram', badge: isNew ? 'after saving' : null, locked: isNew, warn: false },
  { id: 's-parts', label: 'Sold in parts', badge: isNew ? 'after saving' : (siblings.length ? String(siblings.length) : null), locked: isNew, warn: false },
  { id: 's-delete', label: 'Delete', badge: null, locked: isNew, warn: false },
].filter((sec) => !(isNew && sec.id === 's-delete'));
/*
 * A first listing is four steps; an existing one is not.
 *
 * The page is the same form either way - one POST, the same field names, one
 * Save - and the steps are staging over it, shown and hidden in the same
 * document. Nothing navigates, so the unsaved-changes warning is untouched,
 * and with scripting off all four render open one after another with the
 * single Save at the foot, exactly as the page worked before.
 *
 * Description comes after price and stock deliberately. It is the field an
 * owner most often skips, and it should not stand between them and a listing
 * that exists.
 */
const STEPS = [
  { id: 's-identity', n: 1, name: 'The book', hint: 'Title, author, publisher, ISBN' },
  { id: 's-subjects', n: 2, name: 'Subjects', hint: 'The shelves it belongs on' },
  { id: 's-commerce', n: 3, name: 'Price and stock', hint: 'What it costs, how many, visibility' },
  { id: 's-description', n: 4, name: 'Description', hint: 'Anything worth saying, then save' },
];
const STEP_OF: Record<string, number> = Object.fromEntries(STEPS.map((s) => [s.id, s.n]));
/* Only the first pass is staged; `order` puts the four in the step order
   without moving the markup, so one template serves both shapes. */
const stepAttrs = (id: string) =>
  isNew
    ? { 'data-step': String(STEP_OF[id]), style: `order:${STEP_OF[id]}` }
    : { hidden: justSaved };

const posted = Astro.url.searchParams.get('posted');
/*
 * Arrived here straight from a shipment's spare copies.
 *
 * The book has the price, the volumes and the copies already - what it is
 * missing is everything that makes it a listing rather than a line on a
 * packing list. Saying so here is the point of sending the owner to this page
 * instead of publishing the row where it stood.
 */
const fromShipment = Astro.url.searchParams.get('from_shipment');
const error = Astro.url.searchParams.get('e');
const multibuyProblem = error === 'multibuy' ? Astro.url.searchParams.get('m') : null;

// What the channel post will look like, rendered from the same function that
// builds the real caption - so the preview cannot drift from what is sent.
// The channel post is stale when the listing has been saved since it was
// announced. That is what decides whether "Update channel post" does anything,
// so the button can be switched off when there is nothing to send.
// A missing posted_at counts as stale: we cannot show that the channel is up
// to date, and wrongly disabling the button would leave the owner unable to
// push a correction.
const channelStale = Boolean(
  book?.telegram_message_id &&
    (book.telegram_posted_at === null || book.updated_at > book.telegram_posted_at),
);

/*
 * What the shop would write for this listing, as plain text.
 *
 * This is what the box below starts with, so the owner edits the post itself
 * rather than describing changes to it. Built from `plainCaption` and not by
 * unescaping the markdown one: MarkdownV2 escapes every full stop, so the
 * price would reach him as `£3\.75` and come back with the backslash in it.
 */
const generatedCaption = book
  ? plainCaption({
      title: book.title,
      titleAr: book.title_ar ?? book.title_ur,
      pricePence: book.price_pence,
      blurb: truncate(stripTags(book.description_html), 180) || null,
      available: book.available,
      volumes: book.volumes,
      url: `${Astro.url.origin}/book/${book.slug}`,
    })
  : '';

/** His, if he has written one; otherwise the shop's, ready to be edited. */
const captionValue = book?.telegram_caption ?? generatedCaption;

/*
 * A post he wrote before the price or the stock moved.
 *
 * The shop cannot keep a hand-written post true - that is the trade for
 * letting him write it - but it can notice, and saying so is better than a
 * channel quietly advertising last week's price.
 */
const currentPrice = book ? `£${(book.price_pence / 100).toFixed(2)}` : '';
const currentStock = book
  ? book.available > 0 ? `${book.available} available` : 'out of stock'
  : '';
// At nought the shop marks a written post out of stock itself, so only the
// price is left for him to keep true.
const captionStale = Boolean(
  book?.telegram_caption &&
    (!book.telegram_caption.includes(currentPrice) ||
      (book.available > 0 && !book.telegram_caption.includes(currentStock))),
);

/*
 * The channel last said "out of stock" and there are copies again.
 *
 * The post is somewhere up the channel by now, so the button offers a fresh
 * one at the bottom instead - with editing the old one still there for a
 * restock that happens the same afternoon.
 */
const offerRepost = Boolean(book && book.status === 'live' && backInStock(book, book.available));
---

<Admin
  title={isNew ? 'Add a listing' : book!.title}
  sub={isNew ? undefined : `£${(book!.price_pence / 100).toFixed(2)} · ${book!.available} available`}
  back={{ href: '/admin/books', label: 'All listings' }}
>
  {
    error === 'upload' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        That photo could not be saved. Check it is a JPEG, PNG or WebP under 8 MB.
      </p>
    )
  }
  {
    fromShipment && (
      <p class="mb-5 p-3 bg-[var(--color-brass)]/10 border border-[var(--color-brass)]/30 rounded-[3px] text-[14.5px] leading-relaxed">
        Off the shipment and yours to finish. It kept its price, volumes and the
        copies nobody reserved - it still needs an <strong>English title</strong>,
        a cover and a description, and it is a draft until you set it live below.
        {' '}<a href={`/admin/shipments/${fromShipment}`} class="underline">
          Back to the shipment
        </a>.
      </p>
    )
  }
  {
    posted === '1' && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Posted to the Telegram channel.
      </p>
    )
  }
  {
    posted === 'repost' && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Posted again at the bottom of the channel, and the old post taken down.
      </p>
    )
  }
  {
    posted === 'orphan' && (
      <p class="mb-5 p-3 bg-[var(--color-brass)]/10 border border-[var(--color-brass)]/30 rounded-[3px] text-[14.5px] leading-relaxed">
        Posted again at the bottom of the channel, but the old post could not be taken down.
        Delete it in the channel by hand, or give the bot the <em>Delete messages</em> right
        there so it can do this itself next time.
      </p>
    )
  }
  {
    posted === '0' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        Telegram rejected the post. Check the bot is an admin of the channel.
      </p>
    )
  }
  {
    error === 'held' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        This listing cannot be deleted while copies are reserved by an open order. Cancel or complete
        that order first.
      </p>
    )
  }
  {/*
    * Refusals from the set actions.
    *
    * `set.ts` has always redirected with these codes and the page has never
    * rendered any of them, so a refused restock or a mistyped part row changed
    * nothing on screen and said nothing about why. Silence reads as a bug in
    * the button.
    */}
  {
    error && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        {SET_REFUSALS[error] ?? `Something was refused and the page did not know what to call it (${error}). Nothing was changed.`}
      </p>
    )
  }
  {
    posted === 'draft' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        Not announced - only live listings can be posted to the channel.
      </p>
    )
  }

  <form id="bookForm" method="post" action="/api/admin/books/save" class="grid gap-6 lg:grid-cols-[14rem_1fr] items-start">
    <input type="hidden" name="id" value={book?.id ?? ''} />

    {/*
      * A jump nav, not a wizard.
      *
      * These are same-page anchors: nothing navigates, so the unsaved-changes
      * warning keeps working untouched. Splitting this into real steps would
      * have meant either losing that or saving per section, and the page has
      * one Save for a reason.
      */}
    {/*
      * A rail, not a lock.
      *
      * Every entry is clickable in both directions - it is navigation, and an
      * owner who wants to change the price before writing the description
      * should not have to walk back through two screens to do it.
      */}
    {isNew ? (
      <nav class="lg:sticky lg:top-[84px] lg:self-start" aria-label="Steps">
        {/* Narrow screens get the same information in one line. */}
        <div class="lg:hidden flex items-center gap-2.5 mb-3">
          <p id="stepCount" class="text-[13.5px] text-[var(--color-ink-soft)]">Step 1 of 4</p>
          <span class="flex gap-1.5" aria-hidden="true">
            {STEPS.map((step) => (
              <span data-dot={step.n} class="w-2 h-2 rounded-full bg-[var(--color-rule)]"></span>
            ))}
          </span>
        </div>

        <ul class="hidden lg:grid gap-0.5">
          {STEPS.map((step) => (
            <li>
              <button
                type="button"
                data-goto={step.n}
                class="w-full grid grid-cols-[26px_1fr] gap-2.5 items-start text-left px-3 py-2.5 rounded-[10px] hover:bg-[var(--color-wash-soft)]/50 transition-colors"
              >
                <span
                  data-badge={step.n}
                  class="grid place-items-center w-[26px] h-[26px] rounded-full border border-[var(--color-rule)] text-[12.5px] font-medium text-[var(--color-ink-faint)]"
                >{step.n}</span>
                <span class="min-w-0">
                  <span class="flex items-baseline gap-1.5">
                    <span data-name={step.n} class="text-[14px] font-medium text-[var(--color-ink-soft)]">{step.name}</span>
                    {step.id === 's-subjects' && (
                      <span
                        id="subjectsBadge"
                        class:list={[
                          'text-[11.5px]',
                          chosenCount > 0 ? 'text-[var(--color-ink-faint)]' : 'text-[var(--color-outstock)]',
                        ]}
                      >{chosenCount > 0 ? String(chosenCount) : 'none yet'}</span>
                    )}
                  </span>
                  <span class="block mt-0.5 text-[12.5px] leading-snug text-[var(--color-ink-faint)]">{step.hint}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        {/*
          * What has to wait, said once in the rail.
          *
          * These were three full-width dashed panels down the page. They said
          * the right thing and cost a third of the screen to say it.
          */}
        <div class="hidden lg:block mt-4 p-3.5 rounded-[10px] bg-[var(--color-paper)] border border-[var(--color-rule-soft)]">
          <p class="eyebrow">After saving</p>
          <ul class="mt-2.5 grid gap-1.5">
            {['Photos', 'Telegram', 'Sold in parts', 'Delete'].map((label) => (
              <li class="flex items-center gap-2 text-[13px] text-[var(--color-ink-faint)]">
                <span aria-hidden="true">🔒</span>{label}
              </li>
            ))}
          </ul>
          <p class="mt-2.5 text-[12px] leading-relaxed text-[var(--color-ink-faint)]">
            All four need a listing to attach to. Delete is not offered at all until there is
            something to delete.
          </p>
        </div>
      </nav>
    ) : (
    <nav class="hidden lg:block lg:sticky lg:top-[84px] lg:self-start" aria-label="Sections">
      <ul class="space-y-0.5">
        {
          SECTIONS.map((sec) => (
            <li>
              <a
                href={`#${sec.id}`}
                class:list={[
                  'flex items-baseline justify-between gap-2 px-3 py-2 rounded-[var(--radius-field)] text-[14px]',
                  sec.locked
                    ? 'text-[var(--color-ink-faint)]'
                    : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-wash-soft)]/50 hover:text-[var(--color-navy)]',
                ]}
              >
                <span>{sec.label}</span>
                {sec.badge && (
                  <span
                    class:list={[
                      'shrink-0 text-[11.5px]',
                      sec.warn ? 'text-[var(--color-outstock)]' : 'text-[var(--color-ink-faint)]',
                    ]}
                  >{sec.badge}</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 px-3 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
        These jump down the page. It is all one form - one Save at the bottom covers everything.
      </p>
    </nav>
    )}

    <div class:list={['min-w-0', isNew ? 'flex flex-col gap-5' : 'space-y-5']}>
      {/*
        * What was just filled in, folded into a line.
        *
        * Only on the arrival from a save. Every other visit leaves the four
        * sections open, because the jump nav points into them and an anchor
        * into a hidden panel goes nowhere.
        */}
      {justSaved && (
        <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] px-5 py-4 flex flex-wrap items-center gap-4">
          <p class="flex-1 min-w-[16rem] text-[14px] text-[var(--color-ink-soft)]">
            The four things you just filled in -
            <span class="text-[var(--color-ink)]"> identity, description, price and stock, subjects</span>
          </p>
          <a href={`/admin/books/${book!.id}#s-identity`} class="btn btn-ghost !py-2 !text-[13.5px]">
            Edit them
          </a>
        </div>
      )}

      <section id="s-identity" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 space-y-4 scroll-mt-24" {...stepAttrs('s-identity')}>
        {isNew ? (
          <Fragment>
            <p class="eyebrow">Step one</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              Which book is it?
            </h2>
            <p class="mt-2 mb-5 max-w-[62ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              Only the title is required. Everything else on this step can be left empty and filled in later.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-1">Identity</h2>
        )}
        <div>
          <label for="title" class="block text-[14.5px] font-medium mb-1.5">Title</label>
          <input id="title" name="title" required maxlength="200" value={book?.title ?? ''} class="field" />
        </div>

        {/*
          * The two native titles, and with them the book's language.
          *
          * There is no language field to set. Filling in the Arabic title
          * makes this an Arabic book and the Urdu one makes it Urdu; leaving
          * both empty makes it English. That is how the owner describes the
          * catalogue, and deriving it means a listing cannot end up filed
          * under one language while reading as another.
          */}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="title_ar" class="block text-[14.5px] font-medium mb-1.5">
              Arabic title <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input
              id="title_ar"
              name="title_ar"
              dir="rtl"
              maxlength="200"
              value={book?.title_ar ?? ''}
              class="field ar"
            />
          </div>
          <div>
            <label for="title_ur" class="block text-[14.5px] font-medium mb-1.5">
              Urdu title <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input
              id="title_ur"
              name="title_ur"
              dir="rtl"
              lang="ur"
              maxlength="200"
              value={book?.title_ur ?? ''}
              class="field ar"
            />
          </div>
        </div>
        <p class="-mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
          {book
            ? `Filed under ${book.language}. `
            : 'A listing with neither of these is filed as English. '}
          An Arabic title files the book as Arabic, an Urdu title as Urdu, and
          that is what customers filter the catalogue by.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="author" class="block text-[14.5px] font-medium mb-1.5">
              Author <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input id="author" name="author" maxlength="160" value={book?.author ?? ''} class="field" />
          </div>
          <div>
            <label for="publisher" class="block text-[14.5px] font-medium mb-1.5">
              Publisher <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input
              id="publisher"
              name="publisher"
              maxlength="160"
              value={book?.publisher ?? ''}
              list="publisherNames"
              autocomplete="off"
              class="field"
            />
            <datalist id="publisherNames">
              {publishers.map((p) => (
                <option value={p.name} data-count={p.count}>
                  {p.count === 1 ? '1 listing' : `${p.count} listings`}
                </option>
              ))}
            </datalist>
            {/* Filled by the script below when the name looks like one already
                in use under another spelling. Empty, it takes no room. */}
            <p id="publisherHint" class="mt-1.5 text-[12.5px] leading-relaxed text-[var(--color-ink-soft)]" aria-live="polite" hidden>
              Did you mean <button type="button" id="publisherUse" class="font-medium text-[var(--color-navy)] underline underline-offset-2"></button>?
              <span id="publisherUsed" class="text-[var(--color-ink-faint)]"></span>
            </p>
          </div>
          <div>
            <label for="volumes" class="block text-[13px] text-[var(--color-ink-faint)] mb-1">
              Volumes in the set
            </label>
            {/* Blank for an ordinary book. Only a number greater than one is
                shown to anyone - "1 volume" is not worth printing. */}
            <input
              id="volumes"
              name="volumes"
              type="number"
              min="1"
              max="200"
              placeholder="Leave blank unless it is a set"
              value={book?.volumes ?? ''}
              class="field"
            />
          </div>

          {/*
            * The ISBN, and the one field on this page worth leaving empty.
            *
            * It is what Google matches this book against every other seller's
            * copy of it. A wrong one is worse than none - the listing is
            * matched to a different edition and the shop's price then looks
            * wrong beside it - so the lookup offers candidates and a person
            * chooses. Nothing here fills it in on its own.
            */}
          <div class="sm:col-span-2">
            <div class="flex items-baseline justify-between gap-3 mb-1.5">
              <label for="isbn" class="block text-[14.5px] font-medium">
                ISBN <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
              </label>
              <button type="button" id="findIsbn" class="text-[13px] text-[var(--color-navy)] hover:underline underline-offset-2">
                Look it up
              </button>
            </div>
            <input
              id="isbn"
              name="isbn"
              maxlength="20"
              inputmode="numeric"
              placeholder="978…"
              value={book?.isbn ?? ''}
              class="field"
            />
            {error === 'isbn' && (
              <p
                id="isbnError"
                role="alert"
                class="mt-2 flex items-start gap-2 px-3 py-2.5 bg-[var(--color-outstock)]/6 border border-[var(--color-outstock)]/25 rounded-[9px] text-[13px] leading-relaxed text-[var(--color-outstock)]"
              >
                <span aria-hidden="true">!</span>
                <span>That is not a real ISBN - the check digit does not add up. Correct it, or
                clear the field: a wrong number matches this listing to a different book.</span>
              </p>
            )}
            <p id="isbnNote" class="mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
              Used by Google to match this against the same book elsewhere. Leave it blank if you
              are not sure which edition this is - a wrong one is worse than none.
            </p>
            <div id="isbnList" hidden class="mt-2 grid gap-1.5"></div>
          </div>
        </div>

        </section>

        <section id="s-description" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24" {...stepAttrs('s-description')}>
          {isNew ? (
          <Fragment>
            <p class="eyebrow">Step four</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              Anything to say about it
            </h2>
            <p class="mt-2 mb-5 max-w-[62ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              Plain text. Blank lines start a new paragraph. The first couple of lines are what appears on Telegram.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-3">Description</h2>
        )}
        <div>
          <label for="description" class="block text-[14.5px] font-medium mb-1.5">Description</label>
          <textarea id="description" name="description" rows="7" maxlength="6000" class="field"
            >{htmlToPlainText(book?.description_html)}</textarea
          >
          <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
            Plain text. Blank lines start a new paragraph. The first couple of lines are what
            appears on Telegram.
          </p>
        </div>

        </section>

        <section id="s-commerce" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24" {...stepAttrs('s-commerce')}>
          {isNew ? (
          <Fragment>
            <p class="eyebrow">Step three</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              What it costs and how many you have
            </h2>
            <p class="mt-2 mb-5 max-w-[62ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              A draft is saved and kept out of the shop until you set it live.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-3">Price, stock and visibility</h2>
        )}
        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <label for="price" class="block text-[14.5px] font-medium mb-1.5">Price (£)</label>
            <PoundInput
              id="price"
              name="price"
              min="0"
              required
              value={((book?.price_pence ?? 0) / 100).toFixed(2)}
            />
          </div>
          <div>
            <label for="stock" class="block text-[14.5px] font-medium mb-1.5">In stock</label>
            <input
              id="stock"
              name="stock"
              type="number"
              min={book?.reserved ?? 0}
              required
              value={book?.stock ?? 1}
              class="field tabular-nums"
            />
            {
              book && book.reserved > 0 && (
                <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
                  {book.reserved} reserved by open orders
                </p>
              )
            }
          </div>

          <div>
            <label for="status" class="block text-[14.5px] font-medium mb-1.5">Visibility</label>
            <select id="status" name="status" class="field">
              <option value="live" selected={(book?.status ?? 'live') === 'live'}>Live in shop</option>
              <option value="draft" selected={book?.status === 'draft'}>Draft (hidden)</option>
              <option value="archived" selected={book?.status === 'archived'}>Archived</option>
            </select>
          </div>
        </div>

          {/*
            * Multi-buy prices.
            *
            * Two kinds, as many of each as the owner wants: exactly N copies
            * for a total, and N or more at a price each. The customer is
            * charged the cheapest combination - see src/lib/multibuy.ts - and
            * never a multi-buy price cut again by a sale.
            */}
          <div id="multibuy" class="pt-4 mt-4 border-t border-[var(--color-rule-faint)] scroll-mt-24">
            <p class="text-[14.5px] font-medium">Multi-buy prices</p>
            <p class="mt-0.5 mb-3 text-[13px] text-[var(--color-ink-faint)] leading-relaxed max-w-[62ch]">
              Optional. Customers see "Multi-buy discounts available" on the listing and pay the
              cheapest combination of these and the price above. Leave a row blank to have no offer.
            </p>

            {multibuyProblem && (
              <p role="alert" class="mb-3 flex items-start gap-1.5 text-[13px] text-[var(--color-outstock)]">
                <span aria-hidden="true">!</span><span>{multibuyProblem}</span>
              </p>
            )}

            <div id="mbRows" class="space-y-2">
              {offers.map((o) => (
                <div data-mb-row class="flex flex-wrap items-center gap-2">
                  {/* Read left to right as a sentence: "10 copies or more at
                      £12.50 each", "20 copies exactly for £220.00 in total". */}
                  <input type="number" name="mb_qty" min="2" max="999" placeholder="10"
                    aria-label="Number of copies" value={o?.qty ?? ''}
                    class="field !w-20 !py-1.5 !text-[13.5px] !px-2 tabular-nums" />
                  <span class="text-[13px] text-[var(--color-ink-soft)]">copies</span>
                  <select name="mb_kind" aria-label="Exactly that many, or that many or more"
                    class="field !w-auto !py-1.5 !text-[13.5px]">
                    <option value="bundle" selected={o?.kind !== 'from'}>exactly</option>
                    <option value="from" selected={o?.kind === 'from'}>or more</option>
                  </select>
                  <span data-mb-joiner class="text-[13px] text-[var(--color-ink-soft)]">
                    {o?.kind === 'from' ? 'at' : 'for'}
                  </span>
                  <div class="flex items-center w-28 rounded-[var(--radius-field)] border border-[var(--color-rule)] bg-white focus-within:border-[var(--color-navy)]">
                    <span class="pl-2.5 text-[13.5px] text-[var(--color-ink-faint)]">£</span>
                    <input type="text" name="mb_price" inputmode="decimal" placeholder="0.00"
                      aria-label="Price" value={o ? (o.pence / 100).toFixed(2) : ''}
                      class="w-full bg-transparent border-0 outline-none py-1.5 pl-1 pr-2 text-[13.5px] tabular-nums" />
                  </div>
                  <span data-mb-unit class="text-[13px] text-[var(--color-ink-soft)]">
                    {o?.kind === 'from' ? 'each' : 'in total'}
                  </span>
                  <button type="button" data-mb-remove
                    class="text-[12.5px] text-[var(--color-ink-faint)] hover:text-[var(--color-outstock)] underline underline-offset-2">
                    Remove
                  </button>
                  <span data-mb-hint class="basis-full text-[12.5px] text-[var(--color-ink-faint)]"></span>
                </div>
              ))}
            </div>

            <button type="button" id="mbAdd"
              class="mt-3 text-[13.5px] font-medium text-[var(--color-navy)] hover:underline underline-offset-2">
              + Add another offer
            </button>
          </div>

      </section>

      <section id="s-subjects" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24" {...stepAttrs('s-subjects')}>
        {isNew ? (
          <Fragment>
            <p class="eyebrow">Step two</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              Which shelves does it belong on?
            </h2>
            <p class="mt-2 max-w-[64ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              Pick as many as fit. A book in Dars Nizami and Fiqh appears under both.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-3">Subjects</h2>
        )}

        <p
          id="subjectsHead"
          class:list={[
            'mt-2 mb-3 text-[13.5px]',
            chosenCount > 0 ? 'text-[var(--color-ink-soft)]' : 'text-[var(--color-outstock)]',
          ]}
        >
          {chosenCount > 0
            ? `${chosenCount} chosen`
            : 'None chosen - a listing with no subject cannot be browsed to'}
        </p>

        {/* An enhancement: with scripting off the box is not there and the
            whole list is, which is how the page worked before. */}
        <div data-subject-filter hidden class="mb-3">
          <input
            type="search"
            id="subjectFilter"
            placeholder={`Filter the ${categories.length} subjects`}
            class="field !py-2 !text-[14px] max-w-[20rem]"
            aria-label="Filter the subject list"
          />
        </div>

        {/*
          * Three columns, and a label that never breaks across one.
          *
          * Twenty-six checkboxes in two columns ran past the height of the
          * panel; in three they fit, and the box scrolls rather than the page.
          */}
        <div class="grid gap-x-4 gap-y-1.5 sm:grid-cols-2 lg:grid-cols-3 max-h-[186px] overflow-y-auto pr-1">
          {
            categories.map((c) => (
              <label
                data-subject
                data-name={c.name.toLowerCase()}
                class="flex items-baseline gap-2 text-[14.5px] cursor-pointer break-inside-avoid"
              >
                <input
                  type="checkbox"
                  name="categories"
                  value={c.id}
                  checked={selected.has(c.id)}
                  class="w-4 h-4 accent-[var(--color-navy)] shrink-0"
                />
                <span class:list={['min-w-0', c.parent_id ? 'text-[var(--color-ink-soft)] pl-2' : '']}>
                  {c.name}
                  <span class="ml-1.5 text-[11.5px] text-[var(--color-ink-faint)] tabular-nums">
                    {shelfCounts.get(c.id) ?? 0}
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <p data-subject-empty hidden class="mt-2 text-[13px] text-[var(--color-ink-faint)]">
          No subject matches that.
        </p>
        <p class="mt-3 text-[12.5px] leading-relaxed text-[var(--color-ink-faint)] max-w-[70ch]">
          Indented subjects sit inside the one named above them, exactly as the catalogue nests
          them. The number is how many listings are already there - useful for spotting the shelf
          you meant.
        </p>
      </section>

      {/* Everything below was a sidebar. One column now, so the page reads top
          to bottom in the order the work actually happens. */}
      <section
        id="s-photos"
        class:list={[isNew ? LOCKED_PANEL : OPEN_PANEL]}
        hidden={isNew}
        style={isNew ? 'order:8' : undefined}
      >
        <h2 class="eyebrow mb-3">Photos</h2>

        {
          book && book.images.length > 0 && (
            <ul class="grid grid-cols-3 gap-2 mb-3">
              {book!.images.map((img, i) => (
                <li class="relative">
                  <div class="aspect-[5/7] bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[2px] grid place-items-center overflow-hidden">
                    <img
                      src={imageUrl(img.image_key, 'thumb')}
                      alt=""
                      class:list={[i === 0 ? 'h-full w-full object-cover' : 'max-h-full max-w-full object-contain']}
                    />
                  </div>
                  <button
                    type="button"
                    data-remove-image={img.id}
                    class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-[var(--color-outstock)] text-white text-[12px] leading-none grid place-items-center"
                    title="Remove this photo"
                  >
                    ×
                  </button>
                </li>
              ))}
            </ul>
          )
        }

        {
          isNew ? (
            <p class="text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed flex items-start gap-2">
              <span aria-hidden="true" class="shrink-0">🔒</span>
              Available once the listing is saved - a photo needs something to attach to.
            </p>
          ) : (
            <div>
              {/*
                * Two doors of the same size. Finding one is quicker when it
                * works and often does not; a photo of the book on the desk
                * always works. Neither is a fallback in small print.
                */}
              {(book?.images.length ?? 0) === 0 && (
                <div id="coverStart" class="grid gap-3 sm:grid-cols-2 mb-4">
                  <button
                    type="button"
                    id="findCover"
                    class="text-left p-4 bg-white border border-[var(--color-rule-soft)] rounded-[10px] hover:border-[var(--color-navy)] transition-colors"
                  >
                    <span class="block text-[14.5px] font-medium text-[var(--color-navy)]">Find a cover</span>
                    <span class="block mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      Searches Open Library editions and Google Books using the title and author.
                    </span>
                  </button>
                  {/*
                    * The upload door is the file control itself, not a second
                    * button beside one. Two ways to reach the same input read
                    * as two different things, and with scripting off this one
                    * still works while its neighbour does not.
                    */}
                  <label
                    for="photo"
                    class="block text-left p-4 bg-white border border-[var(--color-rule-soft)] rounded-[10px] cursor-pointer hover:border-[var(--color-navy)] transition-colors"
                  >
                    <span class="block text-[14.5px] font-medium text-[var(--color-navy)]">Upload one myself</span>
                    <span class="block mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      A photo of the book on your desk is often the best one there is.
                    </span>
                  </label>
                </div>
              )}

              {/* What came back, or did not. */}
              <div id="coverResults" hidden class="mb-4">
                <p id="coverCount" class="text-[13.5px] font-medium mb-2"></p>
                <p id="coverTerms" class="text-[12.5px] text-[var(--color-ink-faint)] mb-3"></p>

                <div id="coverGrid" class="space-y-5"></div>

                <div id="coverRetry" hidden class="mt-3">
                  <label class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                    Try different words - accents and punctuation are optional
                  </label>
                  <div class="flex flex-wrap gap-2">
                    <input id="coverWords" class="field !py-2 !text-[14px] flex-1 min-w-[12rem]" />
                    <button type="button" id="coverGo" class="btn btn-ghost !py-2 !text-[13.5px]">Search</button>
                  </div>
                </div>

                <p id="coverNote" class="mt-3 pt-3 border-t border-[var(--color-rule-faint)] text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                  Up to eight results from each source are shown. Covers use the same full-bleed
                  preview as the shop. Nothing is attached until you accept it, and nothing is saved
                  until you save the page.
                </p>
              </div>

              <label
                for="photo"
                class:list={[
                  'block p-4 text-center border-2 border-dashed border-[var(--color-rule)] rounded-[3px] cursor-pointer hover:border-[var(--color-navy)] transition-colors',
                  (book?.images.length ?? 0) === 0 && 'hidden',
                ]}
              >
                <span class="text-[14px] text-[var(--color-navy)]">Add another photo</span>
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mt-0.5">
                  Take one now or pick from your photos
                </span>
              </label>
              <input id="photo" type="file" accept="image/*" class="sr-only" />
              <p id="uploadStatus" class="mt-2 text-[13.5px] text-[var(--color-ink-soft)]" hidden />

              <CoverReview />
            </div>
          )
        }
      </section>


      {
        book && (
          <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24">
            <h2 class="eyebrow mb-2">Telegram channel</h2>
            {offerRepost ? (
              <p class="text-[13.5px] text-[var(--color-ink-soft)] mb-3 leading-relaxed">
                Back in stock. The channel post still says it is out of stock, and it is a long way
                up the channel by now.
              </p>
            ) : book.telegram_message_id ? (
              <p class="text-[13.5px] text-[var(--color-instock)] mb-3">
                ✓ Announced. Posting again updates that message rather than adding a new one.
                The count keeps itself up to date as copies sell.
              </p>
            ) : (
              <p class="text-[13.5px] text-[var(--color-ink-soft)] mb-3">Not announced yet.</p>
            )}

            <details class="mb-3" open={Boolean(book.telegram_caption) || captionStale}>
              <summary class="text-[14px] text-[var(--color-navy)] cursor-pointer">
                The post, and the photos that go with it
              </summary>
              <div class="mt-2 p-3 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px]">
                {/* Every photo, because every photo is what goes to the
                    channel now - a preview showing only the cover would be
                    telling the owner something that is no longer true. */}
                {book.images.length > 0 && (
                  <div class="flex gap-1.5 overflow-x-auto mb-2 pb-1">
                    {book.images.slice(0, 10).map((img) => (
                      <img
                        src={imageUrl(img.image_key, 'social')}
                        alt=""
                        class="h-28 w-28 shrink-0 object-contain bg-white rounded-[3px] border border-[var(--color-rule-soft)]"
                      />
                    ))}
                  </div>
                )}
                {book.images.length > 10 && (
                  <p class="text-[12px] text-[var(--color-ink-faint)] mb-2">
                    Telegram allows ten photos in one post; the first ten go.
                  </p>
                )}
                {/* What the shop would have written, so the server can tell
                    "he left it alone" from "he wrote one that happens to read
                    the same". Sent as a field rather than compared in the
                    browser, so it still works with scripting off. */}
                {captionStale && (
                  <p class="mb-2 text-[13px] text-[var(--color-outstock)] leading-relaxed">
                    This post no longer matches the listing - it says something other than
                    {' '}{currentPrice} or {currentStock}. A post you have written is yours to
                    keep true; the button below puts the written-for-you version back.
                  </p>
                )}
                <input type="hidden" name="telegram_caption_generated" form="telegramForm" value={generatedCaption} />
                <textarea
                  id="telegram_caption"
                  name="telegram_caption"
                  form="telegramForm"
                  rows="12"
                  maxlength="1024"
                  data-generated={generatedCaption}
                  class="field !text-[13px] leading-relaxed font-[family-name:var(--font-body)]"
                >{captionValue}</textarea>
                <div class="mt-2 flex flex-wrap items-center gap-3">
                  <button
                    type="button"
                    id="resetCaption"
                    class="btn btn-ghost !py-1 !text-[13px]"
                  >
                    Back to the written-for-you version
                  </button>
                  <span class="text-[12.5px] text-[var(--color-ink-faint)]">
                    {book.telegram_caption
                      ? 'You are writing this one.'
                      : 'Written for you, and kept up to date until you change it.'}
                  </span>
                </div>
              </div>
            </details>

            {botConfigured() ? (
              <>
                <button
                  type="submit"
                  form="telegramForm"
                  id="postBtn"
                  class="btn btn-primary w-full !py-2"
                  disabled={book.status !== 'live'}
                  data-blocked={book.status !== 'live' ? '1' : '0'}
                  data-reason={book.status !== 'live' ? 'Only live listings can be announced.' : ''}
                >
                  {offerRepost
                    ? 'Repost to channel'
                    : book.telegram_message_id
                      ? 'Update channel post'
                      : 'Post to channel'}
                </button>
                <p id="postHint" class="mt-2 text-[12.5px] text-[var(--color-ink-faint)]">
                  {book.status !== 'live'
                    ? 'Only live listings can be announced.'
                    : offerRepost
                      ? 'Posts it again at the bottom of the channel and takes the old post down.'
                      : 'Sends the post above and remembers it. Nothing else on this page needs saving first.'}
                </p>
                {/*
                  * Whichever the button does not do, offered underneath it.
                  *
                  * The automatic choice only knows about stock: it reposts a
                  * listing that has been sold out long enough to have been
                  * scrolled past, and edits in place otherwise. Neither test can
                  * see that the photographs were replaced, or that a post nobody
                  * ever ordered from is simply buried - so the other action is
                  * always one press away rather than unreachable.
                  */}
                {offerRepost ? (
                  <button
                    type="submit"
                    form="telegramForm"
                    formaction={`/api/admin/books/${book.id}/telegram?mode=edit`}
                    id="postEditBtn"
