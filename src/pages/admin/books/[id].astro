---
import { VAGUE, monthOptions, whenText } from '../../../lib/incoming';
import Admin from '../../../layouts/Admin.astro';
import CoverReview from '../../../components/CoverReview.astro';
import { getBookAdmin, partCandidates } from '../../../lib/admin-db';
import { allCategories, categoryCounts, setOptionsForOwner } from '../../../lib/db';
import { imageUrl, price, stripTags, truncate, htmlToPlainText } from '../../../lib/format';
import { botConfigured, plainCaption } from '../../../lib/telegram';

const { id } = Astro.params;
const isNew = id === 'new';
const months = monthOptions();
const bookId = isNew ? null : Number.parseInt(id ?? '', 10);

if (!isNew && (!bookId || Number.isNaN(bookId))) return Astro.rewrite('/404');

const book = bookId ? await getBookAdmin(bookId) : null;

// The other options, when this listing is already part of a set.
const siblings = book?.set_id ? await setOptionsForOwner(book.set_id) : [];

/* Listings that already exist and look like parts of this one. Only worth
   asking about for a listing that says it has volumes and is not yet a set. */
const candidates =
  book && !book?.set_id && (book.volumes ?? 0) > 1 ? await partCandidates(book) : [];


if (!isNew && !book) return Astro.rewrite('/404');

const categories = await allCategories();
/* How many listings each shelf already holds - the quickest way to recognise
   the shelf you meant among twenty-six similar names. Cached for a minute and
   read as 441 links rather than the rollup that once ate the read budget; see
   `categoryCounts`. */
const shelfCounts = (await categoryCounts()).any;
const selected = new Set(book?.categoryIds ?? []);

/*
 * The nav, and what each entry has to say for itself.
 *
 * Photos, Telegram and the set builder all need a listing that exists, so on a
 * new one they are locked rather than hidden - a section that vanishes reads
 * as missing, one that says why reads as waiting.
 */
const chosenCount = book ? selected.size : 0;
/* Nothing to split, and nothing split yet. */
const partsEmpty = Boolean(book) && !book!.set_id && (book!.volumes ?? 0) <= 1;
/*
 * Arriving straight from a save.
 *
 * The four fields the owner has just typed are the last thing they want to
 * look at; the cover is the first. So on this one arrival they collapse into a
 * line, and on every other visit the page is as it was - the jump nav points
 * into those sections, and an anchor into a closed panel is a dead link.
 */
const justSaved = Astro.url.searchParams.get('saved') === '1';

/* A section that cannot be used yet is shown dashed and says why, rather than
   being hidden - a section that vanishes reads as missing, one that explains
   itself reads as waiting. */
const OPEN_PANEL =
  'bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24';
const LOCKED_PANEL =
  'bg-[#faf9f6] border border-dashed border-[var(--color-rule)] rounded-[var(--radius-panel)] p-5 scroll-mt-24';
const SECTIONS = [
  { id: 's-identity', label: 'Identity', badge: null, locked: false, warn: false },
  { id: 's-description', label: 'Description', badge: null, locked: false, warn: false },
  { id: 's-commerce', label: 'Price and stock', badge: null, locked: false, warn: false },
  {
    id: 's-subjects',
    label: 'Subjects',
    badge: chosenCount > 0 ? String(chosenCount) : 'none yet',
    locked: false,
    warn: chosenCount === 0,
  },
  { id: 's-photos', label: 'Photos', badge: isNew ? 'after saving' : String(book?.images.length ?? 0), locked: isNew, warn: false },
  { id: 's-telegram', label: 'Telegram', badge: isNew ? 'after saving' : null, locked: isNew, warn: false },
  { id: 's-parts', label: 'Sold in parts', badge: isNew ? 'after saving' : (siblings.length ? String(siblings.length) : null), locked: isNew, warn: false },
  { id: 's-delete', label: 'Delete', badge: null, locked: isNew, warn: false },
].filter((sec) => !(isNew && sec.id === 's-delete'));
/*
 * A first listing is four steps; an existing one is not.
 *
 * The page is the same form either way - one POST, the same field names, one
 * Save - and the steps are staging over it, shown and hidden in the same
 * document. Nothing navigates, so the unsaved-changes warning is untouched,
 * and with scripting off all four render open one after another with the
 * single Save at the foot, exactly as the page worked before.
 *
 * Description comes after price and stock deliberately. It is the field an
 * owner most often skips, and it should not stand between them and a listing
 * that exists.
 */
const STEPS = [
  { id: 's-identity', n: 1, name: 'The book', hint: 'Title, author, publisher, ISBN' },
  { id: 's-subjects', n: 2, name: 'Subjects', hint: 'The shelves it belongs on' },
  { id: 's-commerce', n: 3, name: 'Price and stock', hint: 'What it costs, how many, visibility' },
  { id: 's-description', n: 4, name: 'Description', hint: 'Anything worth saying, then save' },
];
const STEP_OF: Record<string, number> = Object.fromEntries(STEPS.map((s) => [s.id, s.n]));
/* Only the first pass is staged; `order` puts the four in the step order
   without moving the markup, so one template serves both shapes. */
const stepAttrs = (id: string) =>
  isNew
    ? { 'data-step': String(STEP_OF[id]), style: `order:${STEP_OF[id]}` }
    : { hidden: justSaved };

const posted = Astro.url.searchParams.get('posted');
/*
 * Arrived here straight from a shipment's spare copies.
 *
 * The book has the price, the volumes and the copies already - what it is
 * missing is everything that makes it a listing rather than a line on a
 * packing list. Saying so here is the point of sending the owner to this page
 * instead of publishing the row where it stood.
 */
const fromShipment = Astro.url.searchParams.get('from_shipment');
const error = Astro.url.searchParams.get('e');

// What the channel post will look like, rendered from the same function that
// builds the real caption - so the preview cannot drift from what is sent.
// The channel post is stale when the listing has been saved since it was
// announced. That is what decides whether "Update channel post" does anything,
// so the button can be switched off when there is nothing to send.
// A missing posted_at counts as stale: we cannot show that the channel is up
// to date, and wrongly disabling the button would leave the owner unable to
// push a correction.
const channelStale = Boolean(
  book?.telegram_message_id &&
    (book.telegram_posted_at === null || book.updated_at > book.telegram_posted_at),
);

/*
 * What the shop would write for this listing, as plain text.
 *
 * This is what the box below starts with, so the owner edits the post itself
 * rather than describing changes to it. Built from `plainCaption` and not by
 * unescaping the markdown one: MarkdownV2 escapes every full stop, so the
 * price would reach him as `£3\.75` and come back with the backslash in it.
 */
const generatedCaption = book
  ? plainCaption({
      title: book.title,
      titleAr: book.title_ar ?? book.title_ur,
      pricePence: book.price_pence,
      blurb: truncate(stripTags(book.description_html), 180) || null,
      available: book.available,
      volumes: book.volumes,
      url: `${Astro.url.origin}/book/${book.slug}`,
    })
  : '';

/** His, if he has written one; otherwise the shop's, ready to be edited. */
const captionValue = book?.telegram_caption ?? generatedCaption;

/*
 * A post he wrote before the price or the stock moved.
 *
 * The shop cannot keep a hand-written post true - that is the trade for
 * letting him write it - but it can notice, and saying so is better than a
 * channel quietly advertising last week's price.
 */
const currentPrice = book ? `£${(book.price_pence / 100).toFixed(2)}` : '';
const currentStock = book
  ? book.available > 0 ? `${book.available} available` : 'out of stock'
  : '';
const captionStale = Boolean(
  book?.telegram_caption &&
    (!book.telegram_caption.includes(currentPrice) ||
      !book.telegram_caption.includes(currentStock)),
);
---

<Admin
  title={isNew ? 'Add a listing' : book!.title}
  sub={isNew ? undefined : `£${(book!.price_pence / 100).toFixed(2)} · ${book!.available} available`}
  back={{ href: '/admin/books', label: 'All listings' }}
>
  {
    error === 'upload' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        That photo could not be saved. Check it is a JPEG, PNG or WebP under 8 MB.
      </p>
    )
  }
  {
    fromShipment && (
      <p class="mb-5 p-3 bg-[var(--color-brass)]/10 border border-[var(--color-brass)]/30 rounded-[3px] text-[14.5px] leading-relaxed">
        Off the shipment and yours to finish. It kept its price, volumes and the
        copies nobody reserved — it still needs an <strong>English title</strong>,
        a cover and a description, and it is a draft until you set it live below.
        {' '}<a href={`/admin/shipments/${fromShipment}`} class="underline">
          Back to the shipment
        </a>.
      </p>
    )
  }
  {
    posted === '1' && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Posted to the Telegram channel.
      </p>
    )
  }
  {
    posted === '0' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        Telegram rejected the post. Check the bot is an admin of the channel.
      </p>
    )
  }
  {
    error === 'held' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        This listing cannot be deleted while copies are reserved by an open order. Cancel or complete
        that order first.
      </p>
    )
  }
  {
    posted === 'draft' && (
      <p class="mb-5 p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        Not announced - only live listings can be posted to the channel.
      </p>
    )
  }

  <form id="bookForm" method="post" action="/api/admin/books/save" class="grid gap-6 lg:grid-cols-[14rem_1fr] items-start">
    <input type="hidden" name="id" value={book?.id ?? ''} />

    {/*
      * A jump nav, not a wizard.
      *
      * These are same-page anchors: nothing navigates, so the unsaved-changes
      * warning keeps working untouched. Splitting this into real steps would
      * have meant either losing that or saving per section, and the page has
      * one Save for a reason.
      */}
    {/*
      * A rail, not a lock.
      *
      * Every entry is clickable in both directions - it is navigation, and an
      * owner who wants to change the price before writing the description
      * should not have to walk back through two screens to do it.
      */}
    {isNew ? (
      <nav class="lg:sticky lg:top-[84px] lg:self-start" aria-label="Steps">
        {/* Narrow screens get the same information in one line. */}
        <div class="lg:hidden flex items-center gap-2.5 mb-3">
          <p id="stepCount" class="text-[13.5px] text-[var(--color-ink-soft)]">Step 1 of 4</p>
          <span class="flex gap-1.5" aria-hidden="true">
            {STEPS.map((step) => (
              <span data-dot={step.n} class="w-2 h-2 rounded-full bg-[var(--color-rule)]"></span>
            ))}
          </span>
        </div>

        <ul class="hidden lg:grid gap-0.5">
          {STEPS.map((step) => (
            <li>
              <button
                type="button"
                data-goto={step.n}
                class="w-full grid grid-cols-[26px_1fr] gap-2.5 items-start text-left px-3 py-2.5 rounded-[10px] hover:bg-[var(--color-wash-soft)]/50 transition-colors"
              >
                <span
                  data-badge={step.n}
                  class="grid place-items-center w-[26px] h-[26px] rounded-full border border-[var(--color-rule)] text-[12.5px] font-medium text-[var(--color-ink-faint)]"
                >{step.n}</span>
                <span class="min-w-0">
                  <span class="flex items-baseline gap-1.5">
                    <span data-name={step.n} class="text-[14px] font-medium text-[var(--color-ink-soft)]">{step.name}</span>
                    {step.id === 's-subjects' && (
                      <span
                        id="subjectsBadge"
                        class:list={[
                          'text-[11.5px]',
                          chosenCount > 0 ? 'text-[var(--color-ink-faint)]' : 'text-[var(--color-outstock)]',
                        ]}
                      >{chosenCount > 0 ? String(chosenCount) : 'none yet'}</span>
                    )}
                  </span>
                  <span class="block mt-0.5 text-[12.5px] leading-snug text-[var(--color-ink-faint)]">{step.hint}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        {/*
          * What has to wait, said once in the rail.
          *
          * These were three full-width dashed panels down the page. They said
          * the right thing and cost a third of the screen to say it.
          */}
        <div class="hidden lg:block mt-4 p-3.5 rounded-[10px] bg-[var(--color-paper)] border border-[var(--color-rule-soft)]">
          <p class="eyebrow">After saving</p>
          <ul class="mt-2.5 grid gap-1.5">
            {['Photos', 'Telegram', 'Sold in parts', 'Delete'].map((label) => (
              <li class="flex items-center gap-2 text-[13px] text-[var(--color-ink-faint)]">
                <span aria-hidden="true">🔒</span>{label}
              </li>
            ))}
          </ul>
          <p class="mt-2.5 text-[12px] leading-relaxed text-[var(--color-ink-faint)]">
            All four need a listing to attach to. Delete is not offered at all until there is
            something to delete.
          </p>
        </div>
      </nav>
    ) : (
    <nav class="hidden lg:block lg:sticky lg:top-[84px] lg:self-start" aria-label="Sections">
      <ul class="space-y-0.5">
        {
          SECTIONS.map((sec) => (
            <li>
              <a
                href={`#${sec.id}`}
                class:list={[
                  'flex items-baseline justify-between gap-2 px-3 py-2 rounded-[var(--radius-field)] text-[14px]',
                  sec.locked
                    ? 'text-[var(--color-ink-faint)]'
                    : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-wash-soft)]/50 hover:text-[var(--color-navy)]',
                ]}
              >
                <span>{sec.label}</span>
                {sec.badge && (
                  <span
                    class:list={[
                      'shrink-0 text-[11.5px]',
                      sec.warn ? 'text-[var(--color-outstock)]' : 'text-[var(--color-ink-faint)]',
                    ]}
                  >{sec.badge}</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 px-3 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
        These jump down the page. It is all one form - one Save at the bottom covers everything.
      </p>
    </nav>
    )}

    <div class:list={['min-w-0', isNew ? 'flex flex-col gap-5' : 'space-y-5']}>
      {/*
        * What was just filled in, folded into a line.
        *
        * Only on the arrival from a save. Every other visit leaves the four
        * sections open, because the jump nav points into them and an anchor
        * into a hidden panel goes nowhere.
        */}
      {justSaved && (
        <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] px-5 py-4 flex flex-wrap items-center gap-4">
          <p class="flex-1 min-w-[16rem] text-[14px] text-[var(--color-ink-soft)]">
            The four things you just filled in —
            <span class="text-[var(--color-ink)]"> identity, description, price and stock, subjects</span>
          </p>
          <a href={`/admin/books/${book!.id}#s-identity`} class="btn btn-ghost !py-2 !text-[13.5px]">
            Edit them
          </a>
        </div>
      )}

      <section id="s-identity" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 space-y-4 scroll-mt-24" {...stepAttrs('s-identity')}>
        {isNew ? (
          <Fragment>
            <p class="eyebrow">Step one</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              Which book is it?
            </h2>
            <p class="mt-2 mb-5 max-w-[62ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              Only the title is required. Everything else on this step can be left empty and filled in later.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-1">Identity</h2>
        )}
        <div>
          <label for="title" class="block text-[14.5px] font-medium mb-1.5">Title</label>
          <input id="title" name="title" required maxlength="200" value={book?.title ?? ''} class="field" />
        </div>

        {/*
          * The two native titles, and with them the book's language.
          *
          * There is no language field to set. Filling in the Arabic title
          * makes this an Arabic book and the Urdu one makes it Urdu; leaving
          * both empty makes it English. That is how the owner describes the
          * catalogue, and deriving it means a listing cannot end up filed
          * under one language while reading as another.
          */}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="title_ar" class="block text-[14.5px] font-medium mb-1.5">
              Arabic title <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input
              id="title_ar"
              name="title_ar"
              dir="rtl"
              maxlength="200"
              value={book?.title_ar ?? ''}
              class="field ar"
            />
          </div>
          <div>
            <label for="title_ur" class="block text-[14.5px] font-medium mb-1.5">
              Urdu title <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input
              id="title_ur"
              name="title_ur"
              dir="rtl"
              lang="ur"
              maxlength="200"
              value={book?.title_ur ?? ''}
              class="field ar"
            />
          </div>
        </div>
        <p class="-mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
          {book
            ? `Filed under ${book.language}. `
            : 'A listing with neither of these is filed as English. '}
          An Arabic title files the book as Arabic, an Urdu title as Urdu, and
          that is what customers filter the catalogue by.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="author" class="block text-[14.5px] font-medium mb-1.5">
              Author <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input id="author" name="author" maxlength="160" value={book?.author ?? ''} class="field" />
          </div>
          <div>
            <label for="publisher" class="block text-[14.5px] font-medium mb-1.5">
              Publisher <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
            </label>
            <input id="publisher" name="publisher" maxlength="160" value={book?.publisher ?? ''} class="field" />
          </div>
          <div>
            <label for="volumes" class="block text-[13px] text-[var(--color-ink-faint)] mb-1">
              Volumes in the set
            </label>
            {/* Blank for an ordinary book. Only a number greater than one is
                shown to anyone - "1 volume" is not worth printing. */}
            <input
              id="volumes"
              name="volumes"
              type="number"
              min="1"
              max="200"
              placeholder="Leave blank unless it is a set"
              value={book?.volumes ?? ''}
              class="field"
            />
          </div>

          {/*
            * The ISBN, and the one field on this page worth leaving empty.
            *
            * It is what Google matches this book against every other seller's
            * copy of it. A wrong one is worse than none - the listing is
            * matched to a different edition and the shop's price then looks
            * wrong beside it - so the lookup offers candidates and a person
            * chooses. Nothing here fills it in on its own.
            */}
          <div class="sm:col-span-2">
            <div class="flex items-baseline justify-between gap-3 mb-1.5">
              <label for="isbn" class="block text-[14.5px] font-medium">
                ISBN <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
              </label>
              <button type="button" id="findIsbn" class="text-[13px] text-[var(--color-navy)] hover:underline underline-offset-2">
                Look it up
              </button>
            </div>
            <input
              id="isbn"
              name="isbn"
              maxlength="20"
              inputmode="numeric"
              placeholder="978…"
              value={book?.isbn ?? ''}
              class="field"
            />
            {error === 'isbn' && (
              <p
                id="isbnError"
                role="alert"
                class="mt-2 flex items-start gap-2 px-3 py-2.5 bg-[var(--color-outstock)]/6 border border-[var(--color-outstock)]/25 rounded-[9px] text-[13px] leading-relaxed text-[var(--color-outstock)]"
              >
                <span aria-hidden="true">!</span>
                <span>That is not a real ISBN — the check digit does not add up. Correct it, or
                clear the field: a wrong number matches this listing to a different book.</span>
              </p>
            )}
            <p id="isbnNote" class="mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
              Used by Google to match this against the same book elsewhere. Leave it blank if you
              are not sure which edition this is - a wrong one is worse than none.
            </p>
            <div id="isbnList" hidden class="mt-2 grid gap-1.5"></div>
          </div>
        </div>

        </section>

        <section id="s-description" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24" {...stepAttrs('s-description')}>
          {isNew ? (
          <Fragment>
            <p class="eyebrow">Step four</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              Anything to say about it
            </h2>
            <p class="mt-2 mb-5 max-w-[62ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              Plain text. Blank lines start a new paragraph. The first couple of lines are what appears on Telegram.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-3">Description</h2>
        )}
        <div>
          <label for="description" class="block text-[14.5px] font-medium mb-1.5">Description</label>
          <textarea id="description" name="description" rows="7" maxlength="6000" class="field"
            >{htmlToPlainText(book?.description_html)}</textarea
          >
          <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
            Plain text. Blank lines start a new paragraph. The first couple of lines are what
            appears on Telegram.
          </p>
        </div>

        </section>

        <section id="s-commerce" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24" {...stepAttrs('s-commerce')}>
          {isNew ? (
          <Fragment>
            <p class="eyebrow">Step three</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              What it costs and how many you have
            </h2>
            <p class="mt-2 mb-5 max-w-[62ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              A draft is saved and kept out of the shop until you set it live.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-3">Price, stock and visibility</h2>
        )}
        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <label for="price" class="block text-[14.5px] font-medium mb-1.5">Price (£)</label>
            <input
              id="price"
              name="price"
              type="number"
              step="0.01"
              inputmode="decimal"
              min="0"
              required
              value={((book?.price_pence ?? 0) / 100).toFixed(2)}
              class="field tabular-nums"
            />
          </div>
          <div>
            <label for="stock" class="block text-[14.5px] font-medium mb-1.5">In stock</label>
            <input
              id="stock"
              name="stock"
              type="number"
              min={book?.reserved ?? 0}
              required
              value={book?.stock ?? 1}
              class="field tabular-nums"
            />
            {
              book && book.reserved > 0 && (
                <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
                  {book.reserved} reserved by open orders
                </p>
              )
            }
          </div>

          <div>
            <label for="status" class="block text-[14.5px] font-medium mb-1.5">Visibility</label>
            <select id="status" name="status" class="field">
              <option value="live" selected={(book?.status ?? 'live') === 'live'}>Live in shop</option>
              <option value="draft" selected={book?.status === 'draft'}>Draft (hidden)</option>
              <option value="archived" selected={book?.status === 'archived'}>Archived</option>
            </select>
          </div>
        </div>

          {/*
            * A delivery on its way.
            *
            * Separate from "In stock" because it is a different kind of fact:
            * stock is what is on the shelf, this is a promise about what will
            * be. Customers can claim against it, and the two numbers are never
            * added together anywhere.
            */}
          {/*
            * Behind a tick, because almost no listing has a delivery coming and
            * an always-visible "How many coming: 0" reads as something nobody
            * filled in rather than something switched off.
            *
            * The dimming is CSS on the group, not JavaScript, so it behaves
            * with scripting off - and the save route reads the tick first, so
            * clearing it is also how a delivery gets cancelled.
            */}
          <div class="group pt-4 mt-4 border-t border-[var(--color-rule-faint)]">
            <label class="flex items-start gap-2.5 cursor-pointer select-none">
              <input
                type="checkbox"
                name="has_incoming"
                checked={(book?.incoming ?? 0) > 0}
                class="w-4 h-4 mt-0.5 accent-[var(--color-navy)]"
              />
              <span>
                <span class="block text-[14.5px] font-medium">A delivery is on its way</span>
                <span class="block mt-0.5 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
                  Tick this to let customers reserve copies before they arrive.
                </span>
              </span>
            </label>

            <div class="mt-4 delivery-fields">
            <div class="flex flex-wrap items-end gap-3">
              <label class="block">
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">How many coming</span>
                <input
                  name="incoming"
                  type="number"
                  min={book?.reserved_incoming ?? 0}
                  max="999"
                  value={book?.incoming ?? 0}
                  class="field !w-40 tabular-nums"
                />
              </label>

              <label class="block">
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">Roughly when</span>
                <select name="incoming_vague" class="field !w-36">
                  {VAGUE.map((v) => (
                    <option value={v.value} selected={(book?.incoming_vague ?? 'mid') === v.value}>
                      {v.label}
                    </option>
                  ))}
                </select>
              </label>

              <label class="block">
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1 sr-only">Month</span>
                <select name="incoming_month" class="field !w-44">
                  <option value="">Not said</option>
                  {months.map((m) => (
                    <option value={m.value} selected={book?.incoming_month === m.value}>{m.label}</option>
                  ))}
                </select>
              </label>
            </div>

            <p class="mt-2 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
              Be vague about when - a month you will beat is better than a date you might miss.
            </p>

            {book && book.incoming > 0 && (
              <div class="mt-3 flex flex-wrap items-center gap-2.5">
                <p class="text-[13.5px] text-[var(--color-ink-soft)]">
                  Customers read:{' '}
                  <strong class="text-[var(--color-ink)]">
                    {book.incoming} {book.incoming === 1 ? 'copy' : 'copies'} expected
                    {whenText(book.incoming_vague, book.incoming_month)
                      ? ` ${whenText(book.incoming_vague, book.incoming_month)}`
                      : ' shortly'}
                  </strong>
                </p>
                {book.reserved_incoming > 0 && (
                  <span class="rounded-[var(--radius-pill)] bg-[var(--color-brass)]/12 px-3 py-1 text-[12.5px] font-medium text-[var(--color-brass)]">
                    {book.reserved_incoming} already reserved
                  </span>
                )}
              </div>
            )}
            </div>
          </div>
      </section>

      <section id="s-subjects" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24" {...stepAttrs('s-subjects')}>
        {isNew ? (
          <Fragment>
            <p class="eyebrow">Step two</p>
            <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[21px] font-semibold">
              Which shelves does it belong on?
            </h2>
            <p class="mt-2 max-w-[64ch] text-[14px] leading-relaxed text-[var(--color-ink-soft)]">
              Pick as many as fit. A book in Dars Nizami and Fiqh appears under both.
            </p>
          </Fragment>
        ) : (
          <h2 class="eyebrow mb-3">Subjects</h2>
        )}

        <p
          id="subjectsHead"
          class:list={[
            'mt-2 mb-3 text-[13.5px]',
            chosenCount > 0 ? 'text-[var(--color-ink-soft)]' : 'text-[var(--color-outstock)]',
          ]}
        >
          {chosenCount > 0
            ? `${chosenCount} chosen`
            : 'None chosen — a listing with no subject cannot be browsed to'}
        </p>

        {/* An enhancement: with scripting off the box is not there and the
            whole list is, which is how the page worked before. */}
        <div data-subject-filter hidden class="mb-3">
          <input
            type="search"
            id="subjectFilter"
            placeholder={`Filter the ${categories.length} subjects`}
            class="field !py-2 !text-[14px] max-w-[20rem]"
            aria-label="Filter the subject list"
          />
        </div>

        {/*
          * Three columns, and a label that never breaks across one.
          *
          * Twenty-six checkboxes in two columns ran past the height of the
          * panel; in three they fit, and the box scrolls rather than the page.
          */}
        <div class="grid gap-x-4 gap-y-1.5 sm:grid-cols-2 lg:grid-cols-3 max-h-[186px] overflow-y-auto pr-1">
          {
            categories.map((c) => (
              <label
                data-subject
                data-name={c.name.toLowerCase()}
                class="flex items-baseline gap-2 text-[14.5px] cursor-pointer break-inside-avoid"
              >
                <input
                  type="checkbox"
                  name="categories"
                  value={c.id}
                  checked={selected.has(c.id)}
                  class="w-4 h-4 accent-[var(--color-navy)] shrink-0"
                />
                <span class:list={['min-w-0', c.parent_id ? 'text-[var(--color-ink-soft)] pl-2' : '']}>
                  {c.name}
                  <span class="ml-1.5 text-[11.5px] text-[var(--color-ink-faint)] tabular-nums">
                    {shelfCounts.get(c.id) ?? 0}
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <p data-subject-empty hidden class="mt-2 text-[13px] text-[var(--color-ink-faint)]">
          No subject matches that.
        </p>
        <p class="mt-3 text-[12.5px] leading-relaxed text-[var(--color-ink-faint)] max-w-[70ch]">
          Indented subjects sit inside the one named above them, exactly as the catalogue nests
          them. The number is how many listings are already there — useful for spotting the shelf
          you meant.
        </p>
      </section>

      {/* Everything below was a sidebar. One column now, so the page reads top
          to bottom in the order the work actually happens. */}
      <section
        id="s-photos"
        class:list={[isNew ? LOCKED_PANEL : OPEN_PANEL]}
        hidden={isNew}
        style={isNew ? 'order:8' : undefined}
      >
        <h2 class="eyebrow mb-3">Photos</h2>

        {
          book && book.images.length > 0 && (
            <ul class="grid grid-cols-3 gap-2 mb-3">
              {book!.images.map((img, i) => (
                <li class="relative">
                  <div class="aspect-[5/7] bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[2px] grid place-items-center overflow-hidden">
                    <img
                      src={imageUrl(img.image_key, 'thumb')}
                      alt=""
                      class:list={[i === 0 ? 'h-full w-full object-cover' : 'max-h-full max-w-full object-contain']}
                    />
                  </div>
                  <button
                    type="button"
                    data-remove-image={img.id}
                    class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-[var(--color-outstock)] text-white text-[12px] leading-none grid place-items-center"
                    title="Remove this photo"
                  >
                    ×
                  </button>
                </li>
              ))}
            </ul>
          )
        }

        {
          isNew ? (
            <p class="text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed flex items-start gap-2">
              <span aria-hidden="true" class="shrink-0">🔒</span>
              Available once the listing is saved - a photo needs something to attach to.
            </p>
          ) : (
            <div>
              {/*
                * Two doors of the same size. Finding one is quicker when it
                * works and often does not; a photo of the book on the desk
                * always works. Neither is a fallback in small print.
                */}
              {(book?.images.length ?? 0) === 0 && (
                <div id="coverStart" class="grid gap-3 sm:grid-cols-2 mb-4">
                  <button
                    type="button"
                    id="findCover"
                    class="text-left p-4 bg-white border border-[var(--color-rule-soft)] rounded-[10px] hover:border-[var(--color-navy)] transition-colors"
                  >
                    <span class="block text-[14.5px] font-medium text-[var(--color-navy)]">Find a cover</span>
                    <span class="block mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      Searches Open Library editions and Google Books using the title and author.
                    </span>
                  </button>
                  {/*
                    * The upload door is the file control itself, not a second
                    * button beside one. Two ways to reach the same input read
                    * as two different things, and with scripting off this one
                    * still works while its neighbour does not.
                    */}
                  <label
                    for="photo"
                    class="block text-left p-4 bg-white border border-[var(--color-rule-soft)] rounded-[10px] cursor-pointer hover:border-[var(--color-navy)] transition-colors"
                  >
                    <span class="block text-[14.5px] font-medium text-[var(--color-navy)]">Upload one myself</span>
                    <span class="block mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      A photo of the book on your desk is often the best one there is.
                    </span>
                  </label>
                </div>
              )}

              {/* What came back, or did not. */}
              <div id="coverResults" hidden class="mb-4">
                <p id="coverCount" class="text-[13.5px] font-medium mb-2"></p>
                <p id="coverTerms" class="text-[12.5px] text-[var(--color-ink-faint)] mb-3"></p>

                <div id="coverGrid" class="space-y-5"></div>

                <div id="coverRetry" hidden class="mt-3">
                  <label class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                    Try different words - accents and punctuation are optional
                  </label>
                  <div class="flex flex-wrap gap-2">
                    <input id="coverWords" class="field !py-2 !text-[14px] flex-1 min-w-[12rem]" />
                    <button type="button" id="coverGo" class="btn btn-ghost !py-2 !text-[13.5px]">Search</button>
                  </div>
                </div>

                <p id="coverNote" class="mt-3 pt-3 border-t border-[var(--color-rule-faint)] text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                  Up to eight results from each source are shown. Covers use the same full-bleed
                  preview as the shop. Nothing is attached until you accept it, and nothing is saved
                  until you save the page.
                </p>
              </div>

              <label
                for="photo"
                class:list={[
                  'block p-4 text-center border-2 border-dashed border-[var(--color-rule)] rounded-[3px] cursor-pointer hover:border-[var(--color-navy)] transition-colors',
                  (book?.images.length ?? 0) === 0 && 'hidden',
                ]}
              >
                <span class="text-[14px] text-[var(--color-navy)]">Add another photo</span>
                <span class="block text-[12.5px] text-[var(--color-ink-faint)] mt-0.5">
                  Take one now or pick from your photos
                </span>
              </label>
              <input id="photo" type="file" accept="image/*" class="sr-only" />
              <p id="uploadStatus" class="mt-2 text-[13.5px] text-[var(--color-ink-soft)]" hidden />

              <CoverReview />
            </div>
          )
        }
      </section>


      {
        book && (
          <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 scroll-mt-24">
            <h2 class="eyebrow mb-2">Telegram channel</h2>
            {book.telegram_message_id ? (
              <p class="text-[13.5px] text-[var(--color-instock)] mb-3">
                ✓ Announced. Posting again updates that message rather than adding a new one.
              </p>
            ) : (
              <p class="text-[13.5px] text-[var(--color-ink-soft)] mb-3">Not announced yet.</p>
            )}

            <details class="mb-3" open={Boolean(book.telegram_caption) || captionStale}>
              <summary class="text-[14px] text-[var(--color-navy)] cursor-pointer">
                The post, and the photos that go with it
              </summary>
              <div class="mt-2 p-3 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px]">
                {/* Every photo, because every photo is what goes to the
                    channel now - a preview showing only the cover would be
                    telling the owner something that is no longer true. */}
                {book.images.length > 0 && (
                  <div class="flex gap-1.5 overflow-x-auto mb-2 pb-1">
                    {book.images.slice(0, 10).map((img) => (
                      <img
                        src={imageUrl(img.image_key, 'social')}
                        alt=""
                        class="h-28 w-28 shrink-0 object-contain bg-white rounded-[3px] border border-[var(--color-rule-soft)]"
                      />
                    ))}
                  </div>
                )}
                {book.images.length > 10 && (
                  <p class="text-[12px] text-[var(--color-ink-faint)] mb-2">
                    Telegram allows ten photos in one post; the first ten go.
                  </p>
                )}
                {/* What the shop would have written, so the server can tell
                    "he left it alone" from "he wrote one that happens to read
                    the same". Sent as a field rather than compared in the
                    browser, so it still works with scripting off. */}
                {captionStale && (
                  <p class="mb-2 text-[13px] text-[var(--color-outstock)] leading-relaxed">
                    This post no longer matches the listing - it says something other than
                    {' '}{currentPrice} or {currentStock}. A post you have written is yours to
                    keep true; the button below puts the written-for-you version back.
                  </p>
                )}
                <input type="hidden" name="telegram_caption_generated" form="telegramForm" value={generatedCaption} />
                <textarea
                  id="telegram_caption"
                  name="telegram_caption"
                  form="telegramForm"
                  rows="12"
                  maxlength="1024"
                  data-generated={generatedCaption}
                  class="field !text-[13px] leading-relaxed font-[family-name:var(--font-body)]"
                >{captionValue}</textarea>
                <div class="mt-2 flex flex-wrap items-center gap-3">
                  <button
                    type="button"
                    id="resetCaption"
                    class="btn btn-ghost !py-1 !text-[13px]"
                  >
                    Back to the written-for-you version
                  </button>
                  <span class="text-[12.5px] text-[var(--color-ink-faint)]">
                    {book.telegram_caption
                      ? 'You are writing this one.'
                      : 'Written for you, and kept up to date until you change it.'}
                  </span>
                </div>
              </div>
            </details>

            {botConfigured() ? (
              <>
                <button
                  type="submit"
                  form="telegramForm"
                  id="postBtn"
                  class="btn btn-primary w-full !py-2"
                  disabled={book.status !== 'live'}
                  data-blocked={book.status !== 'live' ? '1' : '0'}
                  data-reason={book.status !== 'live' ? 'Only live listings can be announced.' : ''}
                >
                  {book.telegram_message_id ? 'Update channel post' : 'Post to channel'}
                </button>
                <p id="postHint" class="mt-2 text-[12.5px] text-[var(--color-ink-faint)]">
                  {book.status !== 'live'
                    ? 'Only live listings can be announced.'
                    : 'Sends the post above and remembers it. Nothing else on this page needs saving first.'}
                </p>
              </>
            ) : (
              <p class="text-[13px] text-[var(--color-ink-faint)]">
                Add TELEGRAM_BOT_TOKEN to enable posting.
              </p>
            )}
          </section>
        )
      }


      {
        book && (
          <>
      {/* The delivery has landed. Green rule: this is the finishing of
          something, not a warning. */}
      {book && book.incoming > 0 && (
        <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] border-l-[3px] border-l-[var(--color-instock)] p-5">
          <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
            Has this delivery arrived?
          </h2>
          <p class="mt-1.5 text-[14px] text-[var(--color-ink-soft)] leading-relaxed">
            {book.incoming} expected
            {whenText(book.incoming_vague, book.incoming_month)
              ? `, ${whenText(book.incoming_vague, book.incoming_month)}`
              : ''}
            {book.reserved_incoming > 0
              ? ` · ${book.reserved_incoming} already reserved by customers`
              : ' · none reserved yet'}
          </p>

          <div class="mt-4 flex items-end gap-2">
            <label class="block">
              <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">How many arrived</span>
              <input
                name="arrived"
                type="number"
                min="1"
                max="999"
                value={book.incoming}
                form="arrivedForm"
                class="field !w-40 tabular-nums"
              />
            </label>
            <button type="submit" form="arrivedForm" class="btn btn-primary !py-2 !text-[14px]">
              Release the reservations
            </button>
          </div>

          <p class="mt-2.5 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
            Those copies go on the shelf and the reservations against them become ordinary orders,
            oldest first. If fewer arrive than were claimed, the rest stay reserved and wait for the
            next delivery - they are never cancelled.
          </p>
        </section>
      )}

          <section
            id="s-parts"
            data-parts-panel
            class:list={[
              'p-5 scroll-mt-24 rounded-[var(--radius-panel)]',
              partsEmpty
                ? 'bg-[#faf9f6] border border-dashed border-[var(--color-rule)]'
                : 'bg-white border border-[var(--color-rule-soft)]',
            ]}
          >
            <h2 class="eyebrow mb-3">Sold in parts</h2>
            {/*
              * Open, but with nothing to build from.
              *
              * A single book cannot be split, and the builder asking for a
              * first and last volume of a one-volume book is a form that
              * cannot be filled in. Saying what it needs is shorter than
              * hiding the section and leaving a gap where it will appear.
              *
              * It is a wait, not a wall. Type a volume count above one in
              * Identity and the builder opens underneath without a save -
              * `partsForm` posts its own volume count anyway, so nothing here
              * needed the saved value except the decision to show it.
              */}
            {siblings.length > 0 ? (
              <>
                <div class="flex items-center gap-2.5 mb-3">
                  <span class="rounded-[var(--radius-pill)] bg-[var(--color-navy)]/10 px-3 py-1 text-[12.5px] font-medium text-[var(--color-navy)]">
                    {siblings.length} {siblings.length === 1 ? 'part' : 'parts'} live
                  </span>
                  <span class="text-[13px] text-[var(--color-ink-faint)]">
                    {book.volumes} volumes altogether
                  </span>
                </div>

                <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed mb-3">
                  Each of these is its own listing with its own price and cover. The shelf count is
                  shared between them.
                </p>

                <ul class="space-y-1.5 mb-4">
                  {siblings.map((o) => (
                    <li class="flex items-baseline justify-between gap-3 text-[13.5px]">
                      <a
                        href={`/admin/books/${o.id}`}
                        class:list={[
                          'truncate',
                          o.id === book.id ? 'font-medium' : 'text-[var(--color-navy)] underline underline-offset-2',
                        ]}
                      >
                        {o.set_from === o.set_to ? `Volume ${o.set_from}` : `Volumes ${o.set_from}-${o.set_to}`}
                        {o.id === book.id ? ' (this one)' : ''}
                      </a>
                      <span class="text-[var(--color-ink-faint)] shrink-0 tabular-nums">
                        {o.available} left
                      </span>
                    </li>
                  ))}
                </ul>

                <div class="bg-[var(--color-paper-raised)] border border-[var(--color-rule-soft)] rounded-[10px] p-4">
                  <p class="text-[13px] font-medium mb-2">A delivery has come in</p>
                  <div class="flex items-end gap-2">
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Complete sets on the shelf
                      </span>
                      <input
                        type="number"
                        name="sets"
                        min="0"
                        max="999"
                        required
                        form="restockForm"
                        class="field !py-2 !text-[14px] !w-40"
                      />
                    </label>
                    <button type="submit" form="restockForm" class="btn btn-ghost !py-2 !text-[13.5px]">
                      Update
                    </button>
                  </div>
                  <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                    Sets every volume to that number and every part recalculates from it. A half sold
                    on its own already came off the volumes it contained.
                  </p>
                </div>

                <div class="mt-4 pt-4 border-t border-[var(--color-rule-faint)]">
                  <button
                    type="submit"
                    form="unsplitForm"
                    class="rounded-[var(--radius-pill)] border border-[var(--color-outstock)]/40 px-4 py-2 text-[13.5px] text-[var(--color-outstock)] hover:bg-[var(--color-outstock)]/5 transition-colors"
                    data-confirm="Stop selling this set in parts? The part listings come down. The complete set stays, and orders that already contain a part keep their record."
                  >
                    Stop selling in parts
                  </button>
                  <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                    The part listings come down and the complete set stays. Orders that already
                    contain a part keep their record.
                  </p>
                </div>
              </>
            ) : (
              <>
                <p
                  data-parts-wait
                  hidden={!partsEmpty}
                  class="text-[13.5px] leading-relaxed text-[var(--color-ink-faint)] max-w-[70ch]"
                >
                  Empty for a single book: it needs more than one volume in the set. Put the number
                  of volumes in “Volumes in the set” above and this becomes the part builder.
                </p>
                <div data-parts-builder hidden={partsEmpty}>
                {/*
                  * The example sits above the grid and uses the same four
                  * columns, so each value is under the header it belongs to.
                  * It does not scroll away and does not vanish on focus, which
                  * is what a placeholder does exactly when it is needed.
                  */}
                {candidates.length > 0 && (
                  <div class="mb-5 pb-5 border-b border-[var(--color-rule-faint)]">
                    <p class="text-[13px] font-medium mb-1">These look like parts of this set</p>
                    <p class="text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed mb-3">
                      Already in the catalogue with their own covers and descriptions. Linking them
                      keeps all of that - nothing is created and nothing comes down.
                    </p>

                    <div class="grid grid-cols-2 gap-3 mb-3">
                      <label class="block">
                        <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                          Volumes altogether
                        </span>
                        <input type="number" name="volumes" min="2" max="200" required
                          value={book.volumes ?? ''} form="adoptForm"
                          class="field !py-2 !text-[14px]" />
                      </label>
                      <label class="block">
                        <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                          Complete sets on the shelf
                        </span>
                        <input type="number" name="sets" min="0" max="999" required
                          value={book.stock} form="adoptForm"
                          class="field !py-2 !text-[14px]" />
                      </label>
                    </div>

                    <div class="grid grid-cols-[auto_1fr_3.6rem_3.6rem] gap-2 pb-1.5 mb-1.5 border-b border-[var(--color-rule-soft)]">
                      <span />
                      {['Listing', 'First', 'Last'].map((h) => (
                        <span class="text-[10.5px] font-semibold tracking-[0.14em] uppercase text-[var(--color-ink-faint)]">
                          {h}
                        </span>
                      ))}
                    </div>

                    <div class="space-y-2">
                      {candidates.map((c) => (
                        <label class="grid grid-cols-[auto_1fr_3.6rem_3.6rem] gap-2 items-center cursor-pointer">
                          <input type="checkbox" name={`adopt_${c.id}`} form="adoptForm"
                            class="w-4 h-4 accent-[var(--color-navy)]" />
                          <span class="min-w-0 truncate text-[13.5px]">
                            {c.title}
                            <span class="ml-1.5 text-[var(--color-ink-faint)]">{price(c.price_pence)}</span>
                          </span>
                          <input type="number" name={`from_${c.id}`} min="1" max="200" placeholder="1"
                            form="adoptForm" class="field !py-1.5 !text-[13.5px] !px-2 tabular-nums" />
                          <input type="number" name={`to_${c.id}`} min="1" max="200" placeholder="2"
                            form="adoptForm" class="field !py-1.5 !text-[13.5px] !px-2 tabular-nums" />
                        </label>
                      ))}
                    </div>

                    <button type="submit" form="adoptForm" class="btn btn-primary !py-2 !text-[13.5px] mt-3">
                      Link these as the parts
                    </button>
                    <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      Tick the ones that belong, and say which volumes each covers.
                    </p>
                  </div>
                )}

                <div class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed mb-3">
                  <p>
                    <strong class="text-[var(--color-ink)]">This listing becomes the complete set</strong>,
                    keeping its cover and description. Each part below becomes a listing of its own,
                    drawing on one shared count.
                  </p>
                </div>

                <div class="bg-[var(--color-paper-raised)] border border-[var(--color-rule-soft)] rounded-[10px] p-3 mb-4">
                  <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[var(--color-ink-faint)] mb-2">
                    For example
                  </p>
                  <div class="grid grid-cols-[1fr_.8fr_.8fr_1fr] gap-1.5 text-[13px]">
                    <span class="text-[var(--color-ink)]">Volumes 1-2</span>
                    <span class="tabular-nums text-[var(--color-ink)]">1</span>
                    <span class="tabular-nums text-[var(--color-ink)]">2</span>
                    <span class="tabular-nums text-[var(--color-ink)]">17.00</span>
                    <span class="text-[var(--color-ink)]">Volumes 3-4</span>
                    <span class="tabular-nums text-[var(--color-ink)]">3</span>
                    <span class="tabular-nums text-[var(--color-ink)]">4</span>
                    <span class="tabular-nums text-[var(--color-ink)]">17.00</span>
                  </div>
                  <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                    A four volume set, sold whole or as either half. Parts may overlap or leave gaps
                    - it is your shelf.
                  </p>
                </div>

                <div class="space-y-3">
                  <input type="hidden" name="action" value="create" form="partsForm" />

                  <div class="grid grid-cols-2 gap-3">
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Volumes altogether
                      </span>
                      <input type="number" name="volumes" min="2" max="200" required
                        placeholder="4" form="partsForm" class="field !py-2 !text-[14px]" />
                    </label>
                    <label class="block">
                      <span class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Complete sets on the shelf
                      </span>
                      <input type="number" name="sets" min="0" max="999" required
                        placeholder="3" form="partsForm" class="field !py-2 !text-[14px]" />
                    </label>
                  </div>

                  {/* Headers that stay. The only labelling used to be placeholder
                      text, which disappears the moment anyone types into it. */}
                  <div>
                    <div class="grid grid-cols-[1fr_.8fr_.8fr_1fr] gap-1.5 pb-1.5 mb-1.5 border-b border-[var(--color-rule-soft)]">
                      {['Name of the part', 'First volume', 'Last volume', 'Price'].map((h) => (
                        <span class="text-[10.5px] font-semibold tracking-[0.14em] uppercase text-[var(--color-ink-faint)]">
                          {h}
                        </span>
                      ))}
                    </div>

                    <div class="space-y-1.5">
                      {[0, 1, 2, 3].map((i) => (
                        <div class="grid grid-cols-[1fr_.8fr_.8fr_1fr] gap-1.5 items-center">
                          <input
                            type="text"
                            name={`part_${i}_name`}
                            maxlength="200"
                            placeholder="Volumes 1-2"
                            form="partsForm"
                            class="field !py-1.5 !text-[13.5px]"
                          />
                          <input type="number" name={`part_${i}_from`} min="1" max="200"
                            placeholder="1" form="partsForm"
                            class="field !py-1.5 !text-[13.5px] !px-2 tabular-nums" />
                          <input type="number" name={`part_${i}_to`} min="1" max="200"
                            placeholder="2" form="partsForm"
                            class="field !py-1.5 !text-[13.5px] !px-2 tabular-nums" />
                          {/* The £ lives inside the field shell, so the border,
                              background and radius stay one object. */}
                          <div class="flex items-center rounded-[var(--radius-field)] border border-[var(--color-rule)] bg-white focus-within:border-[var(--color-navy)]">
                            <span class="pl-2.5 text-[13.5px] text-[var(--color-ink-faint)]">£</span>
                            <input
                              type="text"
                              name={`part_${i}_price`}
                              inputmode="decimal"
                              placeholder="0.00"
                              form="partsForm"
                              class="w-full bg-transparent border-0 outline-none py-1.5 pl-1 pr-2 text-[13.5px] tabular-nums"
                            />
                          </div>
                        </div>
                      ))}
                    </div>

                    <p id="partsError" hidden role="alert"
                      class="mt-2 flex items-start gap-1.5 text-[12.5px] text-[var(--color-outstock)]">
                      <span aria-hidden="true">!</span><span data-parts-message></span>
                    </p>

                    <p class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      Leave rows blank if you need fewer. One volume on its own is fine - put the
                      same number in both.
                    </p>
                  </div>

                  <button type="submit" form="partsForm" id="buildParts"
                    class="btn btn-primary !py-2 !text-[13.5px]">
                    Build the parts
                  </button>
                </div>
                </div>
              </>
            )}
          </section>
          </>
        )
      }

      {
        book && (
          <section id="s-delete" class="border border-[var(--color-outstock)]/30 rounded-[var(--radius-panel)] p-5 scroll-mt-24">
            <h2 class="eyebrow !text-[var(--color-outstock)] mb-2">Delete</h2>
            <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed">
              Removes this listing for good, with any photos you uploaded
              {book.telegram_message_id ? ' and its post in the channel' : ''}. Past orders keep
              their record of it. To hide it without losing it, set Visibility to Archived.
            </p>
            {book.reserved > 0 && (
              <p class="mt-2 text-[13px] text-[var(--color-outstock)]">
                {book.reserved} {book.reserved === 1 ? 'copy is' : 'copies are'} reserved by an open
                order, so this cannot be deleted yet.
              </p>
            )}
            <button
              type="submit"
              form="deleteForm"
              class="btn btn-ghost w-full !py-2 mt-3 !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40"
              disabled={book.reserved > 0}
            >
              Delete listing
            </button>
          </section>
        )
      }

      {
        book && (
          <a
            href={`/book/${book.slug}`}
            class="block text-center text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2"
          >
            View in the shop →
          </a>
        )
      }
      {/*
        * A last look over, before the only Save on the page.
        *
        * Every value is read from the live form fields when the step is
        * opened, never from a copy kept alongside them - two records of the
        * same answer is how a review card comes to show something the form
        * does not.
        */}
      {isNew && (
        <section data-step="4" style="order:5" class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
          <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold mb-3">
            A last look over
          </h2>
          <dl class="grid">
            {[
              { key: 'book', label: 'The book', step: 1 },
              { key: 'subjects', label: 'Subjects', step: 2 },
              { key: 'commerce', label: 'Price and stock', step: 3 },
              { key: 'delivery', label: 'Delivery coming', step: 3 },
            ].map((row) => (
              <div
                data-review-row={row.key}
                class="grid grid-cols-[7rem_1fr_auto] sm:grid-cols-[11rem_1fr_auto] gap-x-4 items-baseline py-3 border-b border-[var(--color-rule-faint)] last:border-b-0"
              >
                <dt class="text-[13px] text-[var(--color-ink-faint)]">{row.label}</dt>
                <dd data-review={row.key} class="text-[14.5px] leading-relaxed min-w-0"></dd>
                <button
                  type="button"
                  data-goto={row.step}
                  class="text-[13px] text-[var(--color-navy)] underline underline-offset-2"
                >Change</button>
              </div>
            ))}
          </dl>
          <p class="mt-3.5 text-[13px] leading-relaxed text-[var(--color-ink-faint)] max-w-[70ch]">
            Saving opens the listing itself, where the cover, the Telegram post and selling in
            parts are waiting.
          </p>
        </section>
      )}

      {/*
        * One Save for the whole page, wizard or not.
        *
        * `Continue` is a plain button that changes which panel is on screen -
        * it never submits, and it never navigates, so the unsaved-changes
        * warning is untouched. The submit is the same single button it always
        * was; on the first pass it simply waits until the last step, and with
        * scripting off it is the only control here.
        */}
      <div
        class="sticky bottom-0 -mx-1 px-1 pb-1 pt-3 bg-gradient-to-t from-[var(--color-paper-raised)] via-[var(--color-paper-raised)] to-transparent"
        style={isNew ? 'order:9' : undefined}
      >
        <div class="flex flex-wrap items-center gap-3 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] shadow-[var(--shadow-panel)] px-4 py-3">
          {isNew && (
            <button
              type="button"
              id="stepBack"
              hidden
              class="btn btn-ghost !py-2.5 !text-[14px]"
            >Back</button>
          )}
          <p id="saveHint" class="text-[13px] text-[var(--color-ink-faint)]">
            {isNew ? 'Nothing saved yet.' : 'No unsaved changes.'}
          </p>
          {isNew && (
            <button
              type="button"
              id="stepNext"
              hidden
              class="ml-auto btn btn-primary !py-2.5"
            >Continue</button>
          )}
          <button
            type="submit"
            id="saveBtn"
            class:list={['btn btn-primary !py-2.5', isNew ? 'ml-auto' : 'ml-auto']}
          >
            {isNew ? 'Create listing' : 'Save changes'}
          </button>
        </div>
      </div>
    </div>
  </form>

  {/* Outside the main form: forms cannot nest, so the sidebar buttons reach
      these through their `form` attribute instead. */}
  {
    book && (
      <>
        <form id="telegramForm" method="post" action={`/api/admin/books/${book.id}/telegram`} />
        <form id="restockForm" method="post" action={`/api/admin/books/${book.id}/set`} />
        <form id="arrivedForm" method="post" action={`/api/admin/books/${book.id}/arrived`}>
          <input type="hidden" name="receipt_key" value={crypto.randomUUID()} />
          <input type="hidden" name="delivery_version" value={book.delivery_version} />
        </form>
        <form id="partsForm" method="post" action={`/api/admin/books/${book.id}/set`} />
        <form id="adoptForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="adopt" />
        </form>
        <form id="unsplitForm" method="post" action={`/api/admin/books/${book.id}/set`}>
          <input type="hidden" name="action" value="unsplit" />
        </form>
        <form id="deleteForm" method="post" action={`/api/admin/books/${book.id}/delete`} />
      </>
    )
  }

  {
    book && (
      <script is:inline nonce={Astro.locals.cspNonce} define:vars={{ bookId: book.id, bookTitle: book.title, bookAuthor: book.author ?? '' }}>
        // ------------------------------------------------------------------
        // Save and post are ordered, not parallel. Posting sends whatever is
        // in the database, so offering it while the form has unsaved edits
        // would announce the old version of a listing the owner has just
        // changed. Save is offered only when there is something to save;
        // posting only once there is nothing outstanding.
        // ------------------------------------------------------------------
        /*
         * A half-filled part row is refused, never guessed at. Filling in a
         * missing price or inferring a range would put a listing on the shop
         * front at a number nobody chose.
         *
         * The server refuses it too - this only saves a round trip and names
         * the row, which a redirect with ?e=parts cannot.
         */
        const partsForm = document.querySelector('#partsForm');
        const partsError = document.querySelector('#partsError');
        const buildBtn = document.querySelector('#buildParts');

        function checkParts() {
          if (!partsError || !buildBtn) return true;
          let problem = null;
          for (let i = 0; i < 4 && !problem; i++) {
            const cells = ['name', 'from', 'to', 'price'].map((k) =>
              document.querySelector('[name="part_' + i + '_' + k + '"]'),
            );
            const filled = cells.map((el) => (el && el.value.trim() ? 1 : 0));
            const count = filled.reduce((a, b) => a + b, 0);
            if (count === 0 || count === 4) {
              for (const el of cells) el && el.classList.remove('!border-[var(--color-outstock)]');
              continue;
            }
            const missing = ['a name', 'a first volume', 'a last volume', 'a price'];
            const first = filled.indexOf(0);
            problem = 'Row ' + (i + 1) + ' needs ' + missing[first] +
              '. We will not guess one - fill it in or clear the row.';
            for (const [n, el] of cells.entries()) {
              if (!el) continue;
              el.classList.toggle('!border-[var(--color-outstock)]', filled[n] === 0);
            }
          }
          partsError.hidden = !problem;
          if (problem) partsError.querySelector('[data-parts-message]').textContent = problem;
          buildBtn.classList.toggle('opacity-50', Boolean(problem));
          return !problem;
        }

        if (partsForm) {
          for (let i = 0; i < 4; i++) {
            for (const k of ['name', 'from', 'to', 'price']) {
              const el = document.querySelector('[name="part_' + i + '_' + k + '"]');
              el && el.addEventListener('input', checkParts);
            }
          }
          partsForm.addEventListener('submit', (event) => {
            if (!checkParts()) event.preventDefault();
          });
        }

        const bookForm = document.querySelector('#bookForm');
        const saveBtn = document.querySelector('#saveBtn');
        const saveHint = document.querySelector('#saveHint');
        const postBtn = document.querySelector('#postBtn');
        const postHint = document.querySelector('#postHint');

        const snapshot = () => new URLSearchParams(new FormData(bookForm)).toString();
        let saved = snapshot();

        function sync() {
          const dirty = snapshot() !== saved;

          if (saveBtn) {
            saveBtn.disabled = !dirty;
            saveHint.textContent = dirty ? 'You have unsaved changes.' : 'No unsaved changes.';
          }

          if (postBtn) {
            const blocked = postBtn.dataset.blocked === '1';
            postBtn.disabled = dirty || blocked;
            postHint.textContent = dirty
              ? 'Save your changes first, then post them.'
              : postBtn.dataset.reason || '';
          }
        }

        bookForm?.addEventListener('input', sync);
        bookForm?.addEventListener('change', sync);
        sync();

        // A form submission is about to reload the page; leaving the button
        // enabled invites a second click that posts twice.
        bookForm?.addEventListener('submit', () => {
          if (saveBtn) { saveBtn.disabled = true; saveHint.textContent = 'Saving…'; }
        });

        /*
         * Back to the written-for-you post.
         *
         * The generated text travels on the textarea itself, so this needs no
         * round trip and works before anything has been saved. With scripting
         * off the button is not there and emptying the box does the same job:
         * a blank caption is the shop's to write again.
         */
        const captionBox = document.querySelector('#telegram_caption');
        document.querySelector('#resetCaption')?.addEventListener('click', () => {
          if (!captionBox) return;
          captionBox.value = captionBox.dataset.generated ?? '';
          captionBox.focus();
        });

        document.querySelector('#telegramForm')?.addEventListener('submit', () => {
          if (postBtn) { postBtn.disabled = true; postHint.textContent = 'Posting…'; }
        });

        // Confirm in JS rather than an inline onsubmit: a title containing an
        // apostrophe would break the attribute.
        document.querySelector('#deleteForm')?.addEventListener('submit', (event) => {
          const ok = confirm(
            `Delete “${bookTitle}” for good?\n\nIts photos and channel post go too. Past orders keep their record of it.`,
          );
          if (!ok) event.preventDefault();
        });

        const input = document.querySelector('#photo');
        const status = document.querySelector('#uploadStatus');

        /**
         * Shrinks the photo before it leaves the phone, and measures it.
         *
         * A phone camera produces something like 4000px and several megabytes,
         * so this has to come down before it is sent. Resizing here also
         * sidesteps HEIC, which iPhones produce and the server does not
         * accept, because the canvas decodes it and hands back WebP.
         *
         * The ceiling has to clear the largest thing the shop builds, and for
         * a long time it did not. It was 800, written when the biggest variant
         * was 600x800; the detail variant is 840x1176 now, so every upload was
         * arriving smaller than the size it would be enlarged to. That is what
         * made covers added through the portal look soft, and it survived the
         * fix to the cropper - which had its own separate ceiling - because
         * this runs afterwards and simply put the photo back down again.
         *
         * Measured while we are holding the bitmap: the server cannot read
         * dimensions from a stream it passes straight through, and without them
         * the page has nothing to reserve space with, so the grid jumps as the
         * photo loads.
         *
         * The photo itself is not altered - no frame, no background, no mark.
         * There was a frame here briefly, to match a standardising pass over
         * the catalogue; the owner did not want it, and the covers read better
         * as they are.
         *
         * A failure here used to return the original silently, which on a phone
         * that cannot decode HEIC meant several megabytes going to R2 unshrunk.
         * It still sends - refusing the photo would be worse - but it says so.
         */
        const MAX_EDGE = 1400;

        async function shrink(file) {
          try {
            const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });

            // Fitted inside, never cropped and never enlarged, so a wide book
            // or a spine keeps all of itself at whatever size it arrived.
            const scale = Math.min(MAX_EDGE / bitmap.width, MAX_EDGE / bitmap.height, 1);
            const w = Math.max(1, Math.round(bitmap.width * scale));
            const h = Math.max(1, Math.round(bitmap.height * scale));

            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);

            /*
             * Encoded generously, because this is not the picture anyone sees.
             * It is the master the variants are cut from, and each of those is
             * encoded again at 82 - so anything given away here is given away
             * twice. The extra weight is paid once, on the way to R2.
             */
            const blob = await new Promise((r) => canvas.toBlob(r, 'image/webp', 0.92));
            return blob
              ? { file: new File([blob], 'photo.webp', { type: 'image/webp' }), width: w, height: h }
              : { file, width: bitmap.width, height: bitmap.height };
          } catch {
            return { file, width: null, height: null, failed: true };
          }
        }

        input?.addEventListener('change', async () => {
          const chosen = input.files?.[0];
          if (!chosen) return;
          await handOff(chosen);
        });

        /*
         * One path from "here is an image" to "it is on the listing", whether
         * it came off the owner's phone or out of the search. The search must
         * not get its own quieter route to R2 - the straightening, the look at
         * it, and the shrink are the same requirements either way.
         */
        async function handOff(chosen) {
          status.hidden = false;
          status.textContent = 'Preparing…';

          /*
           * Straighten and crop first, and let the owner look at it.
           *
           * Nothing reaches R2 until he has answered: a crooked photo of a book
           * on a kitchen table used to be live the moment it was chosen. If the
           * panel is not on the page - an older browser, a failed module - this
           * is undefined and the upload carries on exactly as it did.
           */
          /*
           * Two different nothings, and they must not be confused.
           *
           * `?? chosen` used to cover both, which meant Cancel resolved null,
           * fell through to the original, and uploaded the crooked photo the
           * owner had just refused. The panel being absent is the only case
           * that may fall back.
           */
          const original = window.coverClean ? await window.coverClean.review(chosen) : chosen;
          if (!original) {
            // Cancelled. Clear the input so choosing the same file again still
            // fires a change event.
            input.value = '';
            status.hidden = true;
            return;
          }

          status.textContent = 'Preparing…';

          /*
           * Framed and cut to size here, on the machine that already has the
           * photo decoded.
           *
           * The alternative was what this used to do: send the photo and
           * nothing else, leaving the listing with no variants until somebody
           * remembered to run scripts/resize-covers.mjs. Until that happened
           * `?p=card` fell back to the full-size original and the browser
           * cropped it however object-fit saw fit, which is not the framing
           * this shop follows. Sharp cannot run at Cloudflare's edge, so the
           * only machine that can do this before the upload lands is this one.
           */
          const dressed = window.coverClean?.dress
            ? await window.coverClean.dress(original)
            : null;

          // Falls back to the old path whenever the framing could not run, so
          // an older browser still uploads a usable cover.
          const { file, width, height, failed } = dressed?.variants?.size
            ? { file: dressed.master, width: dressed.width, height: dressed.height, failed: false }
            : await shrink(original);

          const saved = original.size - file.size;
          status.textContent = failed
            ? 'This phone could not shrink that photo - sending it as it is…'
            : saved > 0
              ? `Uploading… (${Math.round(original.size / 1024)}KB down to ${Math.round(file.size / 1024)}KB)`
              : 'Uploading…';

          const body = new FormData();
          body.append('bookId', String(bookId));
          body.append('photo', file);
          if (width && height) {
            body.append('width', String(width));
            body.append('height', String(height));
          }
          for (const [name, variant] of dressed?.variants ?? []) {
            body.append(`variant:${name}`, variant);
          }

          try {
            const res = await fetch('/api/admin/upload', { method: 'POST', body });
            input.value = '';
            if (!res.ok) throw new Error(await res.text());
            status.textContent = 'Uploaded.';
            window.location.reload();
          } catch (err) {
            status.textContent = `Could not upload that photo. ${err}`;
          }
        }

        for (const btn of document.querySelectorAll('[data-remove-image]')) {
          btn.addEventListener('click', async () => {
            if (!confirm('Remove this photo?')) return;
            const body = new FormData();
            body.append('imageId', btn.dataset.removeImage);
            const res = await fetch('/api/admin/upload', { method: 'DELETE', body });
            if (res.ok) window.location.reload();
          });
        }

        /*
         * Find a cover in two independent catalogues. Open Library work
         * results are expanded into editions on our server; Google stays in
         * its own provider block and in its native relevance order.
         *
         * Candidate images still come through our id-only proxy. It satisfies
         * the site's CSP and cannot be turned into an arbitrary URL fetcher.
         */
        const findBtn = document.querySelector('#findCover');
        if (findBtn) {
          const results = document.querySelector('#coverResults');
          const countLine = document.querySelector('#coverCount');
          const termsLine = document.querySelector('#coverTerms');
          const grid = document.querySelector('#coverGrid');
          const retry = document.querySelector('#coverRetry');
          const words = document.querySelector('#coverWords');
          const note = document.querySelector('#coverNote');

          // Dimensions are known only after the proxied image has loaded.
          function faults(w, h) {
            const out = [];
            if (w < 300) out.push('a thumbnail - too small to use');
            if (w >= h) out.push('not cover-shaped - check it is the right image');
            return out;
          }

          async function search(terms, author = '') {
            results.hidden = false;
            grid.innerHTML = '';
            retry.hidden = true;
            countLine.textContent = 'Looking…';
            note.hidden = false;
            termsLine.textContent = '';
            findBtn.disabled = true;

            let covers = [];
            let providers = {
              openlibrary: { state: 'unavailable', count: 0 },
              google: { state: 'unavailable', count: 0 },
            };
            try {
              const params = new URLSearchParams(author
                ? { title: terms, author }
                : { q: terms });
              // Read from the field rather than the saved row, so an ISBN just
              // typed in is used without having to save the listing first.
              const isbnNow = document.querySelector('#isbn')?.value?.trim();
              if (isbnNow) params.set('isbn', isbnNow);
              const res = await fetch(`/api/admin/covers/search?${params}`);
              if (res.ok) {
                const payload = await res.json();
                covers = payload.covers ?? [];
                providers = payload.providers ?? providers;
              }
            } catch {
              /* The provider-aware empty state below explains an outage. */
            }
            findBtn.disabled = false;

            function nothing() {
              const unavailable = Object.entries(providers)
                .filter(([, report]) => report.state === 'unavailable')
                .map(([provider]) => provider === 'google' ? 'Google Books' : 'Open Library');
              const googleMissing = providers.google?.state === 'not-configured';
              countLine.textContent = unavailable.length
                ? 'Cover search unavailable'
                : 'Nothing found';
              note.hidden = true;
              termsLine.textContent = unavailable.length
                ? `${unavailable.join(' and ')} could not be reached. Try again, or upload a photo.`
                : googleMissing
                  ? 'No match in Open Library. Google Books is not connected yet, so upload a photo or try different words.'
                  : 'Neither source has a matching cover. A photograph of the book is still the most reliable option.';
              retry.hidden = false;
              words.value = terms;
            }

            if (covers.length === 0) {
              nothing();
              return;
            }

            const unavailable = Object.entries(providers)
              .filter(([, report]) => report.state === 'unavailable')
              .map(([provider]) => provider === 'google' ? 'Google Books' : 'Open Library');
            termsLine.textContent = providers.google?.state === 'not-configured'
              ? `Searched for “${terms}”. Google Books is not connected yet.`
              : unavailable.length
                ? `Searched for “${terms}”. ${unavailable.join(' and ')} could not be reached, so these are partial results.`
                : `Searched for “${terms}”. Nothing is attached until you accept it.`;
            retry.hidden = false;
            words.value = terms;

            let shown = 0;
            let pending = covers.length;
            for (const provider of ['openlibrary', 'google']) {
              const providerCovers = covers.filter((cover) => cover.provider === provider);
              if (providerCovers.length === 0) continue;

              const section = document.createElement('section');
              section.dataset.coverProvider = provider;
              const heading = document.createElement('div');
              heading.className = 'mb-2 flex min-h-8 items-center justify-between gap-3';
              const headingText = document.createElement('h3');
              headingText.className = 'text-[13px] font-medium text-[var(--color-ink-soft)]';
              headingText.textContent = provider === 'google' ? 'Google Books' : 'Open Library editions';
              heading.append(headingText);
              if (provider === 'google') {
                const brand = document.createElement('img');
                brand.src = 'https://books.google.com/googlebooks/images/poweredby.png';
                brand.alt = 'Powered by Google';
                brand.width = 62;
                brand.height = 30;
                heading.append(brand);
              }
              const providerGrid = document.createElement('div');
              providerGrid.className = 'grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4';
              section.append(heading, providerGrid);
              grid.append(section);

              for (const cover of providerCovers) {
                const cell = document.createElement('div');

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className =
                  'block w-full text-left rounded-[8px] overflow-hidden border border-[var(--color-rule-soft)] hover:border-[var(--color-navy)] transition-colors';

                const img = document.createElement('img');
                img.alt = cover.title;
                img.className = 'block w-full aspect-[5/7] object-cover bg-[var(--color-paper)]';

                const title = document.createElement('p');
                title.className =
                  'mt-2 text-[12.5px] font-medium text-[var(--color-navy)] leading-tight line-clamp-2';
                title.textContent = cover.title;

                const note = document.createElement('p');
                note.className = 'mt-1 text-[11px] text-[var(--color-ink-faint)] leading-tight line-clamp-2';
                note.textContent = cover.source;

              // A provider id can still point at an image which has since
              // disappeared, so a tile earns its place by loading.
              cell.hidden = true;
              img.addEventListener('load', () => {
                cell.hidden = false;
                shown += 1;
                pending -= 1;
                countLine.textContent = shown === 1 ? '1 cover found' : `${shown} covers found`;
                const bad = faults(img.naturalWidth, img.naturalHeight);
                note.textContent = `${img.naturalWidth}×${img.naturalHeight} · ${cover.source}`;
                if (bad.length) {
                  const warn = document.createElement('span');
                  warn.className = 'block text-[var(--color-outstock)]';
                  warn.textContent = bad.join(' · ');
                  note.append(warn);
                }
              });
              img.addEventListener('error', () => {
                pending -= 1;
                cell.remove();
                if (providerGrid.children.length === 0) section.remove();
                if (pending === 0 && shown === 0) {
                  grid.innerHTML = '';
                  nothing();
                }
              });

              btn.addEventListener('click', async () => {
                status.hidden = false;
                status.textContent = 'Fetching that cover…';
                try {
                  const coverParams = new URLSearchParams({
                    provider: cover.provider,
                    id: String(cover.id),
                  });
                  const res = await fetch(`/api/admin/covers/image?${coverParams}`);
                  if (!res.ok) throw new Error('gone');
                  const blob = await res.blob();
                  // Straight into the same review the owner's own photo gets.
                  await handOff(new File([blob], 'cover.jpg', { type: blob.type || 'image/jpeg' }));
                } catch {
                  status.textContent = 'Could not fetch that cover. Try another, or upload one.';
                }
              });

              btn.append(img);
              cell.append(btn, title, note);
              if (provider === 'google') {
                const sourceLink = document.createElement('a');
                sourceLink.href = `https://books.google.com/books?id=${encodeURIComponent(cover.id)}`;
                sourceLink.target = '_blank';
                sourceLink.rel = 'noopener';
                sourceLink.className =
                  'mt-1.5 inline-block text-[11.5px] font-medium text-[var(--color-navy)] underline underline-offset-2';
                sourceLink.textContent = 'View on Google Books';
                cell.append(sourceLink);
              }
              providerGrid.append(cell);

              const imageParams = new URLSearchParams({
                provider: cover.provider,
                id: String(cover.id),
              });
              img.src = `/api/admin/covers/image?${imageParams}`;
              }
            }
          }

          // `start` deliberately stays visible. Hiding it once a search runs
          // would leave uploading as a link under a grid of results, which is
          // the one shape this section is not allowed to take.
          findBtn.addEventListener('click', () => search(bookTitle, bookAuthor));
          document.querySelector('#coverGo')?.addEventListener('click', () => search(words.value));
          words?.addEventListener('keydown', (e) => {
            // Enter inside the listing form would otherwise save the page.
            if (e.key === 'Enter') {
              e.preventDefault();
              search(words.value);
            }
          });
        }
      </script>
    )
  }
  {/*
    The review panel.

    A bundled module rather than another `is:inline` block: this is far too
    much logic for a script Astro ships verbatim, and it needs to import the
    geometry from src/scripts/cover-clean.ts, which an inline script cannot do.

    It hands itself to the inline uploader through `window.coverClean`, which
    is the whole seam between them - the uploader asks for a file to send and
    gets one back, or null if the owner cancelled.
  */}
  {/*
    * Sold in parts, without a save in the middle.
    *
    * The section waits on a volume count above one, and that count is typed in
    * Identity at the top of the same page. Reading it from the saved book
    * meant typing it, saving, scrolling back down, and only then finding the
    * builder - one round trip to learn something already on screen.
    *
    * `partsForm` posts its own volume count, so the saved value was never what
    * the builder needed; it was only what decided whether to draw it. So this
    * watches the field instead, and carries the number down so it is not typed
    * twice. With scripting off the panel keeps its original wording and the
    * save still gets there.
    */}
  <script is:inline nonce={Astro.locals.cspNonce}>
    (() => {
      const panel = document.querySelector('[data-parts-panel]');
      const wait = document.querySelector('[data-parts-wait]');
      const builder = document.querySelector('[data-parts-builder]');
      const volumes = document.querySelector('#volumes');
      if (!panel || !wait || !builder || !volumes) return;

      wait.textContent =
        'Waiting on a volume count. Put the number of volumes in \u201CVolumes in the set\u201D above and the builder opens here.';

      /* The builder's own volume field, which the owner should not have to
         fill in twice with the same number. */
      const echo = builder.querySelector('input[name="volumes"]');

      function paint() {
        const n = Number(volumes.value);
        const splittable = Number.isFinite(n) && n > 1;
        wait.hidden = splittable;
        builder.hidden = !splittable;

        panel.classList.toggle('bg-[#faf9f6]', !splittable);
        panel.classList.toggle('border-dashed', !splittable);
        panel.classList.toggle('border-[var(--color-rule)]', !splittable);
        panel.classList.toggle('bg-white', splittable);
        panel.classList.toggle('border-[var(--color-rule-soft)]', splittable);

        /* Only while it is untouched - overwriting a number the owner typed
           into the builder itself would be worse than asking for it twice. */
        if (splittable && echo && !echo.value) echo.value = String(Math.round(n));
      }

      volumes.addEventListener('input', paint);
      paint();
    })();
  </script>

  {/*
    * Catch a mistyped ISBN before the save does.
    *
    * `save.ts` refuses one and redirects, which loses everything else typed on
    * the page - survivable on a listing being edited, and on a new one it
    * throws away the whole form. The same check runs here first, using the
    * shop's own validator rather than a second copy of the arithmetic, so the
    * round trip never happens. The server still refuses: this only saves the
    * owner from it.
    */}
  <script>
    import { validIsbn } from '../../../lib/isbn-search';

    const form = document.querySelector<HTMLFormElement>('#bookForm');
    const field = document.querySelector<HTMLInputElement>('#isbn');
    const note = document.querySelector<HTMLElement>('#isbnNote');

    if (form && field && note) {
      const said = note.textContent ?? '';
      form.addEventListener('submit', (event) => {
        const typed = field.value.trim();
        if (!typed || validIsbn(typed)) return;
        event.preventDefault();
        note.textContent =
          'That is not a real ISBN - the check digit does not add up. Correct it, or clear the field.';
        note.style.color = 'var(--color-outstock)';
        field.focus();
        /* The page is not going anywhere after all, so anything watching for
           a save - the wizard's leave-the-page guard - has to be told. */
        form.dispatchEvent(new CustomEvent('save:blocked'));
      });
      field.addEventListener('input', () => {
        note.textContent = said;
        note.style.color = '';
      });
    }
  </script>

  {/*
    * Finding a shelf among twenty-six, and saying how many are picked.
    *
    * Both are enhancements over a list that already works: the filter box is
    * hidden until this runs, and the counts it keeps up to date are rendered
    * correctly by the server to begin with.
    */}
  <script is:inline nonce={Astro.locals.cspNonce}>
    (() => {
      const labels = [...document.querySelectorAll('[data-subject]')];
      if (!labels.length) return;

      const head = document.getElementById('subjectsHead');
      const badge = document.getElementById('subjectsBadge');
      const empty = document.querySelector('[data-subject-empty]');
      const wrap = document.querySelector('[data-subject-filter]');
      const box = document.getElementById('subjectFilter');
      if (wrap) wrap.hidden = false;

      function count() {
        const n = labels.filter((l) => l.querySelector('input')?.checked).length;
        if (head) {
          head.textContent =
            n > 0
              ? `${n} chosen`
              : 'None chosen \u2014 a listing with no subject cannot be browsed to';
          head.style.color = n > 0 ? 'var(--color-ink-soft)' : 'var(--color-outstock)';
        }
        if (badge) {
          badge.textContent = n > 0 ? String(n) : 'none yet';
          badge.style.color = n > 0 ? 'var(--color-ink-faint)' : 'var(--color-outstock)';
        }
      }

      function filter() {
        const want = (box?.value ?? '').trim().toLowerCase();
        let shown = 0;
        for (const label of labels) {
          /* A shelf already ticked stays visible whatever is typed, or
             filtering would look like it had unpicked something. */
          const keep =
            !want ||
            (label.dataset.name ?? '').includes(want) ||
            Boolean(label.querySelector('input')?.checked);
          label.hidden = !keep;
          if (keep) shown += 1;
        }
        if (empty) empty.hidden = shown > 0;
      }

      box?.addEventListener('input', filter);
      for (const label of labels) {
        label.querySelector('input')?.addEventListener('change', count);
      }
      count();
    })();
  </script>

  {/*
    * The ISBN lookup, on both shapes of the page.
    *
    * Its own script because it is the one piece of the editor that a listing
    * being created for the first time needs as much as a saved one - and the
    * script that carries the rest only runs when there is a book to carry.
    */}
  <script is:inline nonce={Astro.locals.cspNonce}>
        /*
         * Look up the ISBN.
         *
         * Candidates only. Open Library returns many editions for one title -
         * eight numbers came back for "Riyad as-Salihin" - and the shop stocks
         * one of them, so the publisher and year are shown beside each and a
         * person picks. Nothing is written until they do.
         */
        const isbnBtn = document.querySelector('#findIsbn');
        if (isbnBtn) {
          /*
           * What to search for, read when the button is pressed.
           *
           * It used to be a value rendered into the page from the saved book,
           * which is why the lookup could only be offered on a listing that
           * already existed - on a new one there was nothing to render. Read
           * from the fields instead and the same button works on the first
           * pass, where it is most useful.
           */
          const terms = () =>
            [document.querySelector('#title')?.value, document.querySelector('#author')?.value]
              .map((v) => (v ?? '').trim())
              .filter(Boolean)
              .join(' ');
          const isbnField = document.querySelector('#isbn');
          const isbnList = document.querySelector('#isbnList');
          const isbnNote = document.querySelector('#isbnNote');

          isbnBtn.addEventListener('click', async () => {
            isbnBtn.disabled = true;
            isbnNote.textContent = 'Looking…';
            isbnList.hidden = true;
            isbnList.innerHTML = '';

            let found = [];
            try {
              const res = await fetch(`/api/admin/isbn/search?q=${encodeURIComponent(terms())}`);
              if (res.ok) found = (await res.json()).candidates ?? [];
            } catch {
              /* Same as finding nothing: the field is typed by hand instead. */
            }
            isbnBtn.disabled = false;

            if (found.length === 0) {
              isbnNote.textContent =
                'Nothing found. That is normal for these publishers - type it off the back of the book.';
              return;
            }

            isbnNote.textContent = 'Pick the edition that matches the copy on your shelf.';
            isbnList.hidden = false;

            for (const c of found) {
              const row = document.createElement('button');
              row.type = 'button';
              row.className =
                'text-left w-full px-3 py-2 bg-white border border-[var(--color-rule-soft)] rounded-[8px] hover:border-[var(--color-navy)] transition-colors';
              row.innerHTML =
                `<span class="block text-[13.5px] font-medium text-[var(--color-navy)]"></span>` +
                `<span class="block text-[12.5px] text-[var(--color-ink-faint)]"></span>`;
              row.children[0].textContent = c.isbn;
              row.children[1].textContent = `${c.title} · ${c.detail}`;
              row.addEventListener('click', () => {
                isbnField.value = c.isbn;
                isbnField.dispatchEvent(new Event('input', { bubbles: true }));
                isbnList.hidden = true;
                isbnNote.textContent = 'Set. Nothing is saved until you save the page.';
              });
              isbnList.append(row);
            }
          });
        }
  </script>

  {/*
    * The four steps, as staging over a form that already worked.
    *
    * Everything here is show and hide inside one document: no navigation, no
    * history entry, no second save. With scripting off none of it runs, all
    * four panels render open one after another, and the single Save at the
    * foot does what it always did.
    */}
  {
    isNew && (
      <script is:inline nonce={Astro.locals.cspNonce}>
        (() => {
          const form = document.getElementById('bookForm');
          if (!form) return;
          const panels = [...document.querySelectorAll('[data-step]')];
          if (!panels.length) return;

          const back = document.getElementById('stepBack');
          const next = document.getElementById('stepNext');
          const save = document.getElementById('saveBtn');
          const hint = document.getElementById('saveHint');
          const countLine = document.getElementById('stepCount');
          const NAMES = ['the book', 'subjects', 'price and stock', 'description'];
          const LAST = NAMES.length;
          let at = 1;

          const field = (name) => form.elements.namedItem(name);
          const valueOf = (name) => {
            const el = field(name);
            return el && 'value' in el ? String(el.value).trim() : '';
          };

          /* Every value read from the live field at the moment the review is
             drawn, so the card and the form cannot disagree. */
          function review() {
            const set = (key, text, muted) => {
              const cell = document.querySelector(`[data-review="${key}"]`);
              if (!cell) return;
              cell.textContent = text;
              cell.style.color = muted ? 'var(--color-outstock)' : '';
            };

            const vols = Number(valueOf('volumes'));
            const identity = [valueOf('title'), valueOf('title_ar')].filter(Boolean).join(' · ');
            const under = [
              valueOf('author'),
              valueOf('publisher'),
              valueOf('isbn') ? `ISBN ${valueOf('isbn')}` : 'no ISBN',
              vols > 1 ? `${vols} volumes` : 'single volume',
            ].filter(Boolean).join(' · ');
            set('book', identity ? `${identity} — ${under}` : 'no title yet', !identity);

            const picked = [...form.querySelectorAll('input[name="categories"]:checked')]
              .map((box) => box.closest('label')?.textContent?.trim())
              .filter(Boolean);
            set(
              'subjects',
              picked.length ? picked.join(', ') : 'none — it will not appear on any shelf',
              picked.length === 0,
            );

            const statusField = field('status');
            const statusText = statusField && statusField.selectedIndex >= 0
              ? statusField.options[statusField.selectedIndex].textContent.trim().toLowerCase()
              : '';
            const price = valueOf('price');
            const stock = valueOf('stock');
            set(
              'commerce',
              [price ? `£${price}` : 'no price', `${stock || 0} in stock`, statusText]
                .filter(Boolean)
                .join(' · '),
              !price,
            );

            const wants = field('has_incoming');
            const coming = Number(valueOf('incoming'));
            const row = document.querySelector('[data-review-row="delivery"]');
            const on = Boolean(wants && wants.checked && coming > 0);
            if (row) row.hidden = !on;
            if (on) {
              const said = document.getElementById('incomingPreview');
              set(
                'delivery',
                said && said.textContent.trim()
                  ? said.textContent.trim()
                  : `${coming} ${coming === 1 ? 'copy' : 'copies'} coming`,
                false,
              );
            }
          }

          function show(step) {
            at = Math.min(Math.max(1, step), LAST);
            for (const panel of panels) panel.hidden = Number(panel.dataset.step) !== at;

            for (const button of document.querySelectorAll('[data-badge]')) {
              const n = Number(button.dataset.badge);
              const done = n < at;
              button.textContent = done ? '\u2713' : String(n);
              button.style.borderColor =
                n === at ? 'var(--color-navy)' : done ? 'var(--color-instock)' : 'var(--color-rule)';
              button.style.color =
                n === at ? 'var(--color-navy)' : done ? 'var(--color-instock)' : 'var(--color-ink-faint)';
              button.style.background = n === at ? 'var(--color-wash-soft)' : 'transparent';
            }
            for (const label of document.querySelectorAll('[data-name]')) {
              label.style.color =
                Number(label.dataset.name) === at ? 'var(--color-navy)' : 'var(--color-ink-soft)';
            }
            for (const dot of document.querySelectorAll('[data-dot]')) {
              dot.style.background =
                Number(dot.dataset.dot) <= at ? 'var(--color-navy)' : 'var(--color-rule)';
            }

            if (countLine) countLine.textContent = `Step ${at} of ${LAST}`;
            if (back) {
              back.hidden = false;
              back.disabled = at === 1;
              back.style.opacity = at === 1 ? '0.45' : '1';
            }
            if (next) next.hidden = at === LAST;
            if (save) save.hidden = at !== LAST;
            if (hint)
              hint.textContent =
                at === LAST
                  ? 'One Save covers all four steps · leaving the page warns you first'
                  : `Next: ${NAMES[at]} · leaving the page warns you first`;

            if (at === LAST) review();
            form.scrollIntoView({ block: 'start', behavior: 'smooth' });
          }

          /*
           * The one thing that stops the owner moving on.
           *
           * Everything else on the first step can be left empty and filled in
           * later; without a title there is no listing and no address for one.
           */
          function titleOk() {
            const title = field('title');
            if (!title || title.value.trim()) return true;
            title.reportValidity?.();
            title.focus();
            return false;
          }

          next?.addEventListener('click', () => {
            if (at === 1 && !titleOk()) return;
            show(at + 1);
          });
          back?.addEventListener('click', () => show(at - 1));
          for (const jump of document.querySelectorAll('[data-goto]')) {
            jump.addEventListener('click', () => {
              const to = Number(jump.dataset.goto);
              if (to > 1 && !titleOk()) return;
              show(to);
            });
          }

          /*
           * Leaving with work in it.
           *
           * Claimed in the footer, so it has to be true. The submit clears the
           * flag first - saving is not leaving.
           */
          let saving = false;
          form.addEventListener('submit', () => { saving = true; });
          form.addEventListener('save:blocked', () => { saving = false; });
          window.addEventListener('beforeunload', (event) => {
            if (saving) return;
            if (!new URLSearchParams(new FormData(form)).toString().replace(/(^|&)[^=]+=(?=&|$)/g, '').trim()) return;
            event.preventDefault();
            event.returnValue = '';
          });

          /* The one field a save can refuse over is on the first step, which
             is also where this opens, so a refusal lands where it happened. */
          show(1);
        })();
      </script>
    )
  }

  {
    !isNew && (
      <script>
        import { mountCoverReview } from '../../../scripts/cover-review.ts';

        mountCoverReview();
      </script>
    )
  }
</Admin>

<style>
  /*
   * The delivery fields are dimmed and unreachable until the tick is on.
   *
   * Written here rather than as a Tailwind variant for two reasons: the
   * selector has to be `input:checked` and not `:checked`, because a selected
   * <option> in the month dropdown matches the latter and held the gate
   * permanently open; and utility ordering made the opacity half of it lose to
   * the resting class while the pointer-events half won, which is the sort of
   * disagreement a plain rule does not have.
   */
  .delivery-fields {
    opacity: 0.45;
    pointer-events: none;
  }
  .group:has(input[name='has_incoming']:checked) .delivery-fields {
    opacity: 1;
    pointer-events: auto;
  }
</style>
