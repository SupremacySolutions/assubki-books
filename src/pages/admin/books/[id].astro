                    </div>

                    <button type="submit" form="adoptForm" class="btn btn-primary !py-2 !text-[13.5px] mt-3">
                      Link these as the parts
                    </button>
                    <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                      Tick the ones that belong, and say which volumes each covers.
                    </p>
                  </div>
                )}

                <div class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed mb-3">
                  <p>
                    <strong class="text-[var(--color-ink)]">This listing becomes the complete set</strong>,
