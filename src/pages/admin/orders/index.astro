---
import Admin from '../../../layouts/Admin.astro';
import { portalLabel } from '../../../lib/order-status';
import { listOrders, orderCounts, reservationCount } from '../../../lib/admin-db';
import { price } from '../../../lib/format';

const status = Astro.url.searchParams.get('status');
/*
 * Two queues, not one.
 *
 * A reservation is worked through differently - nothing to pack until a box
 * lands, a deadline that only starts then, and a shipment's worth arriving at
 * once - so mixing them in would bury today's parcels under next month's
 * promises. Same page, same rows, same everything downstream; one column
 * decides which half is being looked at.
 */
const kind = Astro.url.searchParams.get('kind') === 'reservations' ? 'reservation' : 'shop';
const [orders, counts, reservations] = await Promise.all([
  listOrders(status, kind),
  orderCounts(kind),
  reservationCount(),
]);
const keep = (extra: Record<string, string | null>) => {
  const q = new URLSearchParams();
  if (kind === 'reservation') q.set('kind', 'reservations');
  for (const [k, v] of Object.entries(extra)) v === null ? q.delete(k) : q.set(k, v);
  const s = q.toString();
  return s ? `?${s}` : '';
};
const cleared = Astro.url.searchParams.get('cleared');
const deleted = Astro.url.searchParams.get('deleted');
const clearable = (counts.cancelled ?? 0) + (counts.expired ?? 0);

const TABS = [
  { key: null, label: 'All' },
  { key: 'requested', label: 'Needs reply' },
  { key: 'awaiting_payment', label: 'Awaiting payment' },
  { key: 'paid', label: 'Paid' },
  { key: 'dispatched', label: 'Posted' },
  { key: 'completed', label: 'Completed' },
  { key: 'expired', label: 'Lapsed' },
  { key: 'cancelled', label: 'Cancelled' },
];

const TONE: Record<string, string> = {
  requested: 'bg-[var(--color-navy)]/10 text-[var(--color-navy)]',
  awaiting_payment: 'bg-[var(--color-brass)]/15 text-[var(--color-brass)]',
  paid: 'bg-[var(--color-instock)]/12 text-[var(--color-instock)]',
  dispatched: 'bg-[var(--color-instock)]/12 text-[var(--color-instock)]',
  completed: 'bg-[var(--color-rule)] text-[var(--color-ink-soft)]',
  expired: 'bg-[var(--color-rule)] text-[var(--color-ink-faint)]',
  cancelled: 'bg-[var(--color-rule)] text-[var(--color-ink-faint)]',
};

/*
 * Two lists, not one.
 *
 * An order that needs doing and an order that is finished are different kinds
 * of thing, and mixing them meant the four that mattered sat in a run of
 * eighteen that did not. The queue carries a spine coloured by how pressing it
 * is; everything settled drops to a compact row below.
 */
const OPEN = ['requested', 'awaiting_payment', 'paid', 'dispatched'];
/* Lapsed holds first. They are the only rows where nothing happens until the
   owner acts, and they are holding stock while they wait. */
const queue = orders
  .filter((o) => OPEN.includes(o.status))
  .sort((a, b) => Number(b.lapsed_at !== null) - Number(a.lapsed_at !== null));
const settled = orders.filter((o) => !OPEN.includes(o.status));

/** Waiting on the owner is the urgent one; the rest are waiting on someone else. */
/** A customer waiting on an answer outranks whatever the status would say. */
const spineFor = (o: (typeof orders)[number]) =>
  o.cancel_requested_at ? 'bg-[var(--color-brass)]' : SPINE[o.status];

const SPINE: Record<string, string> = {
  requested: 'bg-[var(--color-outstock)]',
  awaiting_payment: 'bg-[var(--color-brass)]',
  paid: 'bg-[var(--color-navy)]',
  dispatched: 'bg-[var(--color-navy)]',
};

const hours = (from: number) => Math.max(0, Math.floor((Date.now() / 1000 - from) / 3600));
const until = (at: number | null) =>
  at ? Math.max(0, Math.floor((at - Date.now() / 1000) / 3600)) : null;

/*
 * The line under the name. Only facts that tell two orders apart earn a place:
 * the postcode says where it is going, "group order" says why it is large, and
 * a note attached says there is something to read before replying.
 */
function facts(o: (typeof orders)[number]): string[] {
  const bits = [`${o.item_count} ${o.item_count === 1 ? 'book' : 'books'}`, o.fulfilment];
  const postcode = o.address?.trim().split('\n').pop()?.trim();
  if (o.fulfilment !== 'collection' && postcode) bits.push(postcode);
  if (o.cash_payment) bits.push('cash in person');
  else if (o.payment_preference === 'transfer') bits.push('bank transfer preferred');
  if (o.notes?.trim()) bits.push('note attached');
  // The one fact that changes what the owner should do next.
  if (o.cancel_requested_at) bits.push('asked to cancel');
  return bits;
}

---

<Admin title="Orders" sub={`${orders.length} shown${counts.requested ? ` · ${counts.requested} need a reply` : ''}`}>
  {
    cleared && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[var(--radius-field)] text-[14.5px] text-[var(--color-instock)]">
        Cleared {cleared} {cleared === '1' ? 'order' : 'orders'}.
      </p>
    )
  }

  {
    deleted && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[var(--radius-field)] text-[14.5px] text-[var(--color-instock)]">
        Deleted order {deleted}.
      </p>
    )
  }

  <nav class="flex flex-wrap gap-1.5 mb-4" aria-label="Which orders">
    <a
      href="/admin/orders"
      class:list={[
        'px-3.5 py-2 sm:py-1.5 rounded-[var(--radius-pill)] text-[13.5px] border transition-colors duration-200',
        kind === 'shop'
          ? 'bg-[var(--color-ink)] text-white border-[var(--color-ink)]'
          : 'bg-white border-[var(--color-rule-soft)] text-[var(--color-ink-soft)] hover:border-[var(--color-navy)]',
      ]}
    >Shop orders</a>
    <a
      href="/admin/orders?kind=reservations"
      class:list={[
        'px-3.5 py-2 sm:py-1.5 rounded-[var(--radius-pill)] text-[13.5px] border transition-colors duration-200',
        kind === 'reservation'
          ? 'bg-[var(--color-ink)] text-white border-[var(--color-ink)]'
          : 'bg-white border-[var(--color-rule-soft)] text-[var(--color-ink-soft)] hover:border-[var(--color-navy)]',
      ]}
    >Reservations{reservations ? ` (${reservations})` : ''}</a>
  </nav>

  <nav class="flex flex-wrap gap-1.5 mb-5" aria-label="Filter by status">
    {
      TABS.map((tab) => (
        <a
          href={`/admin/orders${keep({ status: tab.key })}`}
          class:list={[
            'px-3.5 py-2 sm:py-1.5 rounded-[var(--radius-pill)] text-[13.5px] border transition-colors duration-200',
            status === tab.key || (!status && !tab.key)
              ? 'bg-[var(--color-navy)] text-white border-[var(--color-navy)]'
              : 'bg-white border-[var(--color-rule-soft)] text-[var(--color-ink-soft)] hover:border-[var(--color-navy)]',
          ]}
        >
          {tab.label}
          {tab.key && counts[tab.key] ? ` (${counts[tab.key]})` : ''}
        </a>
      ))
    }
  </nav>

  {
    clearable > 0 && (
      <form
        method="post"
        action="/api/admin/orders/clear"
        class="mt-8 flex flex-wrap items-center gap-3 p-4 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)]"
        data-confirm="Delete every cancelled and lapsed order? Orders that were quoted or paid are kept."
      >
        <p class="text-[14px] text-[var(--color-ink-soft)] flex-1 min-w-[220px]">
          {clearable} {clearable === 1 ? 'order' : 'orders'} came to nothing - cancelled or lapsed.
          Clearing them tidies this list; anything quoted or paid is kept.
        </p>
        <button type="submit" class="btn btn-ghost !py-1.5">Clear them</button>
      </form>
    )
  }

  {
    orders.length === 0 ? (
      <p class="p-5 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] text-[15px] text-[var(--color-ink-soft)]">
        No orders with that status.
      </p>
    ) : (
      <>
      {queue.length > 0 && (
        <ul class="space-y-2.5">
          {queue.map((o) => {
            const waited = hours(o.created_at);
            const isLapsed =
              ['requested', 'awaiting_payment'].includes(o.status) && o.lapsed_at !== null;
            const left = o.status === 'requested' && !isLapsed ? until(o.expires_at) : null;
            return (
              <li class="lift bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] overflow-hidden hover:border-[var(--color-navy)]">
                {/* The whole bar is the link. It used to be a card with one
                    small button in the corner, so the obvious thing to click
                    did nothing - and the settled list below was already a
                    single anchor, so the page taught two different rules. */}
                <a href={`/admin/orders/${o.ref}`} class="group flex hover:bg-[var(--color-paper)] transition-colors">
                  <span class:list={['w-1.5 shrink-0', spineFor(o)]} aria-hidden="true" />
                  {/*
                    * Two rows on a phone - who and how much, then how long and
                    * what to do - and one row from md up. On a phone the flex row
                    * wrapped wherever it ran out, which left the price floating
                    * mid-card and the action on a line of its own. The grid
                    * placements are ignored once the container is flex again.
                    */}
                  <div class="flex-1 min-w-0 grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 p-4 md:flex md:flex-wrap md:gap-x-5">
                    <div class="min-w-0 flex-1 basis-[15rem]">
                      <p class="text-[15.5px] font-medium truncate">
                        {o.customer_name}
                        <span class="ml-2 text-[13px] font-normal tracking-wide text-[var(--color-ink-faint)]">
                          {o.ref}
                        </span>
                        {/* Read straight off `orders.unread_for_owner`. Counting
                            the messages per row would be a query per order,
                            which is the shape that once ate the read budget. */}
                        {(o.unread_for_owner ?? 0) > 0 && (
                          <span class="ml-2 inline-flex items-center gap-1 align-middle rounded-[var(--radius-pill)] bg-[var(--color-navy)] px-2 py-0.5 text-[11.5px] font-semibold text-white tabular-nums">
                            {o.unread_for_owner}
                            <span class="sr-only">
                              unread {o.unread_for_owner === 1 ? 'message' : 'messages'}
                            </span>
                            <span aria-hidden="true" class="font-normal">new</span>
                          </span>
                        )}
                        {/* Every book on this one has landed, so it can go out
                            today even though its shipment is still arriving. */}
                        {o.ready_to_send === 1 && (
                          <span class="ml-2 inline-flex items-center align-middle rounded-[var(--radius-pill)] bg-[var(--color-instock)] px-2 py-0.5 text-[11.5px] font-semibold text-white">
                            ready to send
                          </span>
                        )}
                      </p>
                      <p class="mt-0.5 text-[13.5px] text-[var(--color-ink-faint)] truncate">
                        {facts(o).join(' · ')}
                      </p>
                    </div>

                    <div class="row-start-2 col-start-1 md:text-right shrink-0">
                      <p class="eyebrow !text-[10px]">{waited < 1 ? 'Just in' : `Waiting ${waited}h`}</p>
                      {left !== null && (
                        <p class:list={[
                          'text-[13px] tabular-nums',
                          left <= 6 ? 'text-[var(--color-outstock)] font-medium' : 'text-[var(--color-ink-faint)]',
                        ]}>
                          hold expires in {left}h
                        </p>
                      )}
                      {/* The hold is gone rather than going, and the order is
                          still holding its copies until somebody says otherwise. */}
                      {isLapsed && (
                        <p class="text-[13px] font-medium text-[var(--color-outstock)]">
                          {o.pay_by ? 'week to reply ran out' : 'hold ran out'}
                        </p>
                      )}
                    </div>

                    <span class="row-start-1 col-start-2 price text-[16px] shrink-0 md:w-[5.5rem] text-right">
                      {price(o.total_pence ?? o.subtotal_pence)}
                    </span>

                    {/* Text, not a button: the bar is already the control, and a
                        button inside a link is not a button anyone can use. */}
                    <span
                      class:list={[
                        'row-start-2 col-start-2 shrink-0 text-[14px] font-medium md:w-[4.5rem] text-right transition-transform duration-200 group-hover:translate-x-0.5',
                        o.status === 'requested' ? 'text-[var(--color-navy)]' : 'text-[var(--color-ink-faint)]',
                      ]}
                    >
                      {o.status === 'requested' ? 'Confirm →' : 'Open →'}
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}

      {settled.length > 0 && (
        <section class:list={[queue.length > 0 && 'mt-10']}>
          <h2 class="font-[family-name:var(--font-display)] text-[20px] font-semibold mb-3">
            Settled and closed
          </h2>
          <ul class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] divide-y divide-[var(--color-rule-faint)] overflow-hidden">
            {settled.map((o) => (
              <li>
                <a href={`/admin/orders/${o.ref}`} class="flex items-center gap-3 sm:gap-4 px-4 py-3 hover:bg-[var(--color-paper)] transition-colors">
                  <div class="min-w-0 flex-1">
                    <p class="text-[14.5px] font-medium truncate">
                      {o.customer_name}
                      <span class="ml-2 text-[12.5px] font-normal tracking-wide text-[var(--color-ink-faint)]">
                        {o.ref}
                      </span>
                      {(o.unread_for_owner ?? 0) > 0 && (
                        <span class="ml-2 inline-flex items-center gap-1 align-middle rounded-[var(--radius-pill)] bg-[var(--color-navy)] px-2 py-0.5 text-[11px] font-semibold text-white tabular-nums">
                          {o.unread_for_owner}
                          <span class="sr-only">
                            unread {o.unread_for_owner === 1 ? 'message' : 'messages'}
                          </span>
                          <span aria-hidden="true" class="font-normal">new</span>
                        </span>
                      )}
                    </p>
                    <p class="text-[13px] text-[var(--color-ink-faint)] truncate">
                      {o.item_count} {o.item_count === 1 ? 'book' : 'books'} · {o.fulfilment} ·{' '}
                      {new Date(o.created_at * 1000).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                    </p>
                  </div>
                  <span class:list={['px-2.5 py-1 rounded-[var(--radius-pill)] text-[12px] font-medium shrink-0', TONE[o.status]]}>
                    {portalLabel(o.status, o.fulfilment, Boolean(o.cash_payment))}
                  </span>
                  <span class="price text-[14.5px] shrink-0 w-[4.5rem] text-right">
                    {price(o.total_pence ?? o.subtotal_pence)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      </>
    )
  }
</Admin>
