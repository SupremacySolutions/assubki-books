---
import Admin from '../../../layouts/Admin.astro';
import { portalLabel } from '../../../lib/order-status';
import { listOrders, orderCounts } from '../../../lib/admin-db';
import { price } from '../../../lib/format';

const status = Astro.url.searchParams.get('status');
const [orders, counts] = await Promise.all([listOrders(status), orderCounts()]);
const cleared = Astro.url.searchParams.get('cleared');
const deleted = Astro.url.searchParams.get('deleted');
const clearable = (counts.cancelled ?? 0) + (counts.expired ?? 0);

const TABS = [
  { key: null, label: 'All' },
  { key: 'requested', label: 'Needs reply' },
  { key: 'awaiting_payment', label: 'Awaiting payment' },
  { key: 'paid', label: 'Paid' },
  { key: 'dispatched', label: 'Posted' },
  { key: 'completed', label: 'Completed' },
  { key: 'expired', label: 'Lapsed' },
  { key: 'cancelled', label: 'Cancelled' },
];

const TONE: Record<string, string> = {
  requested: 'bg-[var(--color-navy)]/10 text-[var(--color-navy)]',
  awaiting_payment: 'bg-[var(--color-brass)]/15 text-[var(--color-brass)]',
  paid: 'bg-[var(--color-instock)]/12 text-[var(--color-instock)]',
  dispatched: 'bg-[var(--color-instock)]/12 text-[var(--color-instock)]',
  completed: 'bg-[var(--color-rule)] text-[var(--color-ink-soft)]',
  expired: 'bg-[var(--color-rule)] text-[var(--color-ink-faint)]',
  cancelled: 'bg-[var(--color-rule)] text-[var(--color-ink-faint)]',
};


---

<Admin title="Orders" sub={`${orders.length} shown`}>
  {
    cleared && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Cleared {cleared} {cleared === '1' ? 'order' : 'orders'}.
      </p>
    )
  }

  {
    deleted && (
      <p class="mb-5 p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Deleted order {deleted}.
      </p>
    )
  }

  <nav class="flex flex-wrap gap-1.5 mb-5" aria-label="Filter by status">
    {
      TABS.map((tab) => (
        <a
          href={tab.key ? `/admin/orders?status=${tab.key}` : '/admin/orders'}
          class:list={[
            'px-3 py-1.5 rounded-full text-[13.5px] border transition-colors',
            status === tab.key || (!status && !tab.key)
              ? 'bg-[var(--color-navy)] text-white border-[var(--color-navy)]'
              : 'bg-white border-[var(--color-rule)] text-[var(--color-ink-soft)] hover:border-[var(--color-navy)]',
          ]}
        >
          {tab.label}
          {tab.key && counts[tab.key] ? ` (${counts[tab.key]})` : ''}
        </a>
      ))
    }
  </nav>

  {
    clearable > 0 && (
      <form
        method="post"
        action="/api/admin/orders/clear"
        class="mb-5 flex flex-wrap items-center gap-3 p-3.5 bg-white border border-[var(--color-rule)] rounded-[3px]"
        onsubmit="return confirm('Delete every cancelled and lapsed order? Orders that were quoted or paid are kept.')"
      >
        <p class="text-[14px] text-[var(--color-ink-soft)] flex-1 min-w-[220px]">
          {clearable} {clearable === 1 ? 'order' : 'orders'} came to nothing - cancelled or lapsed.
          Clearing them tidies this list; anything quoted or paid is kept.
        </p>
        <button type="submit" class="btn btn-ghost !py-1.5">Clear them</button>
      </form>
    )
  }

  {
    orders.length === 0 ? (
      <p class="p-5 bg-white border border-[var(--color-rule)] rounded-[3px] text-[15px] text-[var(--color-ink-soft)]">
        No orders with that status.
      </p>
    ) : (
      <ul class="bg-white border border-[var(--color-rule)] rounded-[3px] divide-y divide-[var(--color-rule)]">
        {orders.map((o) => (
          <li>
            <a href={`/admin/orders/${o.ref}`} class="flex items-center gap-4 p-4 hover:bg-[var(--color-paper)]">
              <div class="min-w-0 flex-1">
                <p class="text-[15px] font-medium truncate">
                  {o.customer_name}
                  <span class="ml-2 text-[13px] font-normal text-[var(--color-ink-faint)]">{o.ref}</span>
                </p>
                <p class="text-[13.5px] text-[var(--color-ink-faint)] truncate">
                  {o.item_count} {o.item_count === 1 ? 'book' : 'books'} · {o.fulfilment} ·{' '}
                  {new Date(o.created_at * 1000).toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'short',
                  })}
                </p>
              </div>
              <span class:list={['px-2 py-1 rounded-sm text-[12px] font-medium shrink-0', TONE[o.status]]}>
                {portalLabel(o.status, o.fulfilment, Boolean(o.cash_payment))}
              </span>
              <span class="price text-[15px] shrink-0 w-16 text-right">
                {price(o.total_pence ?? o.subtotal_pence)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Admin>
