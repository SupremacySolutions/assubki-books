---
import Admin from '../../../layouts/Admin.astro';
import { getOrderByRef, getOrderItems } from '../../../lib/admin-db';
import { price } from '../../../lib/format';
import { defaultPostagePence, getSetting } from '../../../lib/settings';
import { nextActions, portalLabel, POSTAGE_PROVIDERS } from '../../../lib/order-status';

const { ref } = Astro.params;
const order = ref ? await getOrderByRef(ref) : null;
if (!order) return Astro.rewrite('/404');

const [items, postageDefault, paymentInstructions] = await Promise.all([
  getOrderItems(order.id),
  defaultPostagePence(),
  getSetting('payment_instructions'),
]);

const isCollection = order.fulfilment === 'collection';
const suggestedPostage = order.postage_pence ?? (isCollection ? 0 : postageDefault);
const canConfirm = order.status === 'requested';
const hoursLeft = order.expires_at
  ? Math.max(0, Math.round((order.expires_at * 1000 - Date.now()) / 3_600_000))
  : null;

const sentVia = Astro.url.searchParams.get('sent');
const problem = Astro.url.searchParams.get('e');

// What can happen next, and what it is called, both come from lib/order-status
// so a collection order is never offered "Mark as posted".
const steps = nextActions(order.status, order.fulfilment);
---

<Admin
  title={order.customer_name}
  sub={order.ref}
  back={{ href: '/admin/orders', label: 'All orders' }}
>
  {
    sentVia && (
      <p class="mb-5 p-3.5 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Confirmed. Payment details sent by {sentVia.replace('+', ' and ')}.
      </p>
    )
  }
  {
    problem === 'nosend' && (
      <div class="mb-5 p-3.5 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        <p class="font-medium">Nothing was sent, so this order is still waiting.</p>
        <p class="mt-1 leading-relaxed">
          The postage and total have been saved, but no message could be delivered - email is not
          configured, and this customer has not connected Telegram. Set{' '}
          <code class="text-[13px]">RESEND_API_KEY</code> and{' '}
          <code class="text-[13px]">ORDER_FROM</code>, then confirm again. Until then you can
          contact them directly using the details on the right.
        </p>
      </div>
    )
  }
  {
    problem === 'state' && (
      <p class="mb-5 p-3.5 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        That order had already moved on - nothing was changed.
      </p>
    )
  }

  <div class="grid gap-6 lg:grid-cols-[1fr_320px] items-start">
    <div class="space-y-6">
      <!-- Everything needed to pack and post, in one block. -->
      <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
        <h2 class="eyebrow mb-3">Books to pack</h2>
        <ul class="divide-y divide-[var(--color-rule)]">
          {
            items.map((item) => (
              <li class="py-2.5 flex justify-between gap-4 text-[15px]">
                <span class="min-w-0">
                  {item.slug ? (
                    <a href={`/book/${item.slug}`} class="hover:text-[var(--color-navy)]">
                      {item.title_snapshot}
                    </a>
                  ) : (
                    item.title_snapshot
                  )}
                  {item.qty > 1 && (
                    <strong class="ml-2 text-[var(--color-navy)]">× {item.qty}</strong>
                  )}
                </span>
                <span class="shrink-0 tabular-nums">
                  {price(item.price_pence_snapshot * item.qty)}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 pt-3 border-t border-[var(--color-rule)] flex justify-between text-[15px]">
          <span>Subtotal</span>
          <span class="price">{price(order.subtotal_pence)}</span>
        </div>
        {
          order.total_pence !== null && (
            <>
              {!isCollection && (
                <div class="mt-1 flex justify-between text-[15px] text-[var(--color-ink-soft)]">
                  <span>Postage</span>
                  <span class="tabular-nums">{price(order.postage_pence ?? 0)}</span>
                </div>
              )}
              <div class="mt-2 pt-2 border-t border-[var(--color-rule)] flex justify-between text-[16px] font-semibold">
                <span>Total quoted</span>
                <span class="price text-[19px]">{price(order.total_pence)}</span>
              </div>
            </>
          )
        }
      </section>

      {
        canConfirm && (
          <section class="bg-white border-2 border-[var(--color-navy)] rounded-[3px] p-5">
            <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
              Confirm and send payment details
            </h2>
            <p class="mt-1.5 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
              {isCollection ? 'We will send' : 'Set the postage and we will send'}{' '}
              {order.customer_name.split(' ')[0]} the total and how to pay
              {order.telegram_chat_id
                ? ' - by Telegram and email, since they connected their Telegram.'
                : ' by email. They have not connected Telegram, so email is the only way to reach them.'}
            </p>

            <form method="post" action={`/api/admin/orders/${order.ref}/confirm`} class="mt-4">
              <div class="flex flex-wrap items-end gap-4">
                {/* Nothing is being posted, so there is nothing to charge for
                    it. Showing a postage box on a collection invites the owner
                    to add one by habit. */}
                <div class:list={[isCollection && 'hidden']}>
                  <label for="postage" class="block text-[14px] font-medium mb-1.5">
                    Postage (£)
                  </label>
                  <input
                    id="postage"
                    name="postage"
                    type="number"
                    step="0.01"
                    min="0"
                    value={(suggestedPostage / 100).toFixed(2)}
                    class="field !w-28 tabular-nums"
                  />
                </div>
                <p class="text-[14.5px] text-[var(--color-ink-soft)] pb-2.5">
                  {isCollection ? 'Total to pay is ' : 'Total becomes '}
                  <strong id="total" class="price text-[17px]">
                    {price(order.subtotal_pence + suggestedPostage)}
                  </strong>
                </p>
              </div>

              {/* Editable per order, not a fixed template: which account to pay
                  into depends on the size of the order and what is in it. The
                  setting is only the starting text. */}
              <div class="mt-4">
                <label for="payment_message" class="block text-[14px] font-medium mb-1.5">
                  How they should pay
                </label>
                <textarea
                  id="payment_message"
                  name="payment_message"
                  rows="8"
                  maxlength="4000"
                  class="field font-[family-name:var(--font-body)] text-[14px] leading-relaxed"
                  >{order.payment_message ?? paymentInstructions}</textarea
                >
                <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
                  Sent exactly as written, with the order reference added. Change it for this order
                  only - the starting text lives in{' '}
                  <a href="/admin/settings" class="text-[var(--color-navy)] underline underline-offset-2">Settings</a>.
                </p>
              </div>

              <button type="submit" class="btn btn-primary mt-4">
                Confirm and send
              </button>
            </form>
          </section>
        )
      }

      {
        steps.length > 0 && (
          <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
            <h2 class="eyebrow mb-3">Next steps</h2>
            <div class="space-y-3">
              {steps.map((step) => (
                <form
                  method="post"
                  action={`/api/admin/orders/${order.ref}/status`}
                  class:list={[
                    step.secondary || step.danger
                      ? 'pt-3 border-t border-[var(--color-rule)]'
                      : '',
                  ]}
                >
                  <input type="hidden" name="status" value={step.action} />

                  {/* Captured at the moment of posting, which is the only time
                      the owner is holding the receipt. The carrier matters
                      because the tracking link differs for each. */}
                  {step.needsPostage && (
                    <div class="flex flex-wrap items-end gap-3 mb-3">
                      <span>
                        <label for="tracking" class="block text-[13px] font-medium mb-1.5">
                          Tracking number{' '}
                          <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
                        </label>
                        <input
                          id="tracking"
                          name="tracking"
                          maxlength="80"
                          placeholder="e.g. AB123456789GB"
                          class="field !py-2 !w-52"
                        />
                      </span>
                      <span>
                        <label for="postage_provider" class="block text-[13px] font-medium mb-1.5">
                          Carrier
                        </label>
                        <select id="postage_provider" name="postage_provider" class="field !py-2 !w-40">
                          {POSTAGE_PROVIDERS.map((p) => (
                            <option value={p}>{p}</option>
                          ))}
                        </select>
                      </span>
                      <span>
                        <label for="postage_service" class="block text-[13px] font-medium mb-1.5">
                          Service{' '}
                          <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span>
                        </label>
                        <input
                          id="postage_service"
                          name="postage_service"
                          maxlength="60"
                          placeholder="e.g. Tracked 48"
                          class="field !py-2 !w-44"
                        />
                      </span>
                    </div>
                  )}

                  <button
                    type="submit"
                    class:list={[
                      'btn',
                      step.danger
                        ? 'btn-ghost !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40 hover:!border-[var(--color-outstock)]'
                        : step.secondary
                          ? 'btn-ghost'
                          : 'btn-primary',
                    ]}
                    title={step.hint}
                  >
                    {step.label}
                  </button>
                  {step.hint && (
                    <span class="ml-3 text-[13px] text-[var(--color-ink-faint)]">{step.hint}</span>
                  )}
                </form>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <aside class="space-y-4">
      {/* Deliberately one order at a time. The bulk clear cannot reach a
          completed order, and should not be able to. */}
      <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
        <h2 class="eyebrow mb-3">{isCollection ? 'Collecting' : 'Send to'}</h2>
        <p class="text-[15px] font-medium">{order.customer_name}</p>
        <p class="mt-2 text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line leading-relaxed">
          {isCollection ? 'Collecting in person.' : order.address}
        </p>

        {
          isCollection && (
            <div class="mt-3 pt-3 border-t border-[var(--color-rule)]">
              <label class="flex items-center gap-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  name="cash_payment"
                  value="1"
                  checked={Boolean(order.cash_payment)}
                  class="w-4 h-4 accent-[var(--color-navy)] toggle-cash-payment"
                  data-ref={order.ref}
                />
                <span class="text-[14px] font-medium">Paying in cash</span>
              </label>
              <p class="mt-2 text-[13px] text-[var(--color-ink-faint)]">
                Check if they'll pay cash on collection. The message on their order page will reflect this.
              </p>
            </div>
          )
        }

        <div class="mt-4 pt-3 border-t border-[var(--color-rule)] space-y-1.5 text-[14px]">
          <p><a href={`mailto:${order.email}`} class="text-[var(--color-navy)] break-all">{order.email}</a></p>
          {order.phone && <p><a href={`tel:${order.phone}`} class="text-[var(--color-navy)]">{order.phone}</a></p>}
          {order.telegram && <p class="text-[var(--color-ink-soft)]">{order.telegram}</p>}
          <p
            class:list={[
              'text-[13px]',
              order.telegram_chat_id ? 'text-[var(--color-instock)]' : 'text-[var(--color-ink-faint)]',
            ]}
          >
            {order.telegram_chat_id ? '✓ Telegram connected' : 'Telegram not connected'}
          </p>
        </div>
      </section>

      {
        order.notes && (
          <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5">
            <h2 class="eyebrow mb-2">Their note</h2>
            <p class="text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line">{order.notes}</p>
          </section>
        )
      }

      <section class="bg-white border border-[var(--color-rule)] rounded-[3px] p-5 text-[14px] space-y-2">
        <div class="flex justify-between gap-3">
          <span class="text-[var(--color-ink-faint)]">Status</span>
          <span class="font-medium">{portalLabel(order.status, order.fulfilment)}</span>
        </div>
        <div class="flex justify-between gap-3">
          <span class="text-[var(--color-ink-faint)]">Requested</span>
          <span>{new Date(order.created_at * 1000).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}</span>
        </div>
        {
          order.status === 'requested' && hoursLeft !== null && (
            <div class="flex justify-between gap-3">
              <span class="text-[var(--color-ink-faint)]">Hold expires</span>
              <span class={hoursLeft <= 6 ? 'text-[var(--color-outstock)] font-medium' : ''}>
                in {hoursLeft}h
              </span>
            </div>
          )
        }
        {order.tracking_number && (
          <div class="flex justify-between gap-3">
            <span class="text-[var(--color-ink-faint)]">
              {order.postage_provider ?? 'Tracking'}
            </span>
            <span class="tabular-nums select-all text-right">
              {order.tracking_number}
              {order.postage_service && (
                <span class="block text-[13px] text-[var(--color-ink-faint)]">
                  {order.postage_service}
                </span>
              )}
            </span>
          </div>
        )}
        <a
          href={`/order?ref=${order.ref}&t=${order.access_token}`}
          class="block pt-2 text-[var(--color-navy)] hover:underline underline-offset-2"
        >
          See what the customer sees →
        </a>
      </section>

      <section class="border border-[var(--color-outstock)]/30 rounded-[3px] p-5">
        <h2 class="eyebrow !text-[var(--color-outstock)] mb-2">Delete</h2>
        <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed">
          Removes this order for good. Stock movements stay in the record.
          {['requested', 'awaiting_payment'].includes(order.status)
            ? ' Any copies it is holding are released.'
            : ' Stock is not restored, since these copies already left the shop.'}
        </p>
        <form
          method="post"
          action={`/api/admin/orders/${order.ref}/delete`}
          id="deleteOrderForm"
          data-ref={order.ref}
          class="mt-3"
        >
          <button
            type="submit"
            class="btn btn-ghost w-full !py-2 !text-[13.5px] !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40 hover:!border-[var(--color-outstock)] hover:!bg-[var(--color-outstock)]/5"
          >
            Delete this order
          </button>
        </form>
      </section>
    </aside>
  </div>

  <script is:inline define:vars={{ subtotal: order.subtotal_pence, orderRef: order.ref }}>
    document.querySelector('#deleteOrderForm')?.addEventListener('submit', (event) => {
      if (!confirm(`Delete order ${orderRef} for good?\n\nThis cannot be undone.`)) {
        event.preventDefault();
      }
    });

    const postage = document.querySelector('#postage');
    const total = document.querySelector('#total');
    postage?.addEventListener('input', () => {
      const pence = Math.round((Number(postage.value) || 0) * 100);
      total.textContent = `£${((subtotal + pence) / 100).toFixed(2)}`;
    });

    // Cash on collection saves on the tick rather than behind a Save button,
    // so a failed save must put the box back: a checkbox showing a state the
    // order does not have is worse than no checkbox, because the customer's
    // page would be saying the opposite.
    const cashCheckbox = document.querySelector<HTMLInputElement>('.toggle-cash-payment');
    if (cashCheckbox) {
      cashCheckbox.addEventListener('change', async () => {
        const wanted = cashCheckbox.checked;
        const body = new FormData();
        body.append('cash_payment', wanted ? '1' : '0');
        cashCheckbox.disabled = true;
        try {
          const res = await fetch(`/api/admin/orders/${cashCheckbox.dataset.ref}/cash-payment`, {
            method: 'POST',
            body,
          });
          if (!res.ok) throw new Error(`save failed: ${res.status}`);
        } catch (err) {
          console.error('cash payment save failed', err);
          cashCheckbox.checked = !wanted;
          alert('That did not save. Please try again.');
        } finally {
          cashCheckbox.disabled = false;
        }
      });
    }
  </script>
</Admin>
