---
import Admin from '../../../layouts/Admin.astro';
import { getOrderByRef, getOrderItems, lastPostagePence } from '../../../lib/admin-db';
import { price } from '../../../lib/format';
import { siblingOrders } from '../../../lib/orders';
import {
  paymentOptions,
  collectionPlaces,
  defaultMessage,
  composeMessage,
  CASH_SLOT,
} from '../../../lib/settings';
import {
  nextActions,
  portalLabel,
  POSTAGE_PROVIDERS,
  THREAD,
  replyChannelNote,
} from '../../../lib/order-status';
import Thread from '../../../components/Thread.astro';
import PoundInput from '../../../components/PoundInput.astro';
import { markRead, thread, threadOpen } from '../../../lib/messages';
import {
  canAmend,
  amendments,
  removedSummary,
  AMEND_REFUSAL,
  NOTE_MAX,
} from '../../../lib/amend';

const { ref } = Astro.params;
const order = ref ? await getOrderByRef(ref) : null;
if (!order) return Astro.rewrite('/404');

/*
 * The other orders this customer's one checkout produced.
 *
 * Shown here mainly because of postage: a basket holding shelf books and
 * reserved books becomes two orders, and quoting a delivery charge on each
 * bills one person twice for one basket. The owner cannot avoid that without
 * being told the orders are related, and nothing on this page said so.
 */
const siblings = order.split_group
  ? await siblingOrders(order.split_group, order.id)
  : [];

/* The conversation, and the fact the owner has now seen it. Opening the order
   is the read event on this side too. */
const messages = await thread(order.id);
/* Counted off the thread that was just read, not asked for again. */
const imagesHeld = messages.filter((m) => m.image_key).length;
/* Acknowledged through the newest message on the page, so anything that
   arrives while it renders stays counted. */
if ((order.unread_for_owner ?? 0) > 0) {
  await markRead(order.id, 'owner', messages.reduce((n, m) => Math.max(n, m.id), 0));
}

const threadError = ({
  long: THREAD.tooLong,
  closed: THREAD.closed,
  empty: THREAD.failed,
} as Record<string, string>)[Astro.url.searchParams.get('e') ?? ''] ?? null;

const extended = Astro.url.searchParams.get('extended');

/*
 * A reservation whose week is running.
 *
 * Shown above Next steps because it changes what the next step is: the
 * question stops being "has this been paid" and becomes "is this customer
 * still coming", and there is a date after which the copies leave.
 */
const replyBy = order.pay_by ? new Date(order.pay_by * 1000) : null;
const waitingOnReply = Boolean(
  replyBy && ['requested', 'awaiting_payment'].includes(order.status),
);
const daysLeft = replyBy
  ? Math.ceil((replyBy.getTime() - Date.now()) / 86_400_000)
  : 0;

const isCollection = order.fulfilment === 'collection';
// Cash applies to either journey now - on a posted order it means one handed
// over in person - so this no longer depends on how the books are going.
const isCash = Boolean(order.cash_payment);

// Every part is fetched, not just the ones in force: picking another, or
// ticking "paying in cash", rebuilds the box without a page load, so the other
// wordings have to be here to build from.
const [items, postageDefault, payments, places, opening, changes] = await Promise.all([
  getOrderItems(order.id),
  lastPostagePence(),
  paymentOptions(),
  isCollection ? collectionPlaces() : Promise.resolve([]),
  defaultMessage(order.fulfilment, isCash),
  // Only for an order that has actually been amended, which is nearly none of
  // them - `amended_at` is on the order precisely so this table is not read on
  // every view of every order.
  order.amended_at ? amendments(order.id) : Promise.resolve([]),
]);

// Which of each starts marked. A cash order starts on the cash wording, so bank
// details are never the opening text on an order that is not paying by bank.
const openText = (order.payment_message ?? opening).trim();
const openPayment = isCash
  ? payments.find((p) => p.slot === CASH_SLOT)
  : payments.find((p) => p.slot !== CASH_SLOT);
const activePayment = openPayment?.slot ?? null;
const activePlace = places[0]?.slot ?? null;
const suggestedPostage = order.postage_pence ?? (isCollection ? 0 : postageDefault);

/*
 * Each stage that has already happened, with what was captured at the time.
 * Built from the timestamps the order already carries, so nothing new is
 * recorded to make this work.
 */
const history: { at: number; what: string; detail?: string; body?: string }[] = [];

history.push({
  at: order.created_at,
  what: 'Request placed',
  detail: `${order.item_count} ${order.item_count === 1 ? 'book' : 'books'} · ${price(order.subtotal_pence)}`,
});

if (order.confirmed_at) {
  history.push({
    at: order.confirmed_at,
    what: isCash ? 'Confirmed, paying in cash' : 'Confirmed and payment details sent',
    detail:
      order.total_pence !== null
        ? `Total ${price(order.total_pence)}${
            !isCollection && order.postage_pence ? ` · postage ${price(order.postage_pence)}` : ''
          }`
        : undefined,
    // The message exactly as it went out, which is the thing most worth being
    // able to look back at.
    body: order.payment_message ?? undefined,
  });
}

if (order.paid_at) {
  history.push({
    at: order.paid_at,
    what: isCash ? 'Set aside for collection' : 'Payment received',
  });
}

if (order.dispatched_at) {
  history.push({
    at: order.dispatched_at,
    what: 'Posted',
    detail: [order.postage_provider, order.postage_service, order.tracking_number]
      .filter(Boolean)
      .join(' · ') || undefined,
  });
}

if (order.completed_at) {
  history.push({ at: order.completed_at, what: isCollection ? 'Collected' : 'Closed' });
}

/*
 * Every amendment, in the timeline with everything else that was sent.
 *
 * The lines it names are gone from the order, so this is the only place the
 * shop can still answer "what did this order say before?" - which is the
 * question that arrives when a customer compares two messages from us.
 */
for (const change of changes) {
  history.push({
    at: change.at,
    what: `${change.removed.length === 1 ? 'A book' : `${change.removed.length} books`} taken off`,
    detail:
      `${removedSummary(change.removed)} · ` +
      (change.totalBefore !== null && change.totalAfter !== null
        ? `total ${price(change.totalBefore)} → ${price(change.totalAfter)}`
        : `subtotal ${price(change.subtotalBefore)} → ${price(change.subtotalAfter)}`),
    body: change.note ?? undefined,
  });
}

if (order.status === 'cancelled') {
  history.push({
    at: order.updated_at,
    what: 'Cancelled',
    body: order.cancel_note ?? undefined,
  });
}

history.sort((a, b) => a.at - b.at);
const waitingForBooks = items.some((item) => Boolean(item.from_incoming));
const canConfirm = order.status === 'requested' && !waitingForBooks;
/*
 * Whether books may still come off this order.
 *
 * A single line cannot be amended down to nothing - that is a cancellation,
 * and it already has a button that releases the copies and tells the customer -
 * so an order with one book on it is offered nothing here.
 */
const amendable = canAmend(order.status);
const amendedCount = Number(Astro.url.searchParams.get('amended') ?? 0);
const told = Astro.url.searchParams.get('told') ?? '';
/** Whether a total has been quoted yet, which is what postage hangs off. */
const quoted = order.total_pence !== null;
const totalCopies = items.reduce((n, item) => n + item.qty, 0);
const hoursLeft = order.expires_at
  ? Math.max(0, Math.round((order.expires_at * 1000 - Date.now()) / 3_600_000))
  : null;

const sentVia = Astro.url.searchParams.get('sent');
const saved = Astro.url.searchParams.get('saved');
const problem = Astro.url.searchParams.get('e');

// What can happen next, and what it is called, both come from lib/order-status
// so a collection order is never offered "Mark as posted".
const steps = nextActions(order.status, order.fulfilment, isCash)
  .filter((step) => !waitingForBooks || step.action === 'cancelled');
---

<Admin
  title={order.customer_name}
  sub={order.ref}
  back={{ href: '/admin/orders', label: 'All orders' }}
>
  {/*
    * The status the poll compares against.
    *
    * A status move rewrites too much of this page to patch in - the totals,
    * the payment panel, what the next action is - so the script reloads
    * instead, and this is what it notices the move against.
    */}
  <div data-order-status={order.status} data-order-ref={order.ref}></div>
  {
    saved === 'tracking' && (
      <p class="mb-5 p-3.5 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Tracking updated. Nothing was sent to the customer.
      </p>
    )
  }

  {
    sentVia && (
      <p class="mb-5 p-3.5 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-instock)]">
        Confirmed. Payment details sent by {sentVia.replace('+', ' and ')}.
      </p>
    )
  }
  {
    problem === 'nosend' && (
      <div class="mb-5 p-3.5 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        <p class="font-medium">Nothing was sent, so this order is still waiting.</p>
        <p class="mt-1 leading-relaxed">
          The postage and total have been saved, but no message could be delivered - email is not
          configured, and this customer has not connected Telegram. Set{' '}
          <code class="text-[13px]">RESEND_API_KEY</code> and{' '}
          <code class="text-[13px]">ORDER_FROM</code>, then confirm again. Until then you can
          contact them directly using the details on the right.
        </p>
      </div>
    )
  }
  {
    problem === 'state' && (
      <p class="mb-5 p-3.5 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14.5px] text-[var(--color-outstock)]">
        That order had already moved on - nothing was changed.
      </p>
    )
  }

  {/* The two ways an amendment is refused before it touches anything, in the
      words lib/amend gives them - so the endpoint and the page cannot describe
      the same refusal differently. */}
  {
    (problem === 'nochange' || problem === 'empty') && (
      <p class="mb-5 p-3.5 bg-[var(--color-brass)]/10 border border-[var(--color-brass)]/30 rounded-[3px] text-[14.5px] leading-relaxed">
        {problem === 'empty' ? AMEND_REFUSAL.empty : AMEND_REFUSAL.none}
      </p>
    )
  }

  {/* Whether the customer actually heard is the part worth saying out loud.
      The change stands either way - the copies are back on the shelf - so a
      failed send is a job for the owner, not a reason to have refused. */}
  {
    amendedCount > 0 && (
      <p
        class:list={[
          'mb-5 p-3.5 rounded-[3px] text-[14.5px] leading-relaxed border',
          told
            ? 'bg-[var(--color-instock)]/10 border-[var(--color-instock)]/30 text-[var(--color-instock)]'
            : 'bg-[var(--color-outstock)]/10 border-[var(--color-outstock)]/30 text-[var(--color-outstock)]',
        ]}
      >
        {amendedCount === 1 ? 'One book' : `${amendedCount} books`} taken off, and the copies are
        back on the shelf.{' '}
        {told
          ? `They were told by ${told.replace('+', ' and ')}.`
          : 'Nothing could be delivered to them, though - tell them yourself in the messages below.'}
      </p>
    )
  }

  {/*
    * One checkout, more than one order.
    *
    * Placed above everything else because it changes what the owner does
    * next: postage is quoted per order, so charging it here and again on the
    * sibling bills one customer twice for one basket.
    */}
  {siblings.length > 0 && (
    <div class="mb-5 p-3.5 bg-[var(--color-brass)]/10 border border-[var(--color-brass)]/30 rounded-[3px] text-[14px] leading-relaxed max-w-[46rem]">
      <p>
        Part of one basket that became {siblings.length + 1} orders - the books on
        the shelf are separated from the ones still coming, so each can be sent
        when it is ready.
      </p>
      <ul class="mt-1.5 grid gap-1">
        {siblings.map((other) => (
          <li>
            <a
              href={`/admin/orders/${other.ref}`}
              class="text-[var(--color-navy)] underline underline-offset-2"
            >
              {other.ref}
            </a>
            <span class="text-[var(--color-ink-faint)]">
              {' '}- {other.shipment_id ? 'the reserved half' : 'the shelf half'}
              {other.status === 'cancelled' || other.status === 'expired'
                ? `, ${other.status}`
                : ''}
            </span>
          </li>
        ))}
      </ul>
      {!isCollection && (
        <p class="mt-1.5 text-[13px] text-[var(--color-ink-soft)]">
          Postage is quoted per order. Charge it once across the two unless you
          really are sending two parcels.
        </p>
      )}
    </div>
  )}

  <div class="grid gap-6 lg:grid-cols-[1fr_320px] items-start">
    <div class="space-y-6">
      <!-- Everything needed to pack and post, in one block. -->
      <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
        <h2 class="eyebrow mb-3">Books to pack</h2>
        <ul class="divide-y divide-[var(--color-rule-faint)]">
          {
            items.map((item) => (
              <li class="py-2.5 flex justify-between gap-4 text-[15px]">
                <span class="min-w-0">
                  {item.slug ? (
                    <a
                      href={item.shipment_id
                        ? `/shipments/${item.shipment_id}`
                        : `/book/${item.slug}`}
                      class="hover:text-[var(--color-navy)]"
                    >
                      {item.title_snapshot}
                    </a>
                  ) : (
                    item.title_snapshot
                  )}
                  {item.qty > 1 && (
                    <strong class="ml-2 text-[var(--color-navy)]">× {item.qty}</strong>
                  )}
                </span>
                <span class="shrink-0 tabular-nums">
                  {price(item.price_pence_snapshot * item.qty)}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 pt-3 border-t border-[var(--color-rule)] flex justify-between text-[15px]">
          <span>Subtotal</span>
          <span class="price">{price(order.subtotal_pence)}</span>
        </div>
        {
          order.total_pence !== null && (
            <>
              {!isCollection && (
                <div class="mt-1 flex justify-between text-[15px] text-[var(--color-ink-soft)]">
                  <span>Postage</span>
                  <span class="tabular-nums">{price(order.postage_pence ?? 0)}</span>
                </div>
              )}
              <div class="mt-2 pt-2 border-t border-[var(--color-rule)] flex justify-between text-[16px] font-semibold">
                <span>Total quoted</span>
                <span class="price text-[19px]">{price(order.total_pence)}</span>
              </div>
            </>
          )
        }
      </section>

      {/*
        * Taking books off, which the shop could not do at all.
        *
        * A customer wrote asking for three titles to be removed and the only
        * buttons on this page were cancel the whole order and delete it. The
        * removal happened in the messages instead, so the order went on holding
        * copies of books nobody wanted and quoting a total for them.
        *
        * Folded away, because the ordinary afternoon is packing what was
        * ordered, not editing it - but directly under the packing list, since
        * that is the list it changes.
        */}
      {amendable && totalCopies > 1 && (
        <details
          class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5"
          open={problem === 'nochange' || problem === 'empty'}
        >
          <summary class="text-[14.5px] text-[var(--color-navy)] cursor-pointer">
            Take books off this order
          </summary>
          <p class="mt-3 text-[14px] text-[var(--color-ink-soft)] leading-relaxed max-w-[38rem]">
            Set how many of each to keep. The copies you take off go straight back on the shelf,
            the order's figures follow them, and {order.customer_name.split(' ')[0]} is sent the
            revised list{quoted ? ' and the new total' : ''}.
          </p>

          <form
            method="post"
            action={`/api/admin/orders/${order.ref}/amend`}
            id="amendForm"
            class="mt-4"
          >
            <ul class="divide-y divide-[var(--color-rule-faint)] border-y border-[var(--color-rule-faint)]">
              {items.map((item) => (
                <li class="py-2.5 flex items-center justify-between gap-4 text-[14.5px]">
                  <span class="min-w-0" data-amend-title>
                    {item.title_snapshot}
                    <span class="block text-[13px] text-[var(--color-ink-faint)]">
                      {price(item.price_pence_snapshot)} each
                      {item.from_incoming ? ' · reserved from a delivery' : ''}
                    </span>
                  </span>
                  <span class="shrink-0 flex items-center gap-2">
                    <label class="text-[13px] text-[var(--color-ink-faint)]" for={`qty_${item.id}`}>
                      Keep
                    </label>
                    <input
                      id={`qty_${item.id}`}
                      name={`qty_${item.id}`}
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max={item.qty}
                      value={item.qty}
                      data-amend-qty
                      data-was={item.qty}
                      data-price={item.price_pence_snapshot}
                      data-title={item.title_snapshot}
                      class="field !w-16 !py-1.5 !text-[14px] tabular-nums text-center"
                    />
                    <span class="text-[13px] text-[var(--color-ink-faint)] tabular-nums">
                      of {item.qty}
                    </span>
                    {/* One press for the ordinary case, which is a whole title
                        coming off rather than a quantity being trimmed. */}
                    <button
                      type="button"
                      data-amend-none={`qty_${item.id}`}
                      class="px-2 py-1 text-[13px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-outstock)] hover:text-[var(--color-outstock)]"
                    >
                      Remove
                    </button>
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-3 flex justify-between text-[15px]">
              <span>Order becomes</span>
              <span class="price" id="amendSubtotal">{price(order.subtotal_pence)}</span>
            </div>
            {order.discount_pence > 0 && (
              <p class="mt-1 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
                The {price(order.discount_pence)} discount this order was given is kept in
                proportion to what is left, rather than worked out again from today's rule -
                a customer must not lose a deal because the shop changed its threshold
                afterwards.
              </p>
            )}

            {/* Only once a total has been quoted. Before that the confirm step
                still decides postage, and inventing one here would put a figure
                on an order nobody has priced. */}
            {quoted && !isCollection && (
              <div class="mt-4">
                <label for="amendPostage" class="block text-[13px] font-medium mb-1.5">
                  Postage (£)
                </label>
                <div class="flex items-center gap-3">
                  <PoundInput
                    id="amendPostage"
                    name="postage"
                    min="0"
                    value={((order.postage_pence ?? 0) / 100).toFixed(2)}
                    class="!w-24 !py-1.5 !text-[14px]"
                  />
                  <p class="text-[13.5px] text-[var(--color-ink-soft)]">
                    New total{' '}
                    <strong id="amendTotal" class="price text-[16px]">
                      {price(order.total_pence ?? 0)}
                    </strong>
                  </p>
                </div>
                <p class="mt-1 text-[13px] text-[var(--color-ink-faint)]">
                  A smaller parcel often costs less to send, and they are holding a message
                  quoting the old figure.
                </p>
              </div>
            )}

            <div class="mt-4">
              <label for="amend_note" class="block text-[13px] font-medium mb-1.5">
                Why, in your own words (optional)
              </label>
              <textarea
                id="amend_note"
                name="note"
                rows="2"
                maxlength={NOTE_MAX}
                placeholder="e.g. Taken off at your request - the rest is unchanged."
                class="field font-[family-name:var(--font-body)] !text-[14px]"
              />
              <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">
                Goes with the email, their order page, and Telegram if they connected it.
              </p>
            </div>

            <button type="submit" class="btn btn-ghost mt-4">
              Take them off and tell them
            </button>
          </form>
        </details>
      )}

      {/* One book on the order and nothing to trim it to. Said rather than
          left as a missing panel, because the owner would go looking for it. */}
      {amendable && totalCopies === 1 && (
        <p class="text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed">
          There is one book on this order, so there is nothing to take off it -
          removing it is a cancellation, in Next steps below.
        </p>
      )}

      {waitingForBooks && (
        <p class="p-4 bg-[var(--color-brass)]/10 text-[14px]">Waiting for reserved books to arrive. Payment and dispatch become available once every copy is here.</p>
      )}
      {
        canConfirm && (
          <section class="bg-white border-2 border-[var(--color-navy)] rounded-[3px] p-5">
            <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
              Confirm and send payment details
            </h2>
            <p class="mt-1.5 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
              {isCollection ? 'We will send' : 'Set the postage and we will send'}{' '}
              {order.customer_name.split(' ')[0]}{' '}
              {isCash ? 'the total and a time to arrange' : 'the total and how to pay'}
              {order.telegram_chat_id
                ? ' - by Telegram and email, since they connected their Telegram.'
                : ' by email. They have not connected Telegram, so email is the only way to reach them.'}
            </p>

            <form method="post" action={`/api/admin/orders/${order.ref}/confirm`} class="mt-4">
              <div class="flex flex-wrap items-end gap-4">
                {/* Nothing is being posted, so there is nothing to charge for
                    it. Showing a postage box on a collection invites the owner
                    to add one by habit. */}
                <div class:list={[isCollection && 'hidden']}>
                  <label for="postage" class="block text-[14px] font-medium mb-1.5">
                    Postage (£)
                  </label>
                  <PoundInput
                    id="postage"
                    name="postage"
                    min="0"
                    value={(suggestedPostage / 100).toFixed(2)}
                    class="!w-24"
                  />
                </div>
                <p class="text-[14.5px] text-[var(--color-ink-soft)] pb-2.5">
                  {isCash ? 'To pay in cash: ' : isCollection ? 'Total to pay is ' : 'Total becomes '}
                  <strong id="total" class="price text-[17px]">
                    {price(order.subtotal_pence + suggestedPostage)}
                  </strong>
                </p>
              </div>

              {/* The tick belongs beside the message it rewrites. Left in the
                  aside it was two feet from the box it changes, and the owner
                  could send bank details to someone paying cash without ever
                  seeing the contradiction. */}
              <label class="mt-4 flex items-start gap-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  name="cash_payment"
                  value="1"
                  checked={Boolean(order.cash_payment)}
                  class="w-4 h-4 mt-0.5 accent-[var(--color-navy)] toggle-cash-payment"
                  data-ref={order.ref}
                />
                <span>
                  <span class="block text-[14px] font-medium">
                    Paying in cash {isCollection ? 'on collection' : 'when you hand them over'}
                  </span>
                  <span class="block mt-0.5 text-[13px] text-[var(--color-ink-faint)]">
                    Nothing is owed until then. Their order page, this message and the emails all
                    say so.
                  </span>
                </span>
              </label>

              {/* Editable per order, not a fixed template: which account to pay
                  into depends on the size of the order and what is in it. The
                  drafts are only the starting text. */}
              <div class="mt-4">
                <label for="payment_message" class="block text-[14px] font-medium mb-1.5">
                  {isCash ? 'What they should do next' : 'How they should pay'}
                </label>

                {/* Two pickers, because a message has two parts: where they
                    are collecting, and how they are paying. A collection paid
                    by transfer needs both, which no single list of whole
                    messages could offer without a box per combination. */}
                {places.length > 0 && (
                  <div class="mb-3">
                    <p class="text-[12.5px] text-[var(--color-ink-faint)] mb-1">Where they collect</p>
                    <div class="flex flex-wrap items-center gap-2" data-place-picker>
                      {places.map((d) => (
                        <button
                          type="button"
                          data-part-pick={d.slot}
                          data-part-kind="place"
                          aria-pressed={d.slot === activePlace ? 'true' : 'false'}
                          class="px-2.5 py-1 text-[13px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-navy)] aria-pressed:border-[var(--color-navy)] aria-pressed:bg-[var(--color-navy)] aria-pressed:text-white"
                        >
                          {d.label}
                        </button>
                      ))}
                    </div>
                  </div>
                )}

                {payments.length > 0 && (
                  <div class="mb-2">
                    <p class="text-[12.5px] text-[var(--color-ink-faint)] mb-1">How they pay</p>
                    <div class="flex flex-wrap items-center gap-2" data-draft-picker>
                      {/* Only one side of this is ever live. Ticking cash kills
                          the bank accounts and wakes the cash wording, and
                          unticking does the reverse - so bank details and "pay
                          in cash" cannot both be armed, which is how a message
                          carrying both used to be possible. */}
                      {payments.map((d) => (
                        <button
                          type="button"
                          data-part-pick={d.slot}
                          data-part-kind="payment"
                          data-cash-slot={d.slot === CASH_SLOT ? 'true' : 'false'}
                          disabled={d.slot === CASH_SLOT ? !isCash : isCash}
                          aria-pressed={d.slot === activePayment ? 'true' : 'false'}
                          class="px-2.5 py-1 text-[13px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-navy)] aria-pressed:border-[var(--color-navy)] aria-pressed:bg-[var(--color-navy)] aria-pressed:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:border-[var(--color-rule)]"
                        >
                          {d.label}
                        </button>
                      ))}
                      {payments.length === 1 && (
                        <a href="/admin/settings" class="text-[13px] text-[var(--color-ink-faint)] hover:text-[var(--color-navy)] underline underline-offset-2">
                          Add another
                        </a>
                      )}
                    </div>

                    {/* An unwritten draft is dropped from the list entirely, so
                        ticking cash could otherwise leave nothing selectable
                        and no explanation for it. */}
                    {!payments.some((d) => d.slot === CASH_SLOT) && (
                      <p
                        data-cash-missing
                        hidden={!isCash}
                        class="mt-2 text-[13px] text-[var(--color-outstock)] leading-relaxed"
                      >
                        No cash wording written yet -{' '}
                        <a href="/admin/settings" class="underline underline-offset-2">
                          add one in Settings
                        </a>
                        , or the message below is whatever you type here.
                      </p>
                    )}
                  </div>
                )}

                <textarea
                  id="payment_message"
                  name="payment_message"
                  rows="8"
                  maxlength="4000"
                  class="field font-[family-name:var(--font-body)] text-[14px] leading-relaxed"
                  data-payments={JSON.stringify(payments)}
                  data-places={JSON.stringify(places)}
                  >{order.payment_message ?? opening}</textarea
                >
                <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
                  Sent exactly as written, with the order reference added. Change it for this order
                  only - the drafts themselves live in{' '}
                  <a href="/admin/settings" class="text-[var(--color-navy)] underline underline-offset-2">Settings</a>.
                </p>
              </div>

              <button type="submit" class="btn btn-primary mt-4">
                Confirm and send
              </button>
            </form>
          </section>
        )
      }

      {/*
        * The conversation, between the packing list and the record of what has
        * already been sent.
        *
        * Not in the aside: the aside is 320px of facts about the customer, and
        * a reply box in it would be too narrow to write in on a phone. Not
        * above the confirm card either - the books to pack stay first, because
        * that is what the owner opens this page to do.
        *
        * Everything the shop already sends - the payment message, a
        * cancellation note - stays where it is. This is a conversation, not a
        * merged timeline of every event.
        */}
      <Thread
        messages={messages}
        side="owner"
        action={`/api/admin/orders/${order.ref}/message`}
        open={threadOpen(order.status)}
        proofUrl={(id: number) => `/api/admin/orders/${order.ref}/proof?id=${id}`}
        proofBase={`/api/admin/orders/${order.ref}/proof`}
        pollUrl={threadOpen(order.status) ? `/api/admin/orders/${order.ref}/thread` : null}
        imagesUsed={imagesHeld}
        channelNote={replyChannelNote(order.telegram_chat_id, order.email)}
        error={threadError}
      />

      {/* What has already been done, and what was typed at the time.
          The page used to show only the *next* step, so once an order was
          confirmed there was no way to see what had been sent - the wording,
          the postage, the tracking number were all stored and none displayed.
          Read-only on purpose: it is a record, not a second place to edit. */}
      {
        history.length > 0 && (
          <section class="bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px] p-5">
            <h2 class="eyebrow mb-4">Already sent</h2>
            <ol class="space-y-4">
              {history.map((h) => (
                <li class="grid grid-cols-[7.5rem_1fr] gap-x-4 gap-y-1 text-[14px]">
                  <div class="text-[13px] text-[var(--color-ink-faint)] tabular-nums">
                    {new Date(h.at * 1000).toLocaleDateString('en-GB', {
                      day: 'numeric', month: 'short',
                    })}
                    <span class="block">
                      {new Date(h.at * 1000).toLocaleTimeString('en-GB', {
                        hour: '2-digit', minute: '2-digit',
                      })}
                    </span>
                  </div>
                  <div>
                    <p class="font-medium text-[var(--color-ink-soft)]">{h.what}</p>
                    {h.detail && (
                      <p class="mt-0.5 text-[13.5px] text-[var(--color-ink-faint)]">{h.detail}</p>
                    )}
                    {h.body && (
                      <pre class="mt-1.5 p-2.5 bg-white border border-[var(--color-rule)] rounded-[2px] text-[12.5px] text-[var(--color-ink-faint)] whitespace-pre-wrap font-[family-name:var(--font-body)] max-h-40 overflow-y-auto">{h.body}</pre>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {extended && (
        <p class="p-3 bg-[var(--color-instock)]/10 border border-[var(--color-instock)]/30 rounded-[var(--radius-field)] text-[14.5px] text-[var(--color-instock)]">
          Another week. Let them know in the messages below - nothing was sent.
        </p>
      )}

      {waitingOnReply && (
        <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] border-l-[3px] border-l-[var(--color-brass)] p-5">
          <h2 class="text-[16px]">
            {daysLeft > 0
              ? `Reserved books - ${daysLeft} ${daysLeft === 1 ? 'day' : 'days'} to reply`
              : 'Reserved books - the week is up'}
          </h2>
          <p class="mt-1.5 text-[14px] text-[var(--color-ink-soft)] leading-relaxed max-w-[38rem]">
            Their books arrived and are held under this order until
            {' '}<strong class="text-[var(--color-ink)]">
              {replyBy!.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' })}
            </strong>.
            {daysLeft > 0
              ? ' After that the copies go back on the shelf on their own.'
              : ' The sweep will release them at its next run.'}
          </p>
          <form method="post" action={`/api/admin/orders/${order.ref}/extend`} class="mt-3">
            <button type="submit" class="btn btn-ghost !py-1.5 !text-[13.5px]">
              Give them another week
            </button>
          </form>
          <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)]">
            Counted from today, so this works even if the date has already passed.
            Nothing is sent - tell them yourself in the messages below.
          </p>
        </section>
      )}

      {/*
        * A customer has asked to cancel.
        *
        * Above "Next steps", because it changes what the next step should be.
        * Saying yes is the ordinary cancel action below - it already releases
        * the copies and messages them - so only saying no needs its own form.
        */}
      {order.cancel_requested_at && !['cancelled', 'expired'].includes(order.status) && (
        <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] border-l-[3px] border-l-[var(--color-brass)] p-5">
          <div class="flex items-start gap-3">
            <span
              class="shrink-0 grid place-items-center w-[22px] h-[22px] rounded-full bg-[var(--color-brass)]/15 text-[var(--color-brass)] text-[13px] font-semibold"
              aria-hidden="true"
            >?</span>
            <div class="min-w-0">
              <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
                {order.customer_name} asked to cancel
              </h2>
              <p class="mt-1 text-[14px] text-[var(--color-ink-faint)]">
                {new Date(order.cancel_requested_at * 1000).toLocaleString('en-GB', {
                  dateStyle: 'medium',
                  timeStyle: 'short',
                })}
                {' · their order is still live until you answer'}
              </p>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-[var(--color-rule-faint)]">
            <p class="eyebrow mb-1.5">Their reason</p>
            <p class="text-[14.5px] leading-relaxed whitespace-pre-line">
              {order.customer_cancel_note ?? (
                <span class="text-[var(--color-ink-faint)]">They did not give one.</span>
              )}
            </p>
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <p class="text-[14px] text-[var(--color-ink-soft)] flex-1 min-w-[16rem]">
              To agree, cancel it in <strong class="text-[var(--color-ink)]">Next steps</strong> below -
              that is what puts the books back and tells them.
            </p>
            <form method="post" action={`/api/admin/orders/${order.ref}/cancel-request`} class="shrink-0">
              <button type="submit" class="btn btn-ghost !py-2 !text-[14px]">Keep the order</button>
            </form>
          </div>
        </section>
      )}

      {
        steps.length > 0 && (
          <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
            <h2 class="eyebrow mb-4">Next steps</h2>
            <div class="space-y-4">
              {steps.map((step, i) => (
                <form
                  method="post"
                  action={`/api/admin/orders/${order.ref}/status`}
                  data-confirm={step.action === 'cancelled' ? 'cancel' : undefined}
                  class:list={[
                    // One rule, before the first of the quieter actions - not
                    // one above each of them, which drew two lines in a row.
                    step.secondary || step.danger
                      ? !steps[i - 1]?.secondary && !steps[i - 1]?.danger
                        ? 'pt-4 border-t border-[var(--color-rule)]'
                        : ''
                      : '',
                  ]}
                >
                  <input type="hidden" name="status" value={step.action} />

                  {/* Captured at the moment of posting, which is the only time
                      the owner is holding the receipt. Grouped and labelled,
                      because three bare boxes above a row of buttons read as
                      belonging to all of them. */}
                  {step.needsPostage && (
                    <div class="mb-4 p-3.5 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px]">
                      <p class="text-[13px] font-medium mb-2.5">Posting details</p>
                      <div class="grid gap-3 sm:grid-cols-2">
                        <div>
                          <label for="tracking" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                            Tracking number (optional)
                          </label>
                          <input id="tracking" name="tracking" maxlength="80"
                            placeholder="e.g. AB123456789GB" class="field !py-2 !text-[14px] w-full" />
                        </div>
                        <div>
                          <label for="postage_provider" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                            Carrier
                          </label>
                          {/* A placeholder, so a carrier is a choice. Without
                              one, Royal Mail was submitted on every posting
                              whether or not anyone meant it. */}
                          <select id="postage_provider" name="postage_provider"
                            class="field !py-2 !text-[14px] w-full">
                            <option value="">Not recorded</option>
                            {POSTAGE_PROVIDERS.map((p) => (
                              <option value={p}>{p}</option>
                            ))}
                          </select>
                        </div>
                        <div class="sm:col-span-2">
                          <label for="postage_service" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                            Service (optional)
                          </label>
                          <input id="postage_service" name="postage_service" maxlength="60"
                            placeholder="e.g. Tracked 48" class="field !py-2 !text-[14px] w-full sm:!w-64" />
                        </div>
                      </div>
                    </div>
                  )}

                  {/* A cancellation almost always has a reason, and the standing
                      wording cannot know it - "your order has been cancelled"
                      and nothing else invites a reply asking why. Whatever is
                      written here reaches the email, their order page and
                      Telegram, so the three cannot disagree. */}
                  {step.action === 'cancelled' && (
                    <div class="mb-4 p-3.5 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[3px]">
                      <p class="text-[13px] font-medium mb-2.5">What the customer is told when you cancel</p>
                      <label for="cancel_note" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                        Why, in your own words (optional)
                      </label>
                      <textarea
                        id="cancel_note"
                        name="cancel_note"
                        rows="3"
                        maxlength="600"
                        placeholder="e.g. The printer has these out of stock until March - happy to reorder when they return."
                        class="field font-[family-name:var(--font-body)] !text-[14px]"
                      />
                      <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">
                        Goes with the email, their order page, and Telegram if they connected it.
                        Leave it blank and they are only told the order was cancelled.
                      </p>
                    </div>
                  )}

                  <button
                    type="submit"
                    class:list={['btn', step.danger || step.secondary ? 'btn-ghost' : 'btn-primary']}
                  >
                    {step.label}
                  </button>
                  {/* Under the button, not beside it: the sentence to the right
                      of each one is what made this card look crowded. */}
                  {step.hint && (
                    <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
                      {step.hint}
                    </p>
                  )}
                </form>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <aside class="space-y-4">
      {/* Deliberately one order at a time. The bulk clear cannot reach a
          completed order, and should not be able to. */}
      <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
        <h2 class="eyebrow mb-3">{isCollection ? 'Collecting' : 'Send to'}</h2>
        <p class="text-[15px] font-medium">{order.customer_name}</p>
        <p class="mt-2 text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line leading-relaxed">
          {isCollection ? 'Collecting in person.' : order.address}
        </p>

        {/* Only here once the order is past confirming - before that it sits
            in the confirm card, next to the message it changes.

            After confirming it is a correction, not a choice: the message has
            already gone, so this only changes what their order page and the
            reminders say. Somebody who asked for bank details and then turns
            up with cash is an ordinary afternoon in a shop that takes both,
            and the alternative to this box is editing the database. */}
        {
          !canConfirm && (
            <div class="mt-3 pt-3 border-t border-[var(--color-rule)]">
              <label class="flex items-center gap-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  name="cash_payment"
                  value="1"
                  checked={Boolean(order.cash_payment)}
                  class="w-4 h-4 accent-[var(--color-navy)] toggle-cash-payment"
                  data-ref={order.ref}
                />
                <span class="text-[14px] font-medium">They are paying in cash after all</span>
              </label>
              <p class="mt-2 text-[13px] text-[var(--color-ink-faint)]">
                The confirmation has already gone. This only changes what their order page and
                any reminder say - nothing is owed until{' '}
                {isCollection ? 'they collect' : 'you hand them over'}.
              </p>
            </div>
          )
        }

        <div class="mt-4 pt-3 border-t border-[var(--color-rule)] space-y-1.5 text-[14px]">
          <p><a href={`mailto:${order.email}`} class="text-[var(--color-navy)] break-all">{order.email}</a></p>
          {order.phone && <p><a href={`tel:${order.phone}`} class="text-[var(--color-navy)]">{order.phone}</a></p>}
          {order.telegram && <p class="text-[var(--color-ink-soft)]">{order.telegram}</p>}
          {/* What they asked for at checkout. Only their request - the tick
              above is what actually decides it. */}
          {order.payment_preference && (
            <p class="text-[13px] text-[var(--color-ink-faint)]">
              Asked to pay by{' '}
              <span class="text-[var(--color-ink)] font-medium">
                {order.payment_preference === 'cash' ? 'cash in person' : 'bank transfer'}
              </span>
            </p>
          )}
          <p
            class:list={[
              'text-[13px]',
              order.telegram_chat_id ? 'text-[var(--color-instock)]' : 'text-[var(--color-ink-faint)]',
            ]}
          >
            {order.telegram_chat_id ? '✓ Telegram connected' : 'Telegram not connected'}
          </p>
        </div>
      </section>

      {
        order.notes && (
          <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
            <h2 class="eyebrow mb-2">Their note</h2>
            <p class="text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line">{order.notes}</p>
          </section>
        )
      }

      <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5 text-[14px] space-y-2">
        <div class="flex justify-between gap-3">
          <span class="text-[var(--color-ink-faint)]">Status</span>
          <span class="font-medium">{portalLabel(order.status, order.fulfilment, isCash)}</span>
        </div>
        <div class="flex justify-between gap-3">
          <span class="text-[var(--color-ink-faint)]">Requested</span>
          <span>{new Date(order.created_at * 1000).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}</span>
        </div>
        {
          order.status === 'requested' && hoursLeft !== null && (
            <div class="flex justify-between gap-3">
              <span class="text-[var(--color-ink-faint)]">Hold expires</span>
              <span class={hoursLeft <= 6 ? 'text-[var(--color-outstock)] font-medium' : ''}>
                in {hoursLeft}h
              </span>
            </div>
          )
        }
        {order.tracking_number && (
          <div class="flex justify-between gap-3">
            <span class="text-[var(--color-ink-faint)]">
              {order.postage_provider ?? 'Tracking'}
            </span>
            <span class="tabular-nums select-all text-right">
              {order.tracking_number}
              {order.postage_service && (
                <span class="block text-[13px] text-[var(--color-ink-faint)]">
                  {order.postage_service}
                </span>
              )}
            </span>
          </div>
        )}

        {/* The fields that captured this vanish with the "mark as posted"
            action, so a wrong digit used to be permanent. Correcting it does
            not email the customer again - it was not a new event. */}
        {!isCollection && order.status === 'dispatched' && (
          <details class="pt-2 border-t border-[var(--color-rule)]">
            <summary class="text-[13.5px] text-[var(--color-navy)] cursor-pointer">
              {order.tracking_number ? 'Correct the tracking' : 'Add a tracking number'}
            </summary>
            <form method="post" action={`/api/admin/orders/${order.ref}/tracking`} class="mt-3 space-y-2">
              <input name="tracking" maxlength="80" value={order.tracking_number ?? ''}
                placeholder="Tracking number" class="field !py-1.5 !text-[13.5px] w-full" />
              <select name="postage_provider" class="field !py-1.5 !text-[13.5px] w-full">
                <option value="">Not recorded</option>
                {POSTAGE_PROVIDERS.map((p) => (
                  <option value={p} selected={p === order.postage_provider}>{p}</option>
                ))}
              </select>
              <input name="postage_service" maxlength="60" value={order.postage_service ?? ''}
                placeholder="Service (optional)" class="field !py-1.5 !text-[13.5px] w-full" />
              <button type="submit" class="btn btn-ghost !py-1.5 !text-[13.5px] w-full">Save</button>
              <p class="text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                Updates their order page. No email is sent.
              </p>
            </form>
          </details>
        )}
        <a
          href={`/order?ref=${order.ref}&t=${order.access_token}`}
          class="block pt-2 text-[var(--color-navy)] hover:underline underline-offset-2"
        >
          See what the customer sees →
        </a>
      </section>

      <section class="border border-[var(--color-outstock)]/30 rounded-[3px] p-5">
        <h2 class="eyebrow !text-[var(--color-outstock)] mb-2">Delete</h2>
        <p class="text-[13px] text-[var(--color-ink-soft)] leading-relaxed">
          Removes this order for good. Stock movements stay in the record.
          {['requested', 'awaiting_payment'].includes(order.status)
            ? ' Any copies it is holding are released.'
            : ' Stock is not restored, since these copies already left the shop.'}
        </p>
        <form
          method="post"
          action={`/api/admin/orders/${order.ref}/delete`}
          id="deleteOrderForm"
          data-ref={order.ref}
          class="mt-3"
        >
          <button
            type="submit"
            class="btn btn-ghost w-full !py-2 !text-[13.5px] !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40 hover:!border-[var(--color-outstock)] hover:!bg-[var(--color-outstock)]/5"
          >
            Delete this order
          </button>
        </form>
      </section>
    </aside>
  </div>

  <script is:inline nonce={Astro.locals.cspNonce} define:vars={{ subtotal: order.subtotal_pence, orderRef: order.ref, amendDiscount: order.discount_pence ?? 0, amendEmpty: AMEND_REFUSAL.empty, amendNone: AMEND_REFUSAL.none }}>
    document.querySelector('#deleteOrderForm')?.addEventListener('submit', (event) => {
      if (!confirm(`Delete order ${orderRef} for good?\n\nThis cannot be undone.`)) {
        event.preventDefault();
      }
    });

    /*
     * Cancelling emails the customer and changes what their order page says, and
     * it had no confirmation at all - while deleting, which only affects the
     * shop's own records, did. The guard was on the wrong one.
     */
    for (const form of document.querySelectorAll('[data-confirm="cancel"]')) {
      form.addEventListener('submit', (event) => {
        if (!confirm(`Cancel order ${orderRef}?\n\nThe customer is told, and the books go back on the shelf.`)) {
          event.preventDefault();
        }
      });
    }

    const postage = document.querySelector('#postage');
    const total = document.querySelector('#total');
    // Stepping a pound at a time is PoundInput's own doing, and it fires
    // `input` when it steps, so the total is painted from that one event
    // whether the figure was typed or clicked.
    function paintTotal() {
      const pence = Math.round((Number(postage.value) || 0) * 100);
      total.textContent = `£${((subtotal + pence) / 100).toFixed(2)}`;
    }
    postage?.addEventListener('input', paintTotal);
    if (postage) paintTotal();

    // Cash on collection saves on the tick rather than behind a Save button,
    // so a failed save must put the box back: a checkbox showing a state the
    // order does not have is worse than no checkbox, because the customer's
    // page would be saying the opposite.
    //
    // Plain JS on purpose - this block carries define:vars, so Astro ships it
    // to the browser exactly as written. A TypeScript generic here parses as a
    // pair of comparisons, and the listener silently never binds.
    const message = document.querySelector('#payment_message');
    const payments = message ? JSON.parse(message.dataset.payments ?? '[]') : [];
    const places = message ? JSON.parse(message.dataset.places ?? '[]') : [];

    // What is currently chosen in each picker. Read from the markup rather than
    // assumed, so the server decides the opening state and this only tracks it.
    const chosenOf = (kind) => {
      const pressed = document.querySelector(`[data-part-kind="${kind}"][aria-pressed="true"]`);
      return pressed ? pressed.dataset.partPick : null;
    };

    const bodyOf = (kind, slot) => {
      const list = kind === 'place' ? places : payments;
      return list.find((d) => d.slot === slot)?.body ?? '';
    };

    /*
     * Rebuild the box from whichever parts are chosen: where first, then how to
     * pay - the order the customer needs them in.
     *
     * Switching is deliberately silent. It used to ask before replacing edited
     * text, which is the safe thing for a checkbox but wrong for a button whose
     * entire purpose is to load a wording: the owner asked for it to be
     * seamless, and the cost is that a bespoke message can be lost to a stray
     * click.
     */
    const rebuild = () => {
      if (!message) return;
      const parts = [bodyOf('place', chosenOf('place')), bodyOf('payment', chosenOf('payment'))];
      message.value = parts.map((p) => p.trim()).filter(Boolean).join('\n\n');
    };

    for (const button of document.querySelectorAll('[data-part-pick]')) {
      button.addEventListener('click', () => {
        const kind = button.dataset.partKind;
        for (const sibling of document.querySelectorAll(`[data-part-kind="${kind}"]`)) {
          sibling.setAttribute('aria-pressed', String(sibling === button));
        }
        rebuild();
      });
    }

    /** Move the payment picker onto, or off, the cash wording. */
    const selectPayment = (slot) => {
      for (const button of document.querySelectorAll('[data-part-kind="payment"]')) {
        button.setAttribute('aria-pressed', String(button.dataset.partPick === slot));
      }
      rebuild();
    };

    const cashMissing = document.querySelector('[data-cash-missing]');

    /**
     * Arm one side of the payment picker and kill the other.
     *
     * The tick and the wording are now the same decision rather than two that
     * have to be kept in agreement: a greyed-out button cannot be clicked, so
     * bank details cannot be sent to someone paying in person by leaving a
     * draft selected and forgetting about it.
     */
    const applyCashMode = (wanted) => {
      for (const button of document.querySelectorAll('[data-part-kind="payment"]')) {
        const isCashSlot = button.dataset.cashSlot === 'true';
        button.disabled = isCashSlot ? !wanted : wanted;
      }
      // Only rendered when there is no cash draft at all.
      if (cashMissing) cashMissing.hidden = !wanted;
    };

    /*
     * All of them, not the first. Two of these exist - one in the confirm card,
     * one in the aside - kept apart only by a `canConfirm` condition. A
     * singular querySelector meant that if those conditions ever overlapped,
     * the second checkbox would silently do nothing.
     */
    /*
     * What the order will come to, worked out while the owner is still typing.
     *
     * The same arithmetic the endpoint runs, in the same order - the discount
     * scaled by what is left, floored, then taken off - so the figure on screen
     * is the figure that gets written. A preview that disagreed with the result
     * would be worse than none, because this is the number the owner decides
     * from.
     */
    const amendForm = document.querySelector('#amendForm');
    if (amendForm) {
      const boxes = [...amendForm.querySelectorAll('[data-amend-qty]')];
      const amendPostage = amendForm.querySelector('#amendPostage');
      const outSubtotal = document.querySelector('#amendSubtotal');
      const outTotal = document.querySelector('#amendTotal');
      const money = (pence) => `£${(pence / 100).toFixed(2)}`;
      const kept = (box) =>
        Math.min(Number(box.dataset.was), Math.max(0, Math.trunc(Number(box.value) || 0)));
      const grossBefore = boxes.reduce(
        (n, box) => n + Number(box.dataset.price) * Number(box.dataset.was),
        0,
      );

      const paintAmend = () => {
        const grossAfter = boxes.reduce((n, box) => n + Number(box.dataset.price) * kept(box), 0);
        const discount =
          grossBefore > 0
            ? Math.min(grossAfter, Math.floor((amendDiscount * grossAfter) / grossBefore))
            : 0;
        const subtotalAfter = grossAfter - discount;
        outSubtotal.textContent = money(subtotalAfter);
        if (outTotal) {
          outTotal.textContent = money(
            subtotalAfter + Math.round((Number(amendPostage?.value) || 0) * 100),
          );
        }
      };

      for (const box of boxes) box.addEventListener('input', paintAmend);
      amendPostage?.addEventListener('input', paintAmend);

      for (const button of amendForm.querySelectorAll('[data-amend-none]')) {
        button.addEventListener('click', () => {
          const box = document.getElementById(button.dataset.amendNone);
          if (!box) return;
          box.value = '0';
          paintAmend();
        });
      }

      /*
       * Named, not counted. "Remove 2 books?" is not a question anybody can
       * answer - the titles are the whole point, and this message goes out to a
       * customer under the shop's name.
       */
      amendForm.addEventListener('submit', (event) => {
        const going = boxes
          .filter((box) => kept(box) < Number(box.dataset.was))
          .map((box) => {
            const n = Number(box.dataset.was) - kept(box);
            return n > 1 ? `${box.dataset.title} × ${n}` : box.dataset.title;
          });
        if (!going.length) {
          event.preventDefault();
          alert(amendNone);
          return;
        }
        if (boxes.every((box) => kept(box) === 0)) {
          event.preventDefault();
          alert(amendEmpty);
          return;
        }
        if (!confirm(`Take these off ${orderRef}?\n\n${going.join('\n')}\n\nThe copies go back on the shelf and the customer is told.`)) {
          event.preventDefault();
        }
      });

      paintAmend();
    }

    for (const cashCheckbox of document.querySelectorAll('.toggle-cash-payment')) {
      cashCheckbox.addEventListener('change', async () => {
        const wanted = cashCheckbox.checked;
        const body = new FormData();
        body.append('cash_payment', wanted ? '1' : '0');
        cashCheckbox.disabled = true;
        try {
          const res = await fetch(`/api/admin/orders/${cashCheckbox.dataset.ref}/cash-payment`, {
            method: 'POST',
            body,
          });
          if (!res.ok) throw new Error(`save failed: ${res.status}`);
          applyCashMode(wanted);

          // Ticking cash swings the payment picker onto the cash wording, and
          // unticking puts it back on the first account - so the box never
          // contradicts the tick beside it.
          const cashOption = payments.find((p) => p.slot === 'cash');
          const firstAccount = payments.find((p) => p.slot !== 'cash');
          const next = wanted ? cashOption : firstAccount;
          if (next) selectPayment(next.slot);
        } catch (err) {
          console.error('cash payment save failed', err);
          cashCheckbox.checked = !wanted;
          alert('That did not save. Please try again.');
        } finally {
          cashCheckbox.disabled = false;
        }
      });
    }
  </script>
  {/*
    * The order, kept up to date without a reload.
    *
    * The same file the customer's page uses, driving the portal's routes
    * instead of theirs. It was the customer who had the live thread and the
    * shop that had to reload, which is exactly the wrong way round: the shop
    * is the side being waited on. Telegram and email still carry the ping;
    * this is for when the owner is already looking at the conversation.
    */}
  <script>
    import '../../../scripts/thread.ts';
  </script>
</Admin>
