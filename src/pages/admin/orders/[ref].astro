---
import Admin from '../../../layouts/Admin.astro';
import { getOrderByRef, getOrderItems, lastPostagePence } from '../../../lib/admin-db';
import { price } from '../../../lib/format';
import { siblingOrders } from '../../../lib/orders';
import {
  paymentOptions,
  collectionPlaces,
  defaultMessage,
  composeMessage,
  CASH_SLOT,
} from '../../../lib/settings';
import {
  moneyReceived,
  nextActions,
  portalLabel,
  POSTAGE_PROVIDERS,
  THREAD,
  replyChannelNote,
} from '../../../lib/order-status';
import { orderFlags } from '../../../lib/order-flags';
import Thread from '../../../components/Thread.astro';
import OrderFlag from '../../../components/OrderFlag.astro';
import PoundInput from '../../../components/PoundInput.astro';
import { markRead, thread, threadOpen } from '../../../lib/messages';
import {
  canAmend,
  amendments,
  lineSummary,
  AMEND_REFUSAL,
  ADD_REFUSAL,
  NOTE_MAX,
  shipmentTakingClaims,
} from '../../../lib/amend';

const { ref } = Astro.params;
const order = ref ? await getOrderByRef(ref) : null;
if (!order) return Astro.rewrite('/404');

/*
 * The other orders this customer's one checkout produced.
 *
 * Shown here mainly because of postage: a basket holding shelf books and
 * reserved books becomes two orders, and quoting a delivery charge on each
 * bills one person twice for one basket. The owner cannot avoid that without
 * being told the orders are related, and nothing on this page said so.
 */
const siblings = order.split_group
  ? await siblingOrders(order.split_group, order.id)
  : [];

/* The conversation, and the fact the owner has now seen it. Opening the order
   is the read event on this side too. */
const messages = await thread(order.id);
/* Counted off the thread that was just read, not asked for again. */
const imagesHeld = messages.filter((m) => m.image_key).length;
/* Acknowledged through the newest message on the page, so anything that
   arrives while it renders stays counted. */
if ((order.unread_for_owner ?? 0) > 0) {
  await markRead(order.id, 'owner', messages.reduce((n, m) => Math.max(n, m.id), 0));
}

const threadError = ({
  long: THREAD.tooLong,
  closed: THREAD.closed,
  empty: THREAD.failed,
} as Record<string, string>)[Astro.url.searchParams.get('e') ?? ''] ?? null;

const extended = Astro.url.searchParams.get('extended');

/*
 * A reservation whose week is running.
 *
 * It changes what the next step is: the question stops being "has this been
 * paid" and becomes "is this customer still coming", and there is a date after
 * which the copies leave.
 */
const replyBy = order.pay_by ? new Date(order.pay_by * 1000) : null;
const waitingOnReply = Boolean(
  replyBy && ['requested', 'awaiting_payment'].includes(order.status),
);
const daysLeft = replyBy
  ? Math.ceil((replyBy.getTime() - Date.now()) / 86_400_000)
  : 0;

const isCollection = order.fulfilment === 'collection';
// Cash applies to either journey now - on a posted order it means one handed
// over in person - so this no longer depends on how the books are going.
const isCash = Boolean(order.cash_payment);

// Every part is fetched, not just the ones in force: picking another, or
// ticking "paying in cash", rebuilds the box without a page load, so the other
// wordings have to be here to build from.
const [items, postageDefault, payments, places, opening, changes] = await Promise.all([
  getOrderItems(order.id),
  lastPostagePence(),
  paymentOptions(),
  isCollection ? collectionPlaces() : Promise.resolve([]),
  defaultMessage(order.fulfilment, isCash),
  // Only for an order that has actually been amended, which is nearly none of
  // them - `amended_at` is on the order precisely so this table is not read on
  // every view of every order.
  order.amended_at ? amendments(order.id) : Promise.resolve([]),
]);

// Which of each starts marked. A cash order starts on the cash wording, so bank
// details are never the opening text on an order that is not paying by bank.
const openText = (order.payment_message ?? opening).trim();
const openPayment = isCash
  ? payments.find((p) => p.slot === CASH_SLOT)
  : payments.find((p) => p.slot !== CASH_SLOT);
const activePayment = openPayment?.slot ?? null;
const activePlace = places[0]?.slot ?? null;
const suggestedPostage = order.postage_pence ?? (isCollection ? 0 : postageDefault);

/*
 * Each stage that has already happened, with what was captured at the time.
 * Built from the timestamps the order already carries, so nothing new is
 * recorded to make this work.
 */
const history: { at: number; what: string; detail?: string; body?: string }[] = [];

history.push({
  at: order.created_at,
  what: 'Request placed',
  detail: `${order.item_count} ${order.item_count === 1 ? 'book' : 'books'} · ${price(order.subtotal_pence)}`,
});

if (order.confirmed_at) {
  history.push({
    at: order.confirmed_at,
    what: isCash ? 'Confirmed, paying in cash' : 'Confirmed and payment details sent',
    detail:
      order.total_pence !== null
        ? `Total ${price(order.total_pence)}${
            !isCollection && order.postage_pence ? ` · postage ${price(order.postage_pence)}` : ''
          }`
        : undefined,
    // The message exactly as it went out, which is the thing most worth being
    // able to look back at.
    body: order.payment_message ?? undefined,
  });
}

if (order.paid_at) {
  history.push({
    at: order.paid_at,
    what: isCash ? 'Set aside for collection' : 'Payment received',
  });
}

if (order.dispatched_at) {
  history.push({
    at: order.dispatched_at,
    what: 'Posted',
    detail: [order.postage_provider, order.postage_service, order.tracking_number]
      .filter(Boolean)
      .join(' · ') || undefined,
  });
}

if (order.completed_at) {
  history.push({ at: order.completed_at, what: isCollection ? 'Collected' : 'Closed' });
}

/*
 * Every amendment, in the timeline with everything else that was sent.
 *
 * The lines it names are gone from the order, so this is the only place the
 * shop can still answer "what did this order say before?" - which is the
 * question that arrives when a customer compares two messages from us.
 */
for (const change of changes) {
  /* The figures read the same way whichever direction the books went. */
  const moved =
    change.totalBefore !== null && change.totalAfter !== null
      ? `total ${price(change.totalBefore)} → ${price(change.totalAfter)}`
      : `subtotal ${price(change.subtotalBefore)} → ${price(change.subtotalAfter)}`;

  /* A row carries one side or the other. Both are read anyway, so a row that
     somehow carried both still shows both rather than half of itself. */
  for (const side of [
    { lines: change.removed, verb: 'taken off' },
    { lines: change.added, verb: 'added' },
  ]) {
    if (!side.lines.length) continue;
    history.push({
      at: change.at,
      what: `${side.lines.length === 1 ? 'A book' : `${side.lines.length} books`} ${side.verb}`,
      detail: `${lineSummary(side.lines)} · ${moved}`,
      body: change.note ?? undefined,
    });
  }
}

if (order.status === 'cancelled') {
  history.push({
    at: order.updated_at,
    what: 'Cancelled',
    body: order.cancel_note ?? undefined,
  });
}

history.sort((a, b) => a.at - b.at);
const waitingForBooks = items.some((item) => Boolean(item.from_incoming));
const canConfirm = order.status === 'requested' && !waitingForBooks;
/*
 * Whether books may still come off this order.
 *
 * A single line cannot be amended down to nothing - that is a cancellation,
 * and it already has a button that releases the copies and tells the customer -
 * so an order with one book on it is offered nothing here.
 */
const amendable = canAmend(order.status);
const amendedCount = Number(Astro.url.searchParams.get('amended') ?? 0);
const addedCount = Number(Astro.url.searchParams.get('added') ?? 0);
/*
 * Whether books may still go on, which is very nearly the same question.
 *
 * Nearly, because a reservation can only take more of its own shipment, and a
 * shipment that has landed is closed to new claims - the same rule that shuts
 * reservations off at arrival, read here rather than kept in step with a second
 * flag. One small read, and only ever on a reservation.
 */
const openShipment = order.shipment_id ? await shipmentTakingClaims(order.shipment_id) : true;
const addable = amendable && openShipment;
const told = Astro.url.searchParams.get('told') ?? '';
/** Whether a total has been quoted yet, which is what postage hangs off. */
const quoted = order.total_pence !== null;
const totalCopies = items.reduce((n, item) => n + item.qty, 0);
const hoursLeft = order.expires_at
  ? Math.max(0, Math.round((order.expires_at * 1000 - Date.now()) / 3_600_000))
  : null;
/*
 * A hold that ran out. The order is still `requested` and still holds its
 * copies - the sweep flags it and leaves it alone - so this is the one thing on
 * the page that has to be impossible to miss.
 */
const lapsed = order.status === 'requested' && order.lapsed_at !== null;
const lapsedDays = order.lapsed_at
  ? Math.floor((Date.now() - order.lapsed_at * 1000) / 86_400_000)
  : 0;
const lapsedWhen = order.lapsed_at
  ? new Date(order.lapsed_at * 1000).toLocaleString('en-GB', {
      dateStyle: 'medium',
      timeStyle: 'short',
    })
  : '';

const sentVia = Astro.url.searchParams.get('sent');
const saved = Astro.url.searchParams.get('saved');
const problem = Astro.url.searchParams.get('e');

// What can happen next, and what it is called, both come from lib/order-status
// so a collection order is never offered "Mark as posted".
const steps = nextActions(order.status, order.fulfilment, isCash)
  .filter((step) => !waitingForBooks || step.action === 'cancelled');

// ---------------------------------------------------------------------------
// The action bar
// ---------------------------------------------------------------------------

/** Nothing further will happen to a closed order. */
const openOrder = !['cancelled', 'expired', 'completed'].includes(order.status);
/** A customer waiting to hear whether their cancellation is accepted. */
const answeringCancel = Boolean(order.cancel_requested_at) && openOrder;

/*
 * The bar holds at most two buttons, and never a destructive one.
 *
 * Promoted straight from `nextActions`, in its order: the primary action, then
 * the quieter one. Cancelling is deliberately not eligible - it lives behind
 * the ⋯ with the note it needs, where a mis-click cannot reach it.
 *
 * Confirming is not here either, and not because it is dangerous: it needs a
 * message written before it can be pressed, so it lives in its own panel and
 * the bar shows no copy of it. What the bar carries is the set of steps that
 * are a single press.
 */
const promoted = steps.filter((step) => !step.danger).slice(0, 2);
/*
 * A cancellation being asked for takes the bar outright.
 *
 * The pressing question on that order is not "post it" but "are they having
 * it", and offering "Payment received and posted" as the primary press to
 * somebody who has just asked to cancel is the page arguing with itself. The
 * strip states the question, this answers it, and the ordinary status moves
 * wait in the ⋯ until it has been answered. Agreeing is the cancel, also in
 * the ⋯, where the note it sends lives.
 */
const barActions = answeringCancel ? [] : promoted;
/** Everything else, which is what the ⋯ is for. */
const menuSteps = steps.filter((step) => !step.danger && !barActions.includes(step));
const cancelStep = steps.find((step) => step.action === 'cancelled') ?? null;
/** The one promoted action that wants a tracking number captured with it. */
const postageStep = barActions.find((step) => step.needsPostage) ?? null;
/* Correcting a number afterwards, which is not a new event in the order's
   life and never emails anybody. Delivery only: a collection has nothing to
   track, and the word must not appear on one. */
const correctable = !isCollection && ['dispatched', 'completed'].includes(order.status);

const shortWhen = (at: number) =>
  new Date(at * 1000).toLocaleString('en-GB', {
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });

/*
 * The one line under the name, and it is a clock rather than a description.
 *
 * What the order holds is said by the packing list, which is directly below
 * and counts itself. What is not said anywhere else is where this order has
 * got to in time - how long the hold has left, when the details went, when
 * the money arrived - which is the thing that decides whether it is late.
 */
const summary = lapsed
  ? `Hold ran out ${lapsedWhen}`
  : answeringCancel
    ? 'They asked to cancel'
    : order.completed_at
      ? `Closed ${shortWhen(order.completed_at)}`
      : order.dispatched_at
        ? `Posted ${shortWhen(order.dispatched_at)}`
        : order.paid_at
          ? `Paid ${shortWhen(order.paid_at)}`
          : order.confirmed_at
            ? `Details sent ${shortWhen(order.confirmed_at)}`
            : hoursLeft !== null
              ? `Hold expires in ${hoursLeft}h`
              : `Requested ${shortWhen(order.created_at)}`;

/*
 * The status chip, tinted by where the order stands.
 *
 * One navy pill for every state made the chip decorative - it told the owner
 * the same thing on an order that had lapsed and one that was delivered. The
 * tints are the shop's own: brass for waiting on somebody, red for something
 * that has gone wrong, green for money in, and quiet grey once it is closed.
 */
const CHIP = {
  wait: 'bg-[var(--color-brass)]/10 text-[var(--color-brass)]',
  bad: 'bg-[var(--color-outstock)]/10 text-[var(--color-outstock)]',
  good: 'bg-[var(--color-instock)]/10 text-[var(--color-instock)]',
  done: 'bg-[var(--color-rule-soft)] text-[var(--color-ink-soft)]',
} as const;
const chipTone = lapsed || ['cancelled', 'expired'].includes(order.status)
  ? CHIP.bad
  : order.status === 'completed'
    ? CHIP.done
    : ['paid', 'dispatched'].includes(order.status)
      ? CHIP.good
      : CHIP.wait;

/*
 * What the figure beside it is. Quoted and paid are not the same claim, and
 * on a cash order the money is not in until the books have changed hands -
 * `moneyReceived` is what already knows that, so it decides the word.
 */
const moneyLabel = !quoted
  ? 'Subtotal'
  : moneyReceived(order.status, isCash)
    ? 'Total paid'
    : 'Total quoted';

/*
 * Whether the customer has read what we last said.
 *
 * Measured against our own newest message rather than the newest message of
 * either side. Who spoke last is not the question: a customer can write from
 * Telegram without ever opening the order, which would leave something of ours
 * unread underneath their reply - and "they are up to date" would be the shop
 * telling its owner not to chase a message nobody has seen.
 *
 * Read from their cursor on this order - the one their page moves when they
 * open it - and never from Telegram or email, both of which are "delivered"
 * the instant they go. We have said nothing, there is nothing to report.
 */
const lastOurs = messages.filter((m) => m.sender === 'owner').at(-1) ?? null;
const conversationNote = !lastOurs
  ? null
  : lastOurs.id > (order.read_cursor_customer ?? 0)
    ? 'Last message unread'
    : 'They are up to date';

/*
 * One strip, and panels for the rest.
 *
 * The page used to stack a card per condition. The first of these goes in the
 * row between the bar and the panes; anything else still live becomes a plain
 * panel in the left pane, which is the difference between a page with a banner
 * and a page that is all banner.
 */
const flags = orderFlags({
  customerName: order.customer_name,
  lapsed,
  lapsedDays,
  totalCopies,
  cancelRequestedAt: answeringCancel ? order.cancel_requested_at : null,
  customerCancelNote: order.customer_cancel_note,
  siblingCount: siblings.length,
  saved,
  sentVia,
  problem,
  amendedCount,
  addedCount,
  againstDelivery: order.shipment_id !== null,
  told,
  extended,
});
const [strip, ...demotedFlags] = flags;
---

<Admin title={order.customer_name} sub={order.ref} showHeading={false}>
  {/*
    * The status the poll compares against.
    *
    * A status move rewrites too much of this page to patch in - the totals,
    * the payment panel, what the next action is - so the script reloads
    * instead, and this is what it notices the move against.
    */}
  <div data-order-status={order.status} data-order-ref={order.ref}></div>

  {/*
    * The action bar.
    *
    * Full width, stuck to the top, and the only place on the page a next step
    * appears - so it never moves and never has to be scrolled to. The order
    * itself is below it; the conversation is beside it. What this carries is
    * who, which order, where it has got to, what it comes to, and the one or
    * two presses that move it on.
    */}
  <div
    class="sticky top-0 z-30 -mx-5 md:-mx-8 -mt-8 mb-5 px-5 md:px-8 py-3 bg-[var(--color-paper-raised)]/95 backdrop-blur border-b border-[var(--color-rule-soft)]"
  >
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
          <a
            href="/admin/orders"
            class="text-[13.5px] text-[var(--color-navy)] hover:underline underline-offset-2 shrink-0"
          >← All orders</a>
          <h1 class="font-[family-name:var(--font-display)] text-[20px] font-semibold truncate">
            {order.customer_name}
          </h1>
          <span class="shrink-0 px-2 py-0.5 rounded-full bg-white border border-[var(--color-rule-soft)] text-[12.5px] tabular-nums select-all">
            {order.ref}
          </span>
          {/* The customer's own word for where this has got to, so the portal
              and their page cannot disagree about it. */}
          <span
            class:list={[
              'shrink-0 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[12.5px] font-medium',
              chipTone,
            ]}
          >
            <span class="w-[6px] h-[6px] rounded-full bg-current" aria-hidden="true"></span>
            {portalLabel(order.status, order.fulfilment, isCash)}
          </span>
        </div>
        <p class="mt-0.5 text-[13px] text-[var(--color-ink-faint)]">{summary}</p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <p class="text-right leading-tight">
          <span class="block text-[11.5px] uppercase tracking-[0.08em] text-[var(--color-ink-faint)]">
            {moneyLabel}
          </span>
          <span class="price text-[19px]">{price(order.total_pence ?? order.subtotal_pence)}</span>
        </p>

        {/* Promoted from nextActions, unchanged in wording. The posting
            details, when there are any, are a panel below that posts with
            this button rather than fields wrapped around it. */}
        {barActions.map((step) => (
          <form
            method="post"
            action={`/api/admin/orders/${order.ref}/status`}
            id={`step-${step.action}`}
          >
            <input type="hidden" name="status" value={step.action} />
            <button
              type="submit"
              class:list={['btn !py-2 !text-[14px]', step.secondary ? 'btn-ghost' : 'btn-primary']}
              title={step.hint}
            >
              {step.label}
            </button>
          </form>
        ))}

        {answeringCancel && (
          <form method="post" action={`/api/admin/orders/${order.ref}/cancel-request`}>
            <button type="submit" class="btn btn-primary !py-2 !text-[14px]">Keep the order</button>
          </form>
        )}

        {/*
          * Everything the bar will not hold.
          *
          * Built per state, and each thing in it has exactly one home: the
          * tracking correction jumps to the panel that owns it, cancelling
          * carries the note it sends, and neither appears anywhere else on
          * the page. "Another 48 hours" is not here at all - it belongs to
          * the lapse strip.
          */}
        <details class="relative shrink-0" data-menu>
          <summary
            class="grid place-items-center w-9 h-9 rounded-full border border-[var(--color-rule)] text-[var(--color-ink-soft)] cursor-pointer hover:border-[var(--color-navy)] hover:text-[var(--color-navy)]"
          >
            <span class="sr-only">More actions</span>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <circle cx="5" cy="12" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="19" cy="12" r="1.7" />
            </svg>
          </summary>

          <div
            class="absolute right-0 top-[calc(100%+8px)] z-40 w-[20.5rem] max-w-[85vw] p-1.5 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] shadow-[0_12px_30px_-12px_rgba(14,42,85,0.35)]"
          >
            {/* Demoted status moves - single presses the bar had no room for.
                Each keeps the sentence lib/order-status gives it: out of the
                bar, the label alone no longer says what pressing it does. */}
            {menuSteps.map((step) => (
              <form method="post" action={`/api/admin/orders/${order.ref}/status`}>
                <input type="hidden" name="status" value={step.action} />
                <button type="submit" class="menu-item block">
                  {step.label}
                  {step.hint && <span class="menu-hint">{step.hint}</span>}
                </button>
              </form>
            ))}

            {correctable && (
              <a href="#posting" class="menu-item block">
                {order.tracking_number ? 'Correct the tracking' : 'Add a tracking number'}
                <span class="menu-hint">Updates their order page. No email is sent.</span>
              </a>
            )}

            {/*
              * After confirming, this is a correction rather than a choice:
              * the message has already gone, so it only changes what their
              * order page and the reminders say. Somebody who asked for bank
              * details and then turns up with cash is an ordinary afternoon.
              */}
            {!canConfirm && openOrder && (
              <label class="menu-item flex items-start gap-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  name="cash_payment"
                  value="1"
                  checked={Boolean(order.cash_payment)}
                  class="w-4 h-4 mt-0.5 accent-[var(--color-navy)] toggle-cash-payment"
                  data-ref={order.ref}
                />
                <span>
                  <span class="block">They are paying in cash after all</span>
                  <span class="menu-hint">
                    Changes their order page only - nothing is owed until
                    {isCollection ? ' they collect' : ' you hand them over'}.
                  </span>
                </span>
              </label>
            )}

            <a
              href={`/order?ref=${order.ref}&t=${order.access_token}`}
              class="menu-item block"
            >
              See what the customer sees
              <span class="menu-hint">Opens their order page, as they have it.</span>
            </a>

            {cancelStep && (
              /*
                * Cancelling, with the words that go out with it.
                *
                * The standing wording cannot know why - "your order has been
                * cancelled" and nothing else invites a reply asking - so the
                * note comes with the action rather than being a panel
                * somewhere else that this would have to be kept in step with.
                */
              <details class="mt-1 pt-1 border-t border-[var(--color-rule-faint)]">
                <summary class="menu-item block !text-[var(--color-outstock)] cursor-pointer">
                  {cancelStep.label}
                </summary>
                <form
                  method="post"
                  action={`/api/admin/orders/${order.ref}/status`}
                  data-confirm="cancel"
                  class="px-3 pb-2"
                >
                  <input type="hidden" name="status" value="cancelled" />
                  <label for="cancel_note" class="block mt-1 text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                    Why, in your own words (optional)
                  </label>
                  <textarea
                    id="cancel_note"
                    name="cancel_note"
                    rows="2"
                    maxlength="600"
                    placeholder="e.g. Out of stock until March."
                    class="field font-[family-name:var(--font-body)] !text-[13.5px]"
                  />
                  <p class="mt-1 text-[12px] text-[var(--color-ink-faint)] leading-relaxed">
                    {cancelStep.hint} Goes with the email, their order page and Telegram.
                  </p>
                  <button
                    type="submit"
                    class="btn btn-ghost w-full mt-2 !py-1.5 !text-[13.5px] !text-[var(--color-outstock)] !border-[var(--color-outstock)]/40 hover:!border-[var(--color-outstock)]"
                  >
                    {cancelStep.label}
                  </button>
                </form>
              </details>
            )}

            <form
              method="post"
              action={`/api/admin/orders/${order.ref}/delete`}
              id="deleteOrderForm"
              data-ref={order.ref}
              class="mt-1 pt-1 border-t border-[var(--color-rule-faint)]"
            >
              <button type="submit" class="menu-item block !text-[var(--color-outstock)]">
                Delete this order
              </button>
              <p class="px-3 pb-1 -mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
                Removes it for good. Stock movements stay in the record.
                {['requested', 'awaiting_payment'].includes(order.status)
                  ? ' Any copies it is holding are released.'
                  : ' Stock is not restored, since these copies already left the shop.'}
              </p>
            </form>
          </div>
        </details>
      </div>
    </div>
  </div>

  {/* One row, never a stack. The rest of what is live is further down. */}
  {strip && (
    <div class="mb-5">
      <OrderFlag flag={strip} strip siblings={siblings} isCollection={isCollection} ref={order.ref} />
    </div>
  )}

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_400px] items-start">
    <div class="space-y-6 min-w-0">
      {/*
        * The order itself, and the one control that changes it.
        *
        * The editor used to be a card of its own below this one, which put a
        * panel between the list and the totals it rewrites. It belongs to
        * this list, so it lives in this card: the lines, then what may come
        * off them, then what the order comes to.
        */}
      <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
          <h2 class="eyebrow">Packing list</h2>
          <p class="text-[13px] text-[var(--color-ink-faint)]">
            {totalCopies} {totalCopies === 1 ? 'copy' : 'copies'} ·{' '}
            {items.length} {items.length === 1 ? 'title' : 'titles'}
          </p>
        </div>
        <ul class="divide-y divide-[var(--color-rule-faint)]">
          {
            items.map((item) => (
              <li class="py-2.5 flex justify-between gap-4 text-[15px]">
                <span class="min-w-0">
                  {item.slug ? (
                    <a
                      href={item.shipment_id
                        ? `/shipments/${item.shipment_id}`
                        : `/book/${item.slug}`}
                      class="hover:text-[var(--color-navy)]"
                    >
                      {item.title_snapshot}
                    </a>
                  ) : (
                    item.title_snapshot
                  )}
                  {item.qty > 1 && (
                    <strong class="ml-2 text-[var(--color-navy)]">× {item.qty}</strong>
                  )}
                  {/* What one costs, and where it is coming from. On a line of
                      two the price shown on the right is the pair, and the
                      owner was left to divide it themselves. */}
                  <span class="block text-[13px] text-[var(--color-ink-faint)]">
                    {price(item.price_pence_snapshot)} each
                    {item.from_incoming ? ' · reserved from a delivery' : ''}
                  </span>
                </span>
                <span class="shrink-0 tabular-nums">
                  {price(item.price_pence_snapshot * item.qty)}
                </span>
              </li>
            ))
          }
        </ul>
      {/*
        * Editing the lines, as one control rather than a panel per direction.
        *
        * Taking books off is something the shop could not do at all: a customer
        * wrote asking for three titles to be removed and the only buttons on
        * this page were cancel the whole order and delete it. The removal
        * happened in the messages instead, so the order went on holding copies
        * of books nobody wanted and quoting a total for them.
        *
        * Directly under the packing list, because that is the list it changes,
        * and folded away, because the ordinary afternoon is packing what was
        * ordered rather than editing it.
        */}
      {amendable && totalCopies > 1 && (
        <details
          class="mt-4 pt-4 border-t border-[var(--color-rule-faint)]"
          open={problem === 'nochange' || problem === 'empty'}
        >
          {/* One tab today. Adding books is the other, and it belongs in this
              strip beside this one rather than in a panel of its own - both
              edit the same list, through the same ledgered path, and both
              tell the customer. */}
          <summary class="w-fit px-3.5 py-1.5 rounded-full border border-[var(--color-rule)] text-[13.5px] font-medium text-[var(--color-navy)] cursor-pointer hover:border-[var(--color-navy)]">
            Take books off
          </summary>

          <p class="mt-3 text-[14px] text-[var(--color-ink-soft)] leading-relaxed max-w-[38rem]">
            Set how many of each to keep. The copies you take off go straight back on the shelf,
            the order's figures follow them, and {order.customer_name.split(' ')[0]} is sent the
            revised list{quoted ? ' and the new total' : ''}.
          </p>

          <form
            method="post"
            action={`/api/admin/orders/${order.ref}/amend`}
            id="amendForm"
            class="mt-4"
          >
            <ul class="divide-y divide-[var(--color-rule-faint)] border-y border-[var(--color-rule-faint)]">
              {items.map((item) => (
                <li class="py-2.5 flex items-center justify-between gap-4 text-[14.5px]">
                  <span class="min-w-0" data-amend-title>
                    {item.title_snapshot}
                    <span class="block text-[13px] text-[var(--color-ink-faint)]">
                      {price(item.price_pence_snapshot)} each
                      {item.from_incoming ? ' · reserved from a delivery' : ''}
                    </span>
                  </span>
                  <span class="shrink-0 flex items-center gap-2">
                    <label class="text-[13px] text-[var(--color-ink-faint)]" for={`qty_${item.id}`}>
                      Keep
                    </label>
                    <input
                      id={`qty_${item.id}`}
                      name={`qty_${item.id}`}
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max={item.qty}
                      value={item.qty}
                      data-amend-qty
                      data-was={item.qty}
                      data-price={item.price_pence_snapshot}
                      data-title={item.title_snapshot}
                      class="field !w-16 !py-1.5 !text-[14px] tabular-nums text-center"
                    />
                    <span class="text-[13px] text-[var(--color-ink-faint)] tabular-nums">
                      of {item.qty}
                    </span>
                    {/* One press for the ordinary case, which is a whole title
                        coming off rather than a quantity being trimmed. */}
                    <button
                      type="button"
                      data-amend-none={`qty_${item.id}`}
                      class="px-2 py-1 text-[13px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-outstock)] hover:text-[var(--color-outstock)]"
                    >
                      Remove
                    </button>
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-3 flex justify-between text-[15px]">
              <span>Order becomes</span>
              <span class="price" id="amendSubtotal">{price(order.subtotal_pence)}</span>
            </div>
            {order.discount_pence > 0 && (
              <p class="mt-1 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
                The {price(order.discount_pence)} discount is kept in proportion to what is left,
                so a customer cannot lose a deal because the shop changed its threshold afterwards.
              </p>
            )}

            {/* Only once a total has been quoted. Before that the confirm step
                still decides postage, and inventing one here would put a figure
                on an order nobody has priced. */}
            {quoted && !isCollection && (
              <div class="mt-4">
                <label for="amendPostage" class="block text-[13px] font-medium mb-1.5">
                  Postage (£)
                </label>
                <div class="flex items-center gap-3">
                  <PoundInput
                    id="amendPostage"
                    name="postage"
                    min="0"
                    value={((order.postage_pence ?? 0) / 100).toFixed(2)}
                    class="!w-24 !py-1.5 !text-[14px]"
                  />
                  <p class="text-[13.5px] text-[var(--color-ink-soft)]">
                    New total{' '}
                    <strong id="amendTotal" class="price text-[16px]">
                      {price(order.total_pence ?? 0)}
                    </strong>
                  </p>
                </div>
                <p class="mt-1 text-[13px] text-[var(--color-ink-faint)]">
                  A smaller parcel often costs less, and they hold a message quoting the old figure.
                </p>
              </div>
            )}

            <div class="mt-4">
              <label for="amend_note" class="block text-[13px] font-medium mb-1.5">
                Why, in your own words (optional)
              </label>
              <textarea
                id="amend_note"
                name="note"
                rows="2"
                maxlength={NOTE_MAX}
                placeholder="e.g. Taken off at your request - the rest is unchanged."
                class="field font-[family-name:var(--font-body)] !text-[14px]"
              />
              <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">
                Goes with the email, their order page and Telegram.
              </p>
            </div>

            <button type="submit" class="btn btn-ghost mt-4">
              Take them off and tell them
            </button>
          </form>
        </details>
      )}

      {/*
        * Putting books on, which used to mean placing a second order.
        *
        * "Could you add the second volume as well" arrives in the middle of a
        * conversation about an order that is not paid for yet, and the shop's
        * answer was another order - another reference, another hold with its
        * own clock, another postage quote for the same parcel. The owner was
        * doing the arithmetic by hand and telling the customer the figure.
        *
        * Folded away and directly under taking books off, because they are one
        * job seen from two directions and the owner should not have to look in
        * two different parts of the page for them.
        */}
      {addable && (
        <details
          class="mt-4 pt-4 border-t border-[var(--color-rule-faint)]"
          open={problem === 'noadd' || problem === 'gone'}
        >
          {/* The sibling tab the strip above was built to take. Both edit one
              list, through the same ledgered path, and both tell the customer -
              so they read as one control rather than two panels. */}
          <summary class="w-fit px-3.5 py-1.5 rounded-full border border-[var(--color-rule)] text-[13.5px] font-medium text-[var(--color-navy)] cursor-pointer hover:border-[var(--color-navy)]">
            Add books
          </summary>
          <p class="mt-3 text-[14px] text-[var(--color-ink-soft)] leading-relaxed max-w-[38rem]">
            Search for a title and choose how many.{' '}
            {order.shipment_id
              ? 'This is a reservation, so it can take more of this delivery - the copies are claimed against it along with the rest.'
              : 'The copies come off the shelf the moment you press the button, at today\'s price.'}{' '}
            {order.customer_name.split(' ')[0]} is sent the revised list
            {quoted ? ' and the new total' : ''}.
          </p>

          <form
            method="post"
            action={`/api/admin/orders/${order.ref}/add`}
            id="addForm"
            class="mt-4"
          >
            {/*
              * An ordinary text box, not a combobox: what it opens is a list of
              * buttons that put a book on the form, and nothing here is typed
              * into. With the script absent it stays an inert box and the panel
              * simply adds nothing - which is why this form has no other way to
              * name a book, and cannot be half-submitted by a page that failed
              * to load.
              */}
            <label for="addSearch" class="block text-[13px] font-medium mb-1.5">
              Find a title
            </label>
            <input
              id="addSearch"
              type="search"
              autocomplete="off"
              placeholder="Title, in English or Arabic"
              class="field !py-2 !text-[14px]"
              data-add-search
            />
            <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]" id="addSearchNote">
              {order.shipment_id
                ? 'Only books on this delivery, and only while copies are unclaimed.'
                : 'Only what is on the shelf now. A title with no copies free is not offered.'}
            </p>

            <ul id="addResults" class="mt-2 empty:hidden divide-y divide-[var(--color-rule-faint)] border border-[var(--color-rule-faint)] rounded-[3px]"></ul>

            <ul
              id="addChosen"
              class="mt-3 empty:hidden divide-y divide-[var(--color-rule-faint)] border-y border-[var(--color-rule-faint)]"
            ></ul>
            <p id="addNothing" class="mt-3 text-[13.5px] text-[var(--color-ink-faint)]">
              Nothing chosen yet.
            </p>

            <div class="mt-3 flex justify-between text-[15px]">
              <span>Order becomes</span>
              <span class="price" id="addSubtotal">{price(order.subtotal_pence)}</span>
            </div>
            {order.discount_pence > 0 && (
              <p class="mt-1 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
                The {price(order.discount_pence)} discount this order was given is kept at the
                same rate, so books added now share it - the same rule that scales it down when
                books come off, so that taking one off and putting it back leaves the order
                exactly where it started.
              </p>
            )}

            {/* Only once a total has been quoted, as when books come off: before
                that the confirm step still decides postage, and inventing one
                here would put a figure on an order nobody has priced. */}
            {quoted && !isCollection && (
              <div class="mt-4">
                <label for="addPostage" class="block text-[13px] font-medium mb-1.5">
                  Postage (£)
                </label>
                <div class="flex items-center gap-3">
                  <PoundInput
                    id="addPostage"
                    name="postage"
                    min="0"
                    value={((order.postage_pence ?? 0) / 100).toFixed(2)}
                    class="!w-24 !py-1.5 !text-[14px]"
                  />
                  <p class="text-[13.5px] text-[var(--color-ink-soft)]">
                    New total{' '}
                    <strong id="addTotal" class="price text-[16px]">
                      {price(order.total_pence ?? 0)}
                    </strong>
                  </p>
                </div>
                <p class="mt-1 text-[13px] text-[var(--color-ink-faint)]">
                  A bigger parcel often costs more to send, and they are holding a message
                  quoting the old figure.
                </p>
              </div>
            )}

            <div class="mt-4">
              <label for="add_note" class="block text-[13px] font-medium mb-1.5">
                Why, in your own words (optional)
              </label>
              <textarea
                id="add_note"
                name="note"
                rows="2"
                maxlength={NOTE_MAX}
                placeholder="e.g. Added as you asked - the second volume was back in this morning."
                class="field font-[family-name:var(--font-body)] !text-[14px]"
              />
              <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">
                Goes with the email, their order page, and Telegram if they connected it.
              </p>
            </div>

            <button type="submit" class="btn btn-ghost mt-4">
              Add them and tell them
            </button>
          </form>
        </details>
      )}

        {/* One book on the order and nothing to trim it to. Said rather than
            left as a missing control, because the owner would go looking. */}
        {amendable && totalCopies === 1 && (
          <p class="mt-4 pt-4 border-t border-[var(--color-rule-faint)] text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
            One book on this order, so there is nothing to take off it -
            removing it is a cancellation, in the ⋯ menu above.
          </p>
        )}

        <div class="mt-3 pt-3 border-t border-[var(--color-rule)] flex justify-between text-[15px]">
          <span>Subtotal</span>
          <span class="price">{price(order.subtotal_pence)}</span>
        </div>
        {
          order.total_pence !== null && (
            <>
              {!isCollection && (
                <div class="mt-1 flex justify-between text-[15px] text-[var(--color-ink-soft)]">
                  <span>Postage</span>
                  <span class="tabular-nums">{price(order.postage_pence ?? 0)}</span>
                </div>
              )}
              <div class="mt-2 pt-2 border-t border-[var(--color-rule)] flex justify-between text-[16px] font-semibold">
                <span>Total quoted</span>
                <span class="price text-[19px]">{price(order.total_pence)}</span>
              </div>
            </>
          )
        }
      </section>

      {
        canConfirm && (
          /*
           * Confirming, which is the one action that cannot be a button in the
           * bar: it sends a message somebody has to write first. So it keeps
           * its panel, directly under the list it prices, and the bar carries
           * no copy of it.
           */
          <section class="bg-white border-2 border-[var(--color-navy)] rounded-[var(--radius-panel)] p-5">
            <h2 class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
              Confirm and send payment details
            </h2>
            <p class="mt-1.5 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">
              {isCollection ? 'We will send' : 'Set the postage and we will send'}{' '}
              {order.customer_name.split(' ')[0]}{' '}
              {isCash ? 'the total and a time to arrange' : 'the total and how to pay'}
              {order.telegram_chat_id
                ? ' - by Telegram and email, since they connected their Telegram.'
                : ' by email. They have not connected Telegram, so email is the only way to reach them.'}
            </p>

            <form method="post" action={`/api/admin/orders/${order.ref}/confirm`} class="mt-4">
              <div class="flex flex-wrap items-end gap-4">
                {/* Nothing is being posted, so there is nothing to charge for
                    it. Showing a postage box on a collection invites the owner
                    to add one by habit. */}
                <div class:list={[isCollection && 'hidden']}>
                  <label for="postage" class="block text-[14px] font-medium mb-1.5">
                    Postage (£)
                  </label>
                  <PoundInput
                    id="postage"
                    name="postage"
                    min="0"
                    value={(suggestedPostage / 100).toFixed(2)}
                    class="!w-24"
                  />
                </div>
                <p class="text-[14.5px] text-[var(--color-ink-soft)] pb-2.5">
                  {isCash ? 'To pay in cash: ' : isCollection ? 'Total to pay is ' : 'Total becomes '}
                  <strong id="total" class="price text-[17px]">
                    {price(order.subtotal_pence + suggestedPostage)}
                  </strong>
                </p>
              </div>

              {/* The tick belongs beside the message it rewrites. Left in the
                  aside it was two feet from the box it changes, and the owner
                  could send bank details to someone paying cash without ever
                  seeing the contradiction. */}
              <label class="mt-4 flex items-start gap-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  name="cash_payment"
                  value="1"
                  checked={Boolean(order.cash_payment)}
                  class="w-4 h-4 mt-0.5 accent-[var(--color-navy)] toggle-cash-payment"
                  data-ref={order.ref}
                />
                <span>
                  <span class="block text-[14px] font-medium">
                    Paying in cash {isCollection ? 'on collection' : 'when you hand them over'}
                  </span>
                  <span class="block mt-0.5 text-[13px] text-[var(--color-ink-faint)]">
                    Nothing is owed until then, and every message says so.
                  </span>
                </span>
              </label>

              {/* Editable per order, not a fixed template: which account to pay
                  into depends on the size of the order and what is in it. The
                  drafts are only the starting text. */}
              <div class="mt-4">
                <label for="payment_message" class="block text-[14px] font-medium mb-1.5">
                  {isCash ? 'What they should do next' : 'How they should pay'}
                </label>

                {/* Two pickers, because a message has two parts: where they
                    are collecting, and how they are paying. A collection paid
                    by transfer needs both, which no single list of whole
                    messages could offer without a box per combination. */}
                {places.length > 0 && (
                  <div class="mb-3">
                    <p class="text-[12.5px] text-[var(--color-ink-faint)] mb-1">Where they collect</p>
                    <div class="flex flex-wrap items-center gap-2" data-place-picker>
                      {places.map((d) => (
                        <button
                          type="button"
                          data-part-pick={d.slot}
                          data-part-kind="place"
                          aria-pressed={d.slot === activePlace ? 'true' : 'false'}
                          class="px-2.5 py-1 text-[13px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-navy)] aria-pressed:border-[var(--color-navy)] aria-pressed:bg-[var(--color-navy)] aria-pressed:text-white"
                        >
                          {d.label}
                        </button>
                      ))}
                    </div>
                  </div>
                )}

                {payments.length > 0 && (
                  <div class="mb-2">
                    <p class="text-[12.5px] text-[var(--color-ink-faint)] mb-1">How they pay</p>
                    <div class="flex flex-wrap items-center gap-2" data-draft-picker>
                      {/* Only one side of this is ever live. Ticking cash kills
                          the bank accounts and wakes the cash wording, and
                          unticking does the reverse - so bank details and "pay
                          in cash" cannot both be armed, which is how a message
                          carrying both used to be possible. */}
                      {payments.map((d) => (
                        <button
                          type="button"
                          data-part-pick={d.slot}
                          data-part-kind="payment"
                          data-cash-slot={d.slot === CASH_SLOT ? 'true' : 'false'}
                          disabled={d.slot === CASH_SLOT ? !isCash : isCash}
                          aria-pressed={d.slot === activePayment ? 'true' : 'false'}
                          class="px-2.5 py-1 text-[13px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-navy)] aria-pressed:border-[var(--color-navy)] aria-pressed:bg-[var(--color-navy)] aria-pressed:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:border-[var(--color-rule)]"
                        >
                          {d.label}
                        </button>
                      ))}
                      {payments.length === 1 && (
                        <a href="/admin/settings" class="text-[13px] text-[var(--color-ink-faint)] hover:text-[var(--color-navy)] underline underline-offset-2">
                          Add another
                        </a>
                      )}
                    </div>

                    {/* An unwritten draft is dropped from the list entirely, so
                        ticking cash could otherwise leave nothing selectable
                        and no explanation for it. */}
                    {!payments.some((d) => d.slot === CASH_SLOT) && (
                      <p
                        data-cash-missing
                        hidden={!isCash}
                        class="mt-2 text-[13px] text-[var(--color-outstock)] leading-relaxed"
                      >
                        No cash wording written yet -{' '}
                        <a href="/admin/settings" class="underline underline-offset-2">
                          add one in Settings
                        </a>
                        , or the message below is whatever you type here.
                      </p>
                    )}
                  </div>
                )}

                <textarea
                  id="payment_message"
                  name="payment_message"
                  rows="8"
                  maxlength="4000"
                  class="field font-[family-name:var(--font-body)] text-[14px] leading-relaxed"
                  data-payments={JSON.stringify(payments)}
                  data-places={JSON.stringify(places)}
                  >{order.payment_message ?? opening}</textarea
                >
                <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
                  Sent exactly as written, with the reference added. The drafts live in{' '}
                  <a href="/admin/settings" class="text-[var(--color-navy)] underline underline-offset-2">Settings</a>.
                </p>
              </div>

              <button type="submit" class="btn btn-primary mt-4">
                Confirm and send
              </button>
            </form>
          </section>
        )
      }

      {waitingForBooks && (
        <p class="p-4 bg-[var(--color-brass)]/10 rounded-[var(--radius-panel)] text-[14px]">
          Waiting for reserved books to arrive. Payment and dispatch become available once every
          copy is here.
        </p>
      )}

      {/*
        * Posting details, as a panel rather than three boxes wrapped around a
        * button.
        *
        * Before the parcel goes they are captured by the press in the bar -
        * the fields belong to that form through `form=`, so the button can sit
        * where the next step sits and the fields can sit with the order.
        * Afterwards they are a correction with its own Save, which is not a
        * new event in the order's life and emails nobody.
        */}
      {postageStep && (
        <section
          id="posting"
          class="scroll-mt-24 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5"
        >
          <h2 class="eyebrow mb-1">Posting details</h2>
          <p class="mb-3 text-[13px] text-[var(--color-ink-faint)]">
            Captured when you press “{postageStep.label}”.
          </p>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="tracking" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                Tracking number (optional)
              </label>
              <input id="tracking" name="tracking" maxlength="80" form={`step-${postageStep.action}`}
                placeholder="e.g. AB123456789GB" class="field !py-2 !text-[14px] w-full" />
            </div>
            <div>
              <label for="postage_provider" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                Carrier
              </label>
              {/* A placeholder, so a carrier is a choice. Without one, Royal
                  Mail was submitted on every posting whether anyone meant it. */}
              <select id="postage_provider" name="postage_provider" form={`step-${postageStep.action}`}
                class="field !py-2 !text-[14px] w-full">
                <option value="">Not recorded</option>
                {POSTAGE_PROVIDERS.map((p) => (
                  <option value={p}>{p}</option>
                ))}
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="postage_service" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                Service (optional)
              </label>
              <input id="postage_service" name="postage_service" maxlength="60" form={`step-${postageStep.action}`}
                placeholder="e.g. Tracked 48" class="field !py-2 !text-[14px] w-full sm:!w-64" />
            </div>
          </div>
        </section>
      )}

      {correctable && (
        <section
          id="posting"
          class="scroll-mt-24 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5"
        >
          <h2 class="eyebrow mb-3">Posting details</h2>
          <form method="post" action={`/api/admin/orders/${order.ref}/tracking`} class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="tracking" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                Tracking number
              </label>
              <input id="tracking" name="tracking" maxlength="80" value={order.tracking_number ?? ''}
                placeholder="e.g. AB123456789GB" class="field !py-2 !text-[14px] w-full" />
            </div>
            <div>
              <label for="postage_provider" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                Carrier
              </label>
              <select id="postage_provider" name="postage_provider" class="field !py-2 !text-[14px] w-full">
                <option value="">Not recorded</option>
                {POSTAGE_PROVIDERS.map((p) => (
                  <option value={p} selected={p === order.postage_provider}>{p}</option>
                ))}
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="postage_service" class="block text-[12.5px] text-[var(--color-ink-faint)] mb-1">
                Service (optional)
              </label>
              <input id="postage_service" name="postage_service" maxlength="60"
                value={order.postage_service ?? ''}
                placeholder="e.g. Tracked 48" class="field !py-2 !text-[14px] w-full sm:!w-64" />
            </div>
            <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
              <button type="submit" class="btn btn-ghost !py-1.5 !text-[13.5px]">Save</button>
              <p class="text-[12.5px] text-[var(--color-ink-faint)]">
                Updates their order page. No email is sent.
              </p>
            </div>
          </form>
        </section>
      )}

      {/* Everything else that is live. Plain panels, because only one
          condition gets to be a strip. */}
      {demotedFlags.map((flag) => (
        <OrderFlag flag={flag} siblings={siblings} isCollection={isCollection} ref={order.ref} />
      ))}

      {waitingOnReply && (
        <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] border-l-[3px] border-l-[var(--color-brass)] p-5">
          <h2 class="text-[16px]">
            {daysLeft > 0
              ? `Reserved books - ${daysLeft} ${daysLeft === 1 ? 'day' : 'days'} to reply`
              : 'Reserved books - the week is up'}
          </h2>
          <p class="mt-1.5 text-[14px] text-[var(--color-ink-soft)] leading-relaxed max-w-[38rem]">
            Their books arrived and are held under this order until
            {' '}<strong class="text-[var(--color-ink)]">
              {replyBy!.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' })}
            </strong>.
            {daysLeft > 0
              ? ' After that the copies go back on the shelf on their own.'
              : ' The sweep will release them at its next run.'}
          </p>
          {/* The same button on its own card, as it has always been - a
              reservation's week is not the shelf hold's 48 hours. */}
          <form method="post" action={`/api/admin/orders/${order.ref}/extend`} class="mt-3">
            <button type="submit" class="btn btn-ghost !py-1.5 !text-[13.5px]">
              Give them another week
            </button>
          </form>
          <p class="mt-2 text-[12.5px] text-[var(--color-ink-faint)]">
            Counted from today, so this works even if the date has passed. Nothing is sent.
          </p>
        </section>
      )}

      {/* What has already been done, and what was typed at the time.
          Read-only on purpose: it is a record, not a second place to edit, and
          folded away because the order in hand is the thing being worked on. */}
      {
        history.length > 0 && (
          <details class="bg-[var(--color-paper)] border border-[var(--color-rule)] rounded-[var(--radius-panel)] p-5">
            <summary class="eyebrow cursor-pointer">
              Already sent
              <span class="ml-1.5 !normal-case !tracking-normal text-[var(--color-ink-faint)]">
                · {history.length} {history.length === 1 ? 'entry' : 'entries'}
              </span>
            </summary>
            <ol class="mt-4 space-y-4">
              {history.map((h) => (
                <li class="grid grid-cols-[7.5rem_1fr] gap-x-4 gap-y-1 text-[14px]">
                  <div class="text-[13px] text-[var(--color-ink-faint)] tabular-nums">
                    {new Date(h.at * 1000).toLocaleDateString('en-GB', {
                      day: 'numeric', month: 'short',
                    })}
                    <span class="block">
                      {new Date(h.at * 1000).toLocaleTimeString('en-GB', {
                        hour: '2-digit', minute: '2-digit',
                      })}
                    </span>
                  </div>
                  <div>
                    <p class="font-medium text-[var(--color-ink-soft)]">{h.what}</p>
                    {h.detail && (
                      <p class="mt-0.5 text-[13.5px] text-[var(--color-ink-faint)]">{h.detail}</p>
                    )}
                    {h.body && (
                      <pre class="mt-1.5 p-2.5 bg-white border border-[var(--color-rule)] rounded-[2px] text-[12.5px] text-[var(--color-ink-faint)] whitespace-pre-wrap font-[family-name:var(--font-body)] max-h-40 overflow-y-auto">{h.body}</pre>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      {
        order.notes && (
          <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
            <h2 class="eyebrow mb-2">Their note</h2>
            <p class="text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line">{order.notes}</p>
          </section>
        )
      }

      {/* Where the books are going, and how to reach the person expecting
          them. Last, because it is the thing the owner reads once. */}
      <section class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-5">
        <h2 class="eyebrow mb-3">{isCollection ? 'Collecting' : 'Send to'}</h2>
        <p class="text-[15px] font-medium">{order.customer_name}</p>
        <p class="mt-2 text-[14.5px] text-[var(--color-ink-soft)] whitespace-pre-line leading-relaxed">
          {isCollection ? 'Collecting in person.' : order.address}
        </p>

        <div class="mt-4 pt-3 border-t border-[var(--color-rule)] grid gap-1.5 text-[14px]">
          <p><a href={`mailto:${order.email}`} class="text-[var(--color-navy)] break-all">{order.email}</a></p>
          {order.phone && <p><a href={`tel:${order.phone}`} class="text-[var(--color-navy)]">{order.phone}</a></p>}
          {order.telegram && <p class="text-[var(--color-ink-soft)]">{order.telegram}</p>}
          {/* What they asked for at checkout. Only their request - the tick in
              the ⋯ menu is what actually decides it. */}
          {order.payment_preference && (
            <p class="text-[13px] text-[var(--color-ink-faint)]">
              Asked to pay by{' '}
              <span class="text-[var(--color-ink)] font-medium">
                {order.payment_preference === 'cash' ? 'cash in person' : 'bank transfer'}
              </span>
            </p>
          )}
          <p
            class:list={[
              'text-[13px]',
              order.telegram_chat_id ? 'text-[var(--color-instock)]' : 'text-[var(--color-ink-faint)]',
            ]}
          >
            {order.telegram_chat_id ? '✓ Telegram connected' : 'Telegram not connected'}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-[var(--color-rule)] grid gap-1.5 text-[13.5px]">
          <div class="flex justify-between gap-3">
            <span class="text-[var(--color-ink-faint)]">Requested</span>
            <span>{new Date(order.created_at * 1000).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}</span>
          </div>
          {
            order.status === 'requested' && hoursLeft !== null && !lapsed && (
              <div class="flex justify-between gap-3">
                <span class="text-[var(--color-ink-faint)]">Hold expires</span>
                <span class={hoursLeft <= 6 ? 'text-[var(--color-outstock)] font-medium' : ''}>
                  in {hoursLeft}h
                </span>
              </div>
            )
          }
          {
            lapsed && (
              <div class="flex justify-between gap-3">
                <span class="text-[var(--color-ink-faint)]">Hold ran out</span>
                <span class="text-[var(--color-outstock)] font-medium">{lapsedWhen}</span>
              </div>
            )
          }
          {order.tracking_number && (
            <div class="flex justify-between gap-3">
              <span class="text-[var(--color-ink-faint)]">
                {order.postage_provider ?? 'Tracking'}
              </span>
              <span class="tabular-nums select-all text-right">
                {order.tracking_number}
                {order.postage_service && (
                  <span class="block text-[13px] text-[var(--color-ink-faint)]">
                    {order.postage_service}
                  </span>
                )}
              </span>
            </div>
          )}
        </div>
      </section>
    </div>

    {/*
      * The conversation, in a pane of its own.
      *
      * It used to be a panel in the middle of the column, below the packing
      * list and above the record - so answering somebody meant scrolling away
      * from the order, and the owner could not read a question and the books
      * it was about at the same time. It is 400px because that is a column
      * somebody can write a paragraph in; under 1100px it goes back under the
      * order, where a phone has the width for it.
      */}
    <div class="lg:sticky lg:top-[5.5rem] lg:h-[calc(100vh-7.5rem)] min-w-0">
      <Thread
        messages={messages}
        side="owner"
        action={`/api/admin/orders/${order.ref}/message`}
        open={threadOpen(order.status)}
        proofUrl={(id: number) => `/api/admin/orders/${order.ref}/proof?id=${id}`}
        proofBase={`/api/admin/orders/${order.ref}/proof`}
        pollUrl={threadOpen(order.status) ? `/api/admin/orders/${order.ref}/thread` : null}
        imagesUsed={imagesHeld}
        channelNote={replyChannelNote(order.telegram_chat_id, order.email)}
        error={threadError}
        readCursor={order.read_cursor_customer ?? 0}
        note={conversationNote}
        fill
      />
    </div>
  </div>

  <script is:inline nonce={Astro.locals.cspNonce} define:vars={{ subtotal: order.subtotal_pence, orderRef: order.ref, amendDiscount: order.discount_pence ?? 0, amendEmpty: AMEND_REFUSAL.empty, amendNone: AMEND_REFUSAL.none, addNone: ADD_REFUSAL.none, addGrossBefore: order.subtotal_pence + (order.discount_pence ?? 0) }}>
    document.querySelector('#deleteOrderForm')?.addEventListener('submit', (event) => {
      if (!confirm(`Delete order ${orderRef} for good?\n\nThis cannot be undone.`)) {
        event.preventDefault();
      }
    });

    /*
     * Cancelling emails the customer and changes what their order page says, and
     * it had no confirmation at all - while deleting, which only affects the
     * shop's own records, did. The guard was on the wrong one.
     */
    for (const form of document.querySelectorAll('[data-confirm="cancel"]')) {
      form.addEventListener('submit', (event) => {
        if (!confirm(`Cancel order ${orderRef}?\n\nThe customer is told, and the books go back on the shelf.`)) {
          event.preventDefault();
        }
      });
    }

    /*
     * The ⋯ menu, which is a <details> and therefore works without any of
     * this. All the script adds is what a menu is expected to do: shut when
     * the next click lands somewhere else, and shut on Escape.
     */
    const menu = document.querySelector('[data-menu]');
    if (menu) {
      document.addEventListener('click', (event) => {
        if (menu.open && !menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    }

    const postage = document.querySelector('#postage');
    const total = document.querySelector('#total');
    // Stepping a pound at a time is PoundInput's own doing, and it fires
    // `input` when it steps, so the total is painted from that one event
    // whether the figure was typed or clicked.
    function paintTotal() {
      const pence = Math.round((Number(postage.value) || 0) * 100);
      total.textContent = `£${((subtotal + pence) / 100).toFixed(2)}`;
    }
    postage?.addEventListener('input', paintTotal);
    if (postage) paintTotal();

    // Cash on collection saves on the tick rather than behind a Save button,
    // so a failed save must put the box back: a checkbox showing a state the
    // order does not have is worse than no checkbox, because the customer's
    // page would be saying the opposite.
    //
    // Plain JS on purpose - this block carries define:vars, so Astro ships it
    // to the browser exactly as written. A TypeScript generic here parses as a
    // pair of comparisons, and the listener silently never binds.
    const message = document.querySelector('#payment_message');
    const payments = message ? JSON.parse(message.dataset.payments ?? '[]') : [];
    const places = message ? JSON.parse(message.dataset.places ?? '[]') : [];

    // What is currently chosen in each picker. Read from the markup rather than
    // assumed, so the server decides the opening state and this only tracks it.
    const chosenOf = (kind) => {
      const pressed = document.querySelector(`[data-part-kind="${kind}"][aria-pressed="true"]`);
      return pressed ? pressed.dataset.partPick : null;
    };

    const bodyOf = (kind, slot) => {
      const list = kind === 'place' ? places : payments;
      return list.find((d) => d.slot === slot)?.body ?? '';
    };

    /*
     * Rebuild the box from whichever parts are chosen: where first, then how to
     * pay - the order the customer needs them in.
     *
     * Switching is deliberately silent. It used to ask before replacing edited
     * text, which is the safe thing for a checkbox but wrong for a button whose
     * entire purpose is to load a wording: the owner asked for it to be
     * seamless, and the cost is that a bespoke message can be lost to a stray
     * click.
     */
    const rebuild = () => {
      if (!message) return;
      const parts = [bodyOf('place', chosenOf('place')), bodyOf('payment', chosenOf('payment'))];
      message.value = parts.map((p) => p.trim()).filter(Boolean).join('\n\n');
    };

    for (const button of document.querySelectorAll('[data-part-pick]')) {
      button.addEventListener('click', () => {
        const kind = button.dataset.partKind;
        for (const sibling of document.querySelectorAll(`[data-part-kind="${kind}"]`)) {
          sibling.setAttribute('aria-pressed', String(sibling === button));
        }
        rebuild();
      });
    }

    /** Move the payment picker onto, or off, the cash wording. */
    const selectPayment = (slot) => {
      for (const button of document.querySelectorAll('[data-part-kind="payment"]')) {
        button.setAttribute('aria-pressed', String(button.dataset.partPick === slot));
      }
      rebuild();
    };

    const cashMissing = document.querySelector('[data-cash-missing]');

    /**
     * Arm one side of the payment picker and kill the other.
     *
     * The tick and the wording are now the same decision rather than two that
     * have to be kept in agreement: a greyed-out button cannot be clicked, so
     * bank details cannot be sent to someone paying in person by leaving a
     * draft selected and forgetting about it.
     */
    const applyCashMode = (wanted) => {
      for (const button of document.querySelectorAll('[data-part-kind="payment"]')) {
        const isCashSlot = button.dataset.cashSlot === 'true';
        button.disabled = isCashSlot ? !wanted : wanted;
      }
      // Only rendered when there is no cash draft at all.
      if (cashMissing) cashMissing.hidden = !wanted;
    };

    /*
     * What the order will come to, worked out while the owner is still typing.
     *
     * The same arithmetic the endpoint runs, in the same order - the discount
     * scaled by what is left, floored, then taken off - so the figure on screen
     * is the figure that gets written. A preview that disagreed with the result
     * would be worse than none, because this is the number the owner decides
     * from.
     */
    const amendForm = document.querySelector('#amendForm');
    if (amendForm) {
      const boxes = [...amendForm.querySelectorAll('[data-amend-qty]')];
      const amendPostage = amendForm.querySelector('#amendPostage');
      const outSubtotal = document.querySelector('#amendSubtotal');
      const outTotal = document.querySelector('#amendTotal');
      const money = (pence) => `£${(pence / 100).toFixed(2)}`;
      const kept = (box) =>
        Math.min(Number(box.dataset.was), Math.max(0, Math.trunc(Number(box.value) || 0)));
      const grossBefore = boxes.reduce(
        (n, box) => n + Number(box.dataset.price) * Number(box.dataset.was),
        0,
      );

      const paintAmend = () => {
        const grossAfter = boxes.reduce((n, box) => n + Number(box.dataset.price) * kept(box), 0);
        const discount =
          grossBefore > 0
            ? Math.min(grossAfter, Math.floor((amendDiscount * grossAfter) / grossBefore))
            : 0;
        const subtotalAfter = grossAfter - discount;
        outSubtotal.textContent = money(subtotalAfter);
        if (outTotal) {
          outTotal.textContent = money(
            subtotalAfter + Math.round((Number(amendPostage?.value) || 0) * 100),
          );
        }
      };

      for (const box of boxes) box.addEventListener('input', paintAmend);
      amendPostage?.addEventListener('input', paintAmend);

      for (const button of amendForm.querySelectorAll('[data-amend-none]')) {
        button.addEventListener('click', () => {
          const box = document.getElementById(button.dataset.amendNone);
          if (!box) return;
          box.value = '0';
          paintAmend();
        });
      }

      /*
       * Named, not counted. "Remove 2 books?" is not a question anybody can
       * answer - the titles are the whole point, and this message goes out to a
       * customer under the shop's name.
       */
      amendForm.addEventListener('submit', (event) => {
        const going = boxes
          .filter((box) => kept(box) < Number(box.dataset.was))
          .map((box) => {
            const n = Number(box.dataset.was) - kept(box);
            return n > 1 ? `${box.dataset.title} × ${n}` : box.dataset.title;
          });
        if (!going.length) {
          event.preventDefault();
          alert(amendNone);
          return;
        }
        if (boxes.every((box) => kept(box) === 0)) {
          event.preventDefault();
          alert(amendEmpty);
          return;
        }
        if (!confirm(`Take these off ${orderRef}?\n\n${going.join('\n')}\n\nThe copies go back on the shelf and the customer is told.`)) {
          event.preventDefault();
        }
      });

      paintAmend();
    }

    /*
     * All of them, not the first. Two of these exist - one in the confirm card,
     * one in the ⋯ menu - kept apart only by a `canConfirm` condition. A
     * singular querySelector meant that if those conditions ever overlapped,
     * the second checkbox would silently do nothing.
     */
    for (const cashCheckbox of document.querySelectorAll('.toggle-cash-payment')) {
      cashCheckbox.addEventListener('change', async () => {
        const wanted = cashCheckbox.checked;
        const body = new FormData();
        body.append('cash_payment', wanted ? '1' : '0');
        cashCheckbox.disabled = true;
        try {
          const res = await fetch(`/api/admin/orders/${cashCheckbox.dataset.ref}/cash-payment`, {
            method: 'POST',
            body,
          });
          if (!res.ok) throw new Error(`save failed: ${res.status}`);
          applyCashMode(wanted);

          // Ticking cash swings the payment picker onto the cash wording, and
          // unticking puts it back on the first account - so the box never
          // contradicts the tick beside it.
          const cashOption = payments.find((p) => p.slot === 'cash');
          const firstAccount = payments.find((p) => p.slot !== 'cash');
          const next = wanted ? cashOption : firstAccount;
          if (next) selectPayment(next.slot);
        } catch (err) {
          console.error('cash payment save failed', err);
          cashCheckbox.checked = !wanted;
          alert('That did not save. Please try again.');
        } finally {
          cashCheckbox.disabled = false;
        }
      });
    }

    /*
<<<<<<< ours
     * Choosing books to put on the order.
     *
     * The search is an enhancement over a form that has no other way to name a
     * book: every row it offers comes from /addable, which is the order's own
     * view of what may go on it, so the panel never shows a title the endpoint
     * would refuse. Quantities are capped at what that read said was free -
     * a courtesy, not a guarantee. The endpoint re-reads availability and the
     * database constraints have the last word.
     */
    const addForm = document.querySelector('#addForm');
    if (addForm) {
      const search = addForm.querySelector('#addSearch');
      const results = addForm.querySelector('#addResults');
      const chosenList = addForm.querySelector('#addChosen');
      const nothing = addForm.querySelector('#addNothing');
      const addPostage = addForm.querySelector('#addPostage');
      const outSubtotal = addForm.querySelector('#addSubtotal');
      const outTotal = addForm.querySelector('#addTotal');
      const money = (pence) => `£${(pence / 100).toFixed(2)}`;
      /** What has been chosen, by book id, so the same title cannot go on twice. */
      const chosen = new Map();

      /*
       * The same arithmetic the endpoint runs, in the same order - the discount
       * scaled by the new gross, floored, then taken off - so the figure on
       * screen is the figure that gets written. This is the number the owner
       * decides from, and a preview that disagreed with the result would be
       * worse than no preview at all.
       */
      const paintAdd = () => {
        let grossAfter = addGrossBefore;
        for (const line of chosen.values()) grossAfter += line.pricePence * line.qty;
        const discount =
          addGrossBefore > 0
            ? Math.min(grossAfter, Math.floor((amendDiscount * grossAfter) / addGrossBefore))
            : 0;
        const subtotalAfter = grossAfter - discount;
        outSubtotal.textContent = money(subtotalAfter);
        if (outTotal) {
          outTotal.textContent = money(
            subtotalAfter + Math.round((Number(addPostage?.value) || 0) * 100),
          );
        }
        nothing.hidden = chosen.size > 0;
      };

      const drawChosen = () => {
        chosenList.replaceChildren();
        for (const line of chosen.values()) {
          const row = document.createElement('li');
          row.className = 'py-2.5 flex items-center justify-between gap-4 text-[14.5px]';

          const name = document.createElement('span');
          name.className = 'min-w-0';
          name.textContent = line.title;
          const each = document.createElement('span');
          each.className = 'block text-[13px] text-[var(--color-ink-faint)]';
          each.textContent =
            `${line.price} each · ${line.free} free` +
            (line.fromIncoming ? ' · claimed from the delivery' : '');
          name.appendChild(each);

          const controls = document.createElement('span');
          controls.className = 'shrink-0 flex items-center gap-2';

          const qty = document.createElement('input');
          // The quantity box *is* the field the endpoint reads. No hidden twin
          // to fall out of step with what is on screen.
          qty.type = 'number';
          qty.name = `add_${line.id}`;
          qty.value = String(line.qty);
          qty.min = '1';
          qty.max = String(line.free);
          qty.inputMode = 'numeric';
          qty.className = 'field !w-16 !py-1.5 !text-[14px] tabular-nums text-center';
          qty.setAttribute('aria-label', `How many of ${line.title}`);
          qty.addEventListener('input', () => {
            const asked = Math.trunc(Number(qty.value) || 0);
            line.qty = Math.min(line.free, Math.max(1, asked));
            paintAdd();
          });
          // Typing is left alone until focus leaves, so a box being cleared to
          // retype does not snap back to 1 under the owner's fingers.
          qty.addEventListener('blur', () => {
            qty.value = String(line.qty);
          });

          const drop = document.createElement('button');
          drop.type = 'button';
          drop.className =
            'px-2 py-1 text-[13px] rounded-[3px] border border-[var(--color-rule)] cursor-pointer hover:border-[var(--color-outstock)] hover:text-[var(--color-outstock)]';
          drop.textContent = 'Remove';
          drop.addEventListener('click', () => {
            chosen.delete(line.id);
            drawChosen();
            paintAdd();
          });

          controls.append(qty, drop);
          row.append(name, controls);
          chosenList.appendChild(row);
        }
      };

      const choose = (book) => {
        if (!chosen.has(book.id)) {
          chosen.set(book.id, { ...book, qty: 1 });
          drawChosen();
          paintAdd();
        }
        results.replaceChildren();
        search.value = '';
        search.focus();
      };

      const drawResults = (books) => {
        results.replaceChildren();
        for (const book of books) {
          // Already on the form. Shown as chosen rather than hidden, so the
          // owner searching for it again is answered rather than left
          // wondering whether the shop has it.
          const taken = chosen.has(book.id);
          const row = document.createElement('li');
          row.className = 'p-2.5 flex items-center justify-between gap-3 text-[14px]';

          const name = document.createElement('span');
          name.className = 'min-w-0';
          name.textContent = book.title;
          const detail = document.createElement('span');
          detail.className = 'block text-[12.5px] text-[var(--color-ink-faint)]';
          detail.textContent =
            `${book.price}${book.wasPrice ? ` (was ${book.wasPrice})` : ''} · ${book.free} free`;
          name.appendChild(detail);

          const pick = document.createElement('button');
          pick.type = 'button';
          pick.className = 'btn btn-ghost !py-1 !px-3 !text-[13px] shrink-0';
          pick.textContent = taken ? 'Chosen' : 'Add';
          pick.disabled = taken;
          pick.addEventListener('click', () => choose(book));

          row.append(name, pick);
          results.appendChild(row);
        }
      };

      /* Long enough that a fast typist makes one request per word, not per
         letter - the same debounce the shop's own search box uses. */
      let typing;
      let latest = 0;
      search.addEventListener('input', () => {
        clearTimeout(typing);
        const q = search.value.trim();
        if (q.length < 2) {
          results.replaceChildren();
          return;
        }
        typing = setTimeout(async () => {
          const mine = ++latest;
          try {
            const res = await fetch(
              `/api/admin/orders/${orderRef}/addable?q=${encodeURIComponent(q)}`,
            );
            if (!res.ok) throw new Error(`search failed: ${res.status}`);
            const body = await res.json();
            // A slow answer to an older keystroke must not overwrite a newer
            // one's results.
            if (mine !== latest) return;
            drawResults(body.results ?? []);
          } catch (err) {
            console.error('[admin] could not search for titles to add', err);
            results.replaceChildren();
          }
        }, 160);
      });

      // Enter in a search box submits the form it is in. Here that would post
      // the order before anything had been chosen.
      search.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') event.preventDefault();
      });

      addPostage?.addEventListener('input', paintAdd);

      /*
       * Named, not counted, exactly as taking books off is: "Add 2 books?" is
       * not a question anybody can answer, and this puts copies on hold and
       * sends a message out under the shop's name.
       */
      addForm.addEventListener('submit', (event) => {
        if (!chosen.size) {
          event.preventDefault();
          alert(addNone);
          return;
        }
        const going = [...chosen.values()].map((line) =>
          line.qty > 1 ? `${line.title} × ${line.qty}` : line.title,
        );
        if (!confirm(`Add these to ${orderRef}?\n\n${going.join('\n')}\n\nThe copies are held for this order and the customer is told.`)) {
          event.preventDefault();
        }
      });

      paintAdd();
    }
  </script>
  {/*
    * The order, kept up to date without a reload.
    *
    * The same file the customer's page uses, driving the portal's routes
    * instead of theirs. It was the customer who had the live thread and the
    * shop that had to reload, which is exactly the wrong way round: the shop
    * is the side being waited on. Telegram and email still carry the ping;
    * this is for when the owner is already looking at the conversation.
    */}
  <script>
    import '../../../scripts/thread.ts';
  </script>
</Admin>

