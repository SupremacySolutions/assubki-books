---
import Admin from '../../layouts/Admin.astro';
import { orderCounts, listOrders, backlog } from '../../lib/admin-db';
import { catalogueStats } from '../../lib/db';
import { price } from '../../lib/format';
import { botConfigured } from '../../lib/telegram';
import { emailConfigured, lastEmailError, fromAddress } from '../../lib/email';

const [counts, pending, work, stats, emailError] = await Promise.all([
  orderCounts(),
  listOrders('requested'),
  backlog(),
  catalogueStats(),
  lastEmailError(),
]);

// A key being present is not the same as email working: an unverified sending
// domain rejects every message. `emailError` is what the provider last said.
const warnings = [
  !emailConfigured() && 'Email is not configured, so customers are not being emailed. Add RESEND_API_KEY and ORDER_FROM.',
  emailConfigured() && emailError &&
    `Email is failing, so customers are not being reached. Sending as ${fromAddress()} was rejected: “${emailError}”`,
  !botConfigured() && 'Telegram is not configured, so new listings cannot be posted to the channel. Add TELEGRAM_BOT_TOKEN.',
].filter(Boolean) as string[];

const CARDS = [
  { key: 'requested', label: 'Needs your reply', href: '/admin/orders?status=requested', urgent: true },
  { key: 'awaiting_payment', label: 'Awaiting payment', href: '/admin/orders?status=awaiting_payment', urgent: false },
  { key: 'paid', label: 'Paid, to post', href: '/admin/orders?status=paid', urgent: true },
];

// Only surface work that exists. A row reading "0 listings with no photo" is
// not information, it is furniture.
const jobs = [
  { n: work.outOfStock, label: 'out of stock', href: '/admin/books?filter=out-of-stock' },
  { n: work.lowStock, label: 'running low', href: '/admin/books?filter=low-stock' },
  { n: work.noImage, label: 'without a photo', href: '/admin/books?filter=no-photo' },
  { n: work.noDescription, label: 'without a description', href: '/admin/books?filter=no-description' },
  { n: work.noCategory, label: 'not on a shelf', href: '/admin/books?filter=no-subject' },
  { n: work.unposted, label: 'never announced', href: '/admin/books?filter=not-announced' },
].filter((j) => j.n > 0);

const totalOrders = Object.values(counts).reduce((a, b) => a + b, 0);
---

<Admin title="Dashboard" sub={`${stats.titles} titles · ${stats.inStock} in stock`}>
  {
    warnings.length > 0 && (
      <div class="mb-6 space-y-2">
        {warnings.map((w) => (
          <p class="p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14px] text-[var(--color-outstock)]">
            {w}
          </p>
        ))}
      </div>
    )
  }

  <div class="flex flex-wrap gap-2 mb-6">
    <a href="/admin/books/new" class="btn btn-primary">Add a listing</a>
    <a href="/admin/books" class="btn btn-ghost">All listings</a>
    <a href="/" class="btn btn-ghost">View the shop</a>
  </div>

  <section class="grid gap-3 sm:grid-cols-3 mb-8">
    {
      CARDS.map((card) => {
        const n = counts[card.key] ?? 0;
        return (
          <a
            href={card.href}
            class:list={[
              'p-4 rounded-[3px] border transition-colors',
              n > 0 && card.urgent
                ? 'bg-white border-[var(--color-navy)] hover:border-[var(--color-navy-hover)]'
                : 'bg-white border-[var(--color-rule)] hover:border-[var(--color-navy)]',
            ]}
          >
            <p class="eyebrow">{card.label}</p>
            <p
              class:list={[
                'mt-1 text-[30px] font-semibold tabular-nums leading-none',
                n === 0 && 'text-[var(--color-ink-faint)]',
              ]}
            >
              {n}
            </p>
          </a>
        );
      })
    }
  </section>

  <section class="mb-10">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="font-[family-name:var(--font-display)] text-[20px] font-semibold">
        Requests waiting
      </h2>
      <a href="/admin/orders" class="text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2">
        All orders →
      </a>
    </div>

    {
      pending.length === 0 ? (
        <p class="p-5 bg-white border border-[var(--color-rule)] rounded-[3px] text-[15px] text-[var(--color-ink-soft)]">
          {totalOrders === 0
            ? 'No orders yet. When someone sends a request it appears here and in your inbox.'
            : 'Nothing waiting on you. New requests appear here and in your inbox.'}
        </p>
      ) : (
        <ul class="bg-white border border-[var(--color-rule)] rounded-[3px] divide-y divide-[var(--color-rule)]">
          {pending.map((o) => {
            const hoursLeft = o.expires_at
              ? Math.max(0, Math.round((o.expires_at * 1000 - Date.now()) / 3_600_000))
              : null;
            return (
              <li>
                <a href={`/admin/orders/${o.ref}`} class="flex items-center gap-4 p-4 hover:bg-[var(--color-paper)]">
                  <div class="min-w-0 flex-1">
                    <p class="text-[15px] font-medium truncate">
                      {o.customer_name}
                      <span class="ml-2 text-[13px] font-normal text-[var(--color-ink-faint)]">{o.ref}</span>
                    </p>
                    <p class="text-[13.5px] text-[var(--color-ink-faint)] truncate">
                      {o.item_count} {o.item_count === 1 ? 'book' : 'books'} · {o.fulfilment}
                      {o.telegram_chat_id ? ' · on Telegram' : ''}
                    </p>
                  </div>
                  <div class="text-right shrink-0">
                    <p class="price text-[15px]">{price(o.subtotal_pence)}</p>
                    {hoursLeft !== null && (
                      <p
                        class:list={[
                          'text-[12.5px] tabular-nums',
                          hoursLeft <= 6 ? 'text-[var(--color-outstock)]' : 'text-[var(--color-ink-faint)]',
                        ]}
                      >
                        {hoursLeft}h left
                      </p>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section>
    <h2 class="font-[family-name:var(--font-display)] text-[20px] font-semibold mb-3">
      Catalogue to tidy
    </h2>

    {
      jobs.length === 0 ? (
        <p class="p-5 bg-[var(--color-instock)]/8 border border-[var(--color-instock)]/25 rounded-[3px] text-[15px] text-[var(--color-instock)]">
          Nothing to handle at the moment. Every listing has a photo, a description and a shelf,
          and all of them have been announced.
        </p>
      ) : (
        <>
          <p class="text-[14.5px] text-[var(--color-ink-soft)] mb-4 max-w-2xl">
            Each of these opens the listings already filtered, so you can work through one at a
            time. They disappear as you clear them.
          </p>
          <ul class="grid gap-2.5 sm:grid-cols-2">
            {jobs.map((job) => (
              <li>
                <a
                  href={job.href}
                  class="flex items-baseline gap-3 p-3.5 bg-white border border-[var(--color-rule)] rounded-[3px] hover:border-[var(--color-navy)] transition-colors"
                >
                  <span class="text-[22px] font-semibold tabular-nums">{job.n}</span>
                  <span class="text-[14.5px] text-[var(--color-ink-soft)]">{job.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Admin>
