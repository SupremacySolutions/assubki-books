---
import Admin from '../../layouts/Admin.astro';
import { orderCounts, listOrders } from '../../lib/admin-db';
import { price } from '../../lib/format';
import { botConfigured } from '../../lib/telegram';
import { emailConfigured, lastEmailError, fromAddress } from '../../lib/email';
import { lastNotifyError } from '../../lib/notify';
import { dashboard } from '../../lib/dashboard';

const [counts, pending, emailError, notifyError] = await Promise.all([
  orderCounts(),
  listOrders('requested'),
  lastEmailError(),
  lastNotifyError(),
]);

const days = Astro.url.searchParams.get('d') === '90' ? 90 : 30;
const d = await dashboard(days);
const work = d.backlog;

// A key being present is not the same as email working: an unverified sending
// domain rejects every message. `emailError` is what the provider last said.
const warnings = [
  !emailConfigured() && 'Email is not configured, so customers are not being emailed. Add RESEND_API_KEY and ORDER_FROM.',
  emailConfigured() && emailError &&
    `Email is failing, so customers are not being reached. Sending as ${fromAddress()} was rejected: “${emailError}”`,
  !botConfigured() && 'Telegram is not configured, so new listings cannot be posted to the channel. Add TELEGRAM_BOT_TOKEN.',
  // A message that never left is invisible unless something says so.
  notifyError && `A customer was not told their order changed: ${notifyError}`,
].filter(Boolean) as string[];

const CARDS = [
  { key: 'requested', label: 'Needs your reply', href: '/admin/orders?status=requested', urgent: true },
  { key: 'awaiting_payment', label: 'Awaiting payment', href: '/admin/orders?status=awaiting_payment', urgent: false },
  { key: 'paid', label: 'Paid, to fulfil', href: '/admin/orders?status=paid', urgent: true },
];

// Only surface work that exists. A row reading "0 listings with no photo" is
// not information, it is furniture.
const jobs = [
  { n: work.outOfStock, label: 'out of stock', href: '/admin/books?filter=out-of-stock' },
  { n: work.lowStock, label: 'running low', href: '/admin/books?filter=low-stock' },
  { n: work.noImage, label: 'without a photo', href: '/admin/books?filter=no-photo' },
  // Next to "without a photo" on purpose: a cover too small to fill the box is
  // the same job, and reads worse on the shop than an honest blank would.
  { n: work.thinImage, label: 'with a photo too small to print well', href: '/admin/books?filter=thin-photo' },
  { n: work.noDescription, label: 'without a description', href: '/admin/books?filter=no-description' },
  { n: work.noCategory, label: 'not on a shelf', href: '/admin/books?filter=no-subject' },
  { n: work.unposted, label: 'never announced', href: '/admin/books?filter=not-announced' },
].filter((j) => j.n > 0);

const totalOrders = Object.values(counts).reduce((a, b) => a + b, 0);

// The chart is drawn from the days that actually have orders, padded out so a
// quiet week does not compress the shape of a busy one.
const span = Array.from({ length: days }, (_, i) => {
  const at = new Date(Date.now() - (days - 1 - i) * 86_400_000);
  const key = at.toISOString().slice(0, 10);
  const found = d.daily.find((x) => x.day === key);
  return { day: key, pence: found?.pence ?? 0, orders: found?.orders ?? 0 };
});
const peak = Math.max(1, ...span.map((p) => p.pence));
const peakOrders = Math.max(1, ...span.map((p) => p.orders));
const W = 560;
const H = 150;
const x = (i: number) => (i / Math.max(1, span.length - 1)) * W;
const y = (pence: number) => H - (pence / peak) * (H - 16);
const line = span.map((p, i) => `${x(i).toFixed(1)},${y(p.pence).toFixed(1)}`).join(' ');
const area = `${line} ${W},${H} 0,${H}`;
const change =
  d.previousPence > 0 ? Math.round(((d.revenuePence - d.previousPence) / d.previousPence) * 100) : null;
const fulfilled = d.collection + d.posted;
const collectionPct = fulfilled > 0 ? Math.round((d.collection / fulfilled) * 100) : 0;
const paid = d.cash + d.transfer;
const cashPct = paid > 0 ? Math.round((d.cash / paid) * 100) : 0;
// The donut is one stroke with a gap, so the arc is just a dash length.
const R = 54;
const CIRC = 2 * Math.PI * R;
const bestPeak = Math.max(1, ...d.bestSellers.map((b) => b.qty));
const shelfPeak = Math.max(1, ...d.byShelf.map((s) => s.pence));
---

<Admin title="Dashboard" showHeading={false}>
  <section class="reveal mb-8 border-l-2 border-[var(--color-navy)] pl-4">
    {/* An H1, not a paragraph styled like one: the page had no top-level
        heading, so its outline began at H2 and assistive technology had
        nothing to announce it by. The eyebrow carries the name because that is
        what it already reads as; "Welcome back" is a greeting, not a title. */}
    <h1 class="eyebrow">Owner dashboard</h1>
    <p class="mt-1 font-[family-name:var(--font-display)] text-[22px] font-semibold">Welcome back.</p>
    <p class="mt-1 text-[14.5px] text-[var(--color-ink-soft)]">Here is what needs your attention today.</p>
  </section>
  {
    warnings.length > 0 && (
      <div class="mb-6 space-y-2">
        {warnings.map((w) => (
          <p class="p-3 bg-[var(--color-outstock)]/10 border border-[var(--color-outstock)]/30 rounded-[3px] text-[14px] text-[var(--color-outstock)]">
            {w}
          </p>
        ))}
      </div>
    )
  }

  <div class="reveal flex flex-wrap gap-2 mb-6" data-delay="1">
    <a href="/admin/books/new" class="btn btn-primary">Add a listing</a>
    <a href="/admin/books" class="btn btn-ghost">All listings</a>
    <a href="/" class="btn btn-ghost">View the shop</a>
  </div>

  <div class="reveal mb-8" data-delay="2">
<div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
    <p class="text-[14.5px] text-[var(--color-ink-soft)]">
      Last {days} days
    </p>
    <div class="flex gap-1.5 text-[13.5px]">
      <a
        href="/admin"
        class:list={['px-2.5 py-1 rounded-[3px]', days === 30 ? 'bg-[var(--color-navy)] text-white' : 'text-[var(--color-navy)] hover:bg-[var(--color-paper)]']}
      >30 days</a>
      <a
        href="/admin?d=90"
        class:list={['px-2.5 py-1 rounded-[3px]', days === 90 ? 'bg-[var(--color-navy)] text-white' : 'text-[var(--color-navy)] hover:bg-[var(--color-paper)]']}
      >90 days</a>
    </div>
  </div>

  {/* What needs the owner today, before anything historical. */}
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <a
      href="/admin/orders?status=requested"
      class:list={[
        'block bg-white border rounded-[3px] p-4 hover:border-[var(--color-navy)] transition-colors',
        d.toConfirm > 0 ? 'border-[var(--color-navy)] border-l-[3px]' : 'border-[var(--color-rule)]',
      ]}
    >
      <p class="eyebrow">To confirm</p>
      <p class="text-[30px] font-semibold leading-none mt-2 tabular-nums">{d.toConfirm}</p>
      <p class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)]">
        {d.oldestWaitingHours === null
          ? 'nothing waiting'
          : d.oldestWaitingHours < 1
            /* "oldest 0h ago" reads as a bug rather than as good news. */
            ? 'all within the hour'
            : `oldest ${d.oldestWaitingHours}h ago`}
      </p>
    </a>
    <a href="/admin/orders?status=awaiting_payment" class="block bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4 hover:border-[var(--color-navy)] transition-colors">
      <p class="eyebrow">Awaiting payment</p>
      <p class="text-[30px] font-semibold leading-none mt-2 tabular-nums">{price(d.awaitingPence)}</p>
      <p class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)]">
        across {d.awaitingPayment} {d.awaitingPayment === 1 ? 'order' : 'orders'}
      </p>
    </a>
    <a href="/admin/orders?status=paid" class="block bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4 hover:border-[var(--color-navy)] transition-colors">
      <p class="eyebrow">To post</p>
      <p class="text-[30px] font-semibold leading-none mt-2 tabular-nums">{d.toPost}</p>
      <p class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)]">paid, not sent</p>
    </a>
    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4">
      <p class="eyebrow">Taken</p>
      <p class="text-[30px] font-semibold leading-none mt-2 tabular-nums">{price(d.revenuePence)}</p>
      <p class="mt-1.5 text-[12.5px]">
        {change === null ? (
          <span class="text-[var(--color-ink-faint)]">no earlier period to compare</span>
        ) : (
          <span class:list={[change >= 0 ? 'text-[var(--color-instock)]' : 'text-[var(--color-outstock)]']}>
            {change >= 0 ? '▲' : '▼'} {Math.abs(change)}% on the {days} days before
          </span>
        )}
      </p>
    </div>
  </div>

  <div class="grid gap-3 lg:grid-cols-[1.9fr_1fr] mt-3">
    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4">
      <p class="eyebrow mb-1">Taken per day</p>
      {d.revenuePence > 0 ? (
        <>
          <svg viewBox={`0 0 ${W} ${H + 18}`} width="100%" height="168" role="img"
               aria-label={`Daily takings over the last ${days} days, ${price(d.revenuePence)} in total`}>
            <g stroke="#eceae4" stroke-width="1">
              <line x1="0" y1={H * 0.25} x2={W} y2={H * 0.25} />
              <line x1="0" y1={H * 0.5} x2={W} y2={H * 0.5} />
              <line x1="0" y1={H * 0.75} x2={W} y2={H * 0.75} />
            </g>
            <polygon points={area} fill="#184485" fill-opacity="0.09" />
            <polyline points={line} fill="none" stroke="#184485" stroke-width="2.2" stroke-linejoin="round" />
            {span.map((p, i) => (
              p.orders > 0 && (
                <rect
                  x={x(i) - 1.6}
                  y={H + 2}
                  width="3.2"
                  height={Math.max(2, (p.orders / peakOrders) * 14)}
                  fill="#c8a24a"
                />
              )
            ))}
          </svg>
          <div class="flex gap-4 text-[11.5px] text-[var(--color-ink-faint)] mt-1">
            <span><span class="inline-block w-2.5 h-2.5 rounded-[2px] bg-[var(--color-navy)] align-[-1px] mr-1"></span>Taken · peak {price(peak)} in a day</span>
            <span><span class="inline-block w-2.5 h-2.5 rounded-[2px] bg-[#c8a24a] align-[-1px] mr-1"></span>Orders</span>
          </div>
        </>
      ) : (
        <p class="py-10 text-center text-[14px] text-[var(--color-ink-faint)]">
          Nothing taken in this period yet.
        </p>
      )}
    </div>

    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4">
      <p class="eyebrow mb-1">How it goes out</p>
      {fulfilled > 0 ? (
        <>
          <svg viewBox="0 0 140 140" width="100%" height="132" style="max-width:132px;margin:8px auto 0;display:block"
               role="img" aria-label={`${collectionPct}% of orders collected`}>
            <circle cx="70" cy="70" r={R} fill="none" stroke="#eceae4" stroke-width="18" />
            <circle
              cx="70" cy="70" r={R} fill="none" stroke="#184485" stroke-width="18"
              stroke-dasharray={`${(CIRC * collectionPct) / 100} ${CIRC}`}
              transform="rotate(-90 70 70)"
            />
            <text x="70" y="67" text-anchor="middle" font-size="24" font-weight="650" fill="#1a1a18">{collectionPct}%</text>
            <text x="70" y="84" text-anchor="middle" font-size="9.5" fill="#6b6b66">collected</text>
          </svg>
          <p class="text-center text-[12.5px] text-[var(--color-ink-faint)] mt-2">
            {d.collection} collected · {d.posted} posted
          </p>
          <p class="text-center text-[12.5px] text-[var(--color-ink-faint)] mt-1 pt-2 border-t border-[var(--color-rule)]">
            {cashPct}% paid in cash · {100 - cashPct}% by transfer
          </p>
        </>
      ) : (
        <p class="py-10 text-center text-[14px] text-[var(--color-ink-faint)]">No orders yet.</p>
      )}
    </div>
  </div>

  <div class="grid gap-3 lg:grid-cols-3 mt-3">
    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4">
      <p class="eyebrow mb-2.5">Selling best</p>
      {d.bestSellers.length > 0 ? (
        <ul class="space-y-2">
          {d.bestSellers.map((b) => (
            <li>
              <div class="flex justify-between gap-3 text-[13px]">
                <span class="truncate">{b.title}</span>
                <span class="text-[var(--color-ink-faint)] tabular-nums shrink-0">{b.qty}</span>
              </div>
              <div class="h-1.5 bg-[var(--color-paper)] rounded-full mt-1 overflow-hidden">
                <div class="h-full bg-[var(--color-navy)] rounded-full" style={`width:${(b.qty / bestPeak) * 100}%`}></div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-[13.5px] text-[var(--color-ink-faint)]">Nothing sold in this period.</p>
      )}
    </div>

    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4">
      <p class="eyebrow mb-1">Taken per shelf</p>
      {/* Said plainly, because a book can sit on more than one shelf and the
          owner should know which shelf a sale was counted against. */}
      <p class="text-[12px] text-[var(--color-ink-faint)] mb-2.5 leading-relaxed">
        Each sale counted once, against the first shelf its title is filed under.
      </p>
      {d.byShelf.length > 0 ? (
        <ul class="space-y-2">
          {d.byShelf.map((s) => (
            <li>
              <div class="flex justify-between gap-3 text-[13px]">
                <span class="truncate">{s.name}</span>
                <span class="text-[var(--color-ink-faint)] tabular-nums shrink-0">{price(s.pence)}</span>
              </div>
              <div class="h-1.5 bg-[var(--color-paper)] rounded-full mt-1 overflow-hidden">
                <div class="h-full bg-[#c8a24a] rounded-full" style={`width:${(s.pence / shelfPeak) * 100}%`}></div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-[13.5px] text-[var(--color-ink-faint)]">Nothing sold in this period.</p>
      )}
    </div>

    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4">
      <p class="eyebrow mb-2.5">Running low</p>
      {d.lowStock.length > 0 ? (
        <ul class="space-y-1.5 text-[13px]">
          {d.lowStock.map((b) => (
            <li class="flex justify-between gap-3">
              <a href={`/admin/books?q=${encodeURIComponent(b.title)}`} class="truncate text-[var(--color-navy)] hover:underline underline-offset-2">
                {b.title}
              </a>
              <span
                class:list={['tabular-nums shrink-0', b.left <= 1 ? 'text-[var(--color-outstock)]' : 'text-[var(--color-ink-faint)]']}
              >{b.left} left</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-[13.5px] text-[var(--color-ink-faint)]">Nothing down to its last copies.</p>
      )}
    </div>
  </div>

  {/*
    * The nearest thing on this page to a customer speaking.
    *
    * Every other panel counts what the shop did. These are people who came
    * looking for something and left with nothing - a purchase request that,
    * until now, vanished the moment the results page rendered empty. Full
    * width rather than a third of a row, because the useful thing is the
    * words, and a title truncated to a card column is no use for deciding
    * whether to order a book.
    */}
  <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] p-4 mt-3">
    <p class="eyebrow mb-1">Looked for, not found</p>
    <p class="text-[12.5px] text-[var(--color-ink-faint)] mb-3 leading-relaxed">
      Searches that returned nothing, most asked first. Some will be robots; the rest are
      customers telling you what to stock.
    </p>
    {d.misses.length > 0 ? (
      <ul class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2 text-[13px]">
        {d.misses.map((m) => (
          <li class="flex justify-between gap-3">
            {/* Straight to the catalogue search, so the owner can see for
                themselves what the customer saw. */}
            <a
              href={`/catalogue?q=${encodeURIComponent(m.terms)}`}
              class="truncate text-[var(--color-navy)] hover:underline underline-offset-2"
            >{m.terms}</a>
            <span class="tabular-nums shrink-0 text-[var(--color-ink-faint)]">
              {m.times}{m.times === 1 ? '' : '×'}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-[13.5px] text-[var(--color-ink-faint)]">
        Every search in this period found something.
      </p>
    )}
  </div>

  {/*
    * Three figures that were a footnote and should not have been. "How many
    * orders" and "what an order is worth" are the two numbers behind the
    * takings above, and repeat customers is the one number that says whether
    * people come back - counted all time, because over thirty days almost
    * nobody has had the chance to.
    */}
  <div class="grid gap-3 sm:grid-cols-3 mt-3">
    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] px-4 py-3">
      <p class="eyebrow">Orders</p>
      <p class="text-[22px] font-semibold leading-none mt-1.5 tabular-nums">{d.orders}</p>
      <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">paid in the last {days} days</p>
    </div>
    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] px-4 py-3">
      <p class="eyebrow">Average order</p>
      <p class="text-[22px] font-semibold leading-none mt-1.5 tabular-nums">{price(d.averagePence)}</p>
      <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">across those orders</p>
    </div>
    <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] px-4 py-3">
      <p class="eyebrow">Repeat customers</p>
      <p class="text-[22px] font-semibold leading-none mt-1.5 tabular-nums">{d.repeatPct}%</p>
      <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">have ordered more than once</p>
    </div>
  </div>

  <p class="mt-4 text-[12.5px] text-[var(--color-ink-faint)]">
    Figures refresh about once a minute.
  </p>
  </div>

  <section class="reveal mb-10" data-delay="3">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="font-[family-name:var(--font-display)] text-[20px] font-semibold">
        Requests waiting
      </h2>
      <a href="/admin/orders" class="text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2">
        All orders →
      </a>
    </div>

    {
      pending.length === 0 ? (
        <p class="p-5 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] text-[15px] text-[var(--color-ink-soft)]">
          {totalOrders === 0
            ? 'No orders yet. When someone sends a request it appears here and in your inbox.'
            : 'Nothing waiting on you. New requests appear here and in your inbox.'}
        </p>
      ) : (
        <ul class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] divide-y divide-[var(--color-rule-faint)]">
          {pending.map((o) => {
            const hoursLeft = o.expires_at
              ? Math.max(0, Math.round((o.expires_at * 1000 - Date.now()) / 3_600_000))
              : null;
            return (
              <li>
                <a href={`/admin/orders/${o.ref}`} class="flex items-center gap-4 p-4 hover:bg-[var(--color-paper)]">
                  <div class="min-w-0 flex-1">
                    <p class="text-[15px] font-medium truncate">
                      {o.customer_name}
                      <span class="ml-2 text-[13px] font-normal text-[var(--color-ink-faint)]">{o.ref}</span>
                    </p>
                    <p class="text-[13.5px] text-[var(--color-ink-faint)] truncate">
                      {o.item_count} {o.item_count === 1 ? 'book' : 'books'} · {o.fulfilment}
                      {o.telegram_chat_id ? ' · on Telegram' : ''}
                    </p>
                  </div>
                  <div class="text-right shrink-0">
                    <p class="price text-[15px]">{price(o.subtotal_pence)}</p>
                    {hoursLeft !== null && (
                      <p
                        class:list={[
                          'text-[12.5px] tabular-nums',
                          hoursLeft <= 6 ? 'text-[var(--color-outstock)]' : 'text-[var(--color-ink-faint)]',
                        ]}
                      >
                        {hoursLeft}h left
                      </p>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section class="reveal" data-delay="4">
    <h2 class="font-[family-name:var(--font-display)] text-[20px] font-semibold mb-3">
      Catalogue to tidy
    </h2>

    {
      jobs.length === 0 ? (
        <p class="p-5 bg-[var(--color-instock)]/8 border border-[var(--color-instock)]/25 rounded-[3px] text-[15px] text-[var(--color-instock)]">
          Nothing to handle at the moment. Every listing has a photo, a description and a shelf,
          and all of them have been announced.
        </p>
      ) : (
        <>
          <p class="text-[14.5px] text-[var(--color-ink-soft)] mb-4 max-w-2xl">
            Each of these opens the listings already filtered, so you can work through one at a
            time. They disappear as you clear them.
          </p>
          <ul class="grid gap-2.5 sm:grid-cols-2">
            {jobs.map((job) => (
              <li>
                <a
                  href={job.href}
                  class="flex items-baseline gap-3 p-3.5 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] hover:border-[var(--color-navy)] transition-colors"
                >
                  <span class="text-[22px] font-semibold tabular-nums">{job.n}</span>
                  <span class="text-[14.5px] text-[var(--color-ink-soft)]">{job.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Admin>
