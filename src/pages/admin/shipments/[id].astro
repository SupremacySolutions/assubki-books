---
import Admin from '../../../layouts/Admin.astro';
import { env } from 'cloudflare:workers';
import { getShipment, shipmentItems } from '../../../lib/shipments';
import { pendingNotices } from '../../../lib/shipment-notify';
import { whenText } from '../../../lib/incoming';

const id = Number.parseInt(Astro.params.id ?? '', 10);
const shipment = Number.isInteger(id) ? await getShipment(id) : null;
if (!shipment) return Astro.rewrite('/404');

const items = await shipmentItems(id);
const params = Astro.url.searchParams;
const added = Number(params.get('added') ?? 0);
const unread = Number(params.get('unread') ?? 0);
const saved = params.get('saved');
const opened = params.get('opened');
const error = params.get('e');

const isDraft = shipment.status === 'draft';
const arrivedCount = Number(params.get('arrived') ?? -1);
// What is still waiting to go out, so the owner can see the queue draining
// rather than wondering whether anything happened.
const waitingToSend = shipment.status === 'arrived'
  ? await pendingNotices(env.DB, id)
  : 0;
const money = (pence: number) => (pence / 100).toFixed(2);

/*
 * A row nobody can reserve yet, spelled out.
 *
 * `openShipment` refuses a list with holes in it, and refusing without saying
 * which row is a puzzle. Marking them here means the button's refusal is
 * already explained by the time it happens.
 */
const listed = params.get('listed');
/*
 * What is left after the reservations were filled.
 *
 * Only these can become listings: a title whose every copy is spoken for has
 * nothing to sell, and offering to list it would be offering to sell a book
 * that is already somebody else's.
 */
const spare = (i: typeof items[number]) => i.stock - i.reserved_incoming - i.reserved;

/*
 * The rows are wrapped in the save form only while the shipment is a draft.
 *
 * After it has landed each row grows a form of its own for listing the spare
 * copies, and a form inside a form is invalid HTML - the browser drops the
 * inner one silently, so the button would render and do nothing.
 */
const Rows = isDraft ? 'form' : 'div';

const incomplete = (i: typeof items[number]) =>
  !i.title || i.price_pence <= 0 || i.incoming <= 0;
const holes = items.filter(incomplete).length;
---

<Admin
  title={shipment.title}
  sub={whenText(shipment.incoming_vague, shipment.incoming_month)
    ? `Expected ${whenText(shipment.incoming_vague, shipment.incoming_month)}`
    : undefined}
  back={{ href: '/admin/shipments', label: 'Shipments' }}
>
  {added > 0 && (
    <p class="mb-4 text-[14px] text-[var(--color-instock)]">
      Read {added} {added === 1 ? 'title' : 'titles'} from the list.
      {unread > 0 && ` ${unread} ${unread === 1 ? 'line' : 'lines'} could not be read and ${unread === 1 ? 'was' : 'were'} left out — add ${unread === 1 ? 'it' : 'them'} by hand below.`}
    </p>
  )}
  {saved && <p class="mb-4 text-[14px] text-[var(--color-instock)]">Saved.</p>}
  {opened && (
    <p class="mb-4 text-[14px] text-[var(--color-instock)]">
      Open. Customers can reserve from these now.
    </p>
  )}
  {error && <p class="mb-4 text-[14px] text-[var(--color-outstock)]">{error}.</p>}
  {listed && (
    <p class="mb-4 text-[14px] text-[var(--color-instock)]">
      “{listed}” is now an ordinary listing. Add photos and a description to it in
      Listings — it will not appear in the catalogue looking its best until you do.
    </p>
  )}
  {arrivedCount >= 0 && (
    <p class="mb-4 text-[14px] text-[var(--color-instock)]">
      Marked as arrived. The copies are on the shelf and
      {arrivedCount === 0
        ? ' nobody had reserved any.'
        : ` ${arrivedCount} ${arrivedCount === 1 ? 'customer is' : 'customers are'} being told — they have seven days to reply.`}
    </p>
  )}
  {waitingToSend > 0 && (
    <p class="mb-4 text-[13.5px] text-[var(--color-ink-soft)] leading-relaxed max-w-[46rem]">
      {waitingToSend} {waitingToSend === 1 ? 'customer has' : 'customers have'} still
      to be told. They go out a few at a time, so a large shipment does not spend
      the day's email in one go — check back in a quarter of an hour.
    </p>
  )}

  <div class="mb-5 flex flex-wrap items-center gap-3">
    <span class="text-[13px] text-[var(--color-ink-faint)]">
      {items.length} {items.length === 1 ? 'title' : 'titles'} ·
      {' '}{shipment.copies} {shipment.copies === 1 ? 'copy' : 'copies'}
      {shipment.claimed > 0 && ` · ${shipment.claimed} reserved`}
    </span>

    {shipment.status === 'open' && (
      <span class="text-[13px] text-[var(--color-ink-faint)]">
        Correct the copy counts before marking it arrived — that is what customers
        are given.
      </span>
    )}
    {isDraft && (
      <form method="post" action={`/api/admin/shipments/${id}/open`}>
        <button
          type="submit"
          class="btn btn-primary !py-1.5 !text-[13.5px]"
          disabled={holes > 0 || items.length === 0}
        >
          Open for reservations
        </button>
      </form>
    )}
    {shipment.status === 'open' && (
      <form method="post" action={`/api/admin/shipments/${id}/arrived`} data-confirm="arrived">
        <button type="submit" class="btn btn-primary !py-1.5 !text-[13.5px]">
          The shipment has arrived
        </button>
      </form>
    )}
    {shipment.status === 'arrived' && (
      <form method="post" action={`/api/admin/shipments/${id}/open`}>
        <input type="hidden" name="action" value="close" />
        <button type="submit" class="btn btn-ghost !py-1.5 !text-[13.5px]">Put away</button>
      </form>
    )}
  </div>

  {holes > 0 && isDraft && (
    <p class="mb-4 text-[13.5px] text-[var(--color-outstock)] leading-relaxed max-w-[46rem]">
      {holes} {holes === 1 ? 'row still needs' : 'rows still need'} a title, a price
      or a number of copies. They are marked below, and the shipment cannot open
      until they are filled in — a customer cannot reserve a book with no price.
    </p>
  )}

  {items.length === 0 ? (
    <p class="text-[15px] text-[var(--color-ink-soft)]">Nothing on this shipment.</p>
  ) : (
    <Rows
      {...(isDraft
        ? { method: 'post', action: `/api/admin/shipments/${id}/save` }
        : {})}
      class="grid gap-2"
    >
      {items.map((i) => (
        <div
          class:list={[
            'bg-white border rounded-[var(--radius-panel)] p-3 grid gap-2 sm:grid-cols-[1fr_5rem_5rem_5rem_7rem] sm:items-end',
            incomplete(i) ? 'border-[var(--color-outstock)]' : 'border-[var(--color-rule-soft)]',
          ]}
        >
          <input type="hidden" name="row" value={i.id} />
          <div>
            <label for={`title_${i.id}`} class="block text-[12px] text-[var(--color-ink-faint)] mb-1">
              Title
            </label>
            <input
              id={`title_${i.id}`}
              name={`title_${i.id}`}
              value={i.title}
              maxlength="200"
              dir="auto"
              class="field ar !text-[14px]"
            />
          </div>
          <div>
            <label for={`price_${i.id}`} class="block text-[12px] text-[var(--color-ink-faint)] mb-1">
              Price £
            </label>
            <input
              id={`price_${i.id}`}
              name={`price_${i.id}`}
              type="number"
              step="0.01"
              min="0"
              value={money(i.price_pence)}
              class="field !text-[14px]"
            />
          </div>
          <div>
            <label for={`volumes_${i.id}`} class="block text-[12px] text-[var(--color-ink-faint)] mb-1">
              Volumes
            </label>
            <input
              id={`volumes_${i.id}`}
              name={`volumes_${i.id}`}
              type="number"
              min="0"
              max="200"
              value={i.volumes ?? ''}
              class="field !text-[14px]"
            />
          </div>
          <div>
            <label for={`incoming_${i.id}`} class="block text-[12px] text-[var(--color-ink-faint)] mb-1">
              Copies
            </label>
            <input
              id={`incoming_${i.id}`}
              name={`incoming_${i.id}`}
              type="number"
              min={i.reserved_incoming}
              max="999"
              value={i.incoming}
              class="field !text-[14px]"
            />
          </div>
          <div>
            <label for={`script_${i.id}`} class="block text-[12px] text-[var(--color-ink-faint)] mb-1">
              Language
            </label>
            <select id={`script_${i.id}`} name={`script_${i.id}`} class="field !text-[14px]">
              <option value="arabic" selected={Boolean(i.title_ar)}>Arabic</option>
              <option value="urdu" selected={Boolean(i.title_ur)}>Urdu</option>
            </select>
          </div>
          {i.reserved_incoming > 0 && (
            <p class="sm:col-span-5 text-[12.5px] text-[var(--color-navy)]">
              {i.reserved_incoming} reserved — the number of copies cannot go below that.
            </p>
          )}

          {/*
            * Turning what is left into a listing.
            *
            * Needs an English title, because the shipment carried the book's own
            * name - right for a list read in Arabic, wrong for a shop front and
            * for the address the page will live at. Its own form rather than
            * part of the row above, since it posts somewhere else and does
            * something that cannot be undone by editing a field back.
            */}
          {shipment.status === 'arrived' && spare(i) > 0 && (
            <form
              method="post"
              action={`/api/admin/shipments/${id}/promote`}
              class="sm:col-span-5 mt-1 pt-3 border-t border-[var(--color-rule-soft)] flex flex-wrap items-end gap-2"
            >
              <input type="hidden" name="book" value={i.id} />
              <div class="min-w-[16rem] flex-1">
                <label for={`en_${i.id}`} class="block text-[12px] text-[var(--color-ink-faint)] mb-1">
                  English title — {spare(i)} {spare(i) === 1 ? 'copy' : 'copies'} left to sell
                </label>
                <input
                  id={`en_${i.id}`}
                  name="title"
                  required
                  maxlength="200"
                  placeholder="How it should read in the catalogue"
                  class="field !text-[14px]"
                />
              </div>
              <button type="submit" class="btn btn-ghost !py-1.5 !text-[13.5px]">
                List the spare copies
              </button>
            </form>
          )}
          {shipment.status === 'arrived' && spare(i) <= 0 && (
            <p class="sm:col-span-5 text-[12.5px] text-[var(--color-ink-faint)]">
              Every copy is spoken for, so there is nothing to list.
            </p>
          )}
        </div>
      ))}

      {isDraft && (
        <div class="mt-2 flex items-center gap-3">
          <button type="submit" class="btn btn-primary !py-2">Save these</button>
          <span class="text-[12.5px] text-[var(--color-ink-faint)]">
            Clearing a title removes that row.
          </span>
        </div>
      )}
    </Rows>
  )}
</Admin>
