---
/*
 * Traffic and health, kept apart from the dashboard on purpose.
 *
 * `/admin/dashboard` records what happens when this line is drawn in the wrong
 * place: the portal briefly had two pages both called Dashboard showing
 * overlapping counts, and they had to be merged back. So this page holds
 * nothing about orders, revenue or stock - those live on `/admin` and stay
 * there. What is here is the shop's plumbing: how much of the database's daily
 * allowance has gone, and where to look when it starts climbing.
 */
import Admin from '../../layouts/Admin.astro';
import { d1Usage, usageLevel, compact, D1_DAILY_ROW_LIMIT } from '../../lib/d1-usage';
import { webhookHealth, botConfigured } from '../../lib/telegram';
import {
  emailUsage,
  usedAgainstLimits,
  RESEND_DAILY_LIMIT,
  RESEND_MONTHLY_LIMIT,
} from '../../lib/email-usage';
import { emailDryRun, lastEmailError } from '../../lib/email';

export const prerender = false;

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const [usage, bot, mail, mailError] = await Promise.all([
  d1Usage(),
  webhookHealth(origin),
  emailUsage(),
  lastEmailError(),
]);
const mailUsed = mail ? usedAgainstLimits(mail) : null;
const mailDayShare = mailUsed ? mailUsed.today / RESEND_DAILY_LIMIT : 0;
const mailMonthShare = mailUsed ? mailUsed.month / RESEND_MONTHLY_LIMIT : 0;
/* Amber from three-quarters: a busy shipment day sends dozens at once. */
const mailLevel = mail?.refused || mailDayShare >= 1 || mailMonthShare >= 1
  ? 'stopped'
  : mailDayShare >= 0.75 || mailMonthShare >= 0.75
    ? 'watch'
    : 'calm';
const repaired = Astro.url.searchParams.get('telegram');
const repairFailure = Astro.url.searchParams.get('why');
const level = usage ? usageLevel(usage.rowsRead) : 'calm';
const share = usage ? usage.rowsRead / D1_DAILY_ROW_LIMIT : 0;

/* Every day the API returned, padded to seven so a quiet week keeps its shape. */
const peak = Math.max(D1_DAILY_ROW_LIMIT, ...(usage?.days.map((d) => d.rowsRead) ?? [0]));
const label = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' });
---

<Admin title="Traffic and health">
  {
    !usage ? (
      <div class="p-4 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)]">
        <p class="eyebrow">Not set up</p>
        <p class="mt-2 text-[14.5px] text-[var(--color-ink-soft)]">
          This page reads the database's usage from Cloudflare's analytics API, which needs a
          token. Create one in the Cloudflare dashboard under My Profile &rarr; API Tokens with
          <strong> Account Analytics: Read</strong>, then set it as a secret:
        </p>
        <pre class="mt-3 p-3 bg-[var(--color-paper)] rounded-[3px] overflow-x-auto text-[13px]"><code>npx wrangler secret put CLOUDFLARE_API_TOKEN</code></pre>
        <p class="mt-3 text-[14.5px] text-[var(--color-ink-soft)]">
          Until then everything else in the portal works as normal — this page is the only thing
          that reads it.
        </p>
      </div>
    ) : (
      <>
        <section class="mb-8">
          <div
            class:list={[
              'p-4 bg-white border rounded-[var(--radius-panel)]',
              level === 'urgent' ? 'border-[var(--color-outstock)]' : 'border-[var(--color-rule-soft)]',
            ]}
          >
            <p class="eyebrow">Rows read today</p>
            <p class="mt-2 text-[34px] font-semibold leading-none tabular-nums">
              {usage.rowsRead.toLocaleString('en-GB')}
            </p>
            <p class="mt-1.5 text-[14px] text-[var(--color-ink-soft)]">
              of {D1_DAILY_ROW_LIMIT.toLocaleString('en-GB')} a day. Resets at midnight UTC.
            </p>

            {/* The bar is the point: a number without its ceiling says nothing. */}
            <div class="mt-3 h-2 bg-[var(--color-paper)] rounded-full overflow-hidden">
              <div
                class:list={[
                  'h-full rounded-full',
                  level === 'urgent'
                    ? 'bg-[var(--color-outstock)]'
                    : level === 'watch'
                      ? 'bg-[var(--color-navy)]'
                      : 'bg-[var(--color-instock)]',
                ]}
                style={`width:${Math.min(100, share * 100).toFixed(1)}%`}
              />
            </div>

            <p class="mt-3 text-[13.5px] text-[var(--color-ink-faint)]">
              {usage.readQueries.toLocaleString('en-GB')} queries ·{' '}
              {usage.rowsWritten.toLocaleString('en-GB')} rows written
            </p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="eyebrow mb-3">The last seven days</h2>
          <div class="p-4 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)]">
            <div class="flex items-end gap-2 h-40">
              {usage.days.map((d) => (
                <div class="flex-1 flex flex-col items-center gap-1.5 min-w-0">
                  <span class="text-[11.5px] tabular-nums text-[var(--color-ink-faint)]">
                    {compact(d.rowsRead)}
                  </span>
                  <div
                    class:list={[
                      'w-full rounded-t-[2px]',
                      d.rowsRead >= D1_DAILY_ROW_LIMIT
                        ? 'bg-[var(--color-outstock)]'
                        : 'bg-[var(--color-navy)]',
                    ]}
                    style={`height:${Math.max(2, (d.rowsRead / peak) * 120)}px`}
                  />
                  <span class="text-[11.5px] text-[var(--color-ink-faint)] truncate">
                    {label(d.date)}
                  </span>
                </div>
              ))}
            </div>
            <p class="mt-3 text-[12.5px] text-[var(--color-ink-faint)]">
              A bar that reaches the top is a day the shop stopped serving.
            </p>
          </div>
        </section>
      </>
    )
  }


  {/*
    The bot, as Telegram sees it. From 31 August to 16 October every customer
    message failed on Telegram's side - the webhook pointed at an address the
    shop had started redirecting - and nothing here could tell. This asks
    Telegram directly, because that is the only place the failure shows.
  */}
  {
    botConfigured() && (
      <section class="mb-8">
        <h2 class="eyebrow mb-3">Telegram bot</h2>
        <div
          class:list={[
            'p-4 bg-white border rounded-[var(--radius-panel)] text-[14.5px]',
            bot && bot.problems.length > 0
              ? 'border-[var(--color-outstock)]'
              : 'border-[var(--color-rule-soft)]',
          ]}
        >
          {repaired === 'fixed' && (
            <p class="mb-3 text-[var(--color-instock)]">
              Reconnected. Anything waiting is being delivered now.
            </p>
          )}
          {repaired === 'failed' && (
            <p class="mb-3 text-[var(--color-outstock)]">
              Could not reconnect: {repairFailure ?? 'no reason given'}
            </p>
          )}
          {!bot ? (
            <p class="text-[var(--color-ink-soft)]">
              Telegram could not be asked just now, so this cannot say whether messages are
              arriving. That is not the same as everything being fine.
            </p>
          ) : bot.problems.length === 0 ? (
            <>
              <p class="font-semibold text-[var(--color-instock)]">Receiving messages</p>
              <p class="mt-1.5 text-[13.5px] text-[var(--color-ink-faint)]">
                Customers who press Start, message the bot or send a payment screenshot reach
                the shop. {bot.pending > 0 ? `${bot.pending} in flight.` : 'Nothing waiting.'}
              </p>
            </>
          ) : (
            <>
              <p class="font-semibold text-[var(--color-outstock)]">
                Customer messages are not reaching the shop
              </p>
              <ul class="mt-2 list-disc pl-5 space-y-1 text-[var(--color-ink-soft)]">
                {bot.problems.map((p) => <li>{p}</li>)}
              </ul>
              <p class="mt-3 text-[13.5px] text-[var(--color-ink-faint)]">
                Telegram keeps undelivered messages for a day, then throws them away.
              </p>
              <form method="post" action="/api/admin/telegram/webhook" class="mt-3">
                <button type="submit" class="btn btn-primary">
                  Reconnect the bot to the shop
                </button>
              </form>
            </>
          )}
        </div>
      </section>
    )
  }


  {/*
    Email, against Resend's free-plan allowance: 100 a day, 3,000 a month.
    Past either, every send is refused until it resets - order confirmations,
    payment details, arrival notices. The shop's key can only send, so this
    counts what the shop sent and keeps whatever Resend said on the way.
  */}
  <section class="mb-8">
    <h2 class="eyebrow mb-3">Email</h2>
    <div
      class:list={[
        'p-4 bg-white border rounded-[var(--radius-panel)] text-[14.5px]',
        mailLevel === 'stopped' ? 'border-[var(--color-outstock)]' : 'border-[var(--color-rule-soft)]',
      ]}
    >
      {emailDryRun() && (
        <p class="mb-3 text-[13.5px] text-[var(--color-ink-soft)]">
          Email is in dry-run mode here, so nothing is sent and nothing new is counted.
        </p>
      )}
      {!mail || !mailUsed ? (
        <p class="text-[var(--color-ink-soft)]">
          Email usage could not be read just now. That is not the same as everything being fine.
        </p>
      ) : (
        <>
          {mail.refused && (
            <p class="mb-3 font-semibold text-[var(--color-outstock)]">
              Email has stopped: Resend refused a send for being over the
              {mail.refused.kind === 'daily' ? ' daily ' : ' monthly '}limit. Nothing will reach
              customers until it resets{mail.refused.kind === 'daily' ? ' at 1am (midnight UTC)' : ''}.
            </p>
          )}
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              { label: 'Sent today', used: mailUsed.today, limit: RESEND_DAILY_LIMIT, share: mailDayShare, note: 'resets at midnight UTC' },
              { label: 'Sent this month', used: mailUsed.month, limit: RESEND_MONTHLY_LIMIT, share: mailMonthShare, note: 'Resend free plan' },
            ].map((row) => (
              <div>
                <p class="eyebrow">{row.label}</p>
                <p class="mt-1.5 text-[26px] font-semibold leading-none tabular-nums" data-email-used={row.used}>
                  {row.used.toLocaleString('en-GB')}
                  <span class="text-[15px] font-normal text-[var(--color-ink-faint)]"> of {row.limit.toLocaleString('en-GB')}</span>
                </p>
                <div class="mt-2 h-2 bg-[var(--color-paper)] rounded-full overflow-hidden">
                  <div
                    class:list={[
                      'h-full rounded-full',
                      row.share >= 1
                        ? 'bg-[var(--color-outstock)]'
                        : row.share >= 0.75
                          ? 'bg-[var(--color-navy)]'
                          : 'bg-[var(--color-instock)]',
                    ]}
                    style={`width:${Math.min(100, row.share * 100).toFixed(1)}%`}
                  />
                </div>
                <p class="mt-1 text-[12.5px] text-[var(--color-ink-faint)]">{row.note}</p>
              </div>
            ))}
          </div>
          {mail.refusedToday > 0 && !mail.refused && (
            <p class="mt-3 text-[13.5px] text-[var(--color-outstock)]">
              {mail.refusedToday} {mail.refusedToday === 1 ? 'email was' : 'emails were'} refused today.
            </p>
          )}
          {mailError && (
            <p class="mt-3 text-[13px] text-[var(--color-ink-soft)]">
              Last failure: <span class="font-mono break-words">{mailError}</span>
            </p>
          )}
          <p class="mt-3 text-[12.5px] text-[var(--color-ink-faint)]">
            {mailUsed.source === 'resend'
              ? "Resend's own count, which includes anything else sending from the same Resend account."
              : 'Counted by the shop as it sends. Resend\'s own figure appears here after its next send, if it reports one.'}
          </p>
        </>
      )}
    </div>
  </section>

  <section>
    <h2 class="eyebrow mb-3">Where the traffic comes from</h2>
    <div class="p-4 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] text-[14.5px] text-[var(--color-ink-soft)] space-y-3">
      <p>
        Cloudflare counts every request before it reaches the shop, including the ones that
        never run a page. That is the only place bot traffic is visible, and it is better than
        anything this page could draw, so it is a link rather than a copy.
      </p>
      <p>
        <a
          href="https://dash.cloudflare.com/?to=/:account/assubkibooks.co.uk/security/analytics"
          rel="noreferrer noopener"
          target="_blank"
          class="text-[var(--color-navy)] hover:underline underline-offset-2"
        >
          Crawlers and bot traffic &rarr;
        </a>
      </p>
      {/* Written down because it is the whole reason this page exists, and in a
          year nobody will remember why the shop kept falling over. */}
      <p class="text-[13.5px] text-[var(--color-ink-faint)]">
        On 24 and 25 September 2026 the shop went offline for an hour each day, both times
        because this allowance ran out. The cause was AI crawlers scraping for training data —
        Amazonbot, GPTBot and Meta-ExternalAgent were about 92% of all traffic, and none of them
        sends a customer. Blocking them in Cloudflare's crawler settings cut the traffic by
        roughly 85%. If these numbers start climbing again, that list is the first place to look.
      </p>
    </div>
  </section>
</Admin>
