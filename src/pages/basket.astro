---
import Base from '../layouts/Base.astro';
import Rosette from '../components/Rosette.astro';
---

<Base title="Your basket" noindex>
  <div class="mx-auto w-full max-w-[900px] py-10 md:py-14">
    <h1 class="text-center font-[family-name:var(--font-display)] text-[32px] md:text-[38px] font-semibold">
      Your basket
    </h1>

    <div id="loading" class="py-16 text-center text-[var(--color-ink-faint)]">Loading your basket…</div>

    <div id="empty" hidden class="py-16 text-center">
      <div class="grid place-items-center text-[var(--color-wash)] mb-5"><Rosette size={64} /></div>
      <h2 class="font-[family-name:var(--font-display)] text-[22px]">Nothing in the basket yet</h2>
      <p class="mt-2 text-[15px] text-[var(--color-ink-soft)]">
        Add the titles you need and send them to us as one request.
      </p>
      <a href="/catalogue" class="btn btn-primary mt-6">Browse the catalogue</a>
    </div>

    {/* Group orders: a madrasah or a class filling one basket between them, so
        the shop receives one request for one address instead of a dozen
        messages asking to be posted together. */}
    <section id="grouppanel" hidden class="mt-6 mb-8 p-5 bg-white border border-[var(--color-rule)] rounded-[3px]">
      <label class="flex items-start gap-2.5 cursor-pointer">
        <input type="checkbox" id="groupon" class="w-4 h-4 mt-0.5 accent-[var(--color-navy)]" />
        <span>
          <span class="block text-[15px] font-medium">Group order</span>
          <span class="block mt-0.5 text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed">
            Several people adding to one basket, sent as a single request to one address.
          </span>
        </span>
      </label>

      <div id="groupchoice" hidden class="mt-4 pt-4 border-t border-[var(--color-rule)]">
        <label for="groupname" class="block text-[14px] font-medium mb-1.5">Your name</label>
        <input id="groupname" maxlength="40" placeholder="e.g. Yusuf" class="field !w-56" />
        <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
          Shown beside the books you add, so the organiser knows whose is whose.
        </p>

        {/* Only asked of whoever starts the group: it is how they get back to
            it. Anyone joining needs a name and nothing else. */}
        <div id="groupemailwrap" class="mt-4">
          <label for="groupemail" class="block text-[14px] font-medium mb-1.5">
            Your email <span class="text-[var(--color-ink-faint)] font-normal">(to start a group)</span>
          </label>
          <input id="groupemail" type="email" maxlength="254" autocomplete="email" class="field !w-72" />
          <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
            We send you the link that sends the order. Keep it - it is how you get back in if you
            lose this page or carry on from your phone.
          </p>
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" id="groupcreate" class="btn btn-primary">Create a group</button>
          <button type="button" id="groupjoinopen" class="btn btn-ghost">Join with a link</button>
        </div>

        <div id="groupjoin" hidden class="mt-4">
          <label for="grouplink" class="block text-[14px] font-medium mb-1.5">Paste the link</label>
          <div class="flex gap-2">
            <input id="grouplink" class="field flex-1 min-w-0" placeholder="https://…/basket?g=GRP-…" />
            <button type="button" id="groupgo" class="btn btn-ghost !px-4 shrink-0" aria-label="Open that group basket">→</button>
          </div>
        </div>

        <p id="grouperror" role="alert" hidden class="mt-3 text-[13.5px] text-[var(--color-outstock)]"></p>
      </div>

      <div id="groupactive" hidden class="mt-4 pt-4 border-t border-[var(--color-rule)]">
        <p class="text-[14.5px]">
          <span id="grouprole" class="font-medium"></span>
          <span id="groupcode" class="text-[var(--color-ink-faint)] tabular-nums"></span>
        </p>
        <label for="groupshare" class="block mt-3 text-[14px] font-medium mb-1.5">Share this link</label>
        <div class="flex gap-2">
          <input id="groupshare" readonly class="field flex-1 min-w-0 text-[13.5px]" />
          <button type="button" id="groupcopy" class="btn btn-ghost !px-4 shrink-0" aria-label="Copy the link">Copy</button>
        </div>
        <p class="mt-3 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
          Anyone with this link can add to the basket. It lasts a week.
        </p>
        <p id="groupkeep" hidden class="mt-2 text-[13px] text-[var(--color-ink-faint)] leading-relaxed">
          Your own link - the one that sends the order - is in your email. This page is that link;
          the one above is not, so sharing it hands out nothing you would rather keep.
        </p>
        <button type="button" id="groupleave" class="mt-3 text-[13.5px] text-[var(--color-ink-faint)] hover:text-[var(--color-outstock)] underline underline-offset-2">
          Leave this group
        </button>
      </div>
    </section>

    <div id="basket" hidden>
      <div class="bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] overflow-hidden">
        <ul id="rows" class="divide-y divide-[var(--color-rule-faint)]"></ul>
      </div>

      <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4 text-[14.5px]">
          <a href="/catalogue" class="text-[var(--color-navy)] hover:underline underline-offset-2">Keep browsing</a>
          <button
            type="button"
            id="groupstart2"
            class="text-[var(--color-navy)] hover:underline underline-offset-2"
          >Start a group order</button>
        </div>
        <p class="text-[15px] text-[var(--color-ink-soft)] sm:ml-auto">
          Subtotal <span id="subtotal" class="price text-[24px] ml-2"></span>
        </p>
        <a href="/checkout" id="tocheckout" class="btn btn-primary !py-3 !px-6">Continue to request →</a>
        {/* One person owns the address and the conversation with the shop, so
            only they can send it. */}
        <p id="organiserwill" hidden class="text-[14px] text-[var(--color-ink-soft)] max-w-xs">
          <span id="organisername"></span> will send this to the shop once everyone has added.
        </p>
      </div>

      <p class="mt-4 text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed max-w-lg">
        Postage is not included above - we confirm the full total when we reply. Nothing is charged
        on this website.
      </p>
    </div>
  </div>

  <script>
    import { read, setQty, remove, setBadge, count } from '../scripts/basket.ts';
    import { readGroup, joinGroup, leaveGroup, shareLink, parseShare } from '../scripts/group.ts';
    import { IMAGE_VERSION } from '../lib/image-presets.ts';

    const gbp = (p: number) => `£${(p / 100).toFixed(2)}`;
    const el = <T extends HTMLElement>(id: string) => document.querySelector<T>(id)!;

    // ------------------------------------------------------------------
    // The group basket
    // ------------------------------------------------------------------

    type GroupLine = {
      bookId: number; slug: string; title: string; titleAr: string | null;
      pricePence: number; available: number; imageKey: string | null;
      qty: number; addedBy: string;
    };
    type GroupView = {
      code: string; organiser: string; expiresAt: number; orderRef: string | null;
      lines: GroupLine[]; subtotalPence: number; people: string[];
      role: 'organiser' | 'member'; shareToken?: string;
    };

    let member = readGroup();
    let poll: ReturnType<typeof setInterval> | null = null;

    const groupError = (words: string) => {
      const box = el<HTMLParagraphElement>('#grouperror');
      box.textContent = words;
      box.hidden = !words;
    };

    function paintGroupPanel() {
      el('#grouppanel').hidden = false;
      const on = el<HTMLInputElement>('#groupon');

      // Being in a group ticks the box; not being in one says nothing about
      // whether they have just ticked it themselves. Assigning `false` here
      // unticked the box on the very render their tick triggered, so the
      // choices never appeared and the option looked dead.
      if (member) on.checked = true;

      el('#groupchoice').hidden = Boolean(member) || !on.checked;
      el('#groupactive').hidden = !member;

      if (member) {
        el('#grouprole').textContent = member.organiser
          ? 'You started this group.'
          : 'You are adding to this group basket.';
        el('#groupcode').textContent = ` ${member.code}`;
        el<HTMLInputElement>('#groupshare').value = shareLink(member);
        // Only the organiser has a second link, and only they need telling to
        // keep it: it is the one that sends the order.
        el('#groupkeep').hidden = !member.organiser;
      }
    }

    async function fetchGroup(): Promise<GroupView | null> {
      if (!member) return null;
      try {
        const res = await fetch(
          `/api/group?g=${encodeURIComponent(member.code)}&k=${encodeURIComponent(member.token)}`,
        );
        const data = await res.json();
        if (!res.ok || !data.ok) {
          // Expired or sent: stop pretending this is still a shared basket.
          leaveGroup();
          member = null;
          groupError(data?.error ?? 'That group basket is no longer available.');
          return null;
        }
        const group = data.group as GroupView;

        // The key decides the role, not this browser: an organiser opening
        // their emailed link on a new phone is the organiser again.
        if (member) {
          const organiser = group.role === 'organiser';
          if (organiser !== member.organiser || group.shareToken !== member.shareToken) {
            member = { ...member, organiser, shareToken: group.shareToken };
            joinGroup(member);
          }
        }
        return group;
      } catch {
        return null; // offline: leave the page exactly as it is
      }
    }

    /** One person's line, editable only by them - everyone else's is read-only. */
    function groupRow(line: GroupLine, mine: boolean, wantedByAll: number): string {
      // Short against what the *group* asked for, not against this one line: two
      // people each wanting the last two copies is a shortfall neither line
      // shows on its own.
      const overrun = wantedByAll > line.available;
      return `
        <li class="grid grid-cols-[4rem_minmax(0,1fr)] gap-x-4 gap-y-3 py-4 items-start sm:flex sm:gap-4">
          <a href="/book/${line.slug}" class="shrink-0 w-16 h-20 bg-white border border-[var(--color-rule)] rounded-[3px] grid place-items-center overflow-hidden">
            ${line.imageKey ? `<img src="/img/${line.imageKey}?p=card&v=${IMAGE_VERSION}" alt="" class="max-h-full max-w-full object-contain p-1">` : ''}
          </a>
          <div class="flex-1 min-w-0">
            <a href="/book/${line.slug}" class="font-[family-name:var(--font-display)] text-[16.5px] hover:text-[var(--color-navy)]">${line.title}</a>
            <p class="price text-[15px] mt-1">${gbp(line.pricePence)}</p>
            <p class="mt-1 text-[13px] text-[var(--color-ink-faint)]">Added by ${line.addedBy}${mine ? ' (you)' : ''}</p>
            ${
              line.available <= 0
                ? `<p class="mt-1 text-[13px] text-[var(--color-outstock)]">Out of stock - it will not be included</p>`
                : overrun
                  ? `<p class="mt-1 text-[13px] text-[var(--color-outstock)]">Only ${line.available} available, and the group has asked for ${wantedByAll}</p>`
                  : ''
            }
          </div>
          <div class="col-start-2 flex items-center gap-4 justify-start sm:ml-auto sm:shrink-0">
            ${
              mine
                ? `<label class="sr-only" for="g${line.bookId}">Quantity for ${line.title}</label>
                   <input id="g${line.bookId}" type="number" min="0" max="${Math.max(line.available, 0)}" value="${line.qty}"
                          class="field !w-16 !py-1.5 tabular-nums" data-group-id="${line.bookId}">`
                : `<span class="text-[15px] tabular-nums text-[var(--color-ink-soft)]">×${line.qty}</span>`
            }
          </div>
        </li>`;
    }

    async function setGroupQty(bookId: number, qty: number) {
      if (!member) return;
      const res = await fetch('/api/group/line', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: member.code, token: member.token, name: member.name, bookId, qty }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        groupError(data?.error ?? 'That did not save.');
      }
      await render();
    }

    async function renderGroup(): Promise<boolean> {
      const view = await fetchGroup();
      if (!view) return false;

      const wantedByAll = new Map<number, number>();
      for (const line of view.lines) {
        wantedByAll.set(line.bookId, (wantedByAll.get(line.bookId) ?? 0) + line.qty);
      }

      const rows = el<HTMLUListElement>('#rows');
      rows.innerHTML = view.lines.length
        ? view.lines
            .map((line) =>
              groupRow(line, line.addedBy === member!.name, wantedByAll.get(line.bookId) ?? line.qty),
            )
            .join('')
        : `<li class="py-8 text-center text-[14.5px] text-[var(--color-ink-faint)]">
             Nothing in the group basket yet. Add books from the catalogue and they will appear here for everyone.
           </li>`;

      // The badge counts what this reader put in, not the whole group's pile.
      setBadge(view.lines.filter((l) => l.addedBy === member!.name).reduce((n, l) => n + l.qty, 0));

      el('#subtotal').textContent = gbp(view.subtotalPence);
      el('#basket').hidden = false;
      el('#empty').hidden = true;
      el('#loading').hidden = true;

      // Only the organiser can send it: they own the address and the
      // conversation with the shop.
      el('#tocheckout').hidden = !member!.organiser;
      el('#organiserwill').hidden = member!.organiser;
      el('#organisername').textContent = view.organiser;

      for (const input of rows.querySelectorAll<HTMLInputElement>('input[data-group-id]')) {
        input.addEventListener('change', () => {
          setGroupQty(Number(input.dataset.groupId), Math.max(0, Number(input.value) || 0));
        });
      }
      return true;
    }

    // ------------------------------------------------------------------

    async function render() {
      paintGroupPanel();
      if (member && (await renderGroup())) return;

      setBadge(null); // back to counting this browser's own basket
      const basket = read();
      const ids = Object.keys(basket);
      const loading = document.querySelector<HTMLElement>('#loading')!;
      const empty = document.querySelector<HTMLElement>('#empty')!;
      const wrap = document.querySelector<HTMLElement>('#basket')!;

      if (!ids.length) {
        loading.hidden = true;
        wrap.hidden = true;
        empty.hidden = false;
        return;
      }

      const res = await fetch(`/api/basket?ids=${ids.join(',')}`);
      const { books } = (await res.json()) as {
        books: {
          id: number; slug: string; title: string; titleAr: string | null;
          pricePence: number; available: number; imageKey: string | null;
        }[];
      };

      loading.hidden = true;

      // A book pulled from the catalogue since it was added is dropped rather
      // than shown as a broken row.
      const live = books.filter((b) => basket[String(b.id)]);
      if (!live.length) {
        wrap.hidden = true;
        empty.hidden = false;
        return;
      }

      const rows = document.querySelector<HTMLUListElement>('#rows')!;
      rows.innerHTML = '';
      let subtotal = 0;

      for (const book of live) {
        const qty = Math.min(basket[String(book.id)], Math.max(book.available, 0));
        const overrun = basket[String(book.id)] > book.available;
        subtotal += book.pricePence * qty;

        const li = document.createElement('li');
        li.className = 'grid grid-cols-[4rem_minmax(0,1fr)] gap-x-4 gap-y-3 px-4 py-4 items-start sm:flex sm:gap-4 sm:items-center';
        li.innerHTML = `
          <a href="/book/${book.slug}" class="shrink-0 w-16 h-20 bg-white border border-[var(--color-rule)] rounded-[3px] grid place-items-center overflow-hidden">
            ${book.imageKey ? `<img src="/img/${book.imageKey}?p=card&v=${IMAGE_VERSION}" alt="" class="max-h-full max-w-full object-contain p-1">` : ''}
          </a>
          <div class="flex-1 min-w-0">
            <a href="/book/${book.slug}" class="font-[family-name:var(--font-display)] text-[16.5px] hover:text-[var(--color-navy)]">${book.title}</a>
            ${book.titleAr ? `<p class="ar text-[14.5px] text-[var(--color-ink-soft)]">${book.titleAr}</p>` : ''}
            <p class="price text-[15px] mt-1">${gbp(book.pricePence)}</p>
            ${
              book.available <= 0
                ? `<p class="mt-1 text-[13px] text-[var(--color-outstock)]">Out of stock - removed from your request</p>`
                : overrun
                  ? `<p class="mt-1 text-[13px] text-[var(--color-outstock)]">Only ${book.available} available - quantity reduced</p>`
                  : ''
            }
          </div>
          <div class="col-start-2 flex items-center justify-between gap-3 sm:ml-auto sm:shrink-0">
            <label class="sr-only" for="q${book.id}">Quantity for ${book.title}</label>
            <input id="q${book.id}" type="number" min="0" max="${Math.max(book.available, 0)}" value="${qty}"
                   class="field !w-16 !py-1.5 tabular-nums" data-id="${book.id}">
            <button type="button" class="text-[13.5px] text-[var(--color-ink-faint)] hover:text-[var(--color-outstock)] underline underline-offset-2" data-remove="${book.id}">Remove</button>
          </div>`;
        rows.appendChild(li);

        if (qty !== basket[String(book.id)]) setQty(book.id, qty);
      }

      document.querySelector<HTMLElement>('#subtotal')!.textContent = gbp(subtotal);
      wrap.hidden = false;
      empty.hidden = true;

      for (const input of rows.querySelectorAll<HTMLInputElement>('input[data-id]')) {
        input.addEventListener('change', () => {
          setQty(Number(input.dataset.id), Math.max(0, Number(input.value) || 0));
          render();
        });
      }
      for (const btn of rows.querySelectorAll<HTMLButtonElement>('button[data-remove]')) {
        btn.addEventListener('click', () => {
          remove(Number(btn.dataset.remove));
          render();
        });
      }
    }

    // ------------------------------------------------------------------
    // Wiring
    // ------------------------------------------------------------------

    /*
     * The footer's "Start a group order" is a way in to the panel that already
     * exists, not a second mechanism - it ticks the same checkbox and scrolls
     * to it, so there is one flow and one place the state lives.
     */
    el('#groupstart2')?.addEventListener('click', () => {
      const panel = el('#grouppanel');
      panel.hidden = false;
      const on = el<HTMLInputElement>('#groupon');
      if (!on.checked) {
        on.checked = true;
        on.dispatchEvent(new Event('change'));
      }
      panel.scrollIntoView({ block: 'center', behavior: 'smooth' });
      el<HTMLInputElement>('#groupname')?.focus({ preventScroll: true });
    });

    el('#groupon').addEventListener('change', () => {
      const on = el<HTMLInputElement>('#groupon').checked;
      if (!on && member) {
        leaveGroup();
        member = null;
      }
      groupError('');
      render();
    });

    el('#groupjoinopen').addEventListener('click', () => {
      el('#groupjoin').hidden = !el('#groupjoin').hidden;
    });

    el('#groupcreate').addEventListener('click', async () => {
      const name = el<HTMLInputElement>('#groupname').value.trim();
      const email = el<HTMLInputElement>('#groupemail').value.trim();
      if (name.length < 2) return groupError('Add your name first, so the others know whose list it is.');

      const res = await fetch('/api/group', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) return groupError(data?.error ?? 'Could not start a group just now.');

      // This browser holds the organiser's key; the shared one is kept beside
      // it so the copy box never hands out the wrong link.
      member = {
        code: data.code,
        token: data.ownerToken,
        shareToken: data.token,
        name,
        organiser: true,
      };
      joinGroup(member);
      if (!data.emailed) {
        groupError('We could not email your link just now - keep this page, or copy your own link from the address bar.');
      }

      // Whatever they had already chosen becomes their share of the group.
      const existing = read();
      for (const [id, qty] of Object.entries(existing)) {
        await setGroupQty(Number(id), qty);
      }
      groupError('');
      render();
    });

    const join = async (raw: string, name: string) => {
      const parsed = parseShare(raw);
      if (!parsed) return groupError('That does not look like a group link.');
      if (name.length < 2) return groupError('Add your name first, so the others know whose books are whose.');

      member = { ...parsed, name, organiser: false };
      const view = await fetchGroup();
      if (!view) return;
      // fetchGroup has already promoted us if that key was the organiser's -
      // which is what makes an emailed link work on a phone that has never
      // seen this basket.

      joinGroup(member);
      groupError('');
      render();
    };

    el('#groupgo').addEventListener('click', () => {
      join(el<HTMLInputElement>('#grouplink').value, el<HTMLInputElement>('#groupname').value.trim());
    });

    el('#groupcopy').addEventListener('click', async () => {
      const field = el<HTMLInputElement>('#groupshare');
      try {
        await navigator.clipboard.writeText(field.value);
      } catch {
        field.select(); // clipboard blocked: at least hand them the selection
      }
      const button = el('#groupcopy');
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });

    el('#groupleave').addEventListener('click', () => {
      leaveGroup();
      member = null;
      render();
    });

    /*
     * Someone else's addition only exists on the server, so the page has to ask.
     * Modestly: five seconds while the tab is being looked at, nothing at all
     * while it is not - a basket left open on a laptop overnight should not
     * spend the night talking to the shop.
     */
    const startPolling = () => {
      if (poll || !member) return;
      poll = setInterval(() => {
        if (document.visibilityState === 'visible' && member) render();
      }, 5000);
    };
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') render();
    });

    // A shared link puts you straight into the group, once you say who you are.
    const params = new URLSearchParams(location.search);
    const invitedCode = params.get('g');
    const invitedToken = params.get('k');

    (async () => {
      await render();
      if (invitedCode && invitedToken && (!member || member.code !== invitedCode)) {
        el('#grouppanel').hidden = false;
        el<HTMLInputElement>('#groupon').checked = true;
        el('#groupchoice').hidden = false;
        el('#groupjoin').hidden = false;
        el<HTMLInputElement>('#grouplink').value = shareLink({ code: invitedCode, token: invitedToken });
        groupError('Add your name, then press the arrow to join this basket.');
      }
      startPolling();
    })();
  </script>
</Base>
