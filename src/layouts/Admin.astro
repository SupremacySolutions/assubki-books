---
import '../styles/global.css';
import Rosette from '../components/Rosette.astro';

interface Props {
  title: string;
  /** Shown under the heading - counts, status, context. */
  sub?: string;
  back?: { href: string; label: string };
  showHeading?: boolean;
}
const { title, sub, back, showHeading = true } = Astro.props;
const admin = Astro.locals.admin;
const path = Astro.url.pathname;

/*
 * The five the owner opens all day, and the rest behind one disclosure.
 *
 * Ten tabs in one row had outgrown the bar: on a phone the last of them sat
 * behind a horizontal scroll, which is a poor place to keep Settings. Split by
 * how often a page is wanted rather than by what it is about - Shelves and
 * Sales are set up once and left, Health and Settings are opened when
 * something is wrong or changing.
 */
const NAV = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/orders', label: 'Orders' },
  { href: '/admin/books', label: 'Listings' },
  { href: '/admin/shipments', label: 'Shipments' },
  { href: '/admin/preorders', label: 'Pre-orders' },
];

const MORE = [
  { href: '/admin/shelves', label: 'Shelves' },
  { href: '/admin/sales', label: 'Sales' },
  { href: '/admin/requests', label: 'Requests' },
  /* A month of invoices at once, for the books. Each order still has its own
     invoice on its page; this is where they add up. */
  { href: '/admin/invoices', label: 'Invoices' },
  /* Plumbing, not the shop: how much of the database's daily allowance has
     gone, and where the traffic came from. Deliberately not called Analytics -
     `/admin/dashboard` is what happened last time two pages here sounded like
     they showed the same numbers. */
  { href: '/admin/health', label: 'Health' },
  { href: '/admin/settings', label: 'Settings' },
];

const active = (href: string) =>
  href === '/admin' ? path === '/admin' : path.startsWith(href);

/* The menu names the page you are on rather than saying "More" over the top of
   it, so a hidden tab still tells you where you are. */
const openHere = MORE.find((item) => active(item.href)) ?? null;
import { maintenanceNotice } from '../lib/maintenance';
const closed = await maintenanceNotice();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - As-Subkī Books portal</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline nonce={Astro.locals.cspNonce}>
      try {
        if (sessionStorage.getItem('asb-internal-navigation') === '1') {
          document.documentElement.classList.add('skip-splash');
          sessionStorage.removeItem('asb-internal-navigation');
        }
      } catch { /* Private browsing can disable session storage. */ }
    </script>
  </head>

  <body class="min-h-screen bg-[var(--color-paper)]">
    <script is:inline nonce={Astro.locals.cspNonce}>
      document.documentElement.classList.add('js');
    </script>
    {/* The shop has had one of these for a long time; the portal, which is
        mostly long forms behind a two-row header, needs it more. */}
    <a href="#main" class="skip">Skip to main content</a>
    <div id="pageTransition" class="page-transition is-loading" aria-hidden="true">
      <div class="page-transition-mark"><Rosette size={34} />As-Subki Books</div>
    </div>
    <header class="bg-[var(--color-navy-deep)] text-white">
      <div class="mx-auto max-w-[var(--width-portal)] px-5 md:px-8">
        <div class="flex items-center gap-3 py-3">
          <span class="text-[var(--color-wash)]"><Rosette size={24} /></span>
          <span class="font-[family-name:var(--font-display)] text-[16px] font-semibold">
            Shop portal
          </span>
          <span class="ml-auto text-[13px] text-[var(--color-wash)]/70 truncate max-w-[45%]">
            {admin?.via === 'password' ? 'Owner workspace' : admin?.email}
          </span>
          <a href="/" class="shrink-0 py-1 text-[13px] text-[var(--color-wash)] hover:text-white underline underline-offset-2 transition-colors">
            View shop
          </a>
        </div>
        {/*
          * Two parts: a strip of tabs that scrolls, and "More" pinned beside it.
          *
          * The tabs used to sit in a plain row with nothing to contain them.
          * On a phone they need about 540px and the row has 350, so they spilled
          * out and stretched the whole page: the browser widened the viewport to
          * fit, the portal slid sideways, and the navy header stopped short of
          * the white page beside it. The strip now scrolls on its own and the
          * page stays the width of the phone.
          *
          * "More" is outside the strip on purpose. A scroll container clips
          * whatever hangs out of it, so a menu opened from inside the strip
          * would be cut off at its bottom edge - which is the whole menu.
          */}
        <nav class="flex items-end -mb-px -mx-5 md:mx-0" aria-label="Portal">
          <div
            data-portal-tabs
            class="scroll-hint flex items-end gap-1 min-w-0 flex-1 md:flex-initial overflow-x-auto overscroll-x-contain pl-5 md:pl-0"
          >
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={active(item.href) ? 'page' : undefined}
                  class:list={[
                    'shrink-0 px-3.5 py-2.5 text-[14.5px] whitespace-nowrap border-b-2 transition-colors duration-200',
                    active(item.href)
                      ? 'border-[var(--color-wash)] text-white font-medium'
                      : 'border-transparent text-[var(--color-wash)]/70 hover:text-white hover:border-[var(--color-wash)]/35',
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </div>


          {/*
            * A disclosure, not a scripted menu: it opens with the keyboard,
            * works with scripting off, and closes itself when the link inside
            * it loads the next page.
            */}
          <details class="portal-more group relative shrink-0 pr-5 md:pr-0" name="portal-more" data-menu>
            <summary
              class:list={[
                'cursor-pointer list-none select-none px-3.5 py-2.5 text-[14.5px] whitespace-nowrap border-b-2 transition-colors duration-200 [&::-webkit-details-marker]:hidden',
                openHere
                  ? 'border-[var(--color-wash)] text-white font-medium'
                  : 'border-transparent text-[var(--color-wash)]/70 hover:text-white hover:border-[var(--color-wash)]/35 group-open:text-white',
              ]}
            >
              {openHere ? openHere.label : 'More'}
              <span aria-hidden="true" class="ml-1 inline-block text-[11px] transition-transform duration-200 group-open:rotate-180">&#9662;</span>
              <span class="sr-only">{openHere ? ' - more portal pages' : 'portal pages'}</span>
            </summary>
            {/* Hung from the right edge rather than the left. "More" is the last
                thing on the bar, so a menu opening rightwards from it ran off
                the side of a phone and widened the page by itself. */}
            <div class="portal-menu absolute right-5 md:right-0 top-full z-30 mt-1 min-w-[11rem] rounded-[var(--radius-panel)] border border-[var(--color-rule-soft)] bg-white py-1 shadow-lg">
              {MORE.map((item) => (
                <a
                  href={item.href}
                  aria-current={active(item.href) ? 'page' : undefined}
                  class:list={[
                    'block px-4 py-2.5 md:py-2 text-[14.5px] whitespace-nowrap transition-colors',
                    active(item.href)
                      ? 'font-medium text-[var(--color-navy)] bg-[var(--color-paper)]'
                      : 'text-[var(--color-ink)] hover:bg-[var(--color-paper)] hover:text-[var(--color-navy)]',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </nav>

        {/*
          * Brings the open tab into view.
          *
          * Every tab is a page load, and a fresh page starts scrolled to the
          * left - so choosing Shipments or Pre-orders on a phone left the tab
          * you had just chosen off the edge, and you had to scroll the bar to
          * find where you were.
          *
          * After the nav rather than inside it, and that placement is the fix
          * for the first attempt: run straight after the strip, it measured
          * the strip before "More" had been read, when the strip still had the
          * whole width to itself - so it centred against a box 100px wider than
          * the one that was left once "More" arrived, and the tab ended up
          * clipped behind it. Measured with getBoundingClientRect against the
          * strip's own visible box, so nothing depends on which ancestor is
          * positioned; and again once the fonts are in, because the portal's
          * typeface is wider than the fallback it is measured in first.
          */}
        <script is:inline nonce={Astro.locals.cspNonce}>
          (() => {
            const strip = document.querySelector('[data-portal-tabs]');
            const here = strip?.querySelector('[aria-current="page"]');
            if (!strip || !here) return;
            const centre = () => {
              if (strip.scrollWidth <= strip.clientWidth) return;
              const box = strip.getBoundingClientRect();
              const tab = here.getBoundingClientRect();
              strip.scrollLeft += (tab.left + tab.width / 2) - (box.left + box.width / 2);
            };
            centre();
            document.fonts?.ready.then(centre);
          })();
        </script>
      </div>
    </header>

    {
      closed && (
        <p class="bg-[var(--color-outstock)] text-white text-[13.5px] px-5 md:px-8 py-2 text-center">
          The shop is closed to customers.{' '}
          <a href="/admin/settings?s=maintenance" class="underline underline-offset-2">Open it again</a>
        </p>
      )
    }
    <main id="main" class="page-enter mx-auto max-w-[var(--width-portal)] px-5 md:px-8 py-8">
      {
        back && (
          <a
            href={back.href}
            class="group inline-flex items-center gap-1.5 mb-4 py-1 text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2"
          >
            <span aria-hidden="true" class="transition-transform duration-200 group-hover:-translate-x-0.5">←</span>
            {back.label}
          </a>
        )
      }
      {
        showHeading && (
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-6">
            <h1 class="font-[family-name:var(--font-display)] text-[30px] md:text-[34px] font-semibold">
              {title}
            </h1>
            {sub && <p class="text-[15px] text-[var(--color-ink-faint)]">{sub}</p>}
          </div>
        )
      }

      <slot />
    </main>
    <script>
      import '../scripts/reveal.ts';
      import '../scripts/page-transition.ts';
      import '../scripts/form-controls.ts';
      import '../scripts/scroll-hint.ts';
      import '../scripts/menus.ts';
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-navy);
        color: #fff;
        padding: 0.75rem 1.25rem;
      }
      .skip:focus {
        left: 0;
      }
      /* The menu drops in rather than appearing, from the corner it hangs off. */
      .portal-more[open] .portal-menu {
        animation: portal-menu-in 0.16s cubic-bezier(0.22, 1, 0.36, 1);
        transform-origin: top right;
      }
      @keyframes portal-menu-in {
        from {
          opacity: 0;
          transform: translateY(-4px) scale(0.98);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .portal-more[open] .portal-menu { animation: none; }
      }
    </style>
  </body>
</html>
