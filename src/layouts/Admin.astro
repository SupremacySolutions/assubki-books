---
import '../styles/global.css';
import Rosette from '../components/Rosette.astro';

interface Props {
  title: string;
  /** Shown under the heading - counts, status, context. */
  sub?: string;
  back?: { href: string; label: string };
  showHeading?: boolean;
}
const { title, sub, back, showHeading = true } = Astro.props;
const admin = Astro.locals.admin;
const path = Astro.url.pathname;

const NAV = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/orders', label: 'Orders' },
  { href: '/admin/books', label: 'Listings' },
  { href: '/admin/shelves', label: 'Shelves' },
  { href: '/admin/sales', label: 'Sales' },
  { href: '/admin/settings', label: 'Settings' },
];

const active = (href: string) =>
  href === '/admin' ? path === '/admin' : path.startsWith(href);
import { maintenanceNotice } from '../lib/maintenance';
const closed = await maintenanceNotice();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - As-Subkī Books portal</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline nonce={Astro.locals.cspNonce}>
      try {
        if (sessionStorage.getItem('asb-internal-navigation') === '1') {
          document.documentElement.classList.add('skip-splash');
          sessionStorage.removeItem('asb-internal-navigation');
        }
      } catch { /* Private browsing can disable session storage. */ }
    </script>
  </head>

  <body class="min-h-screen bg-[var(--color-paper)]">
    <script is:inline nonce={Astro.locals.cspNonce}>
      document.documentElement.classList.add('js');
    </script>
    <div id="pageTransition" class="page-transition is-loading" aria-hidden="true">
      <div class="page-transition-mark"><Rosette size={34} />As-Subki Books</div>
    </div>
    <header class="bg-[var(--color-navy-deep)] text-white">
      <div class="mx-auto max-w-[var(--width-portal)] px-5 md:px-8">
        <div class="flex items-center gap-3 py-3">
          <span class="text-[var(--color-wash)]"><Rosette size={24} /></span>
          <span class="font-[family-name:var(--font-display)] text-[16px] font-semibold">
            Shop portal
          </span>
          <span class="ml-auto text-[13px] text-[var(--color-wash)]/70 truncate max-w-[45%]">
            {admin?.via === 'password' ? 'Owner workspace' : admin?.email}
          </span>
          <a href="/" class="text-[13px] text-[var(--color-wash)] hover:text-white underline underline-offset-2">
            View shop
          </a>
        </div>
        <nav class="flex gap-1 -mb-px overflow-x-auto" aria-label="Portal">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'px-3.5 py-2.5 text-[14.5px] whitespace-nowrap border-b-2 transition-colors',
                  active(item.href)
                    ? 'border-[var(--color-wash)] text-white font-medium'
                    : 'border-transparent text-[var(--color-wash)]/70 hover:text-white',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    {
      closed && (
        <p class="bg-[var(--color-outstock)] text-white text-[13.5px] px-5 md:px-8 py-2 text-center">
          The shop is closed to customers.{' '}
          <a href="/admin/settings?s=maintenance" class="underline underline-offset-2">Open it again</a>
        </p>
      )
    }
    <main class="page-enter mx-auto max-w-[var(--width-portal)] px-5 md:px-8 py-8">
      {
        back && (
          <a
            href={back.href}
            class="inline-block mb-4 text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2"
          >
            ← {back.label}
          </a>
        )
      }
      {
        showHeading && (
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-6">
            <h1 class="font-[family-name:var(--font-display)] text-[30px] md:text-[34px] font-semibold">
              {title}
            </h1>
            {sub && <p class="text-[15px] text-[var(--color-ink-faint)]">{sub}</p>}
          </div>
        )
      }

      <slot />
    </main>
    <script>
      import '../scripts/reveal.ts';
      import '../scripts/page-transition.ts';
      import '../scripts/form-controls.ts';
    </script>
  </body>
</html>
