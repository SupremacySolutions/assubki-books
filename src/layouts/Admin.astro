---
import '../styles/global.css';
import Rosette from '../components/Rosette.astro';

interface Props {
  title: string;
  /** Shown under the heading - counts, status, context. */
  sub?: string;
  back?: { href: string; label: string };
  showHeading?: boolean;
}
const { title, sub, back, showHeading = true } = Astro.props;
const admin = Astro.locals.admin;
const path = Astro.url.pathname;

/*
 * The five the owner opens all day, and the rest behind one disclosure.
 *
 * Ten tabs in one row had outgrown the bar: on a phone the last of them sat
 * behind a horizontal scroll, which is a poor place to keep Settings. Split by
 * how often a page is wanted rather than by what it is about - Shelves and
 * Sales are set up once and left, Health and Settings are opened when
 * something is wrong or changing.
 */
const NAV = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/orders', label: 'Orders' },
  { href: '/admin/books', label: 'Listings' },
  { href: '/admin/shipments', label: 'Shipments' },
  { href: '/admin/preorders', label: 'Pre-orders' },
];

const MORE = [
  { href: '/admin/shelves', label: 'Shelves' },
  { href: '/admin/sales', label: 'Sales' },
  { href: '/admin/requests', label: 'Requests' },
  /* Plumbing, not the shop: how much of the database's daily allowance has
     gone, and where the traffic came from. Deliberately not called Analytics -
     `/admin/dashboard` is what happened last time two pages here sounded like
     they showed the same numbers. */
  { href: '/admin/health', label: 'Health' },
  { href: '/admin/settings', label: 'Settings' },
];

const active = (href: string) =>
  href === '/admin' ? path === '/admin' : path.startsWith(href);

/* The menu names the page you are on rather than saying "More" over the top of
   it, so a hidden tab still tells you where you are. */
const openHere = MORE.find((item) => active(item.href)) ?? null;
import { maintenanceNotice } from '../lib/maintenance';
const closed = await maintenanceNotice();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - As-Subkī Books portal</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline nonce={Astro.locals.cspNonce}>
      try {
        if (sessionStorage.getItem('asb-internal-navigation') === '1') {
          document.documentElement.classList.add('skip-splash');
          sessionStorage.removeItem('asb-internal-navigation');
        }
      } catch { /* Private browsing can disable session storage. */ }
    </script>
  </head>

  <body class="min-h-screen bg-[var(--color-paper)]">
    <script is:inline nonce={Astro.locals.cspNonce}>
      document.documentElement.classList.add('js');
    </script>
    <div id="pageTransition" class="page-transition is-loading" aria-hidden="true">
      <div class="page-transition-mark"><Rosette size={34} />As-Subki Books</div>
    </div>
    <header class="bg-[var(--color-navy-deep)] text-white">
      <div class="mx-auto max-w-[var(--width-portal)] px-5 md:px-8">
        <div class="flex items-center gap-3 py-3">
          <span class="text-[var(--color-wash)]"><Rosette size={24} /></span>
          <span class="font-[family-name:var(--font-display)] text-[16px] font-semibold">
            Shop portal
          </span>
          <span class="ml-auto text-[13px] text-[var(--color-wash)]/70 truncate max-w-[45%]">
            {admin?.via === 'password' ? 'Owner workspace' : admin?.email}
          </span>
          <a href="/" class="text-[13px] text-[var(--color-wash)] hover:text-white underline underline-offset-2">
            View shop
          </a>
        </div>
        <nav class="flex items-end gap-1 -mb-px" aria-label="Portal">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'px-3.5 py-2.5 text-[14.5px] whitespace-nowrap border-b-2 transition-colors',
                  active(item.href)
                    ? 'border-[var(--color-wash)] text-white font-medium'
                    : 'border-transparent text-[var(--color-wash)]/70 hover:text-white',
                ]}
              >
                {item.label}
              </a>
            ))
          }

          {/*
            * A disclosure, not a scripted menu: it opens with the keyboard,
            * works with scripting off, and closes itself when the link inside
            * it loads the next page.
            */}
          <details class="relative shrink-0" name="portal-more">
            <summary
              class:list={[
                'cursor-pointer list-none select-none px-3.5 py-2.5 text-[14.5px] whitespace-nowrap border-b-2 transition-colors',
                openHere
                  ? 'border-[var(--color-wash)] text-white font-medium'
                  : 'border-transparent text-[var(--color-wash)]/70 hover:text-white',
              ]}
            >
              {openHere ? openHere.label : 'More'}
              <span aria-hidden="true" class="ml-1 text-[11px]">&#9662;</span>
              <span class="sr-only">{openHere ? ' - more portal pages' : 'portal pages'}</span>
            </summary>
            <div class="absolute left-0 top-full z-30 mt-1 min-w-[11rem] rounded-[var(--radius-panel)] border border-[var(--color-rule-soft)] bg-white py-1 shadow-lg">
              {MORE.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'block px-4 py-2 text-[14.5px] whitespace-nowrap',
                    active(item.href)
                      ? 'font-medium text-[var(--color-navy)] bg-[var(--color-paper)]'
                      : 'text-[var(--color-ink)] hover:bg-[var(--color-paper)]',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </nav>
      </div>
    </header>

    {
      closed && (
        <p class="bg-[var(--color-outstock)] text-white text-[13.5px] px-5 md:px-8 py-2 text-center">
          The shop is closed to customers.{' '}
          <a href="/admin/settings?s=maintenance" class="underline underline-offset-2">Open it again</a>
        </p>
      )
    }
    <main class="page-enter mx-auto max-w-[var(--width-portal)] px-5 md:px-8 py-8">
      {
        back && (
          <a
            href={back.href}
            class="inline-block mb-4 text-[14px] text-[var(--color-navy)] hover:underline underline-offset-2"
          >
            ← {back.label}
          </a>
        )
      }
      {
        showHeading && (
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-6">
            <h1 class="font-[family-name:var(--font-display)] text-[30px] md:text-[34px] font-semibold">
              {title}
            </h1>
            {sub && <p class="text-[15px] text-[var(--color-ink-faint)]">{sub}</p>}
          </div>
        )
      }

      <slot />
    </main>
    <script>
      import '../scripts/reveal.ts';
      import '../scripts/page-transition.ts';
      import '../scripts/form-controls.ts';
    </script>
  </body>
</html>
