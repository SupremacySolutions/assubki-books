---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rosette from '../components/Rosette.astro';
import { SITE } from '../lib/format';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image for link previews (Telegram, WhatsApp). */
  image?: string | null;
  noindex?: boolean;
  /** Off on the home page, whose hero carries the search. */
  headerSearch?: boolean;
  wide?: boolean;
}

const {
  title,
  description = SITE.tagline,
  image = null,
  noindex = false,
  headerSearch = true,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;

// Absolute URLs follow the host actually being served, not the configured
// `site`. On production those are the same. On the preview deployment they are
// not, and using `site` would point every Telegram link preview at
// assubkibooks.co.uk - still WordPress - so the card would show a broken image.
const origin = Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).toString();
/*
 * Every page shares with a picture. Only book pages had one, so the link the
 * owner posts most - the shop itself, or a shelf - unfurled in WhatsApp and
 * Telegram as a bare line of text. The shop's card stands in wherever a page
 * has no picture of its own, and carries its size so the preview is drawn
 * before the image has been fetched.
 */
const ogImage = new URL(image ?? '/og.png', origin).toString();
const ogIsCard = !image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogIsCard && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${SITE.name} - ${SITE.tagline}`} />
      </>
    )}
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#184485" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* For the browsers and crawlers that never read the SVG - including the
        ones that ask for /favicon.ico by name whatever the page says. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline nonce={Astro.locals.cspNonce}>
      try {
        if (sessionStorage.getItem('asb-internal-navigation') === '1') {
          document.documentElement.classList.add('skip-splash');
          sessionStorage.removeItem('asb-internal-navigation');
        }
      } catch { /* Private browsing can disable session storage. */ }
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <script is:inline nonce={Astro.locals.cspNonce}>
      // Set before paint so reveal styles only apply where JS can undo them.
      // Without this, a JS failure would leave the page permanently blank.
      document.documentElement.classList.add('js');
    </script>
    {/* Every page uses this layout, so it cannot name one of them. */}
    <a href="#main" class="skip">Skip to main content</a>
    <div id="pageTransition" class="page-transition is-loading" aria-hidden="true">
      <div class="page-transition-mark"><Rosette size={34} />As-Subki Books</div>
    </div>
    <Header search={headerSearch} />
    <main id="main" class:list={[wide ? 'flex-1' : 'flex-1 mx-auto w-full max-w-[var(--width-shop)] px-5 md:px-10', 'page-enter']}>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/basket.ts';
      import '../scripts/reveal.ts';
      import '../scripts/page-transition.ts';
      import '../scripts/shelf.ts';
      import '../scripts/form-controls.ts';
      import '../scripts/search-suggest.ts';
      import '../scripts/scroll-hint.ts';
      import { wireQuickAdd } from '../scripts/quick-add.ts';

      // Any page can render a BookCard, so the Add button is wired here rather
      // than on the one page that happened to use it first.
      wireQuickAdd();
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-navy);
        color: #fff;
        padding: 0.75rem 1.25rem;
      }
      .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
