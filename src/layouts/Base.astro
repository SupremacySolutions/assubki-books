---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rosette from '../components/Rosette.astro';
import { SITE } from '../lib/format';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image for link previews (Telegram, WhatsApp). */
  image?: string | null;
  noindex?: boolean;
  wide?: boolean;
}

const {
  title,
  description = SITE.tagline,
  image = null,
  noindex = false,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;

// Absolute URLs follow the host actually being served, not the configured
// `site`. On production those are the same. On the preview deployment they are
// not, and using `site` would point every Telegram link preview at
// assubkibooks.co.uk - still WordPress - so the card would show a broken image.
const origin = Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogImage = image ? new URL(image, origin).toString() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#184485" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        if (sessionStorage.getItem('asb-internal-navigation') === '1') {
          document.documentElement.classList.add('skip-splash');
          sessionStorage.removeItem('asb-internal-navigation');
        }
      } catch { /* Private browsing can disable session storage. */ }
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <script is:inline>
      // Set before paint so reveal styles only apply where JS can undo them.
      // Without this, a JS failure would leave the page permanently blank.
      document.documentElement.classList.add('js');
    </script>
    <a href="#main" class="skip">Skip to catalogue</a>
    <div id="pageTransition" class="page-transition is-loading" aria-hidden="true">
      <div class="page-transition-mark"><Rosette size={34} />As-Subki Books</div>
    </div>
    <Header />
    <main id="main" class:list={[wide ? 'flex-1' : 'flex-1 mx-auto w-full max-w-6xl px-5 md:px-8', 'page-enter']}>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/basket.ts';
      import '../scripts/reveal.ts';
      import '../scripts/page-transition.ts';
      import '../scripts/shelf.ts';
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-navy);
        color: #fff;
        padding: 0.75rem 1.25rem;
      }
      .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
