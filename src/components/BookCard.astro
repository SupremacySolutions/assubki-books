---
/**
 * The catalogue card - the shop's signature unit.
 *
 * It is set as a library entry rather than a product tile: transliterated title
 * as the main entry, the Arabic title beneath it in naskh at a larger optical
 * size (that is the form many customers recognise), and the category as a shelf
 * classmark. The cover sits in a fixed-ratio well so a grid of 24 books does not
 * reflow as images load.
 */
import { price, availability, imageUrl } from '../lib/format';
import { cropsCleanly } from '../lib/cover-fit';
import { IMAGE_PRESETS } from '../lib/image-presets';
import { classmark } from '../lib/classmarks';
import Rosette from './Rosette.astro';
import type { BookRow } from '../lib/db';

interface Props {
  book: BookRow;
  eager?: boolean;
  /**
   * Show an add button under the card.
   *
   * Off by default and used only by the "on the same shelf" strip. This same
   * component draws the whole catalogue, and putting a button under all 226
   * listings is a different decision from putting one under six suggestions.
   */
  quickAdd?: boolean;
}
const { book, eager = false, quickAdd = false } = Astro.props;

const img = imageUrl(book.image_key, 'card');
const avail = availability(book.available);

/*
 * A cover close enough to 3:4 fills the box and is trimmed at the sides, where
 * these scans carry a white margin; anything else is shown whole. Nearly every
 * cover crops, so the grid reads as one size, and the few odd shapes keep all
 * of themselves rather than losing a title.
 */
const fills = cropsCleanly(book.width, book.height);
const marks = (book.cat_slugs ?? '')
  .split(',')
  .filter(Boolean)
  .map(classmark)
  .filter((v, i, a) => a.indexOf(v) === i)
  .slice(0, 3);
---

<article class="group h-full">
  <a href={`/book/${book.slug}`} class="flex h-full flex-col focus:outline-none">
    <div
      class="book-well relative overflow-hidden bg-white border border-[var(--color-rule)] rounded-[var(--radius-card)] aspect-[3/4] grid place-items-center group-focus-visible:outline group-focus-visible:outline-2 group-focus-visible:outline-[var(--color-navy)]"
    >
      {
        img ? (
          <img
            src={img}
            alt={book.title}
            {/* The box's own size, not the stored image's: an owner-uploaded
                photo has no stored dimensions at all, which is what used to
                shift the grid as it loaded. */}
            width={IMAGE_PRESETS.card.width}
            height={IMAGE_PRESETS.card.height}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class:list={[
              'h-full w-full transition-transform duration-300 ease-out group-hover:scale-[1.03] motion-reduce:transform-none',
              fills ? 'object-cover' : 'object-contain p-3',
            ]}
          />
        ) : (
          /* 18 titles arrived with no cover. A rosette placeholder keeps the
             grid even and reads as intentional rather than broken. */
          <div class="grid place-items-center text-[var(--color-wash)]">
            <Rosette size={56} />
          </div>
        )
      }

      {
        avail.state === 'out' && (
          <span class="absolute inset-x-0 bottom-0 bg-[var(--color-ink)]/80 text-white text-[11px] font-semibold tracking-wide uppercase text-center py-1.5">
            Out of stock
          </span>
        )
      }
      {
        avail.state === 'low' && (
          <span class="absolute top-2 right-2 bg-[var(--color-outstock)] text-white text-[10px] font-semibold tracking-wide uppercase px-1.5 py-1 rounded-sm">
            {book.available} left
          </span>
        )
      }
    </div>

    <div class="pt-3 flex flex-1 flex-col">
      {
        marks.length > 0 && (
          <div class="flex flex-wrap gap-1 mb-1.5">
            {marks.map((m) => (
              <span class="classmark">{m}</span>
            ))}
          </div>
        )
      }

      <h3
        class="font-[family-name:var(--font-display)] text-[16.5px] leading-snug text-[var(--color-ink)] group-hover:text-[var(--color-navy)] transition-colors"
      >
        {book.title}
      </h3>

      {book.title_ar && <p class="ar mt-0.5 text-[15px] text-[var(--color-ink-soft)]">{book.title_ar}</p>}

      {/* Said before anyone clicks: a set and a single book cost differently
          and arrive differently, and that is worth knowing from the grid. */}
      {book.volumes && book.volumes > 1 && (
        <p class="mt-1 text-[13px] text-[var(--color-ink-faint)]">{book.volumes} volumes</p>
      )}

      <div class="mt-auto pt-2.5 flex items-baseline justify-between gap-2">
        <span class="price text-[16px]">{price(book.price_pence)}</span>
        <span
          class:list={[
            'text-[12px] font-medium',
            avail.state === 'in' && 'text-[var(--color-instock)]',
            avail.state === 'low' && 'text-[var(--color-outstock)]',
            avail.state === 'out' && 'text-[var(--color-ink-faint)]',
          ]}>{avail.label}</span
        >
      </div>
    </div>
  </a>

  {/* Outside the anchor: a button inside a link is not a button anyone can
      use, and nesting them is invalid besides. */}
  {
    quickAdd && book.available > 0 && (
      <button
        type="button"
        class="quick-add mt-2 w-full btn btn-ghost !py-1.5 !text-[13.5px]"
        data-book-id={book.id}
        data-max={book.available}
        data-slug={book.slug}
      >
        Add to basket
      </button>
    )
  }
</article>
