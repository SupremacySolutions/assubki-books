---
/**
 * A pop-up, using the browser's own.
 *
 * `<dialog>` with `showModal()` gives the backdrop, Esc to close, focus held
 * inside, and the page behind made inert - all of it native, none of it a
 * library. The alternative is several hundred lines of focus management that
 * every framework gets subtly wrong.
 *
 * Opened by any element carrying `data-dialog-open="<id>"`, so a page can put
 * the trigger wherever it belongs and the dialog itself out of the way.
 */
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: extraClass = '' } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={[
    'asb-dialog w-[min(28rem,calc(100vw-2rem))] p-0 rounded-[4px] border border-[var(--color-rule)] bg-[var(--color-paper)] text-[var(--color-ink)]',
    extraClass,
  ]}
>
  <div class="flex items-start justify-between gap-4 p-5 pb-3">
    <h2 id={`${id}-title`} class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
      {title}
    </h2>
    <button
      type="button"
      data-dialog-close
      aria-label="Close"
      class="shrink-0 -mt-2 -mr-2.5 p-2.5 rounded-full text-[var(--color-ink-faint)] hover:text-[var(--color-ink)] hover:bg-[var(--color-wash-soft)] transition-colors cursor-pointer"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="px-5 pb-5">
    <slot />
  </div>
</dialog>

<style is:global>
  /* A native <dialog> centres itself with `margin: auto`, which the CSS reset
     zeroes along with every other margin - so without this it sits in the
     top-left corner. */
  .asb-dialog {
    margin: auto;
    max-height: calc(100dvh - 2rem);
  }
  .asb-dialog::backdrop {
    background: rgb(16 24 40 / 0.55);
    backdrop-filter: blur(2px);
  }
  .asb-dialog[open] {
    animation: asb-dialog-in 0.18s ease-out;
  }
  @keyframes asb-dialog-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  /*
   * On a phone, a sheet from the bottom edge.
   *
   * A box floating mid-screen put its buttons at the height of the address
   * bar, out of thumb's reach, and the page shrank around it to a strip. A
   * sheet keeps the actions under the thumb and reads as "this sits over the
   * page", which is what it is. The grab bar is decoration; tapping the dim
   * page above or pressing Close still puts it away.
   */
  @media (max-width: 639px) {
    .asb-dialog {
      width: 100%;
      max-width: 100%;
      margin: auto 0 0;
      max-height: calc(100dvh - 3rem);
      border-radius: 16px 16px 0 0;
      border-bottom: 0;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .asb-dialog::before {
      content: '';
      display: block;
      width: 36px;
      height: 4px;
      margin: 8px auto 0;
      border-radius: 999px;
      background: var(--color-rule);
    }
    .asb-dialog[open] {
      animation: asb-sheet-in 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  @keyframes asb-sheet-in {
    from {
      transform: translateY(100%);
    }
  }
  .asb-dialog[open]::backdrop {
    animation: asb-backdrop-in 0.2s ease-out;
  }
  @keyframes asb-backdrop-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .asb-dialog[open],
    .asb-dialog[open]::backdrop {
      animation: none;
    }
  }
</style>

<script>
  /*
   * One listener for every dialog on the page. The order page carries two, and
   * a `querySelector` written for one of them would only ever find the first.
   */
  for (const trigger of document.querySelectorAll<HTMLElement>('[data-dialog-open]')) {
    trigger.addEventListener('click', () => {
      const dialog = document.querySelector<HTMLDialogElement>(`#${trigger.dataset.dialogOpen}`);
      dialog?.showModal();
    });
  }

  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog')) {
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());

    // Clicking the backdrop. The event target is the dialog itself only when
    // the click landed outside its content box.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
