---
/**
 * A pop-up, using the browser's own.
 *
 * `<dialog>` with `showModal()` gives the backdrop, Esc to close, focus held
 * inside, and the page behind made inert - all of it native, none of it a
 * library. The alternative is several hundred lines of focus management that
 * every framework gets subtly wrong.
 *
 * Opened by any element carrying `data-dialog-open="<id>"`, so a page can put
 * the trigger wherever it belongs and the dialog itself out of the way.
 */
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: extraClass = '' } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={[
    'asb-dialog w-[min(28rem,calc(100vw-2rem))] p-0 rounded-[4px] border border-[var(--color-rule)] bg-[var(--color-paper)] text-[var(--color-ink)]',
    extraClass,
  ]}
>
  <div class="flex items-start justify-between gap-4 p-5 pb-3">
    <h2 id={`${id}-title`} class="font-[family-name:var(--font-display)] text-[19px] font-semibold">
      {title}
    </h2>
    <button
      type="button"
      data-dialog-close
      aria-label="Close"
      class="shrink-0 -mt-1 -mr-1 p-1.5 text-[var(--color-ink-faint)] hover:text-[var(--color-ink)] cursor-pointer"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="px-5 pb-5">
    <slot />
  </div>
</dialog>

<style is:global>
  /* A native <dialog> centres itself with `margin: auto`, which the CSS reset
     zeroes along with every other margin - so without this it sits in the
     top-left corner. */
  .asb-dialog {
    margin: auto;
    max-height: calc(100dvh - 2rem);
  }
  .asb-dialog::backdrop {
    background: rgb(16 24 40 / 0.55);
    backdrop-filter: blur(2px);
  }
  .asb-dialog[open] {
    animation: asb-dialog-in 0.18s ease-out;
  }
  @keyframes asb-dialog-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .asb-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  /*
   * One listener for every dialog on the page. The order page carries two, and
   * a `querySelector` written for one of them would only ever find the first.
   */
  for (const trigger of document.querySelectorAll<HTMLElement>('[data-dialog-open]')) {
    trigger.addEventListener('click', () => {
      const dialog = document.querySelector<HTMLDialogElement>(`#${trigger.dataset.dialogOpen}`);
      dialog?.showModal();
    });
  }

  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog')) {
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());

    // Clicking the backdrop. The event target is the dialog itself only when
    // the click landed outside its content box.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
