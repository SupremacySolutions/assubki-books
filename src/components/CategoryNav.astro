---
import type { CategoryNode } from '../lib/db';
import { classmark } from '../lib/classmarks';

interface Props {
  tree: CategoryNode[];
  activePath?: string | null;
  /** Preserved so switching shelf does not silently drop the search. */
  query?: string;
}
const { tree, activePath = null, query = '' } = Astro.props;
const href = (path: string) => `/catalogue${path ? `/${path}` : ''}${query}`;
const isActive = (path: string) => activePath === path;
const isAncestor = (path: string) => !!activePath && activePath.startsWith(`${path}/`);
---

<nav aria-label="Shelves" class="text-[14.5px]">
  <h2 class="eyebrow mb-3">Browse by subject</h2>
  <ul class="space-y-0.5">
    <li>
      <a
        href={href('')}
        class:list={[
          'flex items-center justify-between gap-2 px-2 py-1.5 rounded-sm hover:bg-[var(--color-paper)]',
          !activePath
            ? 'bg-[#f4f6fa] font-medium text-[var(--color-navy)]'
            : 'text-[var(--color-ink-soft)]',
        ]}
      >
        <span>All titles</span>
      </a>
    </li>

    {
      tree.map((cat) => {
        const open = isActive(cat.path) || isAncestor(cat.path);
        const panelId = `shelf-${cat.slug}`;
        return (
          <li>
            {/* The name navigates and the chevron expands. Making the whole row
                do both would mean guessing which the visitor intended. */}
            <div class="flex items-stretch gap-0.5">
              <a
                href={href(cat.path)}
                class:list={[
                  'flex items-center justify-between gap-2 px-2 py-1.5 rounded-sm hover:bg-[var(--color-paper)] flex-1 min-w-0',
                  open
                    ? 'bg-[#f4f6fa] font-medium text-[var(--color-navy)]'
                    : 'text-[var(--color-ink-soft)]',
                ]}
              >
                <span class="flex items-center gap-2 min-w-0">
                  <span class="classmark shrink-0">{classmark(cat.slug)}</span>
                  <span class="truncate">{cat.name}</span>
                </span>
                <span class="text-[12px] tabular-nums text-[var(--color-ink-faint)] shrink-0">
                  {cat.count}
                </span>
              </a>

              {cat.children.length > 0 ? (
                <button
                  type="button"
                  class="shelf-toggle w-6 grid place-items-center rounded-sm text-[var(--color-ink-faint)] hover:bg-[var(--color-paper)] hover:text-[var(--color-navy)] shrink-0"
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={panelId}
                >
                  <span class="sr-only">Show shelves under {cat.name}</span>
                  <svg
                    viewBox="0 0 16 16"
                    width="13"
                    height="13"
                    aria-hidden="true"
                    class="transition-transform duration-200 motion-reduce:transition-none"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 6l4 4 4-4" />
                  </svg>
                </button>
              ) : (
                /* Empty slot of the same width: without it the count column
                   shifts on every shelf that has no children. */
                <span class="w-6 shrink-0" aria-hidden="true" />
              )}
            </div>

            {cat.children.length > 0 && (
              <ul
                id={panelId}
                hidden={!open}
                class="ml-3 mt-0.5 mb-1 space-y-0.5 border-l border-[var(--color-wash-soft)] pl-3"
              >
                {cat.children.map((child) => (
                  <li>
                    <a
                      href={href(child.path)}
                      class:list={[
                        'flex items-center justify-between gap-2 px-2 py-1 rounded-sm hover:bg-[var(--color-paper)]',
                        isActive(child.path)
                          ? 'bg-[#f4f6fa] font-medium text-[var(--color-navy)]'
                          : 'text-[var(--color-ink-soft)]',
                      ]}
                    >
                      <span class="truncate">{child.name}</span>
                      <span class="text-[12px] tabular-nums text-[var(--color-ink-faint)] shrink-0 pe-6">
                        {child.count}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .shelf-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
</style>

<script>
  // Without JS every shelf stays open, which is the old behaviour rather than
  // a broken one: the panels are only hidden once something can reopen them.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('.shelf-toggle')) {
    toggle.addEventListener('click', () => {
      const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
      if (!panel) return;
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      panel.hidden = open;
    });
  }
</script>
