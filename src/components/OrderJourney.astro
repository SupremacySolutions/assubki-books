---
/**
 * The order as a story rather than a status.
 *
 * A customer coming back days later wants to know what has happened and what
 * happens next, not a single word. Steps that are done carry the date they
 * happened; the one in progress says what is being waited on; the rest are
 * dimmed so it is obvious how much is left.
 *
 * Collection and delivery are genuinely different journeys, so they show
 * different final steps rather than one wording bent to cover both.
 */
import type { OrderView } from '../lib/orders';
import { trackingUrl } from '../lib/order-status';
import { whenText } from '../lib/incoming';

interface Props {
  order: OrderView;
}
const { order } = Astro.props;

const isCollection = order.fulfilment === 'collection';
// Paying in cash changes what the middle of the journey is waiting on - a time,
// not a transfer - and the step is read directly under a heading that already
// says so. It applies to either journey now: a posted order marked cash is one
// handed over in person.
const cash = Boolean(order.cash_payment);
const cancelled = order.status === 'cancelled' || order.status === 'expired';

const when = (t: number | null) =>
  t ? new Date(t * 1000).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : null;

type Step = {
  title: string;
  /**
   * One or two words, for under a bar segment.
   *
   * "Confirmed, payment details sent" is the right thing to read when it is
   * the step you are on, and far too long to sit under a 90px segment on a
   * phone. The full title still shows for the current step.
   */
  short: string;
  done: boolean;
  at: string | null;
  note?: string;
};

const reached = {
  confirmed:
    Boolean(order.confirmed_at) ||
    ['awaiting_payment', 'paid', 'dispatched', 'completed'].includes(order.status),
  paid: Boolean(order.paid_at) || ['paid', 'dispatched', 'completed'].includes(order.status),
  posted: Boolean(order.dispatched_at) || ['dispatched', 'completed'].includes(order.status),
  // A collection order cannot be posted, so orders predating that rule which
  // were marked dispatched are finished - the page calls them Collected and the
  // timeline used to show that same step as still to come.
  finished:
    order.status === 'completed' || (isCollection && order.status === 'dispatched'),
};

/*
 * An order can be paid and still not postable, because one of its lines is on
 * a lorry. That is a real step with a real duration, not a stalled "Posted" -
 * so it gets its own segment rather than leaving the bar looking stuck.
 */
const waitingOn = order.items.find((i) => i.from_incoming);
const waitingWhen = waitingOn
  ? whenText(waitingOn.incoming_vague, waitingOn.incoming_month)
  : null;

const opening: Step[] = [
  {
    short: 'Requested',
    title: 'Request received',
    done: true,
    at: when(order.created_at),
    note: 'Your books were set aside for you.',
  },
  {
    short: 'Confirmed',
    title: cash
      ? isCollection
        ? 'Confirmed, collection to arrange'
        : 'Confirmed, paying in cash'
      : 'Confirmed, payment details sent',
    done: reached.confirmed,
    at: when(order.confirmed_at),
    note: reached.confirmed
      ? undefined
      : 'We are checking the books and working out the total.',
  },
];

/*
 * The two journeys genuinely differ, so they are written out separately rather
 * than as one list with the wording bent to cover both. A collection has no
 * posting step at all - payment received *is* the moment the books are ready -
 * which is why it is four steps against delivery's five.
 */
const steps: Step[] = isCollection
  ? [
      ...opening,
      ...(waitingOn
        ? [
            {
              short: 'Waiting',
              title: 'Waiting on a delivery',
              done: reached.paid,
              at: null,
              note: reached.paid
                ? undefined
                : `One of your books has not reached us yet${waitingWhen ? `, expected ${waitingWhen}` : ''}. We will let you know the moment it is in.`,
            } as Step,
          ]
        : []),
      {
        short: 'Ready',
        title: 'Ready to collect',
        done: reached.paid,
        at: when(order.paid_at),
        note: reached.finished
          ? undefined // they have been; standing advice about collecting is stale
          : reached.paid
            ? cash
              ? 'Come and collect - you can pay when you arrive.'
              : 'Come and collect whenever suits you.'
            : cash
              ? 'We will set them aside and agree a time with you.'
              : 'Once your payment reaches us your books will be set aside.',
      },
      {
        short: 'Collected',
        title: 'Collected',
        done: reached.finished,
        at: when(order.completed_at),
        note: reached.finished ? undefined : 'We will mark this when you pick them up.',
      },
    ]
  : [
      ...opening,
      {
        // Nothing has been received on a cash order, so this step cannot claim
        // it has - what it marks is the books being ready.
        short: cash ? 'Packed' : 'Paid',
        title: cash ? 'Packed and ready' : 'Payment received',
        done: reached.paid,
        at: when(order.paid_at),
        note: reached.paid
          ? undefined
          : cash
            ? 'We will pack these and be in touch to arrange handing them over.'
            : 'Once your payment reaches us we will confirm here.',
      },
      ...(waitingOn
        ? [
            {
              short: 'Waiting',
              title: 'Waiting on a delivery',
              done: reached.posted,
              at: null,
              note: reached.posted
                ? undefined
                : `One of your books has not reached us yet${waitingWhen ? `, expected ${waitingWhen}` : ''}. The whole order goes out together once it does.`,
            } as Step,
          ]
        : []),
      {
        short: cash ? 'On its way' : 'Posted',
        title: cash ? 'On its way' : 'Posted',
        done: reached.posted,
        at: when(order.dispatched_at),
        note: reached.posted ? undefined : 'We will post your books and note it here.',
      },
      {
        short: cash ? 'Handed over' : 'Delivered',
        title: cash ? 'Handed over' : 'Delivered',
        done: reached.finished,
        at: when(order.completed_at),
        note: reached.finished
          ? undefined
          : cash
            ? 'We will close this off once you have them and the cash is settled.'
            : 'We will close this off once it reaches you.',
      },
    ];

// The first step not yet done is the one being waited on.
const currentIndex = steps.findIndex((s) => !s.done);

/*
 * What to say under the bar.
 *
 * Not just the current step's note: a collection order that has been paid is
 * *waiting to be collected*, and "Come and collect - you can pay when you
 * arrive" hangs off the step that is already done. The vertical timeline
 * printed every note, so it never had to choose; a bar does, and choosing only
 * the current one loses the single most actionable line on the page.
 */
const lastDone = currentIndex === -1 ? steps.length - 1 : currentIndex - 1;
const notes = [steps[lastDone]?.note, steps[currentIndex]?.note].filter(
  (n, i, all): n is string => Boolean(n) && all.indexOf(n) === i,
);

// The link used to be hardcoded to Royal Mail, so an Evri number sent the
// customer to a page that could not find it.
const track = order.tracking_number
  ? trackingUrl(order.postage_provider, order.tracking_number)
  : null;

// "Other" is a value on the owner's carrier list, not something to say to a
// customer - "Use this number with Other to track it" is nonsense to read.
const carrier =
  order.postage_provider && order.postage_provider !== 'Other'
    ? order.postage_provider
    : 'the carrier';
---

{
  cancelled ? (
    <p class="text-[15px] text-[var(--color-ink-soft)]">
      {order.status === 'expired'
        ? 'This request lapsed before it was confirmed, so the books went back on the shelf.'
        : 'This request was cancelled.'}{' '}
      Nothing was charged.
    </p>
  ) : (
    <div>
      {/*
        * A bar rather than a vertical list. The whole journey is four or five
        * steps, and a horizontal run of segments shows at a glance how far
        * along it is - which is the question someone coming back days later is
        * actually asking. The full title and the note belong to whichever step
        * is current; the rest carry a short label and their date.
        */}
      {/* The waiting step gets more room than the others, because it is the
          one with no known length and the label has more to say. */}
      <ol
        class="grid gap-x-2"
        style={`grid-template-columns: ${steps.map((s) => (s.short === 'Waiting' ? '1.5fr' : '1fr')).join(' ')}`}
      >
        {steps.map((step, i) => {
          const isCurrent = i === currentIndex;
          return (
            <li>
              <span
                class:list={[
                  'block h-1 rounded-full',
                  step.done
                    ? 'bg-[var(--color-instock)]'
                    : isCurrent
                      ? step.short === 'Waiting'
                        ? 'bg-[var(--color-brass)]'
                        : 'bg-[var(--color-navy)]'
                      : 'bg-[var(--color-rule-soft)]',
                ]}
                aria-hidden="true"
              />
              <p
                class:list={[
                  'mt-2 text-[12.5px] leading-tight',
                  step.done
                    ? 'text-[var(--color-ink)] font-medium'
                    : isCurrent
                      ? step.short === 'Waiting'
                        ? 'text-[var(--color-brass)] font-medium'
                        : 'text-[var(--color-navy)] font-medium'
                      : 'text-[var(--color-ink-faint)]',
                ]}
              >
                {step.short}
                <span class="sr-only">
                  {' — '}{step.title}{step.done ? ', done' : isCurrent ? ', in progress' : ', still to come'}
                </span>
              </p>
              {step.at && (
                <p class="mt-0.5 text-[11.5px] text-[var(--color-ink-faint)] tabular-nums leading-tight">
                  {step.at.split(',')[0]}
                </p>
              )}
            </li>
          );
        })}
      </ol>

      {/* What is happening now, spelled out under the bar where there is room
          for a whole sentence. */}
      {currentIndex >= 0 && (
        <div class="mt-5 pt-4 border-t border-[var(--color-rule-faint)]">
          <p
            class:list={[
              'text-[15.5px] font-medium',
              steps[currentIndex].short === 'Waiting'
                ? 'text-[var(--color-brass)]'
                : 'text-[var(--color-navy)]',
            ]}
          >
            {steps[currentIndex].title}
            <span class="ml-2 text-[12.5px] font-normal text-[var(--color-ink-faint)]">in progress</span>
          </p>
          {notes.map((note) => (
            <p class="mt-1 text-[14px] text-[var(--color-ink-soft)]">{note}</p>
          ))}
        </div>
      )}
      {currentIndex < 0 && (
        <div class="mt-5 pt-4 border-t border-[var(--color-rule-faint)]">
          <p class="text-[15.5px] font-medium text-[var(--color-instock)]">
            {steps[steps.length - 1].title} — this order is complete.
          </p>
          {notes.map((note) => (
            <p class="mt-1 text-[14px] text-[var(--color-ink-soft)]">{note}</p>
          ))}
        </div>
      )}
    </div>
  )
}

{
  /* Cancelled orders kept showing this: the branch above replaces the timeline
     but never touched the card below it, so a cancelled order that had once
     been posted still advertised its tracking number. */
  order.tracking_number && !isCollection && !cancelled && (
    <div class="mt-4 p-4 bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)]">
      <p class="eyebrow">Tracking number</p>
      <p class="mt-1 text-[17px] font-medium tabular-nums select-all">{order.tracking_number}</p>
      {order.postage_service && (
        <p class="mt-1 text-[13.5px] text-[var(--color-ink-soft)]">
          Sent by {carrier}, {order.postage_service}.
        </p>
      )}
      <p class="mt-1.5 text-[13px] text-[var(--color-ink-faint)]">
        {track ? (
          <>
            Track it on the{' '}
            <a href={track} rel="noopener" class="text-[var(--color-navy)] underline underline-offset-2">
              {carrier} site
            </a>
            .
          </>
        ) : (
          <>Use this number with {carrier} to track it.</>
        )}
      </p>
    </div>
  )
}
