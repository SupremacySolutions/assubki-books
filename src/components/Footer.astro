---
import Rosette from './Rosette.astro';
import { SITE } from '../lib/format';
import { contactHandle, contactLink } from '../lib/telegram';

// Whoever the owner set in the portal, not the channel: the footer is where
// someone with a question looks, and a channel cannot be replied to. The read
// is cached, so this is not a query per page view.
const [handle, contact] = await Promise.all([contactHandle(), contactLink()]);
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-[var(--color-navy-deep)] text-[var(--color-wash)]">
  <div class="mx-auto max-w-6xl px-5 md:px-8 py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5 text-[var(--color-wash)]">
          <Rosette size={26} />
          <span class="font-[family-name:var(--font-display)] text-[18px] font-semibold text-white">
            As-Subkī Books
          </span>
        </div>
        <p class="ar mt-2 text-[15px] text-[var(--color-wash)]/80">{SITE.nameAr}</p>
        <p class="mt-4 text-[14.5px] leading-relaxed text-[var(--color-wash)]/75 max-w-sm">
          Classical texts, syllabus sets and contemporary press for students, teachers, academics
          and enthusiasts worldwide.
        </p>
      </div>

      <div>
        <h2 class="eyebrow !text-[var(--color-wash)]/60">Contact</h2>
        <ul class="mt-3 space-y-3 text-[14.5px]">
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={contact ?? SITE.telegram} rel="noopener">
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.7 3.4 18.4 20c-.25 1.17-.92 1.46-1.87.91l-5.14-3.79-2.48 2.39c-.27.27-.5.5-1.03.5l.37-5.23 9.52-8.6c.41-.37-.09-.58-.64-.21L5.36 13.5.28 11.91c-1.1-.34-1.12-1.1.23-1.63L20.4 2.54c.93-.34 1.74.21 1.3.86Z" />
              </svg>
              {handle || 'Telegram'} on Telegram
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={`mailto:${SITE.email}`}>
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="1.5" />
                <path d="m3 7 9 6 9-6" />
              </svg>
              Email the shop
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between text-[13px] text-[var(--color-wash)]/60"
    >
      <p>© {year} As-Subkī Books</p>
    </div>
  </div>
</footer>
