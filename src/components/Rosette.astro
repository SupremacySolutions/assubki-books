---
/**
 * A 16-fold rosette in the family of the shop's own mark: an eight-point centre
 * star, a ring of eight leaves, and an outer ring offset by half a step.
 * Constructed geometrically rather than traced, so it stays crisp at any size
 * and takes its colour from `currentColor`. The path itself is shared with the
 * favicon and the mark the emails carry - see lib/mark.
 */
import { ROSETTE_PATH } from '../lib/mark';

interface Props {
  size?: number | string;
  class?: string;
  opacity?: number;
}
const { size = 24, class: className = '', opacity = 1 } = Astro.props;

const D = ROSETTE_PATH;
---

<svg
  viewBox="0 0 200 200"
  width={size}
  height={size}
  class={className}
  style={opacity !== 1 ? `opacity:${opacity}` : undefined}
  aria-hidden="true"
  focusable="false"
  fill="currentColor"
>
  <path d={D} />
</svg>
