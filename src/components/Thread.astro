---
import { THREAD } from '../lib/order-status';
import { BODY_MAX, IMAGES_PER_ORDER, type Message, type QuickReply } from '../lib/messages';
import { linkPieces, isExternal } from '../lib/linkify';

/**
 * The conversation on an order, drawn the same way for both sides.
 *
 * One component rather than two so the customer and the owner cannot drift
 * into disagreeing about what was said. What differs is only who "us" is, and
 * that is a prop.
 *
 * The compose box is a plain form that posts and reloads. It works with
 * JavaScript switched off, and src/scripts/thread.ts layers sending-in-place
 * on top of exactly this markup without replacing any of it.
 */
interface Props {
  messages: Message[];
  /** Whose messages are drawn as "ours". */
  side: 'customer' | 'owner';
  /** Where the compose box posts. */
  action: string;
  /** Hidden fields the post needs - the token, on the customer side. */
  hidden?: Record<string, string>;
  /** False on a finished order: readable, not writable. */
  open: boolean;
  /** Whether this side may attach photographs. Both can now; it is still a prop. */
  canAttach?: boolean;
  /** How many this side has already sent, so the limit can be stated honestly. */
  imagesUsed?: number;
  /** This side's photo allowance on the order. */
  maxImages?: number;
  /**
   * Owner only: the replies they send every day, one tap from the box. Already
   * filled in for this order, so a tap puts finished words in the box.
   */
  quickReplies?: QuickReply[];
  /** Where the saved replies are edited, so the row can say so. */
  quickRepliesHref?: string | null;
  /** Builds the src for a photo in the thread. Both sides read their own route. */
  proofUrl?: (id: number) => string;
  /**
   * Where the live poll asks, without its `since` cursor.
   *
   * Given per side rather than assumed, so `src/scripts/thread.ts` drives the
   * customer's page and the portal without knowing which it is on. Omitted, the
   * thread simply does not poll - which is what a finished order wants.
   */
  pollUrl?: string | null;
  /**
   * Where a photo in the thread is read from, without its `id`.
   *
   * The same address `proofUrl` builds, given separately because the script
   * needs it as a string it can append to for a message that arrives after the
   * page was drawn.
   */
  proofBase?: string | null;
  /** Shown above the box: which way a reply will actually travel. */
  channelNote?: string | null;
  /** A refusal from the last post, already turned into a sentence. */
  error?: string | null;
  /**
   * How far the other side has read, when this side is allowed to know.
   *
   * Owner only, and null everywhere else. The shop may tell its owner whether
   * a reply has been looked at; it must not start reporting the owner's own
   * reading back to the customer, so the customer's thread never receives
   * this and draws no receipts at all.
   *
   * It is the order page's cursor, not a delivery receipt. A Telegram message
   * and an email are both delivered the instant they go - only this proves
   * somebody opened the order and read it.
   */
  readCursor?: number | null;
  /** One line above the thread: whether they are up to date. */
  note?: string | null;
  /**
   * Fill the column rather than capping at a fixed height.
   *
   * The portal now gives the conversation a pane of its own, which wants the
   * thread to be as tall as the pane and scroll inside it. Everywhere else it
   * sits in a column of panels, where growing without limit would push the
   * order off the screen.
   */
  fill?: boolean;
}

const {
  messages,
  side,
  action,
  hidden = {},
  open,
  canAttach = false,
  imagesUsed = 0,
  maxImages = IMAGES_PER_ORDER,
  quickReplies = [],
  quickRepliesHref = null,
  proofUrl,
  pollUrl = null,
  proofBase = null,
  channelNote = null,
  error = null,
  readCursor = null,
  note = null,
  fill = false,
} = Astro.props as Props;

/*
 * The list's classes, in one place.
 *
 * `src/scripts/thread.ts` builds this same list when the first message lands
 * in a thread that started empty, so it reads the string off the section
 * rather than carrying a second copy that can drift from this one.
 */
const listClass = fill
  ? 'flex-1 min-h-0 overflow-y-auto p-4 space-y-3'
  : 'max-h-[26rem] overflow-y-auto p-4 space-y-3';

const atImageLimit = imagesUsed >= maxImages;
/* Every photo on the order, both sides', for the retention note. */
const photosHeld = messages.filter((m) => m.image_key).length;
const origin = Astro.url.origin;

/*
 * A line across the conversation where the day changes.
 *
 * A thread that runs over a week read as one block with a date squeezed into
 * every bubble; "Yesterday" between two messages says the same thing once and
 * lets each stamp be just a time.
 */
const dayKey = (at: number) =>
  new Date(at * 1000).toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
const dayLabel = (at: number) => {
  const key = dayKey(at);
  const now = Math.floor(Date.now() / 1000);
  if (key === dayKey(now)) return 'Today';
  if (key === dayKey(now - 86_400)) return 'Yesterday';
  return new Date(at * 1000).toLocaleDateString('en-GB', {
    timeZone: 'Europe/London', weekday: 'short', day: 'numeric', month: 'short',
    ...(new Date(at * 1000).getFullYear() === new Date().getFullYear() ? {} : { year: 'numeric' }),
  });
};
const firstOfDay = new Set(
  messages.filter((m, i) => i === 0 || dayKey(m.created_at) !== dayKey(messages[i - 1].created_at)).map((m) => m.id),
);

/* A time, not a date, for anything from today: "14:32" is what someone wants
   from a conversation they are in the middle of. */
/* Just the time: the day is said once, on the line above the day's first
   message. */
const when = (at: number) =>
  new Date(at * 1000).toLocaleTimeString('en-GB', {
    timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit',
  });

const ours = (m: Message) => m.sender === side;
---

<section
  id="thread"
  class:list={['scroll-mt-24', fill && 'h-full flex flex-col min-h-0']}
  data-thread
  data-side={side}
  data-poll-url={pollUrl ?? undefined}
  data-proof-url={proofBase ?? undefined}
  data-list-class={listClass}
  data-read-state={readCursor === null ? undefined : 'on'}
  data-max-images={canAttach ? maxImages : undefined}
  data-images-used={canAttach ? imagesUsed : undefined}
>
  <div class="mb-3 flex items-baseline justify-between gap-3">
    <h2 class="eyebrow">{THREAD.heading}</h2>
    {/* Owner only. Brass, because it is a state of play rather than a warning
        or a success - and left out entirely on a thread with nothing in it,
        which has no last message to be up to date with. */}
    <p
      class:list={[
        'text-[12.5px] text-[var(--color-brass)]',
        !note && 'hidden',
      ]}
      data-thread-note
    >{note}</p>
  </div>

  <div
    data-thread-panel
    class:list={[
      'bg-white border border-[var(--color-rule-soft)] rounded-[var(--radius-panel)] overflow-hidden',
      fill && 'flex-1 min-h-0 flex flex-col',
    ]}
  >
    {
      messages.length === 0 ? (
        <p class:list={['p-5 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed', fill && 'flex-1']}>
          {/* Both invitations assume there is somebody to answer. On a closed
              thread that put "start the conversation" directly above "the
              conversation is closed". */}
          {!open
            ? THREAD.emptyClosed
            : side === 'customer'
              ? THREAD.emptyCustomer
              : THREAD.emptyOwner}
        </p>
      ) : (
        /* Capped and scrolling rather than growing without limit: this panel
           sits on a page that already has an order on it, and a long thread
           must not push the rest of it out of reach. */
        <ol class={listClass} data-thread-list>
          {messages.map((m) => (
            <>
            {firstOfDay.has(m.id) && (
              <li class="flex items-center gap-3 py-1" data-day={dayKey(m.created_at)} aria-hidden="true">
                <span class="h-px flex-1 bg-[var(--color-rule-faint)]"></span>
                <span class="text-[11.5px] font-medium tracking-wide text-[var(--color-ink-faint)]">{dayLabel(m.created_at)}</span>
                <span class="h-px flex-1 bg-[var(--color-rule-faint)]"></span>
              </li>
            )}
            <li
              class:list={['flex', ours(m) ? 'justify-end' : 'justify-start']}
              data-message-id={m.id}
              data-message-at={m.created_at}
            >
              <div
                class:list={[
                  'max-w-[85%] sm:max-w-[75%] rounded-[12px] px-3.5 py-2.5',
                  ours(m)
                    ? 'bg-[var(--color-navy)] text-white'
                    : 'bg-[var(--color-paper-raised)] border border-[var(--color-rule-soft)]',
                ]}
              >
                {/* Links are links: tracking pages, the shop's own books, a map
                    pin. Built piece by piece, never parsed as markup. */}
                {m.body && (
                  <p class="text-[14.5px] leading-relaxed whitespace-pre-line break-words">{
                    linkPieces(m.body).map((piece) =>
                      piece.href ? (
                        <a
                          href={piece.href}
                          target={isExternal(piece.href, origin) ? '_blank' : undefined}
                          rel={isExternal(piece.href, origin) ? 'noopener noreferrer nofollow' : undefined}
                          class:list={[
                            'underline underline-offset-2 break-all',
                            ours(m) ? 'text-white decoration-white/60 hover:decoration-white' : 'text-[var(--color-navy)] hover:decoration-2',
                          ]}
                        >{piece.text}</a>
                      ) : piece.text,
                    )
                  }</p>
                )}

                {m.image_key && proofUrl && (
                  /* Opened in its own tab rather than a lightbox: the owner is
                     checking a payment reference against a screenshot and wants
                     it at full size, and a plain link needs no script. */
                  <a
                    href={proofUrl(m.id)}
                    target="_blank"
                    rel="noopener"
                    class:list={['block', m.body ? 'mt-2' : '']}
                  >
                    <img
                      src={proofUrl(m.id)}
                      alt="Photo sent with this message"
                      loading="lazy"
                      class="rounded-[8px] max-h-64 w-auto bg-[var(--color-paper)]"
                    />
                  </a>
                )}
                {/* The photo has been swept, and the row remembers it was
                    here. Saying so is the honest reading of a conversation
                    that is missing half of one of its turns. */}
                {!m.image_key && m.had_image === 1 && (
                  <p class:list={['text-[13px] italic opacity-75', m.body ? 'mt-1.5' : '']}>
                    Photo removed - this order closed over six months ago.
                  </p>
                )}

                <p
                  class:list={[
                    'mt-1.5 text-[11.5px] tabular-nums',
                    ours(m) ? 'text-white/65' : 'text-[var(--color-ink-faint)]',
                  ]}
                >
                  {when(m.created_at)}
                  {/* Which door they came through. The shop wants to know. */}
                  {m.via === 'telegram' && <span> · via Telegram</span>}
                  {/*
                    * Whether they have read it, and deliberately without a
                    * time. The cursor records how far they have got, not the
                    * moment they got there, and a clock invented here would
                    * be a guess printed beside a fact.
                    */}
                  {readCursor !== null && ours(m) && (
                    <span> · {m.id <= readCursor ? 'Read' : 'Sent, not read yet'}</span>
                  )}
                </p>
              </div>
            </li>
            </>
          ))}
        </ol>
      )
    }

    {/* Owner side only. The customer does not need the shop's retention policy
        under their compose box; the owner does, because they are the one
        holding somebody's bank details. */}
    {side === 'owner' && photosHeld > 0 && (
      <p class="px-4 pb-3 -mt-1 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
        {THREAD.ownerRetention(photosHeld)}
      </p>
    )}

    {
      open ? (
        <form
          method="post"
          action={action}
          enctype={canAttach ? 'multipart/form-data' : undefined}
          class="border-t border-[var(--color-rule-soft)] p-4"
          data-thread-form
        >
          {Object.entries(hidden).map(([name, value]) => (
            <input type="hidden" name={name} value={value} />
          ))}

          {error && (
            <p
              class="mb-3 text-[13.5px] text-[var(--color-outstock)] leading-relaxed"
              data-thread-error
              role="alert"
            >
              {error}
            </p>
          )}
          {!error && <p class="hidden mb-3 text-[13.5px] text-[var(--color-outstock)] leading-relaxed" data-thread-error role="alert" />}

          {/* Owner only. A tap puts the words in the box rather than sending
              them, so a saved reply can still be read and changed first. */}
          {quickReplies.length > 0 && (
            <div class="mb-3 -mx-1 flex flex-wrap items-center gap-1.5" data-quick-replies>
              <span class="sr-only">{THREAD.savedReplies}</span>
              {quickReplies.map((r) => (
                <button
                  type="button"
                  class="px-3.5 py-2 min-h-[40px] sm:min-h-[32px] sm:px-3 sm:py-1.5 rounded-[var(--radius-pill)] border border-[var(--color-rule-soft)] bg-[var(--color-paper)] text-[12.5px] text-[var(--color-ink-soft)] hover:border-[var(--color-navy)] hover:text-[var(--color-navy)] transition-colors"
                  data-quick-reply={r.text}
                  title={r.text}
                >{r.label}</button>
              ))}
              {quickRepliesHref && (
                <a href={quickRepliesHref} class="px-1.5 text-[12.5px] text-[var(--color-ink-faint)] underline underline-offset-2 hover:text-[var(--color-navy)]">Edit</a>
              )}
            </div>
          )}

          <label class="sr-only" for="thread-body">{THREAD.placeholder}</label>
          <textarea
            id="thread-body"
            name="body"
            rows="3"
            maxlength={BODY_MAX}
            placeholder={THREAD.placeholder}
            data-no-grow
            class="field !text-[14.5px] resize-y min-h-[4.5rem]"
          ></textarea>

          {/* What was picked, before it is sent. Only appears once there is
              something to show - the native input announced "No file chosen"
              whether or not that mattered to anybody. */}
          {canAttach && !atImageLimit && (
            <div class="mt-2.5 hidden items-start gap-2.5" data-thread-preview>
              <img alt="" class="rounded-[8px] max-h-24 w-auto border border-[var(--color-rule-soft)]" />
              <button
                type="button"
                class="text-[12.5px] text-[var(--color-ink-faint)] underline underline-offset-2 hover:text-[var(--color-navy)]"
                data-thread-clear
              >{THREAD.remove}</button>
            </div>
          )}

          <div class="mt-3 flex items-center gap-2.5">
            <button type="submit" class="btn btn-primary !py-2 !text-[14px]" data-thread-send>
              {THREAD.send}
            </button>

            {canAttach && !atImageLimit && (
              /*
               * A paperclip beside Send, not a native file input.
               *
               * `<input type="file">` renders as the browser's own button plus
               * "No file chosen" - two pieces of furniture nobody asked for, in
               * a typeface that is not ours, and on a phone it wraps onto its
               * own line and pushes Send down. The input is still here and
               * still does the work; it is only moved behind the label, which
               * is what keeps the paperclip clickable with no JavaScript at
               * all.
               *
               * 40px square, because that is the smallest thing a thumb can be
               * asked to hit.
               */
              <label
                class="shrink-0 grid place-items-center w-10 h-10 rounded-full border border-[var(--color-rule)] text-[var(--color-ink-faint)] hover:border-[var(--color-navy)] hover:text-[var(--color-navy)] focus-within:border-[var(--color-navy)] focus-within:text-[var(--color-navy)] transition-colors cursor-pointer"
                title={side === 'owner' ? THREAD.attachPhoto : THREAD.attach}
              >
                <span class="sr-only">{side === 'owner' ? THREAD.attachPhoto : THREAD.attach}</span>
                <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                </svg>
                {/* No `capture`: with it a phone opens the camera, and a bank
                    screenshot is in the gallery. Left off, iOS and Android both
                    offer Photo Library first. The narrow accept list is what
                    makes iOS convert an HEIC photo to JPEG on the way out,
                    which is what keeps this working with JavaScript off. */}
                <input
                  type="file"
                  name="image"
                  accept="image/jpeg,image/png,image/webp"
                  class="sr-only"
                  data-thread-image
                />
              </label>
            )}

            {/* With JavaScript off there is no preview, so the paperclip would
                give no sign it had taken anything. This is the fallback name,
                shown only by the script. */}
            {canAttach && !atImageLimit && (
              <p class="hidden min-w-0 flex-1 text-[12.5px] text-[var(--color-ink-faint)] truncate" data-thread-chosen></p>
            )}
          </div>

          {canAttach && atImageLimit && (
            <p class="mt-2.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
              {side === 'owner' ? THREAD.ownerImageCapped : THREAD.imageCapped}
            </p>
          )}

          {/* One line about paying, and only one.
              The customer's real question is where to send proof, and the
              answer is here or Telegram. How long the shop keeps the file is a
              privacy-page matter, not something to put between somebody and
              the send button - the owner is told that instead. */}
          {canAttach && side === 'customer' && (
            <p class="mt-2.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
              {THREAD.payHint}
            </p>
          )}
          {/* Where the reply goes, and - on a keyboard - how to send it, on one
              line. Two lines of small print under the box cost the
              conversation above them its room on a laptop screen. */}
          {(channelNote || side === 'owner') && (
            <p class="mt-2.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
              {channelNote}
              {side === 'owner' && (
                <span class="hidden md:inline">{channelNote ? ' · ' : ''}{THREAD.sendHint}</span>
              )}
            </p>
          )}
        </form>
      ) : (
        <p class="border-t border-[var(--color-rule-soft)] p-4 text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed">
          {THREAD.closed}
        </p>
      )
    }
  </div>
</section>
