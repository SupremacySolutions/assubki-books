---
/**
 * The dialog that shows a photo straightened before it is uploaded.
 *
 * A native `<dialog>` rather than a hand-built overlay: the backdrop, the
 * focus trap, Esc, and making the page behind inert all come with it, and
 * every one of those is something a hand-rolled modal gets wrong.
 *
 * Its own component so the same markup can be mounted outside the portal and
 * driven for real - /clean-check does exactly that in development. Everything
 * here is inert until src/scripts/cover-review.ts finds it.
 */
---

{/* Nothing is uploaded until this has been answered. The photo used to go
    straight to R2 the moment it was chosen, so a crooked shot of a book on a
    kitchen table was already live before anyone saw it. */}
{/* `m-auto` because Tailwind's preflight zeroes every margin, and that takes
    the browser's own centring of a modal dialog with it - without it the
    dialog opens in the top-left corner. */}
<dialog
  id="cleanPanel"
  aria-labelledby="cleanTitle"
  class="m-auto w-[min(56rem,calc(100vw-2rem))] p-0 rounded-[4px] border border-[var(--color-rule)] bg-[var(--color-paper)] text-[var(--color-ink)] backdrop:bg-black/45"
>
  <div class="flex flex-col max-h-[calc(100dvh-3rem)]">
    <header class="px-5 pt-4 pb-3 border-b border-[var(--color-rule)]">
      <h2 id="cleanTitle" class="font-[family-name:var(--font-display)] text-[19px]">
        Before this goes on the listing
      </h2>
      <p class="mt-0.5 text-[13.5px] text-[var(--color-ink-soft)] leading-relaxed">
        Drag the four corners onto the edges of the book. The right-hand side updates as you go.
      </p>
    </header>

    {/* The photo comes first on a phone: it is the one being touched. */}
    <div class="px-5 py-4 overflow-y-auto grid gap-5 sm:grid-cols-2 items-start">
      <div>
        <p class="eyebrow mb-2">The photo</p>
        <div id="cleanStage" class="relative inline-block touch-none select-none max-w-full">
          <canvas id="cleanSource" class="block max-w-full h-auto rounded-[2px]"></canvas>
          <svg
            id="cleanOverlay"
            class="absolute inset-0 w-full h-full overflow-visible"
            aria-hidden="true"
          ></svg>
        </div>
      </div>

      <div>
        <p class="eyebrow mb-2">On the listing</p>
        <canvas
          id="cleanResult"
          class="block max-w-full h-auto rounded-[2px] border border-[var(--color-rule)] bg-white"
        ></canvas>

        {/* Off by default, and nothing is downloaded until it is switched on. */}
        <label class="mt-3 flex items-start gap-2.5 cursor-pointer">
          <input type="checkbox" id="cleanErase" class="w-4 h-4 mt-0.5 accent-[var(--color-navy)]" />
          <span>
            <span class="block text-[13.5px] font-medium">Erase what is left behind the book</span>
            <span class="block mt-0.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed">
              For a hand or a shadow still inside the crop. The first use downloads a few
              megabytes, then it is quick.
            </span>
          </span>
        </label>
        <p
          id="cleanEraseNote"
          hidden
          class="mt-1.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed"
        />
      </div>
    </div>

    <footer class="px-5 py-3.5 border-t border-[var(--color-rule)] bg-white/40">
      <p id="cleanNote" class="mb-2.5 text-[12.5px] text-[var(--color-ink-faint)] leading-relaxed"></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="cleanUse" class="btn btn-primary !py-1.5 !text-[13.5px]">
          Use this
        </button>
        <button type="button" id="cleanRaw" class="btn btn-ghost !py-1.5 !text-[13.5px]">
          Use the photo as it is
        </button>
        <button type="button" id="cleanCancel" class="btn btn-ghost !py-1.5 !text-[13.5px]">
          Cancel
        </button>
      </div>
    </footer>
  </div>
</dialog>
