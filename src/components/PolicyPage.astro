---
import Base from '../layouts/Base.astro';

interface Props { title: string; intro: string; }
const { title, intro } = Astro.props;

// Shared shell for the shop's written policies.
---

<Base title={title} description={intro}>
  <div class="py-10 md:py-14 max-w-2xl">
    <h1 class="font-[family-name:var(--font-display)] text-[30px] md:text-[36px] font-semibold">
      {title}
    </h1>
    <p class="mt-3 text-[16px] text-[var(--color-ink-soft)] leading-relaxed">{intro}</p>
    <div class="policy mt-8 space-y-6 text-[15.5px] leading-relaxed">
      <slot />
    </div>
  </div>
</Base>

<style is:global>
  .policy h2 { font-family: var(--font-display); font-size: 20px; font-weight: 600; margin-top: 1.6rem; }
  .policy p { margin-top: .6rem; color: var(--color-ink-soft); }
  .policy ul { margin-top: .6rem; padding-left: 1.1rem; list-style: disc; color: var(--color-ink-soft); }
  .policy li { margin-top: .3rem; }
</style>
