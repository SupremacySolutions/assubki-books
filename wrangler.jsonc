{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // The adapter supplies the Worker entrypoint; ./dist is served as static
  // assets alongside it.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "assubki-books",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
  "ORDER_FROM": "As-Subki Orders <orders@assubkibooks.co.uk>",
  "OWNER_EMAIL": "subkibooks@gmail.com",
  "TELEGRAM_BOT_USERNAME": "AsSubkiBooksBot",
  "TELEGRAM_CHANNEL_ID": "-1003850128293"
},

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // The live custom domain is managed in Cloudflare outside this config.
  // Deploying this Worker updates assubkibooks.co.uk even without routes here.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assubki-books",
      "database_id": "efc0b55d-885f-44cb-9baf-a4431bb169ce"
    }
  ],

  // All book photos and their processed variants live in R2, including the
  // migrated books/ covers and uploads/ photos. Local R2 must be populated
  // separately; npm run dev:images copies public production photos locally.
  //
  // Deliberately not named IMAGES: the Astro adapter treats a binding of that
  // name as the Cloudflare Images service and wires itself to it.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "assubki-books-uploads"
    }
  ],

  // The 48h hold sweep runs in its own Worker (workers/expire-holds) because
  // the Astro adapter owns this Worker's entrypoint and cannot export
  // `scheduled`.

  "observability": {
    "enabled": true
  }
}
